#ucm-report .ucmw-sum-left, #ucm-report .ucmw-sum-right { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
#ucm-report .ucmw-card {
  background: #fff; border: 1px solid #e8ebf1; border-radius: 14px; padding: 18px 20px;
