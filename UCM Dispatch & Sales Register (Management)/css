        .ucm-soa-slider {
            position: fixed; top: 0; right: 0; height: 100vh;
            width: 55vw; max-width: 94vw; min-width: 480px; background: #fff;
            z-index: 1061; box-shadow: -6px 0 24px rgba(20,30,50,0.18);
            transform: translateX(100%); transition: transform 0.25s ease;
            display: flex; flex-direction: column;
        }
        .ucm-soa-slider.open { transform: translateX(0); }
        .ucm-soa-slider .ucm-cost-slider-header {
            padding: 16px 20px; border-bottom: 1px solid #e6ecf5;
            display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;
        }
        .ucm-soa-slider .ucm-cost-slider-header h4 { margin: 0; font-size: 14px; font-weight: 700; color: #3d5170; }
        .ucm-soa-slider .ucm-cost-slider-header .sub { font-size: 11px; color: #7a8fa8; margin-top: 2px; }
        .ucm-soa-slider .ucm-cost-slider-close {
