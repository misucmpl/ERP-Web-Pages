        .ucm-soa-slider .ucm-cost-slider-close:hover { background: #dde8f8; }
        .ucm-soa-slider .ucm-cost-slider-body { padding: 16px 20px; overflow-y: auto; flex: 1; }
        .ucm-soa-slider .ucm-cost-slider-loading { text-align: center; color: #7a8fa8; font-size: 12px; padding: 40px 0; }
        @media (max-width: 700px) { .ucm-soa-slider { width: 100vw; min-width: 0; max-width: 100vw; } }

        .ucm-soa-pills { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px; }
        .ucm-soa-pill {
            padding:6px 16px; border-radius:20px; cursor:pointer;
            font-size:11.5px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em;
            color:var(--c); background:#fff; border:1.5px solid var(--c);
        }
        .ucm-soa-pill span {
