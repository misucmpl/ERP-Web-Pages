            background:#eef1f6; color:#3d5170; font-size:10.5px;
        }
        .ucm-soa-pill.active { background:var(--c); color:#fff; }
        .ucm-soa-pill.active span { background:rgba(255,255,255,0.25); color:#fff; }

        .ucm-soa-section {
            font-size:11px; font-weight:800; color:#7a8fa8; text-transform:uppercase;
            letter-spacing:0.06em; margin:20px 0 10px; padding-bottom:6px;
            border-bottom:2px solid #1a73e8;
        }
        .ucm-soa-seg > .ucm-soa-section:first-child { margin-top:0; }
        .ucm-soa-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(125px, 1fr)); gap:10px; }
        .ucm-soa-card {
            border:1px solid #dde8f8; border-top:4px solid var(--c); border-radius:10px;
            padding:12px 10px; background:#fff; text-align:center;
        }
        .ucm-soa-card-label {
