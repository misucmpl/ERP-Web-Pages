        .ucm-soa-note { font-size:11px; color:#7a8fa8; margin-top:6px; }

        .ucm-soa-filters { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:10px; }
        .ucm-soa-filter {
            font-size:11px; font-weight:700; padding:4px 10px; border-radius:14px; cursor:pointer;
            background:#fff; color:#3d5170; border:1px solid #c5d5ef;
        }
        .ucm-soa-filter.active { background:#1a73e8; color:#fff; border-color:#1a73e8; }
        .ucm-soa-showing { font-size:11px; color:#7a8fa8; margin-bottom:6px; }

        .ucm-soa-table-wrap { overflow-x:auto; border:1px solid #dde8f8; border-radius:8px; }
        .ucm-soa-table { width:100%; min-width:760px; border-collapse:collapse; font-size:11.5px; }
        .ucm-soa-table th {
            background:#eef4fd; color:#3d5475; font-size:10px; font-weight:700;
            text-transform:uppercase; letter-spacing:0.03em; text-align:left;
            padding:7px 8px; border-bottom:1px solid #dde8f8; white-space:nowrap;
        }
