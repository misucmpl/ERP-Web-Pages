        .ucm-soa-empty { text-align:center; color:#7a8fa8; font-size:12px; padding:40px 0; }

        /* Slider ke andar scroll end par pahunche to bhi page scroll na ho */
        .ucm-soa-slider .ucm-cost-slider-body { overscroll-behavior: contain; }
        .ucm-soa-slider .ucm-soa-table-wrap { overscroll-behavior: contain; }
        body.ucm-soa-scroll-locked { overflow: hidden !important; }

