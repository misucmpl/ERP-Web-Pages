/* ═══════════════════════════ PART B — WEB PAGE LOOK (makeover) ═══════════════════════════
   White background, ek accent (blue), green/red sirf badhat-ghatat ke liye.
   Report ki purani CSS (PART A) ko yahan override kiya gaya hai.            */

#ucm-report, .ucmw-nav-title, .ucmw-nav-actions,
.ucm-sot-slider, .ucm-cost-slider, .ucmw-modal, .ucmw-toast {
  --ink: #0f172a; --ink2: #334155; --mut: #64748b; --mut2: #94a3b8;
  --line: #e5e7eb; --line2: #f1f5f9; --soft: #f8fafc; --accent: #6d32a8;
  --pos: #16a34a; --neg: #dc2626;
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}
body.ucmw-nav-merged, body.ucmw-nav-merged .page-content-wrapper, body.ucmw-nav-merged main { background: #fff !important; }

#ucm-report { color: var(--ink); font-size: 13px; line-height: 1.5; background: #fff; margin: 0 auto 48px; position: relative; }
#ucm-report *, #ucm-report *::before, #ucm-report *::after { box-sizing: border-box; }

/* ── Top progress line while loading ── */
#ucm-report .ucmw-progress { position: sticky; top: 0; height: 2px; z-index: 30; overflow: hidden; }
#ucm-report.ucmw-busy .ucmw-progress::after {
  content: ""; position: absolute; inset: 0 auto 0 0; width: 35%; background: var(--accent);
  animation: ucmwSlide 1.1s ease-in-out infinite;
}
@keyframes ucmwSlide { 0% { left: -35%; } 100% { left: 100%; } }

/* ═════ NAVBAR (logo → report naam → buttons ……… avatar) ═════ */
body.ucmw-nav-merged nav.navbar { border-bottom: 1px solid #e5e7eb; background: #fff !important; }
body.ucmw-nav-merged nav.navbar .navbar-brand img,
body.ucmw-nav-merged nav.navbar .navbar-brand svg { height: 40px !important; max-height: 40px !important; width: auto !important; }
body.ucmw-nav-merged nav.navbar .navbar-brand { display: flex; align-items: center; padding-top: 6px; padding-bottom: 6px; margin-right: 0; }

.ucmw-nav-title { display: flex; flex-direction: column; justify-content: center; margin: 0 20px 0 14px; padding-left: 14px; border-left: 1px solid #e5e7eb; min-width: 0; }
.ucmw-nav-title h3 { margin: 0; font-size: 17px; font-weight: 700; color: #0f172a; white-space: nowrap; line-height: 1.25; letter-spacing: -0.01em; }
.ucmw-nav-title .ucmw-sub { font-size: 11.5px; color: #64748b; white-space: nowrap; margin-top: 1px; }

.ucmw-nav-actions { display: flex; flex-wrap: nowrap; gap: 8px; align-items: center; margin: 0 auto 0 0; }
.ucmw-nav-actions .btn, #ucm-report .page-actions .btn, #ucm-report .btn,
.ucm-sot-slider .btn, .ucm-cost-slider .btn, .ucmw-modal .btn {
  display: inline-flex !important; align-items: center; gap: 6px; height: 34px; padding: 0 14px !important; margin: 0 !important;
  border-radius: 8px !important; font-size: 13px !important; font-weight: 500 !important; line-height: 1 !important; white-space: nowrap;
  border: 1px solid #e5e7eb !important; background: #fff !important; color: #0f172a !important; box-shadow: 0 1px 2px rgba(15,23,42,0.04) !important;
  cursor: pointer; transition: background 0.15s, border-color 0.15s;
}
.ucmw-nav-actions .btn:hover, #ucm-report .btn:hover { background: #f8fafc !important; border-color: #cbd5e1 !important; }
.ucmw-nav-actions .btn-primary, #ucm-report .btn-primary, .ucmw-modal .btn-primary {
  background: #0f172a !important; border-color: #0f172a !important; color: #fff !important;
}
.ucmw-nav-actions .btn-primary:hover, #ucm-report .btn-primary:hover { background: #1e293b !important; }
.ucmw-nav-actions .btn i.fa { display: none; }
@media (max-width: 1360px) { .ucmw-nav-title .ucmw-sub { display: none; } }

/* Page ka apna header (sirf jab navbar merge na ho) */
#ucm-report .ucmw-head { background: #fff; border-bottom: 1px solid var(--line); padding: 16px 28px; }
#ucm-report .ucmw-head-in { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
#ucm-report .ucmw-title h3 { margin: 0; font-size: 20px; font-weight: 700; color: var(--ink); }
#ucm-report .ucmw-sub { font-size: 12px; color: var(--mut); margin-top: 2px; }
#ucm-report .page-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
#ucm-report .ucmw-head-actions-only .ucmw-title { display: none; }

/* ═════ FILTER BAR ═════ */
#ucm-report .ucmw-filterbar { background: #fff; border-bottom: 1px solid var(--line); padding: 16px 28px 18px; }
#ucm-report #ucmw-filters {
