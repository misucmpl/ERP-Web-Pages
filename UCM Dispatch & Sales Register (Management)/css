/* ═══════════ PART H — ACCESS GATE (sirf System Manager) ═══════════ */
/* Access confirm hone tak filters / tabs / data bilkul nahi dikhte */
#ucm-report.ucmw-root:not(.ucmw-allowed) > .ucmw-head,
#ucm-report.ucmw-root:not(.ucmw-allowed) > .ucmw-filterbar,
#ucm-report.ucmw-root:not(.ucmw-allowed) > .ucmw-tabs,
#ucm-report.ucmw-root:not(.ucmw-allowed) > .ucmw-main { display: none !important; }
#ucm-report.ucmw-checking .ucmw-progress { opacity: 1; }
#ucm-report.ucmw-checking::after {
  content: "Checking access…"; display: block; text-align: center;
  padding: 90px 16px; color: #94a3b8; font-size: 13px; letter-spacing: .02em;
}
#ucm-report.ucmw-locked > *:not(.ucmw-gate) { display: none !important; }

.ucmw-gate {
  min-height: calc(100vh - 140px); display: flex; align-items: center; justify-content: center;
  padding: 40px 16px;
  background:
    radial-gradient(600px 300px at 50% 0%, rgba(109, 50, 168, .07), transparent 70%),
    radial-gradient(400px 220px at 85% 100%, rgba(212, 149, 42, .07), transparent 70%);
}
.ucmw-gate-card {
  position: relative; overflow: hidden; width: 100%; max-width: 440px;
  background: #fff; border: 1px solid #ece6f4; border-radius: 16px;
  box-shadow: 0 1px 2px rgba(15, 23, 42, .04), 0 18px 48px -18px rgba(76, 29, 122, .28);
  padding: 34px 32px 22px; text-align: center;
}
.ucmw-gate-band {
  position: absolute; inset: 0 0 auto 0; height: 4px;
  background: linear-gradient(90deg, #6d32a8 0%, #8f5bc4 55%, #d4952a 100%);
}
.ucmw-gate-icon {
  width: 64px; height: 64px; margin: 0 auto 16px; border-radius: 18px;
  display: flex; align-items: center; justify-content: center;
  color: #6d32a8; background: linear-gradient(145deg, #f6f0fc, #efe5f9);
  box-shadow: inset 0 0 0 1px #e4d6f3;
}
.ucmw-gate-kicker {
  font-size: 10.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #b07a1c;
}
.ucmw-gate-title { margin: 6px 0 8px; font-size: 21px; font-weight: 700; color: #0f172a; letter-spacing: -.01em; }
.ucmw-gate-text { margin: 0 auto; max-width: 350px; font-size: 13px; line-height: 1.6; color: #64748b; }
.ucmw-gate-text b { color: #4c1d7a; font-weight: 600; }
.ucmw-gate-user {
  display: inline-flex; align-items: center; gap: 8px; margin-top: 16px;
  padding: 5px 12px 5px 5px; border-radius: 999px; background: #f8fafc; border: 1px solid #eef0f4;
  font-size: 12px; color: #475569;
}
.ucmw-gate-user b { color: #0f172a; font-weight: 600; }
.ucmw-gate-av {
  width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
  background: #6d32a8; color: #fff; font-size: 11px; font-weight: 700;
}
.ucmw-gate-actions { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 22px; }
.ucmw-gate-btn {
  display: inline-flex; align-items: center; height: 34px; padding: 0 16px; border-radius: 9px;
  font-size: 12.5px; font-weight: 600; text-decoration: none !important;
  color: #4c1d7a; background: #fff; border: 1px solid #e4d6f3; transition: background .15s, box-shadow .15s;
}
.ucmw-gate-btn:hover { background: #f8f3fd; }
.ucmw-gate-btn.is-primary { color: #fff; background: #6d32a8; border-color: #6d32a8; box-shadow: 0 6px 16px -8px rgba(109, 50, 168, .7); }
.ucmw-gate-btn.is-primary:hover { background: #5b2890; }
.ucmw-gate-foot {
  margin-top: 22px; padding-top: 12px; border-top: 1px dashed #eef0f4;
  font-size: 10.5px; color: #94a3b8; letter-spacing: .04em;
}
@media (max-width: 480px) { .ucmw-gate-card { padding: 28px 18px 18px; } .ucmw-gate-title { font-size: 18px; } }

