/* ═══════════════════════════════════════════════════════════════════════════
   UCM Dispatch & Sales Register — Web Page CSS
   PART A: Report ki apni CSS (report JS se nikali hui). Website par JS se bani
           <style> tags block ho sakti hain, isliye yahan seedha rakhi hai.
   PART B: Web page ka naya look (navbar, filters, tabs, cards, table, sliders).
           PART A ko override karta hai — design badalna ho to sirf PART B badlein.
   ═══════════════════════════════════════════════════════════════════════════ */

/* ═══════════════════════════ PART A — REPORT CSS ═══════════════════════════ */
/* ═══ from report JS: #ucm-theme-style ═══ */
/* Hide the native 12-card summary unconditionally, from the very

           first paint — CSS applies instantly (no JS delay), unlike the

           watchdog/retry JS which was hiding it a beat late and causing a

           visible flash of the unstyled native summary on every date/filter

           change. #ucm-custom-summary (built in JS) is what's actually shown. */

        .report-summary { display: none !important; }



        /* ══════════════════════════════════════════════════════════════════

           FULL REPORT WIDTH — kept IDENTICAL to the Purchase Intelligence

           report's width block so both reports share the same table/head/

           report-name inset and stay symmetric.

           Real DOM (verified via DevTools):

             .main-section

               .sticky-top > header.navbar > .container   (navbar branch)

               #body > .content.page-container > .page-head.flex > .container  (report branch, real class is "page-container" not "page-content")

           .sticky-top and #body are SIBLINGS under .main-section, not nested

           in each other — so every wrapper in BOTH branches must have ZERO

           padding of its own, or it stacks its own inset on top of

           .main-section's, causing doubled-up padding. */

        .page-content, .page-content .container, .page-content .container-fluid,

        .page-body, .page-body .container, .page-body .container-fluid,

        .layout-main-section, .layout-main, .layout-main-section-wrapper,

        .desk-page, .page-wrapper .page-body, .page-wrapper .container {

            max-width: 100% !important;

            width: 100% !important;

            margin-left: 0 !important;

            margin-right: 0 !important;

            padding-left: 9px !important;

            padding-right: 9px !important;

        }



        /* ── SINGLE SOURCE OF TRUTH for left/right inset: .main-section only. */

        .main-section {

            max-width: 100% !important;

            width: 100% !important;

      
        }



        .sticky-top, .navbar, .navbar .container, .navbar .container-fluid,

        .navbar-fixed-top, #navbar-breadcrumbs,

        #body, .content.page-container, .page-container,

        .page-head, .page-head.flex, .page-head .container,

        .page-body,

        .container, .container-fluid {

            max-width: 100% !important;

            width: 100% !important;

            padding-left: 18 !important;

            padding-right: 18 !important;

            margin-left: 0 !important;

            margin-right: 0 !important;

        }



        /* ── Bootstrap's .container normally has padding specifically to

           offset its inner .row's negative left/right margins. Since we just

           zeroed that container padding above, any .row nested inside now

           overflows the viewport by that same negative-margin amount —

           flatten the grid itself so there's nothing left to compensate for. */

        .row {

            margin-left: 0 !important;

            margin-right: 0 !important;

        }

        [class*="col-"] {

            padding-left: 0 !important;

            padding-right: 0 !important;

        }



        .report-wrapper, .frappe-card {

            margin-left: 0 !important;

            margin-right: 0 !important;

            width: 100% !important;

        }



        .filter-section, .filters-and-controls,

        .page-form, .standard-filter-section {

            background: #ffffff !important;

            border-bottom: 0.5px solid #dde8f8 !important;

            padding: 8px 12px !important;

            display: flex !important;

            flex-wrap: wrap !important;

            gap: 8px !important;

            align-items: flex-end !important;

            margin-bottom: 16px !important;

        }

        

        /* ── FILTER CONTROL STYLING — WIDER (180-220px) ──────────────────────────────── */

        .frappe-control,

        .form-group {

            flex: 0 0 auto !important;

            min-width: 180px !important;

            max-width: 220px !important;

            margin-bottom: 0 !important;

            padding: 0 !important;

        }

        

        .frappe-control label,

        .form-group label {

            color: #0b1424 !important;

            font-size: 10px !important;

            font-weight: 600 !important;

            margin-bottom: 2px !important;

            display: block !important;

            white-space: nowrap !important;

            text-overflow: ellipsis !important;

        }

        

        .frappe-control input[type="text"],

        .frappe-control input[type="search"],

        .frappe-control input[type="date"],

        .frappe-control input[type="email"],

        .frappe-control input[type="number"],

        .frappe-control select,

        .form-group input,

        .form-group select {

            color: #0b1424 !important;

            background-color: #ffffff !important;

            border: 1px solid #c5d5ef !important;

            border-radius: 3px !important;

            padding: 4px 6px !important;

            font-size: 11px !important;

            height: 28px !important;

            width: 100% !important;

        }

        

        .frappe-control input:focus,

        .frappe-control select:focus {

            border-color: #1a73e8 !important;

            box-shadow: 0 0 0 2px rgba(26, 115, 232, 0.1) !important;

        }

        

        .frappe-control input::placeholder {

            color: #7a8fa8 !important;

        }



        .report-wrapper, .frappe-card {

            border-radius: 10px !important;

            border: 0.5px solid #dde8f8 !important;

            overflow: hidden !important;

            background: #ffffff !important;

        }



        .dt-header .dt-cell--header .dt-cell__content {

            background: #f0f5ff !important;

            color: #16233a !important;

            font-weight: 700 !important;

            font-size: 10px !important;

            letter-spacing: 0.05em !important;

            text-transform: uppercase !important;

            border-bottom: 0.5px solid #dde8f8 !important;

            text-align: center !important;

            justify-content: center !important;

        }



        .dt-row:nth-child(even) .dt-cell__content { background: #f7faff !important; }

        .dt-row:nth-child(odd)  .dt-cell__content { background: #ffffff !important; }

        .dt-row:hover           .dt-cell__content { background: #eef4ff !important; }



        .dt-cell__content {

            border-bottom: 0.5px solid #f0f4fb !important;

            font-size: 12px !important;

            color: #0b1424 !important;

            font-weight: 500 !important;

        }

        

        /* ── Left-align links and names ──────────────────────────── */

        .dt-cell__content:has(a[href*="/app/customer/"]),

        .dt-cell__content:has(a[href*="/app/item/"]) {

            justify-content: flex-start !important;

            text-align: left !important;

        }

        

        /* ── Link styling ────────────────────────────────────── */

        .dt-cell__content a {

            color: #0d47a1 !important;

            font-weight: 600 !important;

            text-decoration: none !important;

        }

        

        .dt-cell__content a:hover {

            text-decoration: underline !important;

        }



        .ucm-row-completed .dt-cell__content { background: #f5fbf7 !important; }

        .ucm-row-draft     .dt-cell__content { background: #fffaf4 !important; }



        /* ══════════════════════════════════════════════════════════════════

           CUSTOM SUMMARY PANEL — replaces the native .report-summary entirely.

           Own classes only, nothing shared with Frappe's report-summary CSS,

           so there's no specificity fight to lose. 5 key cards + one chart,

           instead of the original 12 native cards.

           ══════════════════════════════════════════════════════════════════ */

        #ucm-custom-summary { }

        .ucm-summary-columns {

            display: flex;

            gap: 14px;

            align-items: stretch;

            background: #f4f7fd;

            border-bottom: 0.5px solid #dde8f8;

            padding: 14px 16px;

            box-sizing: border-box;

        }

        .ucm-summary-cards-col {

            flex: 1 1 68%;

            max-width: 68%;

            box-sizing: border-box;

            display: flex;

            flex-direction: column;

        }

        .ucm-summary-chart-col {

            flex: 1 1 32%;

            max-width: 32%;

            background: #ffffff;

            border: 0.5px solid #dde8f8;

            border-radius: 10px;

            padding: 12px 14px;

            box-sizing: border-box;

        }



        .ucm-mini-card-grid { display: flex; flex-direction: column; flex: 1; gap: 10px; }

        .ucm-mini-card {

            background: #ffffff;

            border: 0.5px solid #dde8f8;

            border-top-width: 3px;

            border-top-style: solid;

            border-radius: 10px;

            padding: 12px 14px;

            box-sizing: border-box;

            flex: 1 1 150px;

            min-width: 150px;

        }

        /* The COGS row is the last item in the column and grows to absorb

           any leftover height, so the card fills down to match the taller

           Sales Order Type Breakdown panel on the right instead of leaving

           a gap below it. */

        .ucm-mini-card-full { flex-basis: 100%; flex-grow: 1; display: flex; flex-direction: column; }

        .ucm-mini-card-label {

            font-size: 11px; font-weight: 600; color: #3d5475;

            text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 8px;

        }

        .ucm-mini-card-value { font-size: 18px; font-weight: 700; line-height: 1.3; }

        .ucm-cogs-card-title {

            font-size: 15px; font-weight: 700; color: #e65100;

            text-transform: none; letter-spacing: normal; margin-bottom: 12px;

        }




        /* ── Order Details card internals (Completed/Total left, Pending right) ── */

        .ucm-order-details-body { display: flex; align-items: center; gap: 14px; flex: 1; }

        .ucm-order-details-half { flex: 1; min-width: 0; text-align: center; }

        .ucm-order-details-vdiv { width: 1px; align-self: stretch; background: #e6ecf5; flex-shrink: 0; }

        .ucm-order-details-value { font-size: 18px; font-weight: 700; color: #1a73e8; line-height: 1.3; }

        .ucm-order-pending-value { color: #e65100; }

        .ucm-order-details-sub {

            font-size: 10px; color: #7a8fa8; margin-top: 2px; font-weight: 500;

            text-transform: uppercase; letter-spacing: 0.02em;

        }



        /* ── Packing breakdown stacked in one cell: Manufacturing Packing /
           Dispatch Packing / Total Packing (x+y), one below the other ── */
        .ucm-packing-stack { display: flex; flex-direction: column; gap: 6px; text-align: center; }
        .ucm-packing-stack-row { display: flex; flex-direction: column; }
        .ucm-packing-stack-value { font-size: 15px; font-weight: 700; line-height: 1.25; }
        .ucm-packing-stack-label {
            font-size: 9.5px; color: #7a8fa8; margin-top: 1px; font-weight: 500;
            text-transform: uppercase; letter-spacing: 0.02em;
        }
        .ucm-packing-stack-total {
            padding-top: 6px; margin-top: 2px; border-top: 1px dashed #e2e8f0;
        }
        .ucm-packing-stack-total .ucm-packing-stack-value { font-size: 17px; }



        /* ── Sales Order Type Breakdown — horizontal bar chart (right panel) ── */

        .ucm-igroup-title-row {

            display: flex; align-items: center; justify-content: space-between;

            margin-bottom: 10px;

        }

        .ucm-igroup-title {

            font-size: 10.5px; font-weight: 700; color: #7a8fa8;

            text-transform: uppercase; letter-spacing: 0.05em;

        }

        .ucm-sot-detail-link {

            font-size: 10.5px; font-weight: 600; color: #1a73e8; cursor: pointer;

            text-decoration: underline; text-underline-offset: 2px; white-space: nowrap;

        }

        .ucm-sot-detail-link:hover { color: #0d47a1; }

        .ucm-igroup-list { display: flex; flex-direction: column; gap: 12px; }

        .ucm-igroup-row { width: 100%; }

        .ucm-igroup-top {

            display: flex; justify-content: space-between; align-items: baseline; gap: 8px;

            margin-bottom: 4px;

        }

        .ucm-igroup-name {

            font-size: 14px; font-weight: 700; color: #0b1424;

            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;

        }

        .ucm-igroup-amt { font-size: 18px; font-weight: 700; flex-shrink: 0; color: #1a73e8; }

        .ucm-igroup-track {

            height: 8px; background: #eef2fa; border-radius: 4px; overflow: hidden;

        }

        .ucm-igroup-fill { height: 100%; border-radius: 4px; }

        .ucm-igroup-share { font-size: 12px; color: #7a8fa8; margin-top: 3px; font-weight: 600; }

        .ucm-igroup-lm { font-size: 11.5px; color: #5f6b7a; margin-top: 2px; font-weight: 500; }

        .ucm-igroup-lm-label { color: #9aa5b5; }

        .ucm-igroup-lm-value { font-weight: 700; color: #3c4656; }

        .ucm-igroup-lm-change { font-weight: 700; }

        .ucm-igroup-cogs {

            margin-top: 8px; padding-top: 8px; border-top: 1px dashed #e2e8f0;

            display: flex; flex-direction: column; gap: 3px;

        }

        .ucm-igroup-cogs-row {

            display: flex; justify-content: space-between; align-items: baseline; gap: 8px;

        }

        .ucm-igroup-cogs-label { font-size: 10px; color: #8896ab; }

        .ucm-igroup-cogs-value { font-size: 10.5px; font-weight: 600; flex-shrink: 0; }

        .ucm-igroup-cogs-total {

            margin-top: 3px; padding-top: 4px; border-top: 1px solid #eef2fa;

        }

        .ucm-igroup-cogs-total .ucm-igroup-cogs-label { font-weight: 700; color: #6b7280; }

        .ucm-igroup-cogs-total .ucm-igroup-cogs-value { font-size: 11.5px; }

        .ucm-igroup-empty { font-size: 11.5px; color: #9aa5b5; text-align: center; padding: 20px 0; }



        /* ── Sales Order Type detail dialog ── */

        .ucm-sot-dialog { display: flex; flex-direction: column; gap: 18px; }

        .ucm-sot-dialog-section {

            border: 0.5px solid #dde8f8; border-radius: 8px; padding: 14px 16px;

            background: #f9fbfe;

        }

        .ucm-sot-dialog-heading {

            display: flex; justify-content: space-between; align-items: baseline;

            font-size: 13.5px; font-weight: 700; color: #3d5475; margin-bottom: 10px;

            padding-bottom: 8px; border-bottom: 1px solid #e6ecf5;

        }

        .ucm-sot-dialog-amt { color: #0d9488; font-size: 14px; }

        .ucm-sot-dialog-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }

        .ucm-sot-dialog-table td { padding: 5px 0; color: #4a5a72; }

        .ucm-sot-dialog-table tr.ucm-sot-dialog-total-row td {

            font-weight: 700; color: #e65100; border-top: 1px solid #e6ecf5; padding-top: 8px;

        }

        .ucm-sot-dialog-empty { font-size: 12px; color: #9aa5b5; }



        @media (max-width: 900px) {

            .ucm-summary-columns { flex-direction: column; }

            .ucm-summary-cards-col, .ucm-summary-chart-col { flex: 1 1 100%; max-width: 100%; }

        }




        .dt-scrollable::-webkit-scrollbar { height: 5px; width: 5px; }

        .dt-scrollable::-webkit-scrollbar-track { background: #f0f5ff; }

        .dt-scrollable::-webkit-scrollbar-thumb { background: #c5d5ef; border-radius: 10px; }

        .dt-scrollable::-webkit-scrollbar-thumb:hover { background: #1a73e8; }



        /* ══════════════════════════════════════════════════════════════════

           RESPONSIVE — tablet / phone portrait (page padding only; the

           custom summary panel has its own responsive rules above).

           Mirrors the Purchase Intelligence report's breakpoints so both

           reports behave consistently on narrow screens.

           ══════════════════════════════════════════════════════════════════ */

        @media (max-width: 520px) {

            .page-content, .page-content .container, .page-content .container-fluid,

            .page-body, .page-body .container, .page-body .container-fluid,

            .layout-main-section, .layout-main, .layout-main-section-wrapper,

            .desk-page, .page-wrapper .page-body, .page-wrapper .container {

                padding-left: 0 !important;

                padding-right: 0 !important;

            }

            .ucm-summary-columns { padding: 10px !important; gap: 8px !important; }

            .ucm-mini-card { padding: 10px 12px !important; }

        }

/* ═══ from report JS: #ucm-slider-style ═══ */
.ucm-cost-slider-backdrop {

            position: fixed; inset: 0; background: rgba(20,30,50,0.35);

            z-index: 1060; opacity: 0; pointer-events: none;

            transition: opacity 0.2s ease;

        }

        .ucm-cost-slider-backdrop.open { opacity: 1; pointer-events: auto; }



        .ucm-cost-slider {

            position: fixed; top: 0; right: 0; height: 100vh;

            width: 55vw; max-width: 94vw; min-width: 480px; background: #fff;

            z-index: 1061; box-shadow: -6px 0 24px rgba(20,30,50,0.18);

            transform: translateX(100%); transition: transform 0.25s ease;

            display: flex; flex-direction: column;

        }

        .ucm-cost-slider.open { transform: translateX(0); }



        .ucm-cost-slider-header {

            padding: 16px 20px; border-bottom: 1px solid #e6ecf5;

            display: flex; align-items: center; justify-content: space-between;

            flex-shrink: 0;

        }

        .ucm-cost-slider-header h4 {

            margin: 0; font-size: 14px; font-weight: 700; color: #3d5170;

        }

        .ucm-cost-slider-header .sub { font-size: 11px; color: #7a8fa8; margin-top: 2px; }

        .ucm-cost-slider-close {

            cursor: pointer; border: none; background: #f0f5ff; color: #3d5475;

            width: 28px; height: 28px; border-radius: 50%; font-size: 14px;

            display: flex; align-items: center; justify-content: center;

        }

        .ucm-cost-slider-close:hover { background: #dde8f8; }



        .ucm-cost-slider-body { padding: 16px 20px; overflow-y: auto; flex: 1; }



        .ucm-summary-block { margin-bottom: 16px; }

        .ucm-summary-title {

            font-size: 10.5px; font-weight: 700; color: #7a8fa8;

            text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 6px;

        }

        .ucm-summary-card {

            border: 1px solid #dde8f8; border-radius: 8px; overflow: hidden;

        }

        .ucm-summary-head-row, .ucm-summary-item-row, .ucm-summary-total-row {

            display: grid;

            grid-template-columns: 2fr 0.7fr 1fr 1.1fr 1fr 1.1fr 0.8fr;

            gap: 6px; padding: 8px 12px; align-items: center;

        }

        .ucm-summary-head-row {

            background: #eef4fd; color: #3d5475; font-weight: 700;

            font-size: 9px; text-transform: uppercase; letter-spacing: 0.02em;

        }

        .ucm-summary-item-row {

            border-top: 1px solid #f0f3f9; font-size: 10.5px; color: #4a5a72;

            cursor: pointer; transition: background 0.12s;

        }

        .ucm-summary-item-row:hover { background: #eef4fd; }

        .ucm-summary-item-row:nth-child(even) { background: #fafcff; }

        .ucm-summary-item-row:nth-child(even):hover { background: #eef4fd; }

        .ucm-summary-item-row.active {

            background: #dbeafe; box-shadow: inset 3px 0 0 #1a73e8;

        }

        .ucm-summary-item-row.active:hover { background: #dbeafe; }

        .ucm-summary-item-row .si-name { font-weight: 600; color: #3d5170; }

        .ucm-summary-total-row {

            border-top: 2px solid #dde8f8; background: #f5f9ff;

            font-weight: 700; font-size: 10.5px; color: #3d5170;

            cursor: pointer; transition: background 0.12s;

        }

        .ucm-summary-total-row:hover { background: #eaf1ff; }

        .ucm-summary-total-row.active {

            background: #dbeafe; box-shadow: inset 3px 0 0 #1a73e8;

        }

        .ucm-sr-num { text-align: right; }

        .ucm-profit-pos { color: #12805c; }

        .ucm-profit-neg { color: #c0392b; }



        .ucm-detail-title {

            font-size: 10.5px; font-weight: 700; color: #7a8fa8;

            text-transform: uppercase; letter-spacing: 0.03em;

            margin: 4px 0 8px;

        }

        .ucm-detail-group { display: block; }



        .ucm-cost-card {

            border: 1px solid #e6ecf5; border-radius: 8px; padding: 12px 14px;

            margin-bottom: 10px;

        }

        .ucm-cost-card .item-line {

            font-size: 12.5px; font-weight: 600; color: #3d5170; margin-bottom: 6px;

            display: flex; justify-content: space-between; align-items: center; gap: 8px;

        }

        .ucm-cost-card .item-line-name { flex: 1; min-width: 0; }

        .ucm-recent-prod-toggle {

            flex-shrink: 0; font-size: 9.5px; font-weight: 700; color: #3d5475;

            background: #eef4fd; border: 1px solid #dde8f8; border-radius: 12px;

            padding: 3px 9px; cursor: pointer; white-space: nowrap;

            text-transform: uppercase; letter-spacing: 0.02em;

        }

        .ucm-recent-prod-toggle:hover { background: #dbeafe; }

        .ucm-recent-prod-toggle.open .ucm-prod-arrow { transform: rotate(90deg); }

        .ucm-recent-prod-panel {

            margin: 0 0 10px; padding: 0; background: #fff;

            border: 1px solid #e3e9f5; border-radius: 8px; overflow: hidden;

            overflow-x: auto;

        }

        .ucm-cost-card .row-line {

            display: flex; justify-content: space-between; font-size: 11.5px;

            color: #445269; padding: 2px 0;

        }

        .ucm-cost-card .row-line span:last-child { font-weight: 600; color: #3d5170; }

        .ucm-cost-card .row-line.ucm-eff-rate span:last-child { color: #b45309; }

        .ucm-cost-card .row-line.ucm-ste-rate { color: #7a8fa8; font-size: 10.5px; }

        .ucm-cost-card .row-line.ucm-ste-rate span:last-child { color: #445269; font-weight: 500; }

        .ucm-cost-card .source-line {

            margin-top: 6px; padding-top: 6px; border-top: 1px dashed #e6ecf5;

            font-size: 11px; color: #1a73e8; font-weight: 600;

            display: flex; justify-content: space-between; align-items: center; gap: 8px;

        }

        .ucm-cost-card .source-line-main { flex: 1; min-width: 0; }

        .ucm-prod-toggle {

            flex-shrink: 0; font-size: 10px; font-weight: 700; color: #3d5475;

            background: #eef4fd; border: 1px solid #dde8f8; border-radius: 12px;

            padding: 3px 9px; cursor: pointer; white-space: nowrap;

            text-transform: uppercase; letter-spacing: 0.02em;

        }

        .ucm-prod-toggle:hover { background: #dbeafe; }

        .ucm-prod-arrow { display: inline-block; transition: transform 0.15s; }

        .ucm-prod-toggle.open .ucm-prod-arrow { transform: rotate(90deg); }



        .ucm-prod-panel {

            margin-top: 8px; padding: 0; background: #fff;

            border: 1px solid #e3e9f5; border-radius: 8px; overflow: hidden;

            overflow-x: auto; box-shadow: 0 1px 3px rgba(20,30,50,0.04);

        }

        .ucm-prod-table {

            width: 100%; min-width: 980px; border-collapse: collapse;

            font-size: 11px;

        }

        .ucm-prod-table thead th {

