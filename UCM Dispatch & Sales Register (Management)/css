#ucm-report #ucmw-filters .frappe-control .form-control,
#ucm-report #ucmw-filters .frappe-control input,
#ucm-report #ucmw-filters .frappe-control select {
  height: 38px !important; padding: 0 12px !important; font-size: 13px !important; font-weight: 500 !important;
  color: var(--ink) !important; background: #fff !important; border: 1px solid var(--line) !important;
  border-radius: 8px !important; box-shadow: 0 1px 2px rgba(15,23,42,0.04) !important; width: 100% !important;
}
#ucm-report #ucmw-filters .frappe-control input:focus, #ucm-report #ucmw-filters .frappe-control select:focus {
  border-color: var(--accent) !important; box-shadow: 0 0 0 3px rgba(109,50,168,0.12) !important; outline: none !important;
}
#ucm-report #ucmw-filters .frappe-control input::placeholder { color: var(--mut2) !important; font-weight: 400; }

/* Month ▲▼ — ek joined control */
#ucm-report .ucm-ds-month-nav { gap: 0 !important; margin-right: 2px !important; border: 1px solid var(--line); border-radius: 8px; overflow: visible; box-shadow: 0 1px 2px rgba(15,23,42,0.04); }
#ucm-report .ucm-ds-month-nav button {
