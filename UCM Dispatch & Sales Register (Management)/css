        .ucm-soa-table tr:nth-child(even) td { background:#fafcff; }
        .ucm-soa-table .num { text-align:right; font-weight:600; white-space:nowrap; }
        .ucm-soa-table .pend { color:#c62828; font-weight:700; }
        .ucm-soa-table a { color:#0d47a1; font-weight:700; text-decoration:none; }
        .ucm-soa-table a:hover { text-decoration:underline; }
        .ucm-soa-sub { font-size:10px; color:#7a8fa8; margin-top:2px; }
        .ucm-soa-badge {
            display:inline-block; padding:2px 8px; border-radius:12px;
            font-size:10.5px; font-weight:700; white-space:nowrap;
        }
        .ucm-soa-type {
            display:inline-block; margin-left:6px; font-size:9px; font-weight:800;
            padding:1px 6px; border-radius:8px; color:#fff; vertical-align:middle;
