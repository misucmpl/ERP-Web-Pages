  padding: 0 !important; margin: 0 !important; border: 0 !important; background: transparent !important;
}
#ucm-report #ucmw-filters .frappe-control { flex: 0 0 auto !important; min-width: 170px !important; max-width: 240px !important; margin: 0 !important; }
#ucm-report #ucmw-filters .frappe-control[data-fieldname="customer"] { min-width: 240px !important; max-width: 300px !important; }
#ucm-report #ucmw-filters .frappe-control label {
  display: block !important; margin: 0 0 6px !important; font-size: 12px !important; font-weight: 500 !important;
