        .ucm-soa-card-sub { font-size:10.5px; color:#5f6b7a; font-weight:600; margin-top:4px; }
        .ucm-soa-click { cursor:pointer; transition:box-shadow 0.15s, transform 0.1s; }
        .ucm-soa-click:hover { box-shadow:0 2px 8px rgba(20,30,50,0.12); transform:translateY(-1px); }

        .ucm-soa-bar-wrap { margin-top:12px; font-size:11.5px; color:#3d5170; font-weight:700; }
        .ucm-soa-bar { height:8px; background:#eef2fa; border-radius:4px; overflow:hidden; margin-top:4px; }
        .ucm-soa-bar > div { height:100%; border-radius:4px; }

        .ucm-soa-status-chips { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
        .ucm-soa-status-chip {
            font-size:11px; font-weight:700; padding:3px 10px; border-radius:12px;
            background:#f0f5ff; color:#3d5170; border:1px solid #dde8f8;
