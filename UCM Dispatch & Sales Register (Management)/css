/* ═══ from report JS: #ucm-soa-style ═══ */
/* ── Slider shell (self-contained — kisi aur report ki CSS par depend nahi) ── */
        .ucm-soa-backdrop {
            position: fixed; inset: 0; background: rgba(20,30,50,0.35);
