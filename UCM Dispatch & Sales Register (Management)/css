#ucm-report .ucm-ds-month-nav button:first-child { border-radius: 8px 0 0 8px !important; border-right: 1px solid var(--line) !important; }
#ucm-report .ucm-ds-month-nav button:last-child { border-radius: 0 8px 8px 0 !important; }
#ucm-report .ucm-ds-month-nav button:hover { background: var(--soft) !important; color: var(--ink) !important; }
#ucm-report .ucm-ds-month-nav button::after { background: var(--ink) !important; border-radius: 6px !important; font-weight: 500 !important; }

/* ═════ TABS ═════ */
#ucm-report .ucmw-tabs {
  display: flex; align-items: center; gap: 28px; padding: 0 28px; background: #fff;
  border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20;
