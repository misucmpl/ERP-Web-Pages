function _ucmSoaRowMatch($tr, f) {
    if (f.indexOf("sot:") === 0) return ($tr.attr("data-sot") || "") === f.substr(4);
    var perf = $tr.attr("data-perf");
    var grp = $tr.attr("data-grp");
    if (f === "all") return true;
    if (f === "delayed") return perf === "late" || perf === "overdue";
    if (f === "pending_qty") return parseFloat($tr.attr("data-pending")) > 0;
    if (f === "completed" || f === "closed" || f === "open") return grp === f;
    return perf === f;
}

function _ucmSoaApplyFilter($seg, f) {
    $seg.find(".ucm-soa-filter").removeClass("active");
    $seg.find('.ucm-soa-filter[data-soa-filter="' + f + '"]').addClass("active");
    var shown = 0;
    $seg.find("tr.ucm-soa-row").each(function () {
        var ok = _ucmSoaRowMatch($(this), f);
        $(this).toggle(ok);
        if (ok) shown++;
    });
    $seg.find(".ucm-soa-showing").text("Showing " + shown + " sales order" + (shown === 1 ? "" : "s"));
}

function _ucmSoaSegHtml(sg, b, orders) {
