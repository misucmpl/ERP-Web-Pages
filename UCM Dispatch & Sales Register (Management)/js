function _ucmRenderSoStatusPanel($panel, payload) {
    var buckets = payload.buckets || {};
    var orders = payload.orders || [];
    var drafts = payload.drafts || [];
    var $body = $panel.find(".ucm-cost-slider-body");

    var pills = '<div class="ucm-soa-pills">';
    var segs = "";
    UCM_SOA_SEGMENTS.forEach(function (sg, idx) {
        var isDraft = sg.key === "DRAFT";
        var b = buckets[sg.key] || {};
        var count = isDraft ? drafts.length : (b.so_count || 0);
        pills += '<div class="ucm-soa-pill' + (idx === 0 ? ' active' : '') + '" data-soa-seg="' + idx + '" ' +
            'style="--c:' + sg.color + ';">' + sg.label + '<span>' + count + '</span></div>';

        var segHtml;
        if (isDraft) {
            segHtml = _ucmSoaDraftHtml(drafts);
        } else {
            var segOrders = sg.key === "OVERALL" ? orders : orders.filter(function (o) { return o.sot === sg.key; });
            segHtml = _ucmSoaSegHtml(sg, b, segOrders);
        }

        segs += '<div class="ucm-soa-seg" data-soa-seg="' + idx + '"' + (idx === 0 ? '' : ' style="display:none;"') + '>' +
            segHtml + '</div>';
    });
    pills += '</div>';

    $body.html(pills + segs);

    // Pill switch: Overall / Ultra / Large Blow
    $body.off("click.ucmSoaPill").on("click.ucmSoaPill", ".ucm-soa-pill", function () {
        var idx = $(this).attr("data-soa-seg");
        $body.find(".ucm-soa-pill").removeClass("active");
        $(this).addClass("active");
        $body.find(".ucm-soa-seg").hide();
        $body.find('.ucm-soa-seg[data-soa-seg="' + idx + '"]').show();
    });

    // Filter chip ya card click → list filter
    $body.off("click.ucmSoaFilter").on("click.ucmSoaFilter", ".ucm-soa-filter, .ucm-soa-click", function () {
        var $seg = $(this).closest(".ucm-soa-seg");
        var f = $(this).attr("data-soa-filter") || "all";
        _ucmSoaApplyFilter($seg, f);
        if ($(this).hasClass("ucm-soa-click")) {
            var el = $seg.find(".ucm-soa-list-anchor")[0];
