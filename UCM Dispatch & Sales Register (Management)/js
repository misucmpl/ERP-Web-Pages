    // ── FETCH CUSTOMER ACQUISITION REPORT DATA ──────────────────────────────
    function _ucmFetchCustomerAcquisitionData(callback) {
        var fromDate = frappe.query_report.get_filter_value("from_date");
        var toDate   = frappe.query_report.get_filter_value("to_date");
        var company  = frappe.query_report.get_filter_value("company") || "";

        if (!fromDate || !toDate) {
            callback([]);
            return;
        }

        frappe.call({
            method: "frappe.desk.query_report.run",
            args: {
                report_name: "UCM Customer Acquisition Report",
                filters: {
                    from_date: fromDate,
                    to_date: toDate,
                    company: company
                }
            },
            timeout: 60000,
            callback: function (r) {
                var result = (r && r.message && r.message.result) || [];
                _ucmFetchAcqDetail(fromDate, toDate, company, function (detail) {
                    result.detail = detail;
                    _ucmFetchTerritorySalesInvoiceRows(function (terrRows) {
                        result.terrRows = terrRows;
                        _ucmFetchTerritoryTillDateSummary(function (terrTill) {
                            result.terrTill = terrTill;
                            callback(result);
                        });
                    });
                });
            },
            error: function () {
                callback([]);
            }
        });
    }


    function _fmtCurrency(v) {
        try {
            var currency = frappe.defaults.get_default("currency");
            return typeof format_currency_nodecimal === "function"
                ? format_currency_nodecimal(v || 0, currency)
                : format_currency(v || 0, currency);
        } catch (e) { return (v || 0).toString(); }
    }

    function _ucmChangeBadge(current, lastMonth) {
        if (typeof lastMonth !== "number" || lastMonth <= 0) {
            return current > 0
                ? '<span style="color:#1e8e3e; font-weight:700;">▲ New</span>'
                : '<span style="color:#9aa5b5;">—</span>';
        }
        var pct = ((current - lastMonth) / lastMonth) * 100;
        var up = pct >= 0;
        return '<span style="color:' + (up ? "#1e8e3e" : "#d93025") + '; font-weight:700;">' +
            (up ? "▲" : "▼") + " " + Math.abs(Math.round(pct * 10) / 10) + "%</span>";
    }

    // Amount difference vs last month, e.g. "+₹1,20,000" (green) / "-₹80,000" (red)
    function _ucmChangeDelta(current, lastMonth) {
        if (typeof lastMonth !== "number" || lastMonth <= 0) return "";
        var diff = (current || 0) - lastMonth;
        var up = diff >= 0;
        return '<span style="color:' + (up ? "#1e8e3e" : "#d93025") + ';">' +
            (up ? "+" : "-") + _fmtCurrency(Math.abs(diff)) + '</span>';
    }

    // ── 3. Inline SVG chart builders ────────────────────────────────────────

var PALETTE = ["#1a73e8", "#7b3fa0", "#5e35b1", "#512da8", "#4527a0", "#2c1b47"];
    // ── HARDCODED MONTHLY SALES TARGETS ──────────────────────────────────
    var UCM_SALES_TARGETS = {
