            }
            var rowsHtml = "";
            pp.cats.slice(0, MAX_ROWS).forEach(function (c) {
                var pct = Math.round((c.reached / total) * 1000) / 10;
                rowsHtml += '<tr style="height:' + rowPx + 'px;">' +
                    '<td style="padding:0 8px; border:1px solid #eef1f6; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:230px;">' + frappe.utils.escape_html(c.name) + '</td>' +
                    '<td style="padding:0 8px; border:1px solid #eef1f6; white-space:nowrap; font-weight:800; color:' + sg.color + ';">' + c.reached + ' / ' + total +
