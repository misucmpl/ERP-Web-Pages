    var _ucmPdfBusy = false;

    function _ucmShowPdfOverlay(msg, sub) {
        if (!document.getElementById("ucm-pdf-overlay-style")) {
            var st = document.createElement("style");
            st.id = "ucm-pdf-overlay-style";
            st.innerHTML =
                "#ucm-pdf-overlay{position:fixed;inset:0;z-index:2000;background:rgba(15,25,45,0.55);" +
                "display:flex;align-items:center;justify-content:center;cursor:wait;}" +
                "#ucm-pdf-overlay .ucm-pdf-box{background:#fff;border-radius:14px;padding:28px 40px;" +
                "min-width:320px;text-align:center;box-shadow:0 12px 40px rgba(0,0,0,0.25);}" +
                "#ucm-pdf-overlay .ucm-pdf-spin{width:44px;height:44px;margin:0 auto 16px;border-radius:50%;" +
                "border:4px solid #dde8f8;border-top-color:#1a73e8;animation:ucmPdfSpin 0.9s linear infinite;}" +
                "#ucm-pdf-overlay .ucm-pdf-msg{font-size:16px;font-weight:800;color:#0b1424;}" +
                "#ucm-pdf-overlay .ucm-pdf-sub{font-size:12.5px;color:#7a8fa8;margin-top:6px;}" +
                "@keyframes ucmPdfSpin{to{transform:rotate(360deg);}}";
            document.head.appendChild(st);
        }
        var $ov = $("#ucm-pdf-overlay");
        if (!$ov.length) {
            $ov = $('<div id="ucm-pdf-overlay"><div class="ucm-pdf-box">' +
                '<div class="ucm-pdf-spin"></div>' +
                '<div class="ucm-pdf-msg"></div><div class="ucm-pdf-sub"></div>' +
                '</div></div>').appendTo("body");
            // Overlay ke peeche kuch bhi click / scroll na ho
            $ov.on("click mousedown wheel touchmove keydown", function (e) { e.preventDefault(); e.stopPropagation(); });
        }
        $ov.find(".ucm-pdf-msg").text(msg || "PDF is getting generated…");
        $ov.find(".ucm-pdf-sub").text(sub || "Please wait, do not close or refresh the page.");
        $(".btn-pdf-summary-custom").prop("disabled", true);
    }

    function _ucmHidePdfOverlay() {
        $("#ucm-pdf-overlay").remove();
        $(".btn-pdf-summary-custom").prop("disabled", false);
        _ucmPdfBusy = false;
    }

    function _ucmOpenPdfSummaryDialog() {
        if (_ucmPdfBusy) return;          // double click se do PDF na banein
        _ucmPdfBusy = true;
        _ucmShowPdfOverlay("PDF is getting generated…", "Loading report data…");
        // Safety: kuch atak jaaye to 2.5 min baad screen khud khul jaaye
        setTimeout(function () {
            if (_ucmPdfBusy && $("#ucm-pdf-overlay").length) {
                _ucmHidePdfOverlay();
                frappe.msgprint(__("PDF generation took too long. Please try again."));
            }
        }, 150000);

        if (typeof _ucmFetchCostBreakupSummary === "function" && typeof _ucmBuildCustomSummary === "function") {
            _ucmFetchCostBreakupSummary(function () {
                _ucmBuildCustomSummary();
                setTimeout(_ucmContinueOpenPdfSummaryDialog, 300);
            });
        } else {
            _ucmContinueOpenPdfSummaryDialog();
        }
    }

    // Category-wise rows from the SAME API the slider uses (custom_item_category based).
    // Returns rows shaped like report rows: custom_sales_order_type / custom_item_category / qty / amount
    function _ucmFetchCategoryRowsForPdf(fromDate, toDate, callback) {
        if (!fromDate || !toDate) { callback([]); return; }
        frappe.call({
            method: "category_wise_sales",
            args: {
                from_date: fromDate,
                to_date: toDate,
                customer: frappe.query_report.get_filter_value("customer") || undefined
            },
            timeout: 60000,
            callback: function (r) {
                callback(((r && r.message) || []).map(function (x) {
                    return {
                        custom_sales_order_type: x.sales_order_type,
                        custom_item_category: x.category,
                        qty: x.qty || 0,
                        amount: x.amount || 0
                    };
                }));
            },
            error: function () { callback([]); }
        });
    }

    function _ucmContinueOpenPdfSummaryDialog() {
        var lmRunResult = null, acqData = [], siRows = [], siDatesRows = [], catCurRows = [], catLmRows = [];
        var soSummary = null;
        var callCount = 0, finished = false, timeoutHandle = null;

        function finish() {
            if (finished) return;          // timeout + late response se PDF do baar na bane
            finished = true;
            clearTimeout(timeoutHandle);
            _ucmGeneratePdfWithData(lmRunResult, acqData, siRows, siDatesRows, catCurRows, catLmRows, soSummary);
        }
        function done() {
            ++callCount;
            _ucmShowPdfOverlay("PDF is getting generated…", "Loading report data (" + callCount + " / 7)…");
            if (callCount === 7) finish();
        }

        timeoutHandle = setTimeout(finish, 60000);

        _ucmFetchLastMonthExecutiveData(function (r) {
            if (r && r.result) r.result = _ucmPdfDropReturns(r.result);
            lmRunResult = r; done();
        });
        _ucmFetchCustomerAcquisitionData(function (r) {
            if (r && r.terrRows) r.terrRows = _ucmPdfDropReturns(r.terrRows);
            acqData = r; done();
        });
        // Current period ka data hamesha Sales Invoice se (Credit Note hata kar)
        _ucmFetchTerritorySalesInvoiceRows(function (r) { siRows = _ucmPdfDropReturns(r); done(); });
        // Sales-person-wise new customers: Sales Invoice, sirf date range (Credit Note hata kar)
        _ucmFetchSalesInvoiceRowsDatesOnly(function (r) { siDatesRows = _ucmPdfDropReturns(r); done(); });
        // Category-wise (custom_item_category) — current period & last month
        var _f = frappe.query_report.get_filter_value("from_date");
        var _t = frappe.query_report.get_filter_value("to_date");
        _ucmFetchCategoryRowsForPdf(_f, _t, function (r) { catCurRows = r; done(); });
        _ucmFetchCategoryRowsForPdf(frappe.datetime.add_months(_f, -1), frappe.datetime.add_months(_t, -1), function (r) { catLmRows = r; done(); });
        // Sales Order Analysis (same API as "Sales Orders" slider)
        _ucmFetchSoSummaryForPdf(function (r) { soSummary = r; done(); });
    }

    function _ucmGeneratePdfWithData(lmRunResult, acquisitionData, siRows, siDatesRows, catCurRows, catLmRows, soSummary) {
        _ucmShowPdfOverlay("PDF is getting generated…", "Building pages…");
        siRows = siRows || [];

        var fromDate = frappe.query_report.get_filter_value("from_date");
        var toDate   = frappe.query_report.get_filter_value("to_date");
        var metrics  = _ucmScrapeNativeMetrics();
        var sotRows  = _ucmScrapeSotBreakdown();
        var lmStats  = null;

        var custCurrent = siRows;   // hamesha Sales Invoice
        var catCurrent  = siRows;
        var custLastMonth = [];
        var catLastMonth = [];

        if (lmRunResult && lmRunResult.result) {
            custLastMonth = lmRunResult.result || [];
            catLastMonth = lmRunResult.result || [];
            lmStats = _ucmComputeStatsFromReportRun(lmRunResult);
        }

        // ── Credit Note hata kar totals dobara (screen ke native cards mein returns mile hote hain) ──
        var curTot = _ucmPdfTotals(siRows);
        var lmTot  = (lmRunResult && lmRunResult.result) ? _ucmPdfTotals(lmRunResult.result) : null;

        metrics["Total Sale Amount"]   = String(curTot.totalSale);
        metrics["Completed Orders"]    = String(curTot.completedOrders);
        metrics["Total Quantity Sold"] = String(curTot.totalQty);

        if (lmStats && lmTot) {
            lmStats.totalSale       = lmTot.totalSale;
            lmStats.completedOrders = lmTot.completedOrders;
            lmStats.totalQty        = lmTot.totalQty;
            lmStats.avgOrderValue   = lmTot.completedOrders ? lmTot.totalSale / lmTot.completedOrders : 0;
        }

        sotRows = sotRows.map(function (g) {
            var k = String(g.name).toUpperCase();
            return {
                name: g.name,
                amount: curTot.byType[k] || 0,
                lastMonth: lmTot ? (lmTot.byType[k] || 0) : g.lastMonth
            };
        });

        var extra = _ucmGetExtraStats(siRows);   // metrics override ke BAAD

        // ✅ FINAL REORDERED SLIDE SEQUENCE - Top Customers LAST (isLast: true)
        var html = '<div id="ucm-pdf-summary-content">' +
            _slideCoverPage(fromDate, toDate) +
            _slideExecutiveSummary(fromDate, toDate, metrics, extra, lmStats) +
            _slideSalesOrderTypeCombined(sotRows) +
            _slideTargetVsActual(sotRows, siRows) +
            _slideCategoryWiseSalesComparison(catCurRows || [], catLmRows || []) +
            _slideSoOrdersQuantity(soSummary) +
            _slideSoDeliveryPerformance(soSummary) +
            _slideCustomerCountComparison(
                fromDate,
                toDate,
                custCurrent,
                (lmRunResult && lmRunResult.result) || []
            ) +
            _slideCustomerAcquisition(acquisitionData, siRows) +
            _slideNewCustomersBySegment(acquisitionData, "ultra", "Ultra", "#1a73e8") +
            _slideNewCustomersBySegment(acquisitionData, "large_blow", "Large Blow", "#7b3fa0") +
            _slideNewCustomersByPerson(acquisitionData, siDatesRows, "ultra", "ULTRA", "Ultra", "#1a73e8") +
            _slideNewCustomersByPerson(acquisitionData, siDatesRows, "large_blow", "LARGE BLOW", "Large Blow", "#7b3fa0") +
            _slideTerritoryCoverage(acquisitionData && acquisitionData.terrRows) +
            _slideCategoryReach(acquisitionData && acquisitionData.terrTill) +
            _slideTopProducts(false, siRows) +
            _slideTopCustomersComparison(custCurrent, custLastMonth, true) +  // ✅ isLast: true
            '</div>';

        setTimeout(function() {
            var fullHtml =
                '<!DOCTYPE html><html><head><meta charset="utf-8">' +
                '<title>UCM Dispatch & Sales Register - Executive Report</title>' +
                '<style>' +
