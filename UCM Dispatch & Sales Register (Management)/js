// COGS SUBMENU — Expandable cost breakdown (Raw Material, Packaging, Manufacturing)
// ════════════════════════════════════════════════════════════════════════════════

function initCOGSSubmenu() {
    // Initialize COGS expand/collapse after datatable renders
    attachCOGSExpandHandlers();
}

function attachCOGSExpandHandlers() {
    const table = document.querySelector('.frappe-datatable');
    if (!table) return;

    const rows = table.querySelectorAll('[data-row-index]');
    
    rows.forEach(function(row, rowIndex) {
        const cells = row.querySelectorAll('[data-col-index]');
        if (cells.length === 0) return;

        // Get row data from first cell
        const firstCell = cells[0];
        if (!firstCell || !firstCell.__rowData) return;
        
        const rowData = firstCell.__rowData;

        // Check if this row has COGS breakdown and is a product row (has item_code)
        if (rowData.cogs_breakdown && rowData.item_code) {
            // Add expand icon to the first cell
            if (!row.querySelector('.cogs-expand-icon')) {
                const expandIcon = document.createElement('span');
                expandIcon.className = 'cogs-expand-icon';
                expandIcon.innerHTML = '▶';
                expandIcon.style.cssText = `
                    display: inline-block;
                    margin-right: 8px;
                    cursor: pointer;
                    color: #1a73e8;
                    font-weight: bold;
                    transition: transform 0.2s;
                    width: 16px;
                    text-align: center;
                `;
                expandIcon.title = 'Expand COGS breakdown';
                
                firstCell.insertBefore(expandIcon, firstCell.firstChild);
            }

            // Attach click handler
            row.style.cursor = 'pointer';
            row.addEventListener('click', function(e) {
                if (e.target.closest('.cogs-expand-icon') || !e.target.closest('a')) {
                    e.stopPropagation();
                    toggleCOGSSubmenu(row, rowData);
                }
            });
        }
    });
}

function toggleCOGSSubmenu(row, rowData) {
    const docName = rowData.name;
    const itemCode = rowData.item_code;
    const submenuId = `cogs_submenu_${docName}_${itemCode}`.replace(/[^a-zA-Z0-9_-]/g, '_');
    
    let submenu = document.getElementById(submenuId);
    
    if (submenu) {
        // Toggle visibility
        if (submenu.style.display === 'none') {
            submenu.style.display = 'table-row';
            row.querySelector('.cogs-expand-icon').style.transform = 'rotate(90deg)';
        } else {
            submenu.style.display = 'none';
            row.querySelector('.cogs-expand-icon').style.transform = 'rotate(0deg)';
        }
    } else {
        // Create new submenu
        submenu = createCOGSSubmenu(rowData, submenuId);
        
        // Insert after the current row
        row.parentNode.insertBefore(submenu, row.nextSibling);
        row.querySelector('.cogs-expand-icon').style.transform = 'rotate(90deg)';
    }
}

function createCOGSSubmenu(rowData, submenuId) {
    const submenuRow = document.createElement('tr');
    submenuRow.id = submenuId;
    submenuRow.className = 'ucm-cogs-submenu-row';
    submenuRow.style.cssText = `
        background-color: #f9f9f9;
        border-left: 4px solid #1a73e8;
    `;

    const cell = document.createElement('td');
    cell.style.cssText = `
        padding: 16px 20px;
        border-bottom: 1px solid #e0e0e0;
        column-span: all;
    `;
    cell.colSpan = 100;

    const breakdown = rowData.cogs_breakdown || {};
    const rmCost = breakdown.raw_material_cost || 0;
    const pkgCost = breakdown.packaging_cost || 0;
    const mfgCost = breakdown.manufacturing_cost || 0;
    const totalCogs = breakdown.total_cogs || 0;

    // Format currency
    const formatCurr = function(value) {
        if (typeof value !== 'number') value = parseFloat(value) || 0;
        return '₹' + value.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    };

    // Build COGS breakdown HTML
    let html = `
        <div class="ucm-cogs-breakdown" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
            
            <!-- Raw Material Cost -->
            <div style="border: 1px solid #d0d0d0; border-radius: 4px; padding: 12px; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                <div style="color: #666; font-size: 11px; font-weight: 600; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Raw Material</div>
                <div style="font-size: 18px; font-weight: 600; color: #1a73e8;">
                    ${formatCurr(rmCost)}
                </div>
            </div>

            <!-- Packaging Materials Cost -->
            <div style="border: 1px solid #d0d0d0; border-radius: 4px; padding: 12px; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                <div style="color: #666; font-size: 11px; font-weight: 600; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Packaging Materials</div>
                <div style="font-size: 18px; font-weight: 600; color: #ea580c;">
                    ${formatCurr(pkgCost)}
                </div>
            </div>

            <!-- Manufacturing Cost -->
            <div style="border: 1px solid #d0d0d0; border-radius: 4px; padding: 12px; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                <div style="color: #666; font-size: 11px; font-weight: 600; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Manufacturing Cost</div>
                <div style="font-size: 18px; font-weight: 600; color: #34a853;">
                    ${formatCurr(mfgCost)}
                </div>
            </div>

            <!-- Total COGS -->
            <div style="border: 2px solid #1a73e8; border-radius: 4px; padding: 12px; background: #f0f7ff; box-shadow: 0 2px 4px rgba(26, 115, 232, 0.15);">
                <div style="color: #1a73e8; font-size: 11px; font-weight: 700; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Total COGS</div>
                <div style="font-size: 20px; font-weight: 700; color: #1a73e8;">
                    ${formatCurr(totalCogs)}
                </div>
            </div>
        </div>
    `;

    cell.innerHTML = html;
    submenuRow.appendChild(cell);
    
    return submenuRow;
}
