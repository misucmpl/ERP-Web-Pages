            lmMap[type][key] = (lmMap[type][key] || 0) + (row.amount || 0);
        });

        var curGroups = {};
        var groupOrder = [];
        (currentRows || []).forEach(function (row) {
            var type = row.custom_sales_order_type || "Other";
            var key = row.customer_name || row.customer || "Unknown";
            if (!curGroups[type]) { curGroups[type] = {}; groupOrder.push(type); }
            if (!curGroups[type][key]) curGroups[type][key] = { name: key, qty: 0, amount: 0, orders: 0 };
            curGroups[type][key].qty += row.qty || 0;
            curGroups[type][key].amount += row.amount || 0;
            
            // Count unique orders
            if (!curGroups[type][key].orderSet) curGroups[type][key].orderSet = {};
            curGroups[type][key].orderSet[row.name] = true;
            curGroups[type][key].orders = Object.keys(curGroups[type][key].orderSet).length;
        });

        var html = "";

        if (!groupOrder.length) {
            var inner = '<div style="color:#9aa5b5; font-size:14px; text-align:center; margin-top:60px;">No customer data for this period.</div>';
            return _slideWrap("Top Customers", "By Sales Order Type &middot; vs. Last Month", inner, isLast);
        } else {
            var validGroups = [];
            groupOrder.forEach(function (type) {
                if (type !== "Other") {
                    validGroups.push(type);
                }
            });

            validGroups.forEach(function (type, idx) {
                var color = PALETTE[idx % PALETTE.length];
                var top = Object.keys(curGroups[type]).map(function (k) { return curGroups[type][k]; })
                    .sort(function (a, b) { return b.amount - a.amount; })
                    .slice(0, 10);

                var isLastGroup = (idx === validGroups.length - 1);
                var pageBreak = (isLastGroup && isLast) ? '' : 'page-break-after: always;';

                var segmentInner =
                    '<table style="width:100%; border-collapse:collapse; font-size:13px;">' +
                    '<thead><tr style="background:#f0f5ff;">' +
                        '<th style="text-align:left; padding:9px 12px; border:1px solid #dde8f8;">Customer</th>' +
                        '<th style="text-align:center; padding:9px 12px; border:1px solid #dde8f8;">Orders</th>' +
                        '<th style="text-align:right; padding:9px 12px; border:1px solid #dde8f8;">This Period</th>' +
                        '<th style="text-align:right; padding:9px 12px; border:1px solid #dde8f8;">Last Month</th>' +
                    '</tr></thead><tbody>';

                top.forEach(function (c) {
                    var lm = lmMap[type] && lmMap[type][c.name];
                    segmentInner += '<tr>' +
                        '<td style="padding:8px 12px; border:1px solid #eef1f6; font-weight:600;">' + frappe.utils.escape_html(c.name) + '</td>' +
                        '<td style="padding:8px 12px; border:1px solid #eef1f6; text-align:center; color:#1a73e8; font-weight:700;">' + c.orders + '</td>' +
                        '<td style="padding:8px 12px; border:1px solid #eef1f6; text-align:right; font-weight:700; color:' + color + ';">' + _fmtCurrency(c.amount) + '</td>' +
                        '<td style="padding:8px 12px; border:1px solid #eef1f6; text-align:right;">' +
                            (typeof lm === "number" ? _fmtCurrency(lm) : "—") + '</td>' +
                    '</tr>';
                });

                segmentInner += '</tbody></table>';

                // ✅ Each segment on new page
                html += '<div class="ucm-pdf-page" style="padding: 30px 46px; box-sizing:border-box; ' + pageBreak + '">' +
                    '<div style="display:flex; justify-content:space-between; align-items:baseline; ' +
                        'border-bottom:3px solid #1a73e8; padding-bottom:10px; margin-bottom:22px;">' +
                        '<div>' +
                            '<div style="font-size:22px; font-weight:800; color:#0b1424;">Top Customers &mdash; ' + frappe.utils.escape_html(type) + '</div>' +
                            '<div style="font-size:11.5px; color:#9aa5b5; margin-top:2px;">By Sales Value &middot; vs. Last Month</div>' +
                        '</div>' +
                        '<div style="font-size:11px; color:#9aa5b5;">UCM Dispatch &amp; Sales Register</div>' +
                    '</div>' +
                    '<div>' + segmentInner + '</div>' +
                '</div>';
            });
        }

        return html;
    }
    

    // ═══════════════════════════════════════════════════════════════════════
    // SALES ORDER ANALYSIS — 2 PDF pages (before Customer Count)
    // Data: ucm_so_type_summary — wahi API jo "Sales Orders" slider use karta hai.
    // Delivery = Sales Invoice. Rows: Overall / Ultra / Large Blow.
    // ═══════════════════════════════════════════════════════════════════════
    function _ucmFetchSoSummaryForPdf(callback) {
        var fromDate = frappe.query_report.get_filter_value("from_date");
        var toDate   = frappe.query_report.get_filter_value("to_date");
        var customer = frappe.query_report.get_filter_value("customer");
        if (!fromDate || !toDate) { callback(null); return; }
        frappe.call({
            method: "ucm_so_type_summary",
            args: { from_date: fromDate, to_date: toDate, customer: customer || undefined },
            timeout: 60000,
            callback: function (r) { callback((r && r.message) || null); },
            error: function () { callback(null); }
        });
    }

    var UCM_PDF_SO_ROWS = [
        { key: "OVERALL",    label: "Overall",    color: "#0b1424" },
        { key: "ULTRA",      label: "Ultra",      color: "#1a73e8" },
        { key: "LARGE BLOW", label: "Large Blow", color: "#7b3fa0" }
    ];

    function _soPdfQty(v) { return Math.round(v || 0).toLocaleString("en-IN"); }
    function _soPdfPct(a, b) { return b ? Math.round(((a || 0) / b) * 1000) / 10 : 0; }

    function _soPdfCard(label, value, sub, color) {
        return '<div style="flex:1; min-width:0; border:1px solid #dde8f8; border-top:4px solid ' + color + '; ' +
            'border-radius:10px; padding:10px 8px; background:#fff; text-align:center;">' +
                '<div style="font-size:10px; font-weight:800; color:#7a8fa8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:5px;">' + label + '</div>' +
                '<div style="font-size:22px; font-weight:900; color:' + color + '; line-height:1.1;">' + value + '</div>' +
                (sub ? '<div style="font-size:10.5px; color:#5f6b7a; font-weight:600; margin-top:4px;">' + sub + '</div>' : '') +
            '</div>';
    }

    function _soPdfRow(rowDef, cardsHtml, footHtml) {
        return '<div style="display:flex; align-items:stretch; gap:12px; margin-bottom:14px; page-break-inside:avoid;">' +
                '<div style="width:110px; flex-shrink:0; border-radius:10px; background:' + rowDef.color + '; color:#fff; ' +
                    'display:flex; align-items:center; justify-content:center; text-align:center; ' +
                    'font-size:15px; font-weight:800; text-transform:uppercase; letter-spacing:0.04em; padding:8px;">' +
                    rowDef.label + '</div>' +
                '<div style="flex:1; min-width:0;">' +
                    '<div style="display:flex; gap:10px;">' + cardsHtml + '</div>' +
                    (footHtml || '') +
                '</div>' +
            '</div>';
    }

    function _soPdfBar(text, pct, color) {
        return '<div style="margin-top:6px; font-size:11px; font-weight:700; color:#3d5170;">' + text +
            '<div style="height:7px; background:#eef2fa; border-radius:4px; overflow:hidden; margin-top:3px;">' +
                '<div style="height:100%; width:' + Math.min(100, pct) + '%; background:' + color + '; border-radius:4px;"></div>' +
            '</div></div>';
    }

    function _soPdfUnavailable(title) {
        return _slideWrap(title, null,
            '<div style="color:#9aa5b5; font-size:15px; text-align:center; margin-top:60px;">' +
            'Sales Order data could not be loaded. Check that ucm_so_type_summary Server Script is deployed.</div>', false);
    }

    function _soPdfSubtitle(summary) {
        return "Selected period &middot; Sales Order date &middot; Delivery as per Sales Invoice";
    }

    // Page 1 — Orders & Quantity
    function _slideSoOrdersQuantity(summary) {
        var title = "Sales Order Analysis — Orders &amp; Quantity";
        if (!summary || !summary.buckets) return _soPdfUnavailable(title);
        var inner = "";
        UCM_PDF_SO_ROWS.forEach(function (rd) {
            var b = summary.buckets[rd.key] || {};
            var delPct = _soPdfPct(b.delivered_qty, b.qty);
            var cards =
                _soPdfCard("Sales Orders", b.so_count || 0, _fmtCurrency(b.value || 0), rd.color) +
                _soPdfCard("Ordered Qty", _soPdfQty(b.qty), "", "#3d5170") +
                _soPdfCard("Delivered Qty", _soPdfQty(b.delivered_qty), delPct + "% of ordered", "#1a6e3a") +
                _soPdfCard("Pending Qty", _soPdfQty(b.pending_qty), "open orders", "#c62828") +
                _soPdfCard("Closed – Undelivered", _soPdfQty(b.short_closed_qty), "closed SOs", "#5f6b7a");
            inner += _soPdfRow(rd, cards,
                _soPdfBar("Delivered " + delPct + "% of ordered qty", delPct, "#1a6e3a"));
        });
        return _slideWrap(title, _soPdfSubtitle(summary), inner, false);
    }

    // Page 2 — Delivery Performance
    function _slideSoDeliveryPerformance(summary) {
        var title = "Sales Order Analysis — Delivery Performance";
        if (!summary || !summary.buckets) return _soPdfUnavailable(title);
        var inner = "";
        UCM_PDF_SO_ROWS.forEach(function (rd) {
            var b = summary.buckets[rd.key] || {};
            var delayed = (b.late || 0) + (b.overdue || 0);
            var finished = (b.on_time || 0) + (b.late || 0);
            var onTimePct = _soPdfPct(b.on_time, finished);
            var cards =
                _soPdfCard("Sales Orders", b.so_count || 0, "total", rd.color) +
                _soPdfCard("On Time", b.on_time || 0, "fully invoiced by due date", "#1a6e3a") +
                _soPdfCard("Delayed", delayed, (b.late || 0) + " delivered late &middot; " + (b.overdue || 0) + " still pending", "#c62828") +
                _soPdfCard("Pending (On Track)", b.on_track || 0, "due date not passed", "#1a73e8") +
                _soPdfCard("Closed", b.closed_short || 0, "closed before full delivery", "#5f6b7a");
            var foot =
                '<div style="margin-top:5px; font-size:10.5px; color:#5f6b7a; font-weight:700;">' +
                    (b.so_count || 0) + ' = On Time ' + (b.on_time || 0) + ' + Delayed ' + delayed +
                    ' + Pending ' + (b.on_track || 0) + ' + Closed ' + (b.closed_short || 0) + '</div>' +
                _soPdfBar("On-time delivery: " + onTimePct + "% of " + finished + " fully invoiced orders", onTimePct, "#1a6e3a");
            inner += _soPdfRow(rd, cards, foot);
        });
        return _slideWrap(title, _soPdfSubtitle(summary), inner, false);
    }

    function _slideCustomerCountComparison(fromDate, toDate, currentRows, lastMonthRows) {
        function _extractSOTType(type) {
            var t = String(type || "").toUpperCase();
            if (t.indexOf("ULTRA") !== -1) return "Ultra";
            if (t.indexOf("LARGE") !== -1 || t.indexOf("BLOW") !== -1) return "Large Blow";
            return "Other";
        }

        var curCustomers = {}, lmCustomers = {};
        var curSegments = {}, lmSegments = {};

        // Current period
        (currentRows || []).forEach(function (row) {
            var sot = _extractSOTType(row.custom_sales_order_type);
            var cust = row.customer_name || row.customer;
            if (cust && sot !== "Other") {
                var key = sot + "|" + cust;
                curCustomers[key] = true;
                if (!curSegments[sot]) curSegments[sot] = {};
                curSegments[sot][cust] = true;
            }
        });

        // Last month
        (lastMonthRows || []).forEach(function (row) {
            var sot = _extractSOTType(row.custom_sales_order_type);
            var cust = row.customer_name || row.customer;
            if (cust && sot !== "Other") {
                var key = sot + "|" + cust;
                lmCustomers[key] = true;
                if (!lmSegments[sot]) lmSegments[sot] = {};
                lmSegments[sot][cust] = true;
            }
        });

        var curUltra = Object.keys(curSegments.Ultra || {}).length;
        var lmUltra = Object.keys(lmSegments.Ultra || {}).length;
        
        var curLargeBlow = Object.keys(curSegments["Large Blow"] || {}).length;
        var lmLargeBlow = Object.keys(lmSegments["Large Blow"] || {}).length;
        
        var curTotal = curUltra + curLargeBlow;
        var lmTotal = lmUltra + lmLargeBlow;

        function _changePercentage(current, lastMonth) {
            if (lastMonth <= 0) return current > 0 ? '<span style="color:#1a6e3a;">+' + (current - lastMonth) + ' (↑New)</span>' : '<span style="color:#9aa5b5;">—</span>';
            var change = current - lastMonth;
            var pct = (change / lastMonth) * 100;
            var color = change >= 0 ? "#1a6e3a" : "#d93025";
            var symbol = change >= 0 ? "↑" : "↓";
            return '<span style="color:' + color + '; font-weight:700;">' + symbol + change + ' (' + (change >= 0 ? '+' : '') + Math.round(pct * 100) / 100 + '%)</span>';
        }

        var periodLabel = "";
        try {
            var parts = fromDate.split("-");
            if (parts.length === 3) {
                var monthNum = parseInt(parts[1], 10) - 1;
                var monthName = MONTH_NAMES[monthNum] || parts[1];
                periodLabel = monthName;
            }
        } catch (e) {}

        var lmPeriodLabel = "";
        try {
            var lmFromDate = _ucmShiftDateLastMonth(fromDate);
            var parts = lmFromDate.split("-");
            if (parts.length === 3) {
                var monthNum = parseInt(parts[1], 10) - 1;
                var monthName = MONTH_NAMES[monthNum] || parts[1];
                lmPeriodLabel = monthName;
            }
        } catch (e) {}

        var inner =
            '<div style="font-size:18px; font-weight:700; color:#0b1424; margin-bottom:20px;">' +
                'Customer Count - ' + frappe.utils.escape_html(lmPeriodLabel) + ' vs ' + frappe.utils.escape_html(periodLabel) +
            '</div>' +
            '<div style="display:flex; flex-direction:column; gap:16px;">' +
                '<div style="display:flex; justify-content:space-between; align-items:center; padding:16px 20px; background:#f8fafc; border:1px solid #dde8f8; border-radius:8px;">' +
                    '<span style="font-size:15px; font-weight:600;">Ultra Segment</span>' +
                    '<div style="display:flex; gap:30px; align-items:center;">' +
                        '<div style="text-align:center;">' +
                            '<div style="font-size:12px; color:#7a8fa8; margin-bottom:4px;">' + lmPeriodLabel + '</div>' +
                            '<div style="font-size:24px; font-weight:800; color:#1a73e8;">' + lmUltra + '</div>' +
                        '</div>' +
                        '<div style="text-align:center;">' +
                            '<div style="font-size:12px; color:#7a8fa8; margin-bottom:4px;">' + periodLabel + '</div>' +
                            '<div style="font-size:24px; font-weight:800; color:#1a6e3a;">' + curUltra + '</div>' +
                        '</div>' +
                        '<div style="font-size:13px; font-weight:700;">' + _changePercentage(curUltra, lmUltra) + '</div>' +
                    '</div>' +
                '</div>' +
                '<div style="display:flex; justify-content:space-between; align-items:center; padding:16px 20px; background:#f8fafc; border:1px solid #dde8f8; border-radius:8px;">' +
                    '<span style="font-size:15px; font-weight:600;">Large Blow Segment</span>' +
                    '<div style="display:flex; gap:30px; align-items:center;">' +
                        '<div style="text-align:center;">' +
                            '<div style="font-size:12px; color:#7a8fa8; margin-bottom:4px;">' + lmPeriodLabel + '</div>' +
                            '<div style="font-size:24px; font-weight:800; color:#7b3fa0;">' + lmLargeBlow + '</div>' +
                        '</div>' +
                        '<div style="text-align:center;">' +
                            '<div style="font-size:12px; color:#7a8fa8; margin-bottom:4px;">' + periodLabel + '</div>' +
                            '<div style="font-size:24px; font-weight:800; color:#7b3fa0;">' + curLargeBlow + '</div>' +
                        '</div>' +
                        '<div style="font-size:13px; font-weight:700;">' + _changePercentage(curLargeBlow, lmLargeBlow) + '</div>' +
                    '</div>' +
                '</div>' +
                '<div style="display:flex; justify-content:space-between; align-items:center; padding:16px 20px; background:#eff6ff; border:2px solid #1a73e8; border-radius:8px;">' +
                    '<span style="font-size:15px; font-weight:700; color:#0b1424;">TOTAL</span>' +
                    '<div style="display:flex; gap:30px; align-items:center;">' +
                        '<div style="text-align:center;">' +
                            '<div style="font-size:12px; color:#7a8fa8; margin-bottom:4px;">' + lmPeriodLabel + '</div>' +
                            '<div style="font-size:28px; font-weight:800; color:#1a73e8;">' + lmTotal + '</div>' +
                        '</div>' +
                        '<div style="text-align:center;">' +
                            '<div style="font-size:12px; color:#7a8fa8; margin-bottom:4px;">' + periodLabel + '</div>' +
                            '<div style="font-size:28px; font-weight:800; color:#1a73e8;">' + curTotal + '</div>' +
                        '</div>' +
                        '<div style="font-size:13px; font-weight:700;">' + _changePercentage(curTotal, lmTotal) + '</div>' +
                    '</div>' +
                '</div>' +
            '</div>';

        return _slideWrap("Customer Count", lmPeriodLabel + " vs " + periodLabel, inner, false);
    }

    // ✅ FIXED: Uses unified global _extractCategoryFromProduct()
    function _slideCategoryWiseSalesComparison(currentRows, lastMonthRows) {
    // Category = item ka asli Item Group (Python report har row ke saath
    // item_group bhejta hai). Purane report version mein item_group na ho to
    // product-name wala anumaan fallback hai. Saari categories dikhti hain —
    // koi category hide nahi hoti.
    function catOf(row) {
        // Same field the View Details slider uses (custom_item_category)
        var g = String(row.custom_item_category || row.category || "").trim();
        return g || "Uncategorized";
    }

    // Categories that must NOT appear in Category-wise Sales (Ultra & Large Blow)
    function isExcludedCat(name) {
        var n = String(name || "").toUpperCase().replace(/[^A-Z0-9]+/g, " ").trim();
        return /^(CORRUGATED BOX(ES)?|POLY|WADS?|POLY WADS?|EP RINGS?|MASTER ?BATCH(ES)?)$/.test(n);
    }

    var lmMap = {};
    (lastMonthRows || []).forEach(function (row) {
        var type = row.custom_sales_order_type || "Other";
        var cat = catOf(row);
        if (isExcludedCat(cat)) return;
        if (!lmMap[type]) lmMap[type] = {};
        lmMap[type][cat] = (lmMap[type][cat] || 0) + (row.amount || 0);
    });

    var curGroups = {};
    var groupOrder = [];
    (currentRows || []).forEach(function (row) {
        var type = row.custom_sales_order_type || "Other";
        var cat = catOf(row);
        if (isExcludedCat(cat)) return;
        if (!curGroups[type]) { curGroups[type] = {}; groupOrder.push(type); }
        if (!curGroups[type][cat]) curGroups[type][cat] = { name: cat, qty: 0, amount: 0 };
        curGroups[type][cat].qty += row.qty || 0;
        curGroups[type][cat].amount += row.amount || 0;
    });

    // Jo category sirf last month mein bikhi (is period 0), woh bhi list mein aaye
    Object.keys(lmMap).forEach(function (type) {
        if (!curGroups[type]) { curGroups[type] = {}; groupOrder.push(type); }
        Object.keys(lmMap[type]).forEach(function (cat) {
            if (!curGroups[type][cat]) curGroups[type][cat] = { name: cat, qty: 0, amount: 0 };
        });
    });

    // Ultra aur Large Blow — har ek alag page par (fixed order)
    var SEGS = [
        { key: "ULTRA",      label: "Ultra",      color: "#1a73e8" },
        { key: "LARGE BLOW", label: "Large Blow", color: "#7b3fa0" }
    ];

    function findType(map, segKey) {
        var found = null;
        Object.keys(map || {}).forEach(function (t) {
            if (!found && String(t).trim().toUpperCase() === segKey) found = t;
        });
        return found;
    }

    var html = "";
    SEGS.forEach(function (sg) {
        var curType = findType(curGroups, sg.key);
        var lmType  = findType(lmMap, sg.key);
        var curMap  = curType ? curGroups[curType] : {};
        var lmSeg   = lmType ? lmMap[lmType] : {};
        var cats = Object.keys(curMap).map(function (k) { return curMap[k]; })
            .sort(function (a, b) { return b.amount - a.amount; });

        var inner;
        if (!cats.length) {
            inner = '<div style="color:#9aa5b5; font-size:14px; text-align:center; margin-top:60px;">No ' +
                sg.label + ' category-wise sales data for this period.</div>';
        } else {
            var totCur = 0, totLm = 0;
            // Shrink row height/font so the whole segment ALWAYS fits on ONE page
            var rowPx  = Math.max(15, Math.min(34, Math.floor(480 / (cats.length + 2))));
            var fontPx = rowPx >= 28 ? 13 : (rowPx >= 22 ? 12 : (rowPx >= 18 ? 11 : 10));
            var cellS  = 'padding:0 10px; border:1px solid #eef1f6; white-space:nowrap; ';
            var headS  = 'padding:0 10px; border:1px solid #dde8f8; ';
            inner =
                '<table style="width:100%; border-collapse:collapse; font-size:' + fontPx + 'px; page-break-inside:avoid;">' +
                '<thead><tr style="background:#f0f5ff; height:' + rowPx + 'px;">' +
                    '<th style="text-align:left; ' + headS + '">Category</th>' +
                    '<th style="text-align:right; ' + headS + '">This Period</th>' +
                    '<th style="text-align:right; ' + headS + '">Last Month</th>' +
                    '<th style="text-align:right; ' + headS + '">Change vs Last Month</th>' +
                '</tr></thead><tbody>';

            cats.forEach(function (row) {
                var lm = lmSeg[row.name];
                totCur += row.amount || 0;
                if (typeof lm === "number") totLm += lm;
                inner += '<tr style="height:' + rowPx + 'px;">' +
                    '<td style="' + cellS + 'font-weight:600;">' + frappe.utils.escape_html(row.name) + '</td>' +
                    '<td style="' + cellS + 'text-align:right; font-weight:700; color:' + sg.color + ';">' + _fmtCurrency(row.amount) + '</td>' +
                    '<td style="' + cellS + 'text-align:right;">' + (typeof lm === "number" ? _fmtCurrency(lm) : "—") + '</td>' +
                    '<td style="' + cellS + 'text-align:right;">' +
                        _ucmChangeBadge(row.amount, lm) +
                        (typeof lm === "number" && lm > 0 ? ' <span style="font-size:' + Math.max(9, fontPx - 1) + 'px; font-weight:700;">' + _ucmChangeDelta(row.amount, lm) + '</span>' : '') +
                    '</td>' +
                '</tr>';
            });

            inner += '<tr style="background:#f0f5ff; height:' + rowPx + 'px;">' +
                    '<td style="' + headS + 'font-weight:800;">TOTAL</td>' +
                    '<td style="' + headS + 'text-align:right; font-weight:800; color:' + sg.color + ';">' + _fmtCurrency(totCur) + '</td>' +
                    '<td style="' + headS + 'text-align:right; font-weight:800;">' + _fmtCurrency(totLm) + '</td>' +
                    '<td style="' + headS + 'text-align:right; font-weight:800;">' + _ucmChangeBadge(totCur, totLm) + '</td>' +
                '</tr>' +
                '</tbody></table>';
        }

        html += _slideWrap("Category-wise Sales — " + sg.label, "vs. Last Month", inner, false);
    });

    return html;
}
    function _slideTopProducts(isLast, siRows) {
        var groups = _ucmGetTopProductsBySotType(999999, siRows);

