// ═══════════════════════════════════════════════════════════════════════════
// ── TERRITORY COVERAGE (State / City wise sales) ────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════
//
// Toolbar button "Territories" → opens a right-side slider (same visual
// pattern as the existing Cost Breakup slider) with two tabs:
//   Tab 1 "Summary"    : Total Sale Covered, Total States Covered, Total
//                         Cities Covered (for the current report filters).
//   Tab 2 "State Wise"  : one row per state → State Name, Total Cities
//                         Covered (under that state), Total Sales for that
//                         state. Amounts are qty*rate (no GST/tax added).
//
// Data source: frappe.query_report.data (the exact rows already loaded for
// the on-screen report — no extra server call needed). Only rows whose
// status resolves to "Completed" are counted, matching the rest of the
// report's summary logic.
// ═══════════════════════════════════════════════════════════════════════════

// Canonical list of Indian states + union territories, used only to work
// out which ones have NO Large Blow coverage at all ("Missed States").
// Matches ERPNext's standard India state list.
// 28 States
var UCM_INDIA_STATES = [
    "Andhra Pradesh", "Arunachal Pradesh", "Assam", "Bihar", "Chhattisgarh",
    "Goa", "Gujarat", "Haryana", "Himachal Pradesh", "Jharkhand", "Karnataka",
    "Kerala", "Madhya Pradesh", "Maharashtra", "Manipur", "Meghalaya",
    "Mizoram", "Nagaland", "Odisha", "Punjab", "Rajasthan", "Sikkim",
    "Tamil Nadu", "Telangana", "Tripura", "Uttar Pradesh", "Uttarakhand",
    "West Bengal"
];

// 8 Union Territories
var UCM_INDIA_UTS = [
    "Andaman and Nicobar Islands", "Chandigarh",
    "Dadra and Nagar Haveli and Daman and Diu", "Delhi",
    "Jammu and Kashmir", "Ladakh", "Lakshadweep", "Puducherry"
];

var UCM_INDIA_ALL = UCM_INDIA_STATES.concat(UCM_INDIA_UTS);

// Address mein state alag spelling mein ho sakta hai — sab ko ek hi
// canonical naam par map karte hain, taaki counting galat na ho.
var UCM_STATE_ALIASES = {
    "ORISSA": "Odisha",
    "PONDICHERRY": "Puducherry",
    "NCT OF DELHI": "Delhi",
    "NEW DELHI": "Delhi",
    "DELHI NCR": "Delhi",
    "UTTARANCHAL": "Uttarakhand",
    "UK": "Uttarakhand",
    "UP": "Uttar Pradesh",
    "MP": "Madhya Pradesh",
    "HP": "Himachal Pradesh",
    "J&K": "Jammu and Kashmir",
    "JAMMU & KASHMIR": "Jammu and Kashmir",
    "ANDAMAN & NICOBAR ISLANDS": "Andaman and Nicobar Islands",
    "ANDAMAN AND NICOBAR": "Andaman and Nicobar Islands",
    "DADRA AND NAGAR HAVELI": "Dadra and Nagar Haveli and Daman and Diu",
    "DADRA & NAGAR HAVELI": "Dadra and Nagar Haveli and Daman and Diu",
    "DAMAN AND DIU": "Dadra and Nagar Haveli and Daman and Diu",
    "DAMAN & DIU": "Dadra and Nagar Haveli and Daman and Diu",
    "TAMILNADU": "Tamil Nadu",
    "CHATTISGARH": "Chhattisgarh",
    "WESTBENGAL": "West Bengal"
};

// Returns the canonical India state/UT name, or null if it can't be matched
// (e.g. blank / "Unknown" / typo in Address).
function _ucmCanonicalState(name) {
    var raw = (name || "").toString().trim();
    if (!raw || raw.toUpperCase() === "UNKNOWN") return null;

    // "09-Uttar Pradesh" jaisa GST-code prefix hata do
    var up = raw.toUpperCase().replace(/\s+/g, " ").replace(/^\d+\s*-\s*/, "");

    if (UCM_STATE_ALIASES[up]) return UCM_STATE_ALIASES[up];

    var upAnd = up.replace(/&/g, "AND");
    for (var i = 0; i < UCM_INDIA_ALL.length; i++) {
        var c = UCM_INDIA_ALL[i].toUpperCase();
        if (c === up || c === upAnd) return UCM_INDIA_ALL[i];
    }
    return null;
}

