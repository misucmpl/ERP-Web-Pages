            persons.forEach(function (p) {
                topHtml += '<div style="height:' + CHIP_H + 'px; box-sizing:border-box; display:flex; align-items:center; gap:6px; ' +
                    'padding:0 10px; border:1px solid #dde8f8; border-left:4px solid ' + color + '; border-radius:6px; ' +
                    'background:#fbfcfe; font-size:10.5px; white-space:nowrap;">' +
