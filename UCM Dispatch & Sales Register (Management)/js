          (sub ? "<small>" + esc(sub) + "</small>" : "") + "</span>" +
          (sel ? '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>' : "") + "</div>";
      }).join("") : '<div class="ucmw-dd-none">No matches</div>';
