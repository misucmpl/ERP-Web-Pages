    }

    var html = '<div class="ucm-soa-section">Draft Sales Orders</div>' +
        '<div class="ucm-soa-grid">' +
            card("Draft SOs", drafts.length, _ucmSoaMoney(totalValue), "#b8560c", "all") +
            card("Draft Qty", _ucmSoaQty(totalQty), "not submitted yet", "#3d5170", null) +
            card("Ultra", byType["ULTRA"], "draft orders", "#1a73e8", "sot:ULTRA") +
            card("Large Blow", byType["LARGE BLOW"], "draft orders", "#7b3fa0", "sot:LARGE BLOW") +
