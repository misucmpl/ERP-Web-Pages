    // Credit Note hatne ke baad totals rows se dobara nikaalo
    function _ucmPdfTotals(rows) {
        var total = 0, qty = 0, orders = {}, byType = {};
        (rows || []).forEach(function (r) {
            if (!r || !r.item_code) return;
            var st = r.status;
            if (typeof st === "string" && st.indexOf("data-dn-status") !== -1 &&
                !/data-dn-status="Completed"/.test(st)) return;
            var amt = parseFloat(r.amount) || 0;
            total += amt;
            qty += parseFloat(r.qty) || 0;
            if (r.name) orders[r.name] = true;
            var t = String(r.custom_sales_order_type || "").trim().toUpperCase();
            byType[t] = (byType[t] || 0) + amt;
        });
        return { totalSale: total, totalQty: qty, completedOrders: Object.keys(orders).length, byType: byType };
    }

    // Shifts a 'YYYY-MM-DD' date back one calendar month, mirroring the
    // same frappe.utils.add_months(-1) logic the Python side already uses
    // for the Sales Order Type "Last Month" comparison — so all comparisons
    // in this PDF use the exact same period-shift convention.
    function _ucmShiftDateLastMonth(dateStr) {
        try {
            return frappe.datetime.add_months(dateStr, -1);
        } catch (e) {
            var d = new Date(dateStr);
            d.setMonth(d.getMonth() - 1);
            return d.toISOString().slice(0, 10);
        }
    }

    // Month names array
    var MONTH_NAMES = ["January", "February", "March", "April", "May", "June", 
                       "July", "August", "September", "October", "November", "December"];

    // Converts YYYY-MM-DD to Indian date format (DD-MONTH-YYYY)
    function _fmtDateIndian(dateStr) {
        if (!dateStr) return "—";
        try {
            var parts = dateStr.split("-");
            if (parts.length === 3) {
                var year = String(parseInt(parts[0], 10)).slice(-4);
                var monthNum = parseInt(parts[1], 10) - 1;
                var day = String(parseInt(parts[2], 10)).padStart(2, '0');
                var monthName = MONTH_NAMES[monthNum] || parts[1];
                return day + "-" + monthName + "-" + year;  // DD-MONTH-YYYY
            }
            return dateStr;
        } catch (e) {
            return dateStr;
        }
    }

    // Runs the report's own backend query for the last-month-shifted date
    // range via Frappe's generic report-runner — reuses the EXISTING Python
    // report logic as-is (same SQL, same filters), just with different
    // dates. No new backend endpoint added; this is the standard way any
    // frontend can re-run a Script Report with different filters.
    function _ucmFetchLastMonthExecutiveData(callback) {
        var fromDate  = frappe.query_report.get_filter_value("from_date");
        var toDate    = frappe.query_report.get_filter_value("to_date");

        if (!fromDate || !toDate) { 
            callback(null); 
            return; 
        }

        try {
            var lmFrom = frappe.datetime.add_months(fromDate, -1);
            var lmTo   = frappe.datetime.add_months(toDate, -1);
            
            frappe.call({
                method: "frappe.desk.query_report.run",
                args: {
                    report_name: frappe.query_report.report_name,
                    filters: {
                        from_date: lmFrom,
                        to_date: lmTo,
                        customer: frappe.query_report.get_filter_value("customer") || undefined,
                        item_group: frappe.query_report.get_filter_value("item_group") || undefined,
                        source: "Sales Invoice"
                    }
                },
                timeout: 120,
                callback: function (r) { 
                    if (r && r.message && r.message.result) {
                        callback({ 
                            result: r.message.result,
                            report_summary: r.message.report_summary || []
                        });
                    } else {
                        callback(null);
                    }
                },
                error: function (err) { 
                    console.log("Last month fetch error:", err);
                    callback(null); 
                }
            });
        } catch (e) {
            console.log("Last month fetch exception:", e);
            callback(null);
        }
    }

