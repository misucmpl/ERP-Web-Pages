    var partyList = parties.map(function(p) {

        return { name: p.customer, amount: parseFloat(p.amount) || 0 };

    }).sort(function(a, b) { return b.amount - a.amount; });



    var profitList = parties.map(function(p) {

        return { name: p.customer, amount: parseFloat(p.profit) || 0 };

    }).sort(function(a, b) { return b.amount - a.amount; });



