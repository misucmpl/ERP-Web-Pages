// Local currency formatter (self-contained — does not depend on the
// _fmtCurrency() helper defined inside the separate PDF-summary IIFE below,
// since that one is out of scope here).
function _ucmTerritoryFmtCurrency(v) {
    try {
        var currency = frappe.defaults.get_default("currency");
        return typeof format_currency_nodecimal === "function"
            ? format_currency_nodecimal(v || 0, currency)
            : format_currency(v || 0, currency);
    } catch (e) { return (v || 0).toString(); }
}

// ── Build { states: {...}, totalSales, totalStates, totalCities } from a
//    given set of report rows (passed in, so callers can supply
//    Sales-Invoice-only data instead of relying on whatever "source" filter
//    happens to be selected on screen). ──────────────────────────────────
function _ucmComputeTerritoryData(rows, sotKey) {
    rows = rows || [];
    sotKey = (sotKey || "LARGE BLOW").toUpperCase();

    var states = {};          // state name -> { cities: Set, amount: number }
    var allCitiesSeen = {};   // "state||city" -> true  (city counted once per state)
    var totalSales = 0;

    rows.forEach(function (row) {
        var statusHtml = row && row.status;
        var isCompleted = typeof statusHtml === "string" && /data-dn-status="Completed"/.test(statusHtml);
        if (!isCompleted) return;

        // Only rows of the requested sales order type count toward this view.
        var sot = (row.custom_sales_order_type || "").toString().trim().toUpperCase();
        if (sot !== sotKey) return;

        var amount = parseFloat(row.amount) || 0;
        var state = (row.state || "").toString().trim() || "Unknown";
        var city = (row.city || "").toString().trim() || "Unknown";

        totalSales += amount;

        if (!states[state]) {
            states[state] = { cities: {}, amount: 0 };
        }
        states[state].amount += amount;
        if (!states[state].cities[city]) {
            states[state].cities[city] = 0;
        }
        states[state].cities[city] += amount;

        allCitiesSeen[state + "||" + city] = true;
    });

    var totalStates = Object.keys(states).length;
    var totalCities = Object.keys(allCitiesSeen).length;

    return {
        states: states,
        totalSales: totalSales,
        totalStates: totalStates,
        totalCities: totalCities
    };
}

// ── Territory Coverage always reports on Sales Invoice data, regardless of
//    whatever the report's "source" filter (Delivery Note / Sales Invoice)
//    is currently set to on screen. When the report is already showing
//    Sales Invoice, the on-screen data is reused as-is; otherwise the same
//    report is re-run in the background with source forced to
//    "Sales Invoice" via Frappe's generic report runner (no new backend
//    endpoint needed — same approach used elsewhere in this file for the
//    last-month comparison). ───────────────────────────────────────────
function _ucmFetchTerritorySalesInvoiceRows(callback) {
    var currentSource = frappe.query_report.get_filter_value("source") || "Delivery Note";

    if (currentSource === "Sales Invoice") {
        callback((frappe.query_report && frappe.query_report.data) || []);
        return;
    }

    var fromDate     = frappe.query_report.get_filter_value("from_date");
    var toDate       = frappe.query_report.get_filter_value("to_date");
    var customer     = frappe.query_report.get_filter_value("customer");
    var itemGroup    = frappe.query_report.get_filter_value("item_group");

    frappe.call({
        method: "frappe.desk.query_report.run",
        args: {
            report_name: frappe.query_report.report_name,
            filters: {
                from_date: fromDate,
                to_date: toDate,
                customer: customer,
                item_group: itemGroup,
                source: "Sales Invoice"
            }
        },
        timeout: 60000,
        callback: function (r) {
            if (r && r.message && r.message.result) {
                callback(r.message.result);
            } else {
                callback([]);
            }
        },
        error: function () {
            callback([]);
        }
    });
}

// ── "Till date" overview (all-time, ignores the report's from_date/to_date
//    filters) — calls the ucm_territory_till_date_summary Server Script
//    (API type), which aggregates every completed Large Blow Sales Invoice
//    regardless of date. Falls back to null on any error so the slider
//    still renders the period view even if that script isn't deployed yet.
function _ucmFetchTerritoryTillDateSummary(callback) {
    // Dates / customer / item group are passed only for the Category Reach
    // tab (period-wise). Till-date numbers on the server ignore them.
    frappe.call({
        method: "ucm_territory_till_date_summary",
        args: {
            from_date: frappe.query_report.get_filter_value("from_date") || undefined,
            to_date: frappe.query_report.get_filter_value("to_date") || undefined,
            customer: frappe.query_report.get_filter_value("customer") || undefined,
            item_group: frappe.query_report.get_filter_value("item_group") || undefined
        },
        callback: function (r) {
            callback((r && r.message) || null);
        },
        error: function () {
            callback(null);
        }
    });
}

// ── New customers (first-time) per segment for the selected period.
//    Same API as the PDF's New Customers pages; one call per month.
//    Returns { ultra: {id:{name,orders,sales}}, large_blow: {...} } or null.
function _ucmFetchNewCustomersDetail(callback) {
    var fromDate = frappe.query_report.get_filter_value("from_date");
    var toDate   = frappe.query_report.get_filter_value("to_date");
    var company  = frappe.query_report.get_filter_value("company") || "";
    if (!fromDate || !toDate) { callback(null); return; }
    var months = [];
    var y = parseInt(fromDate.substr(0, 4), 10), m = parseInt(fromDate.substr(5, 2), 10);
    var ty = parseInt(toDate.substr(0, 4), 10), tm = parseInt(toDate.substr(5, 2), 10);
    while (y < ty || (y === ty && m <= tm)) {
        months.push({ year: y, month: m });
        m++; if (m > 12) { m = 1; y++; }
    }
    if (!months.length) { callback(null); return; }
    var out = { ultra: {}, large_blow: {} };
    var done = 0, okCount = 0;
    function finish() { if (++done === months.length) callback(okCount ? out : null); }
    months.forEach(function (mm) {
        frappe.call({
            method: "ucm_customer_acquisition_detail",
            type: "GET",
            args: { year: String(mm.year), month: mm.month, company: company, customer_type: "new" },
            callback: function (r) {
                var res = (r && r.message) || {};
                okCount++;
                ["ultra", "large_blow"].forEach(function (seg) {
                    var list = (res[seg] && res[seg].customers) || [];
                    list.forEach(function (c) {
                        var id = c.customer_id || c.customer_name;
                        var cur = out[seg][id] || { name: c.customer_name || c.customer_id, orders: 0, sales: 0 };
                        cur.orders += c.order_count || 0;
                        cur.sales += c.total_sales || 0;
                        out[seg][id] = cur;
                    });
                });
                finish();
            },
            error: function () { finish(); }
        });
    });
}

function _ucmOpenTerritorySlider() {
    $(".ucm-cost-slider, .ucm-cost-slider-backdrop").remove();

    var fromDate = frappe.query_report.get_filter_value("from_date");
    var toDate   = frappe.query_report.get_filter_value("to_date");

    var $backdrop = $('<div class="ucm-cost-slider-backdrop"></div>').appendTo("body");
    var $panel = $(
        '<div class="ucm-cost-slider">' +
            '<div class="ucm-cost-slider-header">' +
                '<div>' +
                    '<h4>Territory Coverage</h4>' +
                    '<div class="sub">' + frappe.utils.escape_html(fromDate || "") + ' to ' +
                        frappe.utils.escape_html(toDate || "") + ' &middot; Sales Invoice</div>' +
                '</div>' +
                '<button class="ucm-cost-slider-close">&times;</button>' +
            '</div>' +
            '<div class="ucm-cost-slider-body">' +
                '<div class="ucm-territory-segment-badge">Large Blow &amp; Ultra</div>' +
                '<div class="ucm-cost-slider-loading">Loading Sales Invoice data…</div>' +
            '</div>' +
        '</div>'
    ).appendTo("body");

    requestAnimationFrame(function () {
        $backdrop.addClass("open");
        $panel.addClass("open");
    });

    function closePanel() {
        $backdrop.removeClass("open");
        $panel.removeClass("open");
        setTimeout(function () { $backdrop.remove(); $panel.remove(); }, 250);
    }

    $backdrop.on("click", closePanel);
    $panel.on("click", ".ucm-cost-slider-close", closePanel);

    var periodRows = null;
    var tillDateSummary = null;
    var tillDateFetched = false;
    var newCustDetail = null;
    var callsDone = 0;

    function maybeRender() {
        callsDone++;
        if (callsDone < 3) return;
        _ucmRenderTerritoryPanel($panel, periodRows, tillDateFetched ? tillDateSummary : null, newCustDetail);
    }

    _ucmFetchNewCustomersDetail(function (detail) {
        newCustDetail = detail;
        maybeRender();
    });

    _ucmFetchTerritorySalesInvoiceRows(function (rows) {
        periodRows = rows;
        maybeRender();
    });

    _ucmFetchTerritoryTillDateSummary(function (summary) {
        tillDateSummary = summary;
        tillDateFetched = true;
        maybeRender();
    });
}

// Ultra: hide "Poly Wad" and "EP Ring" categories everywhere
// reachOnly = true → also hides "Corrugated Box" (Category Reach only)
function _ucmIsHiddenUltraCategory(segType, name, reachOnly) {
    if (String(segType || "").toUpperCase() !== "ULTRA") return false;
    var n = String(name || "").toUpperCase().replace(/[^A-Z0-9]+/g, " ");
    if (/^ ?(POLY|WADS?|POLY ?WADS?|EP ?RINGS?) ?$/.test(n)) return true;
    return !!reachOnly && /^ ?CORRUGATED ?BOX(ES)? ?$/.test(n);
}

// Sales Order Types shown in the Territory slider. Both use the same purple
// styling; each gets its own Current Period + India Reach view.
var UCM_TERRITORY_SEGMENTS = [
    { key: "LARGE BLOW", label: "Large Blow", id: "lb", acqKey: "large_blow" },
    { key: "ULTRA",      label: "Ultra",      id: "ul", acqKey: "ultra" }
];

// Builds the complete view (Current Period tab + India Reach tab) for ONE
// sales order type. `till` = that type's till-date summary from the server
// script (or null if it couldn't be loaded).
function _ucmBuildTerritorySegmentHtml(seg, rows, till, newCustDetail) {

    var terr = _ucmComputeTerritoryData(rows, seg.key);
    var hasData = terr.totalStates > 0;

    // ── Canonical sets: current period vs till date ─────────────────────
    var periodSet = {};
    Object.keys(terr.states).forEach(function (s) {
        var c = _ucmCanonicalState(s);
        if (c) periodSet[c] = true;
    });

    var tillSet = null;
    var unmatchedNames = [];
    if (till && till.states_covered_till_date) {
        tillSet = {};
        till.states_covered_till_date.forEach(function (s) {
            var c = _ucmCanonicalState(s);
            if (c) {
                tillSet[c] = true;
            } else if (s && String(s).trim().toUpperCase() !== "UNKNOWN") {
                unmatchedNames.push(s);
            }
        });
        // Jo is period mein covered hai, wo till date bhi covered hai
        Object.keys(periodSet).forEach(function (c) { tillSet[c] = true; });
    }

    function countIn(list, set) {
        if (!set) return 0;
        return list.filter(function (s) { return set[s]; }).length;
    }

    var tillCount   = tillSet ? countIn(UCM_INDIA_ALL, tillSet) : 0;
    var periodCount = countIn(UCM_INDIA_ALL, periodSet);

    var missedThisPeriod = tillSet
        ? UCM_INDIA_ALL.filter(function (s) { return tillSet[s] && !periodSet[s]; })
        : [];
    var neverCovered = tillSet
        ? UCM_INDIA_ALL.filter(function (s) { return !tillSet[s]; })
        : [];

    function chips(list, cls) {
        return '<div class="ucm-territory-missed-wrap">' +
            list.map(function (s) {
                return '<span class="' + cls + '">' + frappe.utils.escape_html(s) + '</span>';
            }).join("") +
        '</div>';
    }

    // ═════════════════════ TAB 1 — CURRENT PERIOD ═════════════════════
    var periodHtml;
    if (!hasData) {
        periodHtml =
            '<div class="ucm-territory-empty">No completed ' + frappe.utils.escape_html(seg.label) +
            ' Sales Invoice sales found for the selected filters.</div>';
    } else {
        var summaryHtml =
            '<div class="ucm-territory-stat-grid">' +
                '<div class="ucm-territory-stat-card">' +
                    '<div class="ucm-territory-stat-label">Total Sale Covered</div>' +
                    '<div class="ucm-territory-stat-value">' + _ucmTerritoryFmtCurrency(terr.totalSales) + '</div>' +
                '</div>' +
                '<div class="ucm-territory-stat-card">' +
                    '<div class="ucm-territory-stat-label">Total States Covered</div>' +
                    '<div class="ucm-territory-stat-value">' + terr.totalStates + '</div>' +
                '</div>' +
                '<div class="ucm-territory-stat-card">' +
                    '<div class="ucm-territory-stat-label">Total Cities Covered</div>' +
                    '<div class="ucm-territory-stat-value">' + terr.totalCities + '</div>' +
                '</div>' +
            '</div>';

        var stateNames = Object.keys(terr.states).sort(function (a, b) {
            return terr.states[b].amount - terr.states[a].amount;
        });

        var rowsHtml = "";
        stateNames.forEach(function (stateName, idx) {
            var bucket = terr.states[stateName];
            var cityCount = Object.keys(bucket.cities).length;
            var stateId = "ucm-terr-" + seg.id + "-state-" + idx;

            rowsHtml += '<tr class="ucm-territory-state-row" data-state-id="' + stateId + '">' +
                '<td><span class="ucm-territory-expand-icon">&#9656;</span>' + frappe.utils.escape_html(stateName) + '</td>' +
                '<td class="ucm-num">' + cityCount + '</td>' +
                '<td class="ucm-num">' + _ucmTerritoryFmtCurrency(bucket.amount) + '</td>' +
            '</tr>';

            var cityNames = Object.keys(bucket.cities).sort(function (a, b) {
                return bucket.cities[b] - bucket.cities[a];
            });
            var cityRowsHtml = "";
            cityNames.forEach(function (cityName) {
                cityRowsHtml += '<tr>' +
                    '<td>' + frappe.utils.escape_html(cityName) + '</td>' +
                    '<td class="ucm-num">' + _ucmTerritoryFmtCurrency(bucket.cities[cityName]) + '</td>' +
                '</tr>';
            });

            rowsHtml += '<tr class="ucm-territory-city-row" data-state-id="' + stateId + '">' +
                '<td colspan="3">' +
                    '<div class="ucm-territory-city-slide">' +
                        '<div class="ucm-territory-city-wrap">' +
                            '<div class="ucm-territory-city-title">' +
                                frappe.utils.escape_html(stateName) + ' &middot; City Wise Breakup' +
                            '</div>' +
                            '<table class="ucm-territory-table ucm-territory-city-table">' +
                                '<thead><tr>' +
                                    '<th>City</th>' +
                                    '<th style="text-align:right;">Total Sales (excl. GST)</th>' +
                                '</tr></thead>' +
                                '<tbody>' + cityRowsHtml + '</tbody>' +
                            '</table>' +
                        '</div>' +
                    '</div>' +
                '</td>' +
            '</tr>';
        });

        var stateWiseHtml =
            '<div class="ucm-territory-section-title">State Wise</div>' +
            '<table class="ucm-territory-table">' +
                '<thead><tr>' +
                    '<th>State</th>' +
                    '<th style="text-align:right;">Cities Covered</th>' +
                    '<th style="text-align:right;">Total Sales (excl. GST)</th>' +
                '</tr></thead>' +
                '<tbody>' + rowsHtml +
                    '<tr class="ucm-territory-total-row">' +
                        '<td>Grand Total</td>' +
                        '<td class="ucm-num">' + terr.totalCities + '</td>' +
                        '<td class="ucm-num">' + _ucmTerritoryFmtCurrency(terr.totalSales) + '</td>' +
                    '</tr>' +
                '</tbody>' +
            '</table>';

        periodHtml =
            '<div class="ucm-territory-section-title">Summary</div>' +
            summaryHtml +
            '<div style="height:24px;"></div>' +
            stateWiseHtml;
    }

    // Bottom of Tab 1 — till date covered but missed in this period
    if (tillSet) {
        periodHtml +=
            '<div style="height:24px;"></div>' +
            '<div class="ucm-territory-section-title ucm-territory-period-missed-title">' +
                'Missed This Period <span style="font-weight:600; text-transform:none;">(' +
                missedThisPeriod.length + ' states)</span>' +
            '</div>' +
            '<div class="ucm-territory-period-note">' +
                'Covered till date: <b>' + tillCount + '</b> &middot; ' +
                'Covered this period: <b>' + periodCount + '</b> &rarr; ' +
                '<b>' + missedThisPeriod.length + '</b> states had sales earlier but none in this period.' +
            '</div>' +
            (missedThisPeriod.length
                ? chips(missedThisPeriod, "ucm-territory-period-chip")
                : '<div class="ucm-territory-missed-empty">Every state covered till date also has sales this period.</div>');
    }

    // ═════════════════════ TAB 2 — INDIA REACH (overall / till date) ═════
    var reachHtml;
    if (!tillSet) {
        reachHtml =
            '<div class="ucm-territory-missed-unknown">' +
                'Till-date data load nahi hua. Check that the <code>ucm_territory_till_date_summary</code> ' +
                'Server Script is deployed (updated version with <code>by_type</code>).' +
            '</div>';
    } else {
        function reachCard(label, reached, total, color) {
            var pct = total ? Math.round((reached / total) * 1000) / 10 : 0;
            return '<div class="ucm-reach-card" style="--c:' + color + ';">' +
                '<div class="ucm-reach-label">' + label + '</div>' +
                '<div class="ucm-reach-value">' + reached + '<span> / ' + total + '</span></div>' +
                '<div class="ucm-reach-track"><div class="ucm-reach-fill" style="width:' + pct + '%;"></div></div>' +
                '<div class="ucm-reach-pct">' + pct + '% reach &middot; ' + (total - reached) + ' remaining</div>' +
            '</div>';
        }

        var tillStates = countIn(UCM_INDIA_STATES, tillSet);
        var tillUts    = countIn(UCM_INDIA_UTS, tillSet);

        function mapChips(list) {
            return '<div class="ucm-reach-chip-wrap">' +
                list.map(function (s) {
                    return '<span class="ucm-reach-chip ' + (tillSet[s] ? "is-period" : "is-never") + '">' +
                        frappe.utils.escape_html(s) + '</span>';
                }).join("") +
            '</div>';
        }

        reachHtml =
            '<div class="ucm-territory-section-title">Overall Reach (Till Date)</div>' +
            '<div class="ucm-reach-subtitle">India = 28 States + 8 Union Territories = 36</div>' +
            '<div class="ucm-reach-grid">' +
                reachCard("States", tillStates, UCM_INDIA_STATES.length, "#7b3fa0") +
                reachCard("Union Territories", tillUts, UCM_INDIA_UTS.length, "#7b3fa0") +
                reachCard("Total India", tillCount, UCM_INDIA_ALL.length, "#7b3fa0") +
            '</div>' +

            '<div class="ucm-territory-section-title">State Wise Map</div>' +
            '<div class="ucm-reach-legend">' +
                '<span><i style="background:#1a6e3a;"></i>Covered till date</span>' +
                '<span><i style="background:#d94848;"></i>Never covered</span>' +
            '</div>' +
            '<div class="ucm-reach-group-title">States (' + tillStates + ' / 28 reached)</div>' +
            mapChips(UCM_INDIA_STATES) +
            '<div class="ucm-reach-group-title">Union Territories (' + tillUts + ' / 8 reached)</div>' +
            mapChips(UCM_INDIA_UTS) +

            '<div style="height:24px;"></div>' +
            '<div class="ucm-territory-section-title ucm-territory-missed-title">' +
                'Never Covered Till Date <span style="font-weight:600; text-transform:none;">(' +
                neverCovered.length + ' of 36)</span>' +
            '</div>' +
            (neverCovered.length
                ? chips(neverCovered, "ucm-territory-missed-chip")
                : '<div class="ucm-territory-missed-empty">All states covered — no gaps.</div>') +

            (unmatchedNames.length
                ? '<div class="ucm-reach-unmatched"><b>Note:</b> These state names in Customer Address ' +
                  'did not match any Indian state/UT and were not counted: ' +
                  frappe.utils.escape_html(unmatchedNames.join(", ")) +
                  '. Address mein spelling theek kar dein.</div>'
                : '');
    }

    // ═════════════════════ TAB 3 — CATEGORY REACH (till date) ═════════
    // Server script returns, per sales order type, a list of
    // { category, states: { stateName: amount } }. Category = Item Group.
    var categoryHtml;
    var catList = (till && till.category_reach) || null;
    if (catList) catList = catList.filter(function (c) { return !_ucmIsHiddenUltraCategory(seg.key, c.category, true); });
    if (!catList) {
        categoryHtml =
            '<div class="ucm-territory-missed-unknown">' +
                'Category data load nahi hua. Update the <code>ucm_territory_till_date_summary</code> ' +
                'Server Script (version with <code>category_reach</code>).' +
            '</div>';
    } else if (!catList.length) {
        categoryHtml = '<div class="ucm-territory-empty">No ' + frappe.utils.escape_html(seg.label) +
            ' category sales found for the selected dates.</div>';
    } else {
        // Merge state spellings to canonical names, per category
        var cats = catList.map(function (c) {
            var merged = {};
            var total = 0;
            Object.keys(c.states || {}).forEach(function (s) {
                var amt = parseFloat(c.states[s]) || 0;
                var key = _ucmCanonicalState(s) || (String(s || "").trim() || "Unknown");
                merged[key] = (merged[key] || 0) + amt;
                total += amt;
            });
            var reached = Object.keys(merged).filter(function (k) {
                return UCM_INDIA_ALL.indexOf(k) !== -1;
            }).length;
            return { name: c.category || "Uncategorized", states: merged, total: total, reached: reached };
        }).sort(function (a, b) { return b.total - a.total; });

        var catGrand = cats.reduce(function (s, c) { return s + c.total; }, 0);

        // Distinct states reached across all categories in this period
        var catStateUnion = {};
        cats.forEach(function (c) {
            Object.keys(c.states).forEach(function (k) {
                if (UCM_INDIA_ALL.indexOf(k) !== -1) catStateUnion[k] = true;
            });
        });
        var catUnionCount = Object.keys(catStateUnion).length;
        var catFrom = frappe.query_report.get_filter_value("from_date") || "";
        var catTo   = frappe.query_report.get_filter_value("to_date") || "";
        var catRows = "";

        cats.forEach(function (c, idx) {
            var rowId = "ucm-terr-" + seg.id + "-cat-" + idx;
            var pct = Math.round((c.reached / UCM_INDIA_ALL.length) * 1000) / 10;

            catRows += '<tr class="ucm-territory-state-row" data-state-id="' + rowId + '">' +
                '<td><span class="ucm-territory-expand-icon">&#9656;</span>' + frappe.utils.escape_html(c.name) + '</td>' +
                '<td class="ucm-num">' + c.reached + ' / 36 <span class="ucm-cat-reach-pct">(' + pct + '%)</span></td>' +
                '<td class="ucm-num">' + _ucmTerritoryFmtCurrency(c.total) + '</td>' +
            '</tr>';

            var stateNames = Object.keys(c.states).sort(function (a, b) {
                return c.states[b] - c.states[a];
            });
            var stRows = "";
            stateNames.forEach(function (s) {
                stRows += '<tr>' +
                    '<td>' + frappe.utils.escape_html(s) + '</td>' +
                    '<td class="ucm-num">' + _ucmTerritoryFmtCurrency(c.states[s]) + '</td>' +
                '</tr>';
            });

            catRows += '<tr class="ucm-territory-city-row" data-state-id="' + rowId + '">' +
                '<td colspan="3">' +
                    '<div class="ucm-territory-city-slide">' +
                        '<div class="ucm-territory-city-wrap">' +
                            '<div class="ucm-territory-city-title">' +
                                frappe.utils.escape_html(c.name) + ' &middot; State Wise Breakup (' + stateNames.length + ')' +
                            '</div>' +
                            '<table class="ucm-territory-table ucm-territory-city-table">' +
                                '<thead><tr>' +
                                    '<th>State</th>' +
                                    '<th style="text-align:right;">Total Sales (excl. GST)</th>' +
                                '</tr></thead>' +
                                '<tbody>' + stRows + '</tbody>' +
                            '</table>' +
                        '</div>' +
                    '</div>' +
                '</td>' +
            '</tr>';
        });

        categoryHtml =
            '<div class="ucm-territory-section-title">Category Wise Reach (Selected Period)</div>' +
            '<div class="ucm-reach-subtitle">' + frappe.utils.escape_html(frappe.datetime.str_to_user(catFrom)) +
                ' to ' + frappe.utils.escape_html(frappe.datetime.str_to_user(catTo)) + '</div>' +
            '<div class="ucm-reach-subtitle">' + cats.length + ' categories &middot; click a category to see its states</div>' +
            '<table class="ucm-territory-table">' +
                '<thead><tr>' +
                    '<th>Category</th>' +
                    '<th style="text-align:right;">States Reached</th>' +
                    '<th style="text-align:right;">Total Sales (excl. GST)</th>' +
                '</tr></thead>' +
                '<tbody>' + catRows +
                    '<tr class="ucm-territory-total-row">' +
                        '<td>Grand Total</td>' +
                        '<td class="ucm-num">' + catUnionCount + ' / 36</td>' +
                        '<td class="ucm-num">' + _ucmTerritoryFmtCurrency(catGrand) + '</td>' +
                    '</tr>' +
                '</tbody>' +
            '</table>';
    }

    // ═════════════════════ TAB 4 — NEW CUSTOMERS (selected period) ═════
    var newCustHtml;
    if (!newCustDetail) {
        newCustHtml = '<div class="ucm-territory-missed-unknown">New customer data load nahi hua.</div>';
    } else {
        var ncMap = newCustDetail[seg.acqKey] || {};
        var ncList = Object.keys(ncMap).map(function (k) { return ncMap[k]; })
            .sort(function (a, b) { return b.sales - a.sales; });
        var ncFrom = frappe.query_report.get_filter_value("from_date") || "";
        var ncTo   = frappe.query_report.get_filter_value("to_date") || "";
        if (!ncList.length) {
            newCustHtml = '<div class="ucm-territory-empty">No new ' + frappe.utils.escape_html(seg.label) +
                ' customers in the selected period.</div>';
        } else {
            var ncTotal = ncList.reduce(function (t, c) { return t + (c.sales || 0); }, 0);
            var ncRows = "";
            ncList.forEach(function (c, i) {
                ncRows += '<tr>' +
                    '<td>' + (i + 1) + '</td>' +
                    '<td>' + frappe.utils.escape_html(c.name || "") + '</td>' +
                    '<td class="ucm-num">' + c.orders + '</td>' +
                    '<td class="ucm-num">' + _ucmTerritoryFmtCurrency(c.sales) + '</td>' +
                '</tr>';
            });
            newCustHtml =
                '<div class="ucm-territory-section-title">New Customers (Selected Period)</div>' +
                '<div class="ucm-reach-subtitle">' + frappe.utils.escape_html(frappe.datetime.str_to_user(ncFrom)) +
                    ' to ' + frappe.utils.escape_html(frappe.datetime.str_to_user(ncTo)) + '</div>' +
                '<div class="ucm-reach-subtitle">' + ncList.length + ' new customers &middot; first-time buyers, sorted by sales</div>' +
                '<table class="ucm-territory-table">' +
                    '<thead><tr>' +
                        '<th>#</th>' +
                        '<th>Customer</th>' +
                        '<th style="text-align:right;">Orders</th>' +
                        '<th style="text-align:right;">Total Sales (excl. GST)</th>' +
                    '</tr></thead>' +
                    '<tbody>' + ncRows +
                        '<tr><td></td><td><strong>Total</strong></td><td class="ucm-num"></td>' +
                        '<td class="ucm-num"><strong>' + _ucmTerritoryFmtCurrency(ncTotal) + '</strong></td></tr>' +
                    '</tbody>' +
                '</table>';
        }
    }

    var tillLine = tillSet
        ? '<div class="ucm-territory-tilldate-line">' +
              tillCount + ' / 36 States &amp; UTs &middot; ' +
              ((till && till.total_cities_till_date) || 0) + ' Cities covered till date' +
          '</div>'
        : '';

    return (
        '<div class="ucm-terr-seg-head">' + tillLine + '</div>' +
        '<div class="ucm-terr-tabs">' +
            '<div class="ucm-terr-tab active" data-terr-tab="period">Current Period</div>' +
            '<div class="ucm-terr-tab" data-terr-tab="reach">India Reach</div>' +
            '<div class="ucm-terr-tab" data-terr-tab="category">Category Reach</div>' +
            '<div class="ucm-terr-tab" data-terr-tab="newcust">New Customers</div>' +
        '</div>' +
        '<div class="ucm-terr-panel" data-terr-panel="period">' + periodHtml + '</div>' +
        '<div class="ucm-terr-panel" data-terr-panel="reach" style="display:none;">' + reachHtml + '</div>' +
        '<div class="ucm-terr-panel" data-terr-panel="category" style="display:none;">' + categoryHtml + '</div>' +
        '<div class="ucm-terr-panel" data-terr-panel="newcust" style="display:none;">' + newCustHtml + '</div>'
    );
}

function _ucmRenderTerritoryPanel($panel, rows, tillDateSummary, newCustDetail) {

    _ucmInjectTerritoryReachCSS();

    // Till-date summary per type. New server script returns `by_type`;
    // an old one (no by_type) only has Large Blow numbers at the top level.
    function tillFor(key) {
        if (!tillDateSummary) return null;
        if (tillDateSummary.by_type) {
            return tillDateSummary.by_type[key] ||
                { states_covered_till_date: [], total_cities_till_date: 0 };
        }
        return key === "LARGE BLOW" ? tillDateSummary : null;
    }

    var pillsHtml = '<div class="ucm-terr-seg-pills">';
    var segsHtml = "";
    UCM_TERRITORY_SEGMENTS.forEach(function (seg, idx) {
        pillsHtml += '<div class="ucm-terr-seg-pill' + (idx === 0 ? ' active' : '') +
            '" data-terr-seg="' + seg.id + '">' + frappe.utils.escape_html(seg.label) + '</div>';
        segsHtml += '<div class="ucm-terr-seg" data-terr-seg="' + seg.id + '"' +
            (idx === 0 ? '' : ' style="display:none;"') + '>' +
            _ucmBuildTerritorySegmentHtml(seg, rows, tillFor(seg.key), newCustDetail) +
        '</div>';
    });
    pillsHtml += '</div>';

    var $body = $panel.find(".ucm-cost-slider-body");
    $body.html(pillsHtml + segsHtml);

    // ── Sales Order Type switch (Large Blow / Ultra) ──
    $body.off("click.ucmTerrSeg").on("click.ucmTerrSeg", ".ucm-terr-seg-pill", function () {
        var id = $(this).attr("data-terr-seg");
        $body.find(".ucm-terr-seg-pill").removeClass("active");
        $(this).addClass("active");
        $body.find(".ucm-terr-seg").hide();
        $body.find('.ucm-terr-seg[data-terr-seg="' + id + '"]').show();
    });

    // ── Current Period / India Reach tabs (inside each type) ──
    $body.off("click.ucmTerrTab").on("click.ucmTerrTab", ".ucm-terr-tab", function () {
        var $seg = $(this).closest(".ucm-terr-seg");
        var tab = $(this).attr("data-terr-tab");
        $seg.find(".ucm-terr-tab").removeClass("active");
        $(this).addClass("active");
        $seg.find(".ucm-terr-panel").hide();
        $seg.find('.ucm-terr-panel[data-terr-panel="' + tab + '"]').show();
    });

    // ── State row → city breakup ──
    $body.off("click.ucmTerritory").on("click.ucmTerritory", ".ucm-territory-state-row", function () {
        var $row = $(this);
        var $seg = $row.closest(".ucm-terr-seg");
        var stateId = $row.attr("data-state-id");
        var wasOpen = $row.hasClass("ucm-territory-state-row-open");

        $seg.find(".ucm-territory-state-row-open").each(function () {
            var $openRow = $(this);
            $openRow.removeClass("ucm-territory-state-row-open");
            $openRow.find(".ucm-territory-expand-icon").css("transform", "rotate(0deg)");
            $seg.find('tr.ucm-territory-city-row[data-state-id="' + $openRow.attr("data-state-id") + '"] .ucm-territory-city-slide')
                .css("max-height", "0px");
        });

        if (wasOpen) return;

        $row.addClass("ucm-territory-state-row-open");
        $row.find(".ucm-territory-expand-icon").css("transform", "rotate(90deg)");
        var $slide = $seg.find('tr.ucm-territory-city-row[data-state-id="' + stateId + '"] .ucm-territory-city-slide');
        $slide.css("max-height", $slide[0].scrollHeight + "px");
    });
}


