// CUSTOM SUMMARY PANEL

// The native .report-summary (12 cards) is hidden entirely and replaced with

// a from-scratch panel: 5 key cards + one item-group bar chart, in a 68/32

// flex split. Being a brand-new element (not reusing any Frappe class), it

// can't lose a CSS specificity fight the way restyling .report-summary did.

// Re-scrapes + rebuilds every call, so it always reflects the latest values

// even if Frappe re-renders the native summary asynchronously.

// ═══════════════════════════════════════════════════════════════════════════



var UCM_IGROUP_COLORS = ["#ea580c", "#0d9488"]; // orange, teal green — alternated by rank



function _ucmFindSummaryCard($summary, label) {

    var found = null;

    $summary.find(".summary-item").each(function() {

        var $lbl = $(this).find(".summary-label");

        if (!found && $lbl.length && $lbl.text().trim().replace(/\s+/g, " ") === label) {

            found = $(this);

        }

    });

    if (!found) return { value: 0, el: null };

    var raw = found.find(".summary-value").text();

    var num = parseFloat(String(raw).replace(/[^0-9.\-]/g, "")) || 0;

    return { value: num, el: found };

}



function _ucmMiniCard(label, valueHtml, color, extraClass) {

    return '<div class="ucm-mini-card' + (extraClass ? ' ' + extraClass : '') + '" style="border-top-color:' + color + ';">' +

        '<div class="ucm-mini-card-label">' + label + '</div>' +

        '<div class="ucm-mini-card-value" style="color:' + color + ';">' + valueHtml + '</div>' +

    '</div>';

}



// Builds the "Last Month: ₹X (▲12%)" badge shown under each Sales Order
// Type bar in the breakdown panel — compares this period's amount against
// the same date range shifted back one calendar month (see the "<Type>
// Amount LM" hidden summary cards computed in py.txt).
// lastMonthAmount is `undefined` if no matching "LM" card was found (e.g.
// older report version without the py.txt change) — in that case the
// badge is skipped entirely rather than showing a misleading ₹0.
function _ucmBuildLastMonthBadge(currentAmount, lastMonthAmount, currency) {

    if (lastMonthAmount === undefined) return "";

    lastMonthAmount = lastMonthAmount || 0;

    var changeText = "—";
    var changeColor = "#7a8fa8";

    if (lastMonthAmount > 0) {
        var pct = ((currentAmount - lastMonthAmount) / lastMonthAmount) * 100;
        var arrow = pct >= 0 ? "▲" : "▼";
        changeColor = pct >= 0 ? "#1e8e3e" : "#d93025";
        changeText = arrow + " " + Math.abs(Math.round(pct * 10) / 10) + "%";
    } else if (currentAmount > 0) {
        changeColor = "#1e8e3e";
        changeText = "▲ New";
    }

    return (
        '<div class="ucm-igroup-lm">' +
            '<span class="ucm-igroup-lm-label">Last Month Till Date:</span> ' +
            '<span class="ucm-igroup-lm-value">' + format_currency_nodecimal(lastMonthAmount, currency) + '</span>' +
            ' <span class="ucm-igroup-lm-change" style="color:' + changeColor + ';">(' + changeText + ')</span>' +
        '</div>'
    );

}



function _ucmBuildCustomSummary() {

    var $native = $(".report-summary");

    if (!$native.length || !$native.find(".summary-item").length) return;



