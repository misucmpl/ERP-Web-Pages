                        '<td style="padding:0 8px; border:1px solid #dde8f8; font-weight:800;">All categories</td>' +
                        '<td colspan="2" style="padding:0 8px; border:1px solid #dde8f8; font-weight:800; color:' + sg.color + ';">' + pp.unionCount + ' / ' + total + '</td>' +
