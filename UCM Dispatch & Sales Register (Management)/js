    return html;
}

// ============================================================================
// MONTH NAVIGATION (arrows before From Date filter)
//   ▼ = previous month, ▲ = next month. Click again to keep moving month by
//   month. Sets From Date = 1st of that month, To Date = last day of that
//   month (capped at today for the current month), and the report reloads.
// ============================================================================

function _ucmDsInjectMonthNav(report) {
    if (!document.getElementById("ucm-ds-month-nav-styles")) {
        var style = document.createElement("style");
        style.id = "ucm-ds-month-nav-styles";
        style.innerHTML = `
            .ucm-ds-month-nav {
                display: inline-flex !important;
                flex-direction: row !important;
                align-items: center !important;
                gap: 4px !important;
                margin-right: 8px !important;
                flex: 0 0 auto !important;
            }
            .ucm-ds-month-nav button {
                position: relative;
                border: 1px solid #c5d5ef;
                background: #f0f5ff;
                color: #16233a;
                width: 28px;
                height: 28px;
                line-height: 1;
                font-size: 11px;
                border-radius: 6px;
                padding: 0;
                cursor: pointer;
            }
            .ucm-ds-month-nav button:hover {
                background: #e0ebff;
                border-color: #1a73e8;
                color: #1a73e8;
            }
            .ucm-ds-month-nav button::after {
                content: attr(data-label);
                position: absolute;
                top: calc(100% + 6px);
                left: 0;
                background: #111827;
                color: #ffffff;
                font-size: 11.5px;
                font-weight: 600;
                white-space: nowrap;
                padding: 4px 9px;
                border-radius: 6px;
                opacity: 0;
                pointer-events: none;
                z-index: 1070;
            }
            .ucm-ds-month-nav button:hover::after,
            .ucm-ds-month-nav button:focus-visible::after {
                opacity: 1;
            }
        `;
        document.head.appendChild(style);
    }

    $(".ucm-ds-month-nav").remove();

    var fromField = report.get_filter("from_date");
    if (!fromField) return;

    var $anchor = fromField.$wrapper || $(fromField.wrapper);
    if (!$anchor || !$anchor.length) return;

    var $nav = $(
        '<div class="ucm-ds-month-nav">' +
            '<button type="button" class="ucm-ds-month-up">&#9650;</button>' +
            '<button type="button" class="ucm-ds-month-down">&#9660;</button>' +
        '</div>'
    );
    $anchor.before($nav);

    var refreshLabels = function() {
        $nav.find(".ucm-ds-month-up").attr("data-label", _ucmDsTargetMonthLabel(report, 1));
        $nav.find(".ucm-ds-month-down").attr("data-label", _ucmDsTargetMonthLabel(report, -1));
    };
    refreshLabels();

    $nav.find(".ucm-ds-month-up").on("click", function() { _ucmDsShiftMonth(report, 1); });
    $nav.find(".ucm-ds-month-down").on("click", function() { _ucmDsShiftMonth(report, -1); });
    $nav.find("button").on("mouseenter focus", refreshLabels);
    $nav.find("button").on("click", function() { setTimeout(refreshLabels, 50); });
}

function _ucmDsTargetMonthLabel(report, delta) {
    var current = report.get_filter_value("from_date") || frappe.datetime.month_start();
    return moment(current, "YYYY-MM-DD").add(delta, "months").format("MMMM YYYY");
}

function _ucmDsShiftMonth(report, delta) {
    var current = report.get_filter_value("from_date") || frappe.datetime.month_start();
    var base = moment(current, "YYYY-MM-DD").add(delta, "months");

    var monthEnd = base.clone().endOf("month");
    var today = moment();
    // Current month: To Date stops at today (same as this report's default)
    var toDate = monthEnd.isAfter(today, "day") ? today : monthEnd;

    report.set_filter_value({
        from_date: base.clone().startOf("month").format("YYYY-MM-DD"),
        to_date: toDate.format("YYYY-MM-DD")
    });
}
