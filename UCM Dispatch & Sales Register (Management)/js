  };

  var linkWaiters = {};
  function loadLinkOptions(doctype, cb) {
    if (linkCache[doctype]) { cb(linkCache[doctype]); return; }
    if (linkWaiters[doctype]) { linkWaiters[doctype].push(cb); return; }
    linkWaiters[doctype] = [cb];
    var fields = doctype === "Customer" ? '["name","customer_name"]' : '["name"]';
    var flt = doctype === "Customer" ? "&filters=" + encodeURIComponent('[["disabled","=",0]]') : "";
    fetch("/api/resource/" + encodeURIComponent(doctype) + "?fields=" + encodeURIComponent(fields) + flt +
      "&limit_page_length=0&order_by=name%20asc", { credentials: "same-origin", headers: { Accept: "application/json" } })
      .then(function (r) { return r.ok ? r.json() : { data: [] }; })
      .then(function (j) { linkCache[doctype] = j.data || []; })
      .catch(function () { linkCache[doctype] = []; })
      .then(function () {
        var ws = linkWaiters[doctype] || []; delete linkWaiters[doctype];
        ws.forEach(function (f) { try { f(linkCache[doctype]); } catch (e) { console.error(e); } });
      });
  }

  function resolveLink(doctype, v) {
    v = String(v || "").trim();
    var list = linkCache[doctype];
    if (!v || !list || doctype !== "Customer") return v;
    if (list.some(function (x) { return x.name === v; })) return v;
    var hit = list.find(function (x) { return String(x.customer_name || "").toLowerCase() === v.toLowerCase(); });
    return hit ? hit.name : v;
  }

  /* ───────── Safed dropdown (Link filters ke liye) ───────── */
