    // KPI card variant with a "Last Month: X (▲/▼ %)" line at the bottom.
    // Color based on value comparison: Green for increase, Red for decrease, Blue for equal
    function _kpiCardCompare(label, displayValue, color, currentNum, lastMonthNum, isCurrency) {
        // Determine color based on current vs last month
        var cardColor = color;
        if (typeof currentNum === "number" && typeof lastMonthNum === "number") {
            if (currentNum > lastMonthNum) {
                cardColor = "#1a6e3a";  // Green for profit/increase
            } else if (currentNum < lastMonthNum) {
                cardColor = "#d93025";  // Red for loss/decrease
            } else {
                cardColor = "#1a73e8";  // Blue for neutral/equal
            }
        } else if (typeof currentNum === "number") {
            // If only current value exists, keep original logic
            if (currentNum > 0) {
                cardColor = "#1a6e3a";  // Green
            } else if (currentNum < 0) {
                cardColor = "#d93025";  // Red
            } else {
                cardColor = "#1a73e8";  // Blue
            }
        }
        
        // Determine Last Month value color - OPPOSITE of card to show comparison direction
        var lmColor = "#7a8fa8";  // Default gray
        var lmBgColor = "#fff5f5";  // Default light background
        
        if (typeof currentNum === "number" && typeof lastMonthNum === "number") {
            if (currentNum > lastMonthNum) {
                // Card is GREEN (increase) → Last Month should be RED (showing it was lower)
                lmColor = "#d93025";  // Red text
                lmBgColor = "#fef2f2";  // Light red background
            } else if (currentNum < lastMonthNum) {
                // Card is RED (decrease) → Last Month should be GREEN (showing it was higher)
                lmColor = "#1a6e3a";  // Green text
                lmBgColor = "#f0fdf4";  // Light green background
            } else {
                // Card is BLUE (equal) → Last Month should be BLUE (both equal)
                lmColor = "#1a73e8";  // Blue text
                lmBgColor = "#eff6ff";  // Light blue background
            }
        }
        
        var lmDisplay = (typeof lastMonthNum === "number")
            ? (isCurrency ? _fmtCurrency(lastMonthNum) : Math.round(lastMonthNum).toLocaleString('en-IN'))
            : null;
        var badge = (typeof lastMonthNum === "number")
            ? _ucmChangeBadge(currentNum, lastMonthNum)
            : '<span style="color:#9aa5b5;">—</span>';

        return '<div style="flex:1; min-width:150px; border:1px solid #dde8f8; border-top:4px solid ' + cardColor + '; ' +
            'border-radius:10px; padding:18px 20px; background:#fff;">' +
                '<div style="font-size:12px; font-weight:700; color:#7a8fa8; text-transform:uppercase; margin-bottom:8px; letter-spacing:0.03em;">' + label + '</div>' +
                '<div style="font-size:24px; font-weight:800; color:' + cardColor + '; margin-bottom:10px;">' + displayValue + '</div>' +
                '<div style="font-size:13px; display:flex; justify-content:space-between; align-items:center; ' +
                    'border-top:2px solid #ffe0e0; padding-top:10px; font-weight:700; background:' + lmBgColor + '; padding:10px; border-radius:6px; margin-top:8px;">' +
                    '<span>Last Month: ' + (lmDisplay !== null ? '<span style="color:' + lmColor + '; font-weight:900; font-size:14px;">' + lmDisplay + '</span>' : "—") + '</span>' +
                    '<span style="font-size:14px;">' + badge + '</span>' +
                '</div>' +
            '</div>';
    }

    // Generic helper: calls a whitelisted method once for the current
    // from_date/to_date, and again for the same range shifted back one
    // month, then hands both result sets to the callback. Used for
    // category-wise and customer-wise month comparisons — reuses the
    // existing whitelisted APIs, no new backend endpoint.
    function _ucmFetchCurrentAndLastMonth(method, extraArgs, callback) {
        var fromDate = frappe.query_report.get_filter_value("from_date");
        var toDate   = frappe.query_report.get_filter_value("to_date");

        if (!fromDate || !toDate) { callback([], []); return; }

        var lmFrom = _ucmShiftDateLastMonth(fromDate);
        var lmTo   = _ucmShiftDateLastMonth(toDate);

        frappe.call({
            method: method,
            args: Object.assign({ from_date: fromDate, to_date: toDate }, extraArgs || {}),
            callback: function (r1) {
                var current = r1.message || [];
                frappe.call({
                    method: method,
                    args: Object.assign({ from_date: lmFrom, to_date: lmTo }, extraArgs || {}),
                    callback: function (r2) { callback(current, r2.message || []); },
                    error: function () { callback(current, []); }
                });
            },
            error: function () { callback([], []); }
        });
    }

    // ── UCM: detail data for PDF (same API the acquisition slider uses) ─────
    function _ucmFetchAcqDetail(fromDate, toDate, company, callback) {
        var months = [];
        var y = parseInt(fromDate.substr(0, 4), 10), m = parseInt(fromDate.substr(5, 2), 10);
        var ty = parseInt(toDate.substr(0, 4), 10), tm = parseInt(toDate.substr(5, 2), 10);
        while (y < ty || (y === ty && m <= tm)) {
            months.push({ year: y, month: m });
            m++; if (m > 12) { m = 1; y++; }
        }
        var types = ["new", "repeat"];
        var total = months.length * types.length, done = 0;
        var out = { "new": {}, "repeat": {} };
        if (!total) { callback(null); return; }
        function finish() { if (++done === total) callback(out); }
        months.forEach(function (mm) {
            types.forEach(function (t) {
                frappe.call({
                    method: "ucm_customer_acquisition_detail",
                    type: "GET",
                    args: { year: String(mm.year), month: mm.month, company: company, customer_type: t },
                    callback: function (r) {
                        var res = (r && r.message) || {};
                        ["ultra", "large_blow"].forEach(function (seg) {
                            var list = (res[seg] && res[seg].customers) || [];
                            out[t][seg] = out[t][seg] || {};
                            list.forEach(function (c) {
                                var id = c.customer_id || c.customer_name;
                                var cur = out[t][seg][id] || { name: c.customer_name || c.customer_id, orders: 0, sales: 0 };
                                cur.orders += c.order_count || 0;
                                cur.sales += c.total_sales || 0;
                                out[t][seg][id] = cur;
                            });
                        });
                        finish();
                    },
                    error: function () { finish(); }
                });
            });
        });
    }

    // Counts per segment. A customer new in one month is not also counted as repeat.
    function _ucmAcqSegCounts(detail) {
        if (!detail) return null;
        function pick(seg) {
            var n = (detail["new"] && detail["new"][seg]) || {};
            var rp = (detail["repeat"] && detail["repeat"][seg]) || {};
            var nNew = Object.keys(n).length, nRep = 0;
            Object.keys(rp).forEach(function (id) { if (!n[id]) nRep++; });
            return { "new": nNew, repeat: nRep, total: nNew + nRep };
        }
        return { ultra: pick("ultra"), blow: pick("large_blow") };
    }

    // Category Reach page: category name + States Reached (out of 36), Ultra and Large Blow.
    // Same data/logic as the "Category Reach" tab of the Territory slider.
    // Ultra: "Poly Wad" and "EP Ring" categories are hidden. Always fits ONE page.
    function _slideCategoryReach(tillSummary) {
        if (!tillSummary) return "";
        var segs = [
            { key: "ULTRA", label: "Ultra", color: "#1a73e8" },
            { key: "LARGE BLOW", label: "Large Blow", color: "#7b3fa0" }
        ];
        var total = UCM_INDIA_ALL.length;
        var MAX_ROWS = 24;
        function tillFor(key) {
            if (tillSummary.by_type) return tillSummary.by_type[key] || null;
            return key === "LARGE BLOW" ? tillSummary : null;
        }
        // Categories hidden for a segment (Ultra: Poly Wad, EP Ring)
        function isExcluded(segKey, name) {
            return _ucmIsHiddenUltraCategory(segKey, name, true);
        }
        function prepare(sg) {
            var till = tillFor(sg.key);
            var list = till && till.category_reach;
            if (!list) return { sg: sg, msg: "Category data not available." };
            var union = {};
            var cats = [];
            list.forEach(function (c) {
                if (isExcluded(sg.key, c.category)) return;
                var merged = {}, amt = 0;
                Object.keys(c.states || {}).forEach(function (st) {
                    var key = _ucmCanonicalState(st) || (String(st || "").trim() || "Unknown");
                    var v = parseFloat(c.states[st]) || 0;
                    merged[key] = (merged[key] || 0) + v;
                    amt += v;
                });
                var reached = 0;
                Object.keys(merged).forEach(function (k) {
                    if (UCM_INDIA_ALL.indexOf(k) !== -1) { reached++; union[k] = true; }
                });
                cats.push({ name: c.category || "Uncategorized", reached: reached, total: amt });
            });
            if (!cats.length) return { sg: sg, msg: "No category sales found for this period." };
            cats.sort(function (a, b) { return b.total - a.total; });
            return { sg: sg, cats: cats, unionCount: Object.keys(union).length };
        }
        var preps = segs.map(prepare);
        // Shrink row height as needed so everything stays on one page
        var maxRows = 0;
        preps.forEach(function (pp) { if (pp.cats) maxRows = Math.max(maxRows, Math.min(pp.cats.length, MAX_ROWS)); });
        var rowPx = Math.max(19, Math.min(30, Math.floor(500 / (maxRows + 2))));
        var fontPx = rowPx >= 27 ? 13 : (rowPx >= 22 ? 12 : 11);
        function render(pp) {
