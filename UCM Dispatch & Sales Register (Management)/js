// ── Build the profit breakup horizontal bar chart ───────────────────────────

// A bar chart reads better than a pie here: many similarly-sized customers

// are hard to compare as wedges, and profit can go negative — which a pie

// can't represent honestly but a bar chart shows naturally (red, opposite side).

// Reuses the exact same card/rank/track/share markup as the left sales list

// (.ucm-party-card etc.) so both columns look consistent — only the color

// changes (green for profit, red for loss) instead of a rank-based rainbow.

function _ucmBuildProfitBarChart(profitList, currency, grandProfitTotal) {

    var $wrap = $('<div class="ucm-profit-bar-wrap"></div>');



    $wrap.append(

        '<div class="ucm-profit-bar-total">Total Profit&nbsp;<b>' + format_currency_nodecimal(grandProfitTotal, currency) + '</b></div>'

    );



    var maxAbs = profitList.reduce(function(m, p) { return Math.max(m, Math.abs(p.amount)); }, 0) || 1;

    var totalAbs = profitList.reduce(function(s, p) { return s + Math.abs(p.amount); }, 0) || 1;



    var $list = $('<div class="ucm-party-list"></div>');

    profitList.forEach(function(p, idx) {

        var isNeg = p.amount < 0;

        var pct = Math.max(20, Math.round((Math.abs(p.amount) / maxAbs) * 100));

        var sharePct = Math.round((Math.abs(p.amount) / totalAbs) * 1000) / 10;

        var barColor = isNeg ? "#c0392b" : "#1a6e3a";

        $list.append(

            '<div class="ucm-party-card">' +

                '<div class="ucm-party-rank" style="background:' + barColor + ' !important;color:#fff !important;">' + (idx + 1) + '</div>' +

                '<div class="ucm-party-main">' +

                    '<div class="ucm-party-row-top">' +

                        '<span class="ucm-party-name">' + frappe.utils.escape_html(p.name) + '</span>' +

                        '<span class="ucm-party-amt" style="color:' + barColor + ';">' + format_currency_nodecimal(p.amount, currency) + '</span>' +

