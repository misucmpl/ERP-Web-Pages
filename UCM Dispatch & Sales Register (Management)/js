            var head = '<div style="font-size:17px; font-weight:800; color:' + sg.color + '; margin-bottom:8px; padding-bottom:6px; border-bottom:2px solid ' + sg.color + ';">' +
                frappe.utils.escape_html(sg.label) + '</div>';
