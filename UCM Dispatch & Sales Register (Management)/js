// "New Customers" tab: first-time customers in the selected period, per
// sales order type (Ultra / Large Blow). If a specific type was clicked only
// that type shows; on "All Types" both render stacked.
function _ucmLoadNewCustomers(specificSotName, $panel) {
    var $wrap = $panel.find(".ucm-sot-newcust-wrap");
    _ucmFetchNewCustomersDetail(function (detail) {
        if (!$panel.closest("body").length) return;
        if (!detail) {
            $wrap.html('<div class="ucm-sot-slider-empty">No new customer data available for this period.</div>');
            return;
        }
        var currency = (_ucmSotDetailData && _ucmSotDetailData.currency) || frappe.defaults.get_default("currency");
        var COLORS = { ultra: "#1a73e8", large_blow: "#7b3fa0" };
        var segs = [
            { key: "ultra", label: "Ultra" },
            { key: "large_blow", label: "Large Blow" }
        ];
        if (specificSotName) {
            var want = String(specificSotName).toUpperCase().replace(/[^A-Z]/g, "");
            segs = segs.filter(function (sg) { return sg.label.toUpperCase().replace(/[^A-Z]/g, "") === want; });
        }
        var html = "";
        segs.forEach(function (sg) {
            var map = detail[sg.key] || {};
            var list = Object.keys(map).map(function (k) { return map[k]; })
                .sort(function (a, b) { return b.sales - a.sales; });
            var total = list.reduce(function (t, c) { return t + (c.sales || 0); }, 0);
            var maxAmt = list.reduce(function (m, c) { return Math.max(m, c.sales || 0); }, 0) || 1;
            var color = COLORS[sg.key];
            html += '<div class="ucm-sot-category-sticky" style="position:static; margin:0 0 12px; padding:0 0 12px;">' +
                '<div class="ucm-sot-profit-row" style="margin:0;">' +
                    '<div class="ucm-sot-profit-item">' +
                        '<div class="ucm-sot-profit-label">' + frappe.utils.escape_html(sg.label) + ' New Customers</div>' +
                        '<div class="ucm-sot-profit-value" style="color:' + color + ';">' + list.length + '</div>' +
                    '</div>' +
                    '<div class="ucm-sot-profit-item">' +
                        '<div class="ucm-sot-profit-label">Total Sales</div>' +
                        '<div class="ucm-sot-profit-value" style="color:' + color + ';">' + format_currency_nodecimal(total, currency) + '</div>' +
                    '</div>' +
                '</div></div>';
            if (!list.length) {
                html += '<div class="ucm-sot-slider-empty">No new ' + frappe.utils.escape_html(sg.label) + ' customers in this period.</div>';
                return;
            }
            html += '<div class="ucm-sot-category-list" style="margin-bottom:20px;">';
            list.forEach(function (c) {
                var barPct = Math.max(4, Math.round(((c.sales || 0) / maxAmt) * 100));
                html += '<div class="ucm-sot-row" style="--ucm-sot-row-color:' + color + ';">' +
                    '<div class="ucm-sot-row-top">' +
                        '<span class="ucm-sot-row-label">' + frappe.utils.escape_html(c.name || "Unknown Customer") + '</span>' +
                        '<span class="ucm-sot-row-value">' + format_currency_nodecimal(c.sales || 0, currency) + '</span>' +
                    '</div>' +
                    '<div class="ucm-sot-row-track"><div class="ucm-sot-row-fill" style="width:' + barPct + '%;"></div></div>' +
                    '<span class="ucm-sot-row-pct">' + c.orders + ' orders</span>' +
                '</div>';
            });
            html += '</div>';
        });
        $wrap.html(html || '<div class="ucm-sot-slider-empty">No new customers in this period.</div>');
    });
}

