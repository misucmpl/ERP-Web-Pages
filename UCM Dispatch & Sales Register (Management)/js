// COST BREAKUP SUMMARY (Raw Material / Packing / Manufacturing)

// Fills the "Total Cost (COGS)" full-width card with the 3-part split

// instead of a flat total. Sourced from Sales Invoice, same date/customer

// filters as the other summary cards and the party-wise sales card, so it

// stays a stable "actual sales" view no matter which tab (DN/SI) is active

// in the table below.

// ═══════════════════════════════════════════════════════════════════════════



// ⚠ Update this to wherever you placed ucm_cost_breakup_summary in your app,

// e.g. "your_app.api.ucm_cost_breakup_summary"

var UCM_COST_BREAKUP_SUMMARY_METHOD = "aggregated_cost_summary_api";



var _ucmCostBreakupCache = null;

var _ucmCostBreakupRequestId = 0;

var _ucmSotDetailData = null;

// ── Custom currency formatting WITHOUT decimal places ──
function format_currency_nodecimal(value, currency) {
    var formatted = format_currency(value || 0, currency);
    // Remove decimal part (.00, .50, etc.)
    return formatted.replace(/\.\d+$/, '');
}



function _ucmFetchCostBreakupSummary(callback) {

    var fromDate = frappe.query_report.get_filter_value("from_date");

    var toDate   = frappe.query_report.get_filter_value("to_date");

    var customer   = frappe.query_report.get_filter_value("customer");

    var itemGroup  = frappe.query_report.get_filter_value("item_group");

    if (!fromDate || !toDate) {

        callback(null);

        return;

    }



    // Guard against a slower earlier request overwriting a later one when

    // filters are changed quickly in succession — same pattern used for the

    // party-wise sales card above.

    _ucmCostBreakupRequestId++;

    var requestId = _ucmCostBreakupRequestId;



    frappe.call({

        method: UCM_COST_BREAKUP_SUMMARY_METHOD,

        args: {

            from_date: fromDate,

            to_date: toDate,

            customer: customer || undefined,

            item_group: itemGroup || undefined

        },

        callback: function(r) {

            if (requestId !== _ucmCostBreakupRequestId) return; // stale response

            _ucmCostBreakupCache = r.message || null;

            callback(_ucmCostBreakupCache);

        },

        error: function() {

            if (requestId !== _ucmCostBreakupRequestId) return;

            _ucmCostBreakupCache = null;

            callback(null);

        }

    });

}



// Builds the "Total Cost (COGS)" full-width card — reuses the exact same

// .ucm-order-details-* markup/CSS as the Order Details card above it, so no

// new CSS is needed and the visual layout doesn't change. Falls back to the

// flat total (old placeholder behaviour) if the breakup hasn't loaded yet.

function _ucmBuildCostBreakupCard(totalCostValue, currency) {

    var breakup = _ucmCostBreakupCache;



    if (!breakup) {

        return _ucmMiniCard("Total Cost (COGS)", format_currency_nodecimal(totalCostValue, currency), "#e65100", "ucm-mini-card-full");

    }



    var rm      = breakup.raw_material_cost || 0;

    var pkg     = breakup.packaging_cost || 0;

    var dispatchPkg = breakup.dispatch_packaging_cost || 0;

    // Manufacturing-side packing isn't returned separately by the API — it's
    // derived here as the remainder: Total Packing (pkg) minus the Dispatch
    // Packing portion we do get explicitly, so "Manufacturing Packing +
    // Dispatch Packing" always adds back up to exactly "Total Packing".
    var mfgPkg  = pkg - dispatchPkg;

    var mfg     = breakup.manufacturing_cost || 0;

    var trading = breakup.trading_goods_cost || 0;

    var unc     = breakup.truly_unclassified_cost || 0;

    var total   = breakup.total_cogs || totalCostValue;



    var parts =

        '<div class="ucm-order-details-half">' +

            '<div class="ucm-order-details-value" style="color:#3d5170;">' + format_currency_nodecimal(rm, currency) + '</div>' +

            '<div class="ucm-order-details-sub">Raw Material</div>' +

        '</div>';



    // When there's a dispatch-packing component, break "Packing" out into
    // Manufacturing Packing (x) + Dispatch Packing (y) = Total Packing,
    // shown as three boxes so the formula is visible at a glance. With no
    // dispatch packing for this period, just show the single "Packing" box
    // as before — no point splitting a zero out.
    if (dispatchPkg > 0.01) {

        parts +=

            '<div class="ucm-order-details-vdiv"></div>' +

            '<div class="ucm-order-details-half">' +

                '<div class="ucm-packing-stack">' +

                    '<div class="ucm-packing-stack-row">' +
                        '<div class="ucm-packing-stack-value" style="color:#0d9488;">' + format_currency_nodecimal(mfgPkg, currency) + '</div>' +
                        '<div class="ucm-packing-stack-label">Manufacturing Packing</div>' +
                    '</div>' +

                    '<div class="ucm-packing-stack-row">' +
                        '<div class="ucm-packing-stack-value" style="color:#0891b2;">' + format_currency_nodecimal(dispatchPkg, currency) + '</div>' +
                        '<div class="ucm-packing-stack-label">Dispatch Packing</div>' +
                    '</div>' +

                    '<div class="ucm-packing-stack-row ucm-packing-stack-total">' +
                        '<div class="ucm-packing-stack-value" style="color:#0e7490;">' + format_currency_nodecimal(pkg, currency) + '</div>' +
                        '<div class="ucm-packing-stack-label">Total Packing</div>' +
                    '</div>' +

                '</div>' +

            '</div>';

    } else {

        parts +=

            '<div class="ucm-order-details-vdiv"></div>' +

            '<div class="ucm-order-details-half">' +

                '<div class="ucm-order-details-value" style="color:#0d9488;">' + format_currency_nodecimal(pkg, currency) + '</div>' +

                '<div class="ucm-order-details-sub">Packing</div>' +

            '</div>';

    }



    parts +=

        '<div class="ucm-order-details-vdiv"></div>' +

        '<div class="ucm-order-details-half">' +

            '<div class="ucm-order-details-value" style="color:#7b1fa2;">' + format_currency_nodecimal(mfg, currency) + '</div>' +

            '<div class="ucm-order-details-sub">Manufacturing</div>' +

        '</div>' +

        '<div class="ucm-order-details-vdiv"></div>' +

        '<div class="ucm-order-details-half">' +

            '<div class="ucm-order-details-value" style="color:#2563eb;">' + format_currency_nodecimal(trading, currency) + '</div>' +

            '<div class="ucm-order-details-sub">Trading Goods</div>' +

        '</div>';



    if (unc > 0.01) {

        parts +=

            '<div class="ucm-order-details-vdiv"></div>' +

            '<div class="ucm-order-details-half">' +

                '<div class="ucm-order-details-value ucm-order-pending-value">' + format_currency_nodecimal(unc, currency) + '</div>' +

                '<div class="ucm-order-details-sub">Unclassified</div>' +

            '</div>';

    }



    return (

        '<div class="ucm-mini-card ucm-mini-card-full" style="border-top-color:#e65100;">' +

            '<div class="ucm-mini-card-label ucm-cogs-card-title">Total Cost (COGS) — ' + format_currency_nodecimal(total, currency) + '</div>' +

            '<div class="ucm-order-details-body">' + parts + '</div>' +

        '</div>'

    );

}



// Builds the compact COGS breakdown (RM/Packing/Mfg/Trading/Unclassified/

// Total) shown under a single Sales Order Type bar (e.g. "Ultra",

// "Large Blow") in the right-hand chart column. Looks up the segment inside

// the same aggregated_cost_summary_api response already cached for the main

// Total Cost (COGS) card — no extra API call. Matches segmentName against

// by_sales_order_type case-insensitively, since the chart's group names are

// title-case ("Ultra") while the API keys are upper-case ("ULTRA").

function _ucmBuildSegmentCogsBlock(segmentName, currency) {

    var byType = _ucmCostBreakupCache && _ucmCostBreakupCache.by_sales_order_type;

    if (!byType) return "";



    var seg = null;

    for (var key in byType) {

        if (byType.hasOwnProperty(key) && key.toUpperCase() === String(segmentName).toUpperCase()) {

            seg = byType[key];

            break;

        }

    }

    if (!seg) return "";



    var pkgTotal = seg.packaging_cost || 0;

    var rows = [
        { label: "Raw Material",  value: seg.raw_material_cost || 0,   color: "#3d5170" },
        { label: "Packing",       value: pkgTotal,                     color: "#0d9488" }
    ];

    rows.push(
        { label: "Manufacturing", value: seg.manufacturing_cost || 0,  color: "#7b1fa2" },
        { label: "Trading Goods", value: seg.trading_goods_cost || 0,  color: "#2563eb" },
        { label: "Unclassified",  value: seg.unclassified_cost || 0,   color: "#c62828" },
        { label: "Total COGS",    value: seg.total_cogs || 0,          color: "#e65100" }
    );



    var html = '<div class="ucm-igroup-cogs">';

    rows.forEach(function(row) {

        if (row.label === "Unclassified" && row.value <= 0.01) return;

        html +=

            '<div class="ucm-igroup-cogs-row' + ((row.label === "Total COGS" || row.bold) ? " ucm-igroup-cogs-total" : "") + '">' +

                '<span class="ucm-igroup-cogs-label">' + row.label + '</span>' +

                '<span class="ucm-igroup-cogs-value" style="color:' + row.color + ';">' + format_currency_nodecimal(row.value, currency) + '</span>' +

            '</div>';

    });

    html += '</div>';

    return html;

}



// Builds and shows the "Sales Order Type Breakdown — Details" popup for the

