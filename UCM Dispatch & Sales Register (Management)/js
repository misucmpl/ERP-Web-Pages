    // Territory Coverage page: green = covered this period, red = not covered.
    // Overall (Ultra + Large Blow) plus each segment. Same Sales Invoice data as the slider.
    function _slideTerritoryCoverage(rows) {
        if (!rows) return "";
        var segs = [
            { key: "ULTRA", label: "Ultra", color: "#1a73e8" },
            { key: "LARGE BLOW", label: "Large Blow", color: "#7b3fa0" }
        ];
        var infos = segs.map(function (sg) {
            var terr = _ucmComputeTerritoryData(rows, sg.key);
            var covered = {};
            Object.keys(terr.states).forEach(function (n) {
                var c = _ucmCanonicalState(n);
                if (c) covered[c] = true;
            });
            return { label: sg.label, color: sg.color, terr: terr, covered: covered };
        });
        var overall = { label: "Overall (Ultra + Large Blow)", color: "#0b1424", covered: {}, sales: 0, cities: 0 };
        var citySeen = {};
        infos.forEach(function (inf) {
            overall.sales += inf.terr.totalSales;
            Object.keys(inf.covered).forEach(function (k) { overall.covered[k] = true; });
            Object.keys(inf.terr.states).forEach(function (st) {
                Object.keys(inf.terr.states[st].cities).forEach(function (ct) { citySeen[st + "||" + ct] = true; });
            });
        });
        overall.cities = Object.keys(citySeen).length;
        infos.forEach(function (inf) { inf.sales = inf.terr.totalSales; inf.cities = inf.terr.totalCities; });

        function chip(name, isCov) {
            return '<span style="display:inline-block; margin:2px 3px 2px 0; padding:2px 8px; border-radius:11px; font-size:10.5px; font-weight:700; ' +
