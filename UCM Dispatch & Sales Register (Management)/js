    var args = Object.assign({}, opts.args || {});

    // Report ka data ab report se nahi, Server Script API se aata hai
    if (method === RUN_METHOD) {
      var f = args.filters;
      if (typeof f === "string") { try { f = JSON.parse(f); } catch (e) { f = {}; } }
      if (args.report_name === REPORT_NAME) {
        method = DATA_METHOD;
        args = Object.assign({}, f || {});   // filters alag-alag arguments mein
      } else {
        args.filters = f || {};
      }
    }

    var p = request(method, args, String(opts.type || "POST").toUpperCase() === "GET").then(
      function (msg) {
        var r = { message: msg };
        if (opts.callback) { try { opts.callback(r); } catch (e) { console.error(e); } }
        return r;
      },
      function (err) {
