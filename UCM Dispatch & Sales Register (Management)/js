    // ✅ UNIFIED CATEGORY EXTRACTION - Global function used by all slides
 function _extractCategoryFromProduct(itemName) {
    if (!itemName) return "Uncategorized";
    var name = String(itemName).toUpperCase();

    // ✅ SLEEVE CHECK PEHLE (Highest Priority!)
    if (name.indexOf("SLEEVE") !== -1) return "SLEEVEBOX";  // ← ANY sleeve product
    
    // ✅ THEN specific products
    if (name.indexOf("PALLET") !== -1 || name.indexOf("TROLLEY") !== -1) return "PALLET";
    
    // ✅ THEN traffic/safety
    if (name.indexOf("CONE") !== -1 || name.indexOf("TRAFFIC") !== -1) return "TRAFFIC CONE";
    if (name.indexOf("BARRIER") !== -1 || name.indexOf("BARRICADE") !== -1) return "ROAD BARRIER";
    if (name.indexOf("BOLLARD") !== -1 || name.indexOf("POST") !== -1) return "BOLLARD";

    // Rest of categories...
    if (name.indexOf("15GM") !== -1) return "15GM";
    if (name.indexOf("28MM") !== -1) return "28MM";
    if (name.indexOf("20MM") !== -1) return "20MM";
    if (name.indexOf("10MM") !== -1) return "10MM";
    if (name.indexOf("5MM") !== -1) return "5MM";
    if (name.indexOf("30MM") !== -1) return "30MM";
    if (name.indexOf("50GM") !== -1) return "50GM";
    if (name.indexOf("100ML") !== -1) return "100ML";
    if (name.indexOf("COSMETICS") !== -1) return "COSMETICS";
    if (name.indexOf("PHARMA") !== -1) return "PHARMA";
    if (name.indexOf("EDIBLE OIL") !== -1) return "EDIBLE OIL";
    if (name.indexOf("BASE") !== -1 || name.indexOf("ECO BASE") !== -1) return "Base";
    if (name.indexOf("CHAIR") !== -1 || name.indexOf("TABLE") !== -1 || name.indexOf("FURNITURE") !== -1) return "FURNITURE";
    if (name.indexOf("JAR") !== -1 || name.indexOf("CAP") !== -1) return "JARS & CAPS";
    if (name.indexOf("BOTTLE") !== -1) return "BOTTLES";
    if (name.indexOf("CONTAINER") !== -1) return "CONTAINERS";
    if (name.indexOf("BOX") !== -1) return "BOXES";

    return "Uncategorized";
}
    // ✅ MAP category codes to segment names (for Target vs Actual slide)
    function _mapCategoryToSegment(category) {
        var categoryUpper = String(category || "").toUpperCase();

        if (categoryUpper === "SLEEVEBOX") return "FLC Boxes (Sleeve box)";
        if (categoryUpper === "BASE") return "Water Tank (Base)";
        if (categoryUpper === "PALLET") return "Pallets & Trolley";
        if (categoryUpper === "TRAFFIC CONE" || categoryUpper === "ROAD BARRIER" || categoryUpper === "BOLLARD")
            return "Road Safety";
        if (categoryUpper === "FURNITURE") return "Furniture";

        return null; // Not a Large Blow segment
    }

    var UCM_TARGET_PER_SEGMENT = {
        "FLC Boxes (Sleeve box)": 15000000,
        "Water Tank (Base)":      15000000,
        "Pallets & Trolley":      7500000,
        "Furniture":              7500000,    // ✅ UPDATED: 0.75 Cr (₹75 Lakhs)
        "Road Safety":            5000000     // ✅ 0.5 Cr (₹50 Lakhs)
    };

    var UCM_SEGMENT_KEYWORDS = {
        "FLC Boxes (Sleeve box)": ["SLEEVE"],
        "Water Tank (Base)":      ["BASE"],
        "Pallets & Trolley":      ["PALLET", "TROLLEY"],
        "Furniture":              ["TABLE", "FURNITURE", "CHAIR", "STOOL"],
        "Road Safety":            ["CONE", "BARRIER", "BOLLARD"]  // Traffic cones & road barriers
    };

    // ✅ FIXED: Use unified category extraction
    // ── "Others" — naye products jinka segment abhi decide nahi hua.
    //    Target nahi hai, sirf Actual dikhega. Segment decide hone par yahan se
    //    hata kar UCM_TARGET_PER_SEGMENT / _mapCategoryToSegment mein daal dena.
    var UCM_OTHERS_SEGMENT = "Others";
    var UCM_OTHERS_KEYWORDS = ["TASLA", "PORTABLE TOILET", "DUSTBIN"];

    function _ucmIsOthersItem(row) {
        var txt = (String(row.item_name || "") + " " + String(row.item_code || "")).toUpperCase();
        return UCM_OTHERS_KEYWORDS.some(function (k) { return txt.indexOf(k) !== -1; });
    }

    function _ucmComputeLiveSegmentActuals(rows) {
        rows = rows || [];
        var totals = {};
        Object.keys(UCM_TARGET_PER_SEGMENT).forEach(function (seg) { totals[seg] = 0; });
        totals[UCM_OTHERS_SEGMENT] = 0;

        rows.forEach(function (row) {
            var type = (row.custom_sales_order_type || "").toUpperCase();
            if (type !== "LARGE BLOW") return;

            // Others pehle check — taaki ye kisi aur segment mein na chale jaayein
            if (_ucmIsOthersItem(row)) {
                totals[UCM_OTHERS_SEGMENT] += row.amount || 0;
                return;
            }

            var itemName = row.item_name || row.item_code || "";
            var category = _extractCategoryFromProduct(itemName);
            var segment = _mapCategoryToSegment(category);

            if (segment) {
                totals[segment] += row.amount || 0;
            }
        });

        return { totals: totals, needsReviewTotal: 0, needsReviewItems: {} };
    }
    function _slideTargetVsActual(sotRows, siRows) {
        var ultraLive = null;
        for (var i = 0; i < (sotRows || []).length; i++) {
            if (String(sotRows[i].name).toUpperCase() === "ULTRA") {
                ultraLive = sotRows[i].amount || 0;
                break;
            }
        }

        var liveSegmentActuals = _ucmComputeLiveSegmentActuals(siRows).totals;
        var rows = [
            { segment: "Caps & Closures (Ultra)", target: UCM_SALES_TARGETS["Ultra"], actual: ultraLive, isLive: true, hasData: ultraLive !== null }
        ];

        Object.keys(UCM_TARGET_PER_SEGMENT).forEach(function (segName) {
            rows.push({
                segment: segName,
                target: UCM_TARGET_PER_SEGMENT[segName],
                actual: liveSegmentActuals[segName] || 0,
                isLive: true,
                hasData: true
            });
        });

        // Others: koi target nahi, % nahi — sirf Actual
        rows.push({
            segment: UCM_OTHERS_SEGMENT + " (Tasla, Portable Toilet, Dustbin)",
            target: null,
            actual: liveSegmentActuals[UCM_OTHERS_SEGMENT] || 0,
            noTarget: true
        });

        var targetRows  = rows.filter(function (r) { return !r.noTarget; });
        var totalTarget = targetRows.reduce(function (s, r) { return s + r.target; }, 0);
        var targetActual = targetRows.reduce(function (s, r) { return s + (r.actual || 0); }, 0);
        var totalActual = rows.reduce(function (s, r) { return s + (r.actual || 0); }, 0);
        // Achievement % sirf target wale segments par (Others shamil nahi)
        var totalPct = totalTarget ? Math.round((targetActual / totalTarget) * 1000) / 10 : 0;

        var inner = '<table style="width:100%; border-collapse:collapse; font-size:14.5px;">' +
            '<thead><tr style="background:#f0f5ff;">' +
                '<th style="text-align:left; padding:12px 16px; border:1px solid #dde8f8;">Segment</th>' +
                '<th style="text-align:right; padding:12px 16px; border:1px solid #dde8f8;">Target</th>' +
                '<th style="text-align:right; padding:12px 16px; border:1px solid #dde8f8;">Actual</th>' +
                '<th style="text-align:right; padding:12px 16px; border:1px solid #dde8f8;">Achievement %</th>' +
            '</tr></thead><tbody>';

        rows.forEach(function (r) {
            if (r.noTarget) {
                inner += '<tr style="background:#fafbfd;">' +
                    '<td style="padding:11px 16px; border:1px solid #eef1f6; font-weight:600;">' + frappe.utils.escape_html(r.segment) + '</td>' +
                    '<td style="padding:11px 16px; border:1px solid #eef1f6; text-align:right; color:#9aa5b5;">—</td>' +
                    '<td style="padding:11px 16px; border:1px solid #eef1f6; text-align:right;">' + _fmtCurrency(r.actual || 0) + '</td>' +
                    '<td style="padding:11px 16px; border:1px solid #eef1f6; text-align:right; color:#9aa5b5;">—</td>' +
                '</tr>';
                return;
            }
            var pct = r.target ? Math.round(((r.actual || 0) / r.target) * 1000) / 10 : 0;
            var color = pct >= 100 ? "#1a6e3a" : (pct >= 70 ? "#1a73e8" : "#c62828");
        inner += '<tr>' +
    '<td style="padding:11px 16px; border:1px solid #eef1f6; font-weight:600;">' +
        frappe.utils.escape_html(r.segment) + 
    '</td>' +
    '<td style="padding:11px 16px; border:1px solid #eef1f6; text-align:right;">' + _fmtCurrency(r.target) + '</td>' +
    '<td style="padding:11px 16px; border:1px solid #eef1f6; text-align:right;">' + _fmtCurrency(r.actual || 0) + '</td>' +
    '<td style="padding:11px 16px; border:1px solid #eef1f6; text-align:right; font-weight:700; color:' + color + ';">' + pct + '%</td>' +
'</tr>';
        });

        inner += '<tr style="background:#f0f5ff;">' +
                '<td style="padding:11px 16px; border:1px solid #dde8f8; font-weight:800;">TOTAL</td>' +
                '<td style="padding:11px 16px; border:1px solid #dde8f8; text-align:right; font-weight:800;">' + _fmtCurrency(totalTarget) + '</td>' +
                '<td style="padding:11px 16px; border:1px solid #dde8f8; text-align:right; font-weight:800;">' + _fmtCurrency(totalActual) + '</td>' +
                '<td style="padding:11px 16px; border:1px solid #dde8f8; text-align:right; font-weight:800;">' + totalPct + '%</td>' +
            '</tr>' +
            '</tbody></table>';

        inner += '<div style="font-size:11px; color:#9aa5b5; margin-top:18px; font-style:italic;">' +
            'Note: All segments are now live. "Caps &amp; Closures (Ultra)" comes from the Ultra sales-order-type total; ' +
            'the other 4 segments are matched from product names within Large Blow ' +
            '(FLC → FLC Boxes, BASE → Water Tank, PALLET/TROLLEY → Pallets &amp; Trolley, TABLE/FURNITURE → Furniture). ' +
            'Targets remain fixed reference figures. ' +
            '"Others" (Tasla, Portable Toilet, Dustbin) has no target yet — its sales are included in TOTAL Actual, ' +
            'but TOTAL Achievement % is calculated only on segments that have a target.</div>';

        return _slideWrap("Target vs Actual Performance", null, inner, false);
    }

    // ✅ UPDATED: Added isLast parameter + page breaks for each segment
    function _slideTopCustomersComparison(currentRows, lastMonthRows, isLast) {
        var lmMap = {};
        (lastMonthRows || []).forEach(function (row) {
