// app, e.g. "your_app.api.ucm_party_wise_sales_profit"

var UCM_PARTY_SALES_METHOD = "ucm_party_wise_sales_profit";



var _ucmPartySalesRequestId = 0;



function _ucmRenderPartySalesCard() {

    var fromDate = frappe.query_report.get_filter_value("from_date");

    var toDate   = frappe.query_report.get_filter_value("to_date");

    var customer = frappe.query_report.get_filter_value("customer");



    if (!fromDate || !toDate) {

        $("#ucm-party-sales-box").remove();

        return;

    }



    // Guard against a slower earlier request overwriting a later one when

    // filters are changed quickly (dates, customer) in succession.

    _ucmPartySalesRequestId++;

    var requestId = _ucmPartySalesRequestId;



    frappe.call({

        method: UCM_PARTY_SALES_METHOD,

        args: {

            from_date: fromDate,

            to_date: toDate,

            customer: customer || undefined

        },

        callback: function(r) {

            if (requestId !== _ucmPartySalesRequestId) return; // stale response

            _ucmDrawPartySalesCard(r.message || {});

        },

        error: function() {

            if (requestId !== _ucmPartySalesRequestId) return;

            $("#ucm-party-sales-box").remove();

        }

    });

}



function _ucmDrawPartySalesCard(payload) {

    if (!payload || typeof payload.parties === "undefined") {

