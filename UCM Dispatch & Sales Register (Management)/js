            listHtml = '<div style="display:flex; gap:16px; align-items:flex-start;">' +
                '<div style="flex:1; min-width:0;">' + tableFor(shown.slice(0, half)) + '</div>' +
                '<div style="flex:1; min-width:0;">' + tableFor(shown.slice(half)) + '</div>' +
            '</div>';
        } else {
            listHtml = tableFor(shown);
        }

        var inner =
            '<div style="max-height:' + BUDGET + 'px; overflow:hidden;">' +
                topHtml + listHtml +
                '<div style="display:flex; justify-content:space-between; margin-top:8px; font-size:12px; font-weight:700; color:#0b1424;">' +
                    '<span>' + persons.length + ' sales persons &middot; ' + totalCust + ' new customers' +
                        (hidden ? ' <span style="font-weight:500; color:#7a8fa8;">(' + hidden + ' more rows not shown)</span>' : '') + '</span>' +
                    '<span style="color:#1a6e3a;">' + _fmtCurrency(totalSales) + '</span>' +
                '</div>' +
            '</div>';

        return _slideWrap(title, subtitle, inner, false);
    }

