    // Groups top-profit products by Sales Order Type (Ultra / Large Blow),
    // so the two types are never mixed together in the same list — mirrors
    // the same separation already applied to the Sales Order Type cards.
    function _ucmGetTopProductsBySotType(limit, rows) {
        rows = rows || [];
        var groups = {};   // { "Ultra": {item_code: {...}}, "Large Blow": {...} }
        var groupOrder = [];

        rows.forEach(function (row) {
            var code = row.item_code;
            if (!code) return;
            var type = row.custom_sales_order_type || "Other";
            
            // Only show Ultra and Large Blow - skip Other
            if (type !== "Ultra" && type !== "Large Blow") return;

            if (!groups[type]) {
                groups[type] = {};
                groupOrder.push(type);
            }
            if (!groups[type][code]) {
                groups[type][code] = { item_code: code, item_name: row.item_name || code, qty: 0, amount: 0, profit: 0 };
            }
            groups[type][code].qty += row.qty || 0;
            groups[type][code].amount += row.amount || 0;
            groups[type][code].profit += row.profit || 0;
        });

        var result = [];
        groupOrder.forEach(function (type) {
            var list = Object.keys(groups[type]).map(function (k) { return groups[type][k]; });
            list.sort(function (a, b) { return b.profit - a.profit; });
            result.push({ type: type, products: list.slice(0, 10) });
        });
        return result;
    }

