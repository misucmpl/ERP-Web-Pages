                 (data.breakup && data.breakup.by_sales_order_type);



    // If a specific sales order type was clicked, show only that one
    var groupsToShow = specificSotName 
        ? data.groups.filter(function(g) { return g.name === specificSotName; })
        : data.groups;



    if (!groupsToShow || !groupsToShow.length) {
        console.error("SOT not found:", specificSotName, "Available:", data.groups.map(function(g) { return g.name; }));
        frappe.msgprint(__("Sales Order Type data not found. Please try again."));
        return;
    }



    var UCM_SOT_ROW_COLORS = {
        "Raw Material":  "#3d5170",
        "Packing":       "#0d9488",
        "Manufacturing Packing": "#0d9488",
        "Dispatch Packing": "#0891b2",
        "Total Packing (x+y)": "#0e7490",
        "Manufacturing": "#7b1fa2",
        "Trading Goods": "#2563eb",
        "Unclassified":  "#c62828"
    };



    var bodyHtml = "";

    groupsToShow.forEach(function(g) {

        var seg = null;

        if (byType) {

            for (var key in byType) {

                if (byType.hasOwnProperty(key) && key.toUpperCase() === String(g.name).toUpperCase()) {

                    seg = byType[key];

                    break;

                }

            }

        }



        bodyHtml +=
            '<div class="ucm-sot-total-card">' +
                '<div class="ucm-sot-total-label">' + frappe.utils.escape_html(g.name) + ' — Total Sales</div>' +
                '<div class="ucm-sot-total-value">' + format_currency_nodecimal(g.amount, currency) + '</div>' +
            '</div>';



        if (seg) {

            var totalCogs = seg.total_cogs || 0;

            var saleAmount = g.amount || 0;

            var profit = saleAmount - totalCogs;

            var cogsPctOfSale = saleAmount ? Math.round((totalCogs / saleAmount) * 1000) / 10 : 0;

            var marginPct = saleAmount ? Math.round((profit / saleAmount) * 1000) / 10 : 0;

            var profitColor = profit >= 0 ? "#1a6e3a" : "#c62828";

            bodyHtml +=
                '<div class="ucm-sot-profit-row">' +
                    '<div class="ucm-sot-profit-item">' +
                        '<div class="ucm-sot-profit-label">COGS % of Sale</div>' +
                        '<div class="ucm-sot-profit-value" style="color:#5b6b85;">' + cogsPctOfSale + '%</div>' +
                    '</div>' +
                    '<div class="ucm-sot-profit-item">' +
                        '<div class="ucm-sot-profit-label">Profit</div>' +
                        '<div class="ucm-sot-profit-value" style="color:' + profitColor + ';">' + format_currency_nodecimal(profit, currency) + '</div>' +
                    '</div>' +
                    '<div class="ucm-sot-profit-item">' +
                        '<div class="ucm-sot-profit-label">Margin %</div>' +
                        '<div class="ucm-sot-profit-value" style="color:' + profitColor + ';">' + marginPct + '%</div>' +
                    '</div>' +
                '</div>';



            var pkgTotalSlider = seg.packaging_cost || 0;
            var dispatchPkgSlider = seg.dispatch_packaging_cost || 0;
            var mfgPkgSlider = pkgTotalSlider - dispatchPkgSlider;

            var rows = [
                ["Raw Material",  seg.raw_material_cost]
            ];

            if (dispatchPkgSlider > 0.01) {
                rows.push(["Manufacturing Packing", mfgPkgSlider]);
                rows.push(["Dispatch Packing",      dispatchPkgSlider]);
            } else {
                rows.push(["Packing", pkgTotalSlider]);
            }

            rows.push(
                ["Manufacturing", seg.manufacturing_cost],
                ["Trading Goods", seg.trading_goods_cost],
                ["Unclassified",  seg.unclassified_cost]
            );

            var maxRow = rows.reduce(function(m, r) { return Math.max(m, r[1] || 0); }, 0) || 1;

            rows.forEach(function(r) {

                var value = r[1] || 0;

                if (r[0] === "Unclassified" && value <= 0.01) return;

                var color = UCM_SOT_ROW_COLORS[r[0]] || "#c7d7f2";

                var barPct = Math.max(4, Math.round((value / maxRow) * 100));

                var sharePct = totalCogs ? Math.round((value / totalCogs) * 1000) / 10 : 0;

                bodyHtml +=
                    '<div class="ucm-sot-row" style="--ucm-sot-row-color:' + color + ';">' +
                        '<div class="ucm-sot-row-top">' +
                            '<span class="ucm-sot-row-label">' + r[0] + '</span>' +
                            '<span class="ucm-sot-row-value">' + format_currency_nodecimal(value, currency) + '</span>' +
                        '</div>' +
                        '<div class="ucm-sot-row-track"><div class="ucm-sot-row-fill" style="width:' + barPct + '%;"></div></div>' +
                        '<span class="ucm-sot-row-pct">' + sharePct + '% of Total COGS</span>' +
                    '</div>';

            });

            bodyHtml +=
                '<div class="ucm-sot-row ucm-sot-row-total">' +
                    '<div class="ucm-sot-row-top">' +
                        '<span class="ucm-sot-row-label">Total COGS</span>' +
                        '<span class="ucm-sot-row-value">' + format_currency_nodecimal(totalCogs, currency) + '</span>' +
                    '</div>' +
                '</div>';



            var freightCost = seg.freight_cost || 0;

            bodyHtml +=
                '<div class="ucm-sot-row ucm-sot-row-freight">' +
                    '<div class="ucm-sot-row-top">' +
                        '<span class="ucm-sot-row-label">Freight Charges</span>' +
                        '<span class="ucm-sot-row-value">' + format_currency_nodecimal(freightCost, currency) + '</span>' +
                    '</div>' +
                '</div>';

        } else {

            bodyHtml += '<div class="ucm-sot-slider-empty">' + __("No cost breakup available for this segment.") + '</div>';

        }

    });



    _ucmOpenSotSlider(specificSotName, bodyHtml);

}



function _ucmOpenSotSlider(specificSotName, bodyHtml) {

