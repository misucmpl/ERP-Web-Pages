                (pp.cats.length > MAX_ROWS ? '<div style="font-size:10.5px; color:#7a8fa8; margin-top:3px;">+ ' + (pp.cats.length - MAX_ROWS) + ' more categories</div>' : '') +
            '</div>';
        }
        var inner = '<div style="display:flex; gap:22px; align-items:flex-start;">' + render(preps[0]) + render(preps[1]) + '</div>';
        return _slideWrap("Category Reach", "States reached per category &middot; out of " + total + " (28 States + 8 UTs) &middot; selected period", inner, false);
