  /* ───────── frappe.call (fetch based) ───────── */
  function csrf() { return frappe.csrf_token || w.csrf_token || ""; }

  function request(method, args, useGet) {
    var url = "/api/method/" + method;
    var init = { credentials: "same-origin", headers: { "Accept": "application/json" } };
    var clean = {};
    Object.keys(args || {}).forEach(function (k) {
      var v = args[k];
      if (v === undefined || v === null) return;
      clean[k] = (typeof v === "object") ? JSON.stringify(v) : v;
    });
    if (useGet) {
      url += "?" + new URLSearchParams(clean).toString();
      init.method = "GET";
    } else {
      init.method = "POST";
      init.headers["Content-Type"] = "application/json";
      init.headers["X-Frappe-CSRF-Token"] = csrf();
      init.body = JSON.stringify(clean);
    }
    return fetch(url, init).then(function (res) {
      return res.json().catch(function () { return null; }).then(function (body) {
        if (!res.ok) {
          var msg = method + " failed (" + res.status + ")";
          if (body && body._server_messages) {
            try { msg = stripHtml(JSON.parse(JSON.parse(body._server_messages)[0]).message) || msg; } catch (e) { /* ignore */ }
          } else if (body && body.exception) {
            msg = String(body.exception).split("\n")[0];
          } else if (res.status === 403) {
            msg = "Permission denied for " + method;
          }
          var err = new Error(msg); err.status = res.status; err.method = method;
          throw err;
        }
        return body ? body.message : null;
      });
    });
  }

  frappe.call = function (opts) {
    if (typeof opts === "string") opts = { method: opts, args: arguments[1], callback: arguments[2] };
    opts = opts || {};
