                    'body { margin: 0; padding: 0; font-family: -apple-system, Arial, sans-serif; color:#0b1424; }' +
                    '@page { size: A4 landscape; margin: 10mm; }' +
                    '.ucm-pdf-page { page-break-inside: avoid; }' +
                    '.ucm-pdf-page:not(:last-child) { page-break-after: always; }' +
