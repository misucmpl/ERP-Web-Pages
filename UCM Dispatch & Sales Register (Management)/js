function _ucmRetrySummary() {

    var attempts = 0;

    function attempt() {

        attempts++;

        if (!document.querySelectorAll(".report-summary .summary-item").length && attempts < 20) {

            setTimeout(attempt, 300); return;

        }

        _ucmBuildCustomSummary();

        _ucmWatchSummary();

        setTimeout(_ucmBuildCustomSummary, 500);

        setTimeout(_ucmBuildCustomSummary, 1000);

        setTimeout(_ucmBuildCustomSummary, 2000);

        setTimeout(_ucmBuildCustomSummary, 4000);

    }

