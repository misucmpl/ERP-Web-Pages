            '<div>' +

                '<p class="ucm-party-title">Party-wise Sales &amp; Profit</p>' +

                '<p class="ucm-party-sub">Descending order &middot; ' + partyList.length + ' parties &middot; Sales Invoice data</p>' +

            '</div>' +

            '<div class="ucm-party-total-pill">' +

                '<span>Total&nbsp;</span><b>' + format_currency_nodecimal(grandTotal, currency) + '</b>' +

            '</div>' +

        '</div>'

    );



    var $columns = $('<div class="ucm-party-columns"></div>');



    // ── Left column — ranked sales list ──────────────────────────────────────

    var $leftCol = $('<div class="ucm-party-list-col"></div>');

    $leftCol.append('<div class="ucm-party-col-title">Sales Amount</div>');

    $leftCol.append(

        '<div class="ucm-profit-bar-total">Total Sales&nbsp;<b class="ucm-total-sales-b">' + format_currency_nodecimal(grandTotal, currency) + '</b></div>'

