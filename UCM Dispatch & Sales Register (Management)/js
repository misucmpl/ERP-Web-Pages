    var rowsHtml = "";
    drafts.forEach(function (d) {
        var t = TYPE[d.sot] || TYPE[""];
        rowsHtml +=
            '<tr class="ucm-soa-row" data-sot="' + frappe.utils.escape_html(d.sot || "") + '">' +
                '<td><a href="/app/sales-order/' + encodeURIComponent(d.name) + '" target="_blank">' +
