function _ucmShortMachine(v) {

    if (!v) return v;

    return v.replace(/^\s*machine\s*no\.?\s*/i, "").trim();

}



function _ucmOpenDocPopup(doctype, name) {

    if (!doctype || !name) return;

    var slug = doctype.toLowerCase().replace(/ /g, "-");

    var url = "/app/" + slug + "/" + encodeURIComponent(name);

    var w = 1000, h = 720;

    var left = Math.max(0, (screen.width - w) / 2);

    var top = Math.max(0, (screen.height - h) / 2);

    window.open(

        url,

        "ucm_doc_popup_" + name.replace(/[^\w]/g, "_"),

        "width=" + w + ",height=" + h + ",left=" + left + ",top=" + top +

        ",resizable=yes,scrollbars=yes,toolbar=no,menubar=no,location=yes"

    );

}



function _ucmBindCostBreakupClicks() {

    $(document).off("click.ucmCostBreakup").on("click.ucmCostBreakup", "span[data-dn-total='1']", function() {

        var dnName = $(this).attr("data-dn-name");

        if (!dnName) return;

