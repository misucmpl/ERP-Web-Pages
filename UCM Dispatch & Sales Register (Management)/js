    var byType = { "ULTRA": 0, "LARGE BLOW": 0, "": 0 };
    drafts.forEach(function (d) {
        totalQty += d.qty || 0;
        totalValue += d.value || 0;
        var k = byType.hasOwnProperty(d.sot) ? d.sot : "";
        byType[k] = byType[k] + 1;
    });

    function card(label, value, sub, color, filter) {
