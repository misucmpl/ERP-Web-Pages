                    '<b style="color:#1a6e3a;">' + pct + '% covered</b> &middot; <b style="color:#c5221f;">' + (total - covCount) + ' not covered</b></div>' +
                '<div style="font-size:11.5px; color:#3d5170;">Sales ' + _fmtCurrency(inf.sales) + ' &middot; ' + inf.cities + ' cities</div>' +
                group("States", UCM_INDIA_STATES, stCount) +
                group("Union Territories", UCM_INDIA_UTS, utCount) +
            '</div>';
        }
        var inner;
        if (!rows.length) {
            inner = '<div style="color:#9aa5b5; font-size:16px; text-align:center; margin-top:60px;">No Sales Invoice data available for this period.</div>';
        } else {
            inner = '<div style="display:flex; gap:14px; align-items:flex-start;">' +
