    inp.addEventListener("mousedown", function () { if (!box.classList.contains("open")) setTimeout(open, 0); });
    inp.addEventListener("focus", function () { if (!box.classList.contains("open")) open(); });
    inp.addEventListener("blur", function () { setTimeout(function () { if (document.activeElement !== inp) close(); }, 150); });
