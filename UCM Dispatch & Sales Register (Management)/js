// SALES PERSON WISE NEW CUSTOMERS (tab inside View Details slider)
// Ultra / Large Blow alag-alag. Har sales person (Sales Invoice ka
// "Order By") ke naam ke saath: kitne naye customer laaye, unki total sale,
// aur click karne par customer list.
// Data:
//   - New customer list  -> ucm_customer_acquisition_detail (same as
//     "New Customers" tab)
//   - Sales person + sale -> Sales Invoice rows (report re-run with
//     source = Sales Invoice, sirf date range — customer / item group /
//     source filter ka koi asar nahi)
// Ek new customer ek hi sales person ko milta hai: period ke andar us
// customer ki PEHLI Sales Invoice (us segment mein) jisne banayi, wahi.
// ═══════════════════════════════════════════════════════════════════════════

// Sales Invoice rows — sirf date range, baaki filters ignore.
function _ucmFetchSalesInvoiceRowsDatesOnly(callback) {
    var fromDate = frappe.query_report.get_filter_value("from_date");
    var toDate   = frappe.query_report.get_filter_value("to_date");
    if (!fromDate || !toDate) { callback([]); return; }

    frappe.call({
        method: "frappe.desk.query_report.run",
        args: {
            report_name: frappe.query_report.report_name,
            filters: { from_date: fromDate, to_date: toDate, source: "Sales Invoice" }
        },
        callback: function (r) {
            callback((r && r.message && r.message.result) || []);
        },
        error: function () { callback([]); }
    });
}

function _ucmNormName(v) {
    return String(v || "").trim().toUpperCase().replace(/\s+/g, " ");
}

// Builds { "ULTRA": { customerNameNorm: {person, sales, invoices, firstDate} }, "LARGE BLOW": {...} }
function _ucmBuildSiCustomerIndex(rows) {
    var index = { "ULTRA": {}, "LARGE BLOW": {} };
    var lastDate = "";
    var lastInvoice = null;

    (rows || []).forEach(function (row) {
        if (!row || !row.name) return;

        // Report ek invoice ki 2nd+ item rows mein posting_date khali bhejta hai
        // — isliye pichli row ki date aage le jaate hain.
        if (row.name !== lastInvoice) {
            lastInvoice = row.name;
            lastDate = row.posting_date || "";
        }
        var postingDate = row.posting_date || lastDate;

        var seg = _ucmNormName(row.custom_sales_order_type);
        if (!index[seg]) return;

        var cust = _ucmNormName(row.customer_name);
        if (!cust) return;

        var person = String(row.custom_order_by || "").trim() || "Not Set";
        var c = index[seg][cust];
        if (!c) {
            c = index[seg][cust] = { person: person, firstDate: postingDate, firstInvoice: row.name, sales: 0, invoices: {} };
        }
        c.sales += parseFloat(row.amount) || 0;
        c.invoices[row.name] = true;

        // Pehli invoice wala sales person hi credit paata hai
        var earlier = postingDate && (!c.firstDate || postingDate < c.firstDate ||
            (postingDate === c.firstDate && row.name < c.firstInvoice));
        if (earlier) {
            c.firstDate = postingDate;
            c.firstInvoice = row.name;
            c.person = person;
        }
    });
    return index;
}

// Groups one segment's new customers by sales person (first Sales Invoice
// wale "Order By" ko credit). Used by the PDF page. Returns a list sorted by
// new-customer count, then sales:
//   [{ name, sales, customers: [{name, sales, invoices, firstDate}] }]
function _ucmGroupNewCustomersByPerson(acqMap, segIndex) {
    var persons = {};
    Object.keys(acqMap || {}).forEach(function (id) {
        var c = acqMap[id];
        var si = (segIndex || {})[_ucmNormName(c.name)] || (segIndex || {})[_ucmNormName(id)];
        var person = si ? si.person : "Not Set";
        var sales = si ? si.sales : (c.sales || 0);
        if (!persons[person]) persons[person] = { name: person, customers: [], sales: 0 };
        persons[person].customers.push({
            name: c.name || id,
            sales: sales,
            invoices: si ? Object.keys(si.invoices).length : (c.orders || 0),
            firstDate: si ? si.firstDate : ""
        });
        persons[person].sales += sales;
    });
    return Object.keys(persons).map(function (k) {
        persons[k].customers.sort(function (a, b) { return b.sales - a.sales; });
        return persons[k];
    }).sort(function (a, b) {
        return (b.customers.length - a.customers.length) || (b.sales - a.sales);
    });
}

function _ucmLoadPersonNewCustomers(specificSotName, $panel) {
    var $wrap = $panel.find(".ucm-sot-personnew-wrap");

    var newCust = null, siRows = null, calls = 0;
    function done() {
        if (++calls < 2) return;
        if (!$panel.closest("body").length) return;
        _ucmRenderPersonNewCustomers(specificSotName, $wrap, newCust, siRows);
    }

    _ucmFetchNewCustomersDetail(function (d) { newCust = d; done(); });
    _ucmFetchSalesInvoiceRowsDatesOnly(function (r) { siRows = r || []; done(); });

    // Person row click -> uske new customers ki list khule / band ho
    $wrap.off("click.ucmPersonNew").on("click.ucmPersonNew", ".ucm-pnc-person", function () {
        var $row = $(this);
        var $list = $row.next(".ucm-pnc-list");
        var open = $row.hasClass("open");
        $row.toggleClass("open", !open);
        $list.stop(true, true).slideToggle(150);
    });
}

function _ucmRenderPersonNewCustomers(specificSotName, $wrap, newCust, siRows) {
    if (!newCust) {
        $wrap.html('<div class="ucm-sot-slider-empty">New customer data load nahi hua. Check that ucm_customer_acquisition_detail is deployed.</div>');
        return;
    }

    var currency = (_ucmSotDetailData && _ucmSotDetailData.currency) || frappe.defaults.get_default("currency");
    var siIndex = _ucmBuildSiCustomerIndex(siRows);

    var segs = [
        { key: "ULTRA",      acqKey: "ultra",      label: "Ultra",      color: "#1a73e8" },
        { key: "LARGE BLOW", acqKey: "large_blow", label: "Large Blow", color: "#7b3fa0" }
    ];
    if (specificSotName) {
        var want = _ucmNormName(specificSotName);
        segs = segs.filter(function (sg) { return sg.key === want; });
    }

    var PERSON_COLORS = ["#1a73e8", "#0d9488", "#7b1fa2", "#e65100", "#c62828",
                         "#1a6e3a", "#6b3fa0", "#ad1457", "#37474f", "#0f6e56"];

    var html = "";

    segs.forEach(function (sg) {
        var acqMap = newCust[sg.acqKey] || {};
        var segIndex = siIndex[sg.key] || {};

        // person -> { customers: [], sales }
        var persons = {};
        Object.keys(acqMap).forEach(function (id) {
            var c = acqMap[id];
            var si = segIndex[_ucmNormName(c.name)] || segIndex[_ucmNormName(id)];
            var person = si ? si.person : "Not Set";
            var sales  = si ? si.sales : (c.sales || 0);
            var invCount = si ? Object.keys(si.invoices).length : (c.orders || 0);
            var firstDate = si ? si.firstDate : "";

            if (!persons[person]) persons[person] = { name: person, customers: [], sales: 0 };
            persons[person].customers.push({ name: c.name || id, sales: sales, invoices: invCount, firstDate: firstDate });
            persons[person].sales += sales;
        });

        var list = Object.keys(persons).map(function (k) { return persons[k]; })
            .sort(function (a, b) {
                return (b.customers.length - a.customers.length) || (b.sales - a.sales);
            });

        var totalCust = list.reduce(function (t, p) { return t + p.customers.length; }, 0);
        var totalSales = list.reduce(function (t, p) { return t + p.sales; }, 0);
        var maxCust = list.reduce(function (m, p) { return Math.max(m, p.customers.length); }, 0) || 1;

        html += '<div class="ucm-sot-individual-group">';
        if (segs.length > 1) {
            html += '<div class="ucm-sot-individual-group-title" style="color:' + sg.color + ';">' + sg.label + '</div>';
        }

        html +=
            '<div class="ucm-sot-profit-row" style="margin:0 0 14px;">' +
                '<div class="ucm-sot-profit-item">' +
                    '<div class="ucm-sot-profit-label">Sales Persons</div>' +
                    '<div class="ucm-sot-profit-value" style="color:#3d5170;">' + list.length + '</div>' +
                '</div>' +
                '<div class="ucm-sot-profit-item">' +
                    '<div class="ucm-sot-profit-label">New Customers</div>' +
                    '<div class="ucm-sot-profit-value" style="color:' + sg.color + ';">' + totalCust + '</div>' +
                '</div>' +
                '<div class="ucm-sot-profit-item">' +
                    '<div class="ucm-sot-profit-label">Sales from New Customers</div>' +
                    '<div class="ucm-sot-profit-value" style="color:#1a6e3a;">' + format_currency_nodecimal(totalSales, currency) + '</div>' +
                '</div>' +
            '</div>';

        if (!list.length) {
            html += '<div class="ucm-sot-slider-empty" style="padding:20px 0;">No new ' + sg.label + ' customers in this period.</div></div>';
            return;
        }

        list.forEach(function (p, idx) {
            var color = PERSON_COLORS[idx % PERSON_COLORS.length];
            var barPct = Math.max(4, Math.round((p.customers.length / maxCust) * 100));
            var sharePct = totalCust ? Math.round((p.customers.length / totalCust) * 1000) / 10 : 0;

            html +=
                '<div class="ucm-sot-row ucm-pnc-person" style="--ucm-sot-row-color:' + color + '; cursor:pointer;">' +
                    '<div class="ucm-sot-row-top">' +
                        '<span class="ucm-sot-row-label"><span class="ucm-pnc-arrow">&#9656;</span> ' +
                            frappe.utils.escape_html(p.name) + '</span>' +
                        '<span class="ucm-sot-row-value">' + p.customers.length + ' new</span>' +
                    '</div>' +
                    '<div class="ucm-sot-row-track"><div class="ucm-sot-row-fill" style="width:' + barPct + '%;"></div></div>' +
                    '<span class="ucm-sot-row-pct">' + sharePct + '% of new customers &middot; Sales ' +
                        format_currency_nodecimal(p.sales, currency) + '</span>' +
                '</div>';

            var custs = p.customers.slice().sort(function (a, b) { return b.sales - a.sales; });
            html += '<div class="ucm-pnc-list" style="display:none;">' +
                '<table class="ucm-pnc-table"><thead><tr>' +
                    '<th>#</th><th>Customer</th><th>First Invoice</th>' +
                    '<th class="num">Invoices</th><th class="num">Sales</th>' +
                '</tr></thead><tbody>';
            custs.forEach(function (c, i) {
                html += '<tr>' +
                    '<td>' + (i + 1) + '</td>' +
                    '<td>' + frappe.utils.escape_html(c.name) + '</td>' +
                    '<td>' + (c.firstDate ? frappe.datetime.str_to_user(c.firstDate) : "—") + '</td>' +
                    '<td class="num">' + c.invoices + '</td>' +
                    '<td class="num">' + format_currency_nodecimal(c.sales, currency) + '</td>' +
                '</tr>';
            });
            html += '</tbody></table></div>';
        });

        html += '</div>';
    });

    $wrap.html(html || '<div class="ucm-sot-slider-empty">No new customers in this period.</div>');
}



// Fetches person-wise sales (via UCM_INDIVIDUAL_SALES_METHOD, the whitelisted
// get_sales_by_order_person API) for the "Individual Sales Data" tab inside
// the View Details slider. Date range always applies. Rows are grouped by
// sales_order_type first:
//   - If a specific type was clicked (specificSotName = "Ultra" / "Large
//     Blow"), only that type's group renders — each order_by person's sales
//     value and % contribution are computed against THAT type's total.
//   - If no specific type was clicked (viewing "All Types"), both groups
//     render stacked, each still scored against its own type's total (not
//     the combined grand total) — i.e. Ultra people are ranked/percented
//     within Ultra, Large Blow people within Large Blow.
function _ucmLoadIndividualSalesData(specificSotName, $panel) {

    var $wrap = $panel.find(".ucm-sot-individual-wrap");

    var fromDate  = frappe.query_report.get_filter_value("from_date");
    var toDate    = frappe.query_report.get_filter_value("to_date");
    // Individual Sales Data: sirf date range lagti hai. Customer / Item Group /
    // Source filter ignore — hamesha Sales Invoice ka poora data.

    if (!fromDate || !toDate) {
        $wrap.html('<div class="ucm-sot-slider-empty">Select a date range to load individual sales data.</div>');
        return;
    }

    frappe.call({
        method: UCM_INDIVIDUAL_SALES_METHOD,
        args: {
            from_date: fromDate,
            to_date: toDate,
            source: "Sales Invoice"
        },
        callback: function(r) {

            // Slider may have been closed/reopened for a different sot by
            // the time this resolves — bail if it's no longer in the DOM.
            if (!$panel.closest("body").length) return;

            var payload = r.message || {};
            var rows = payload.data || [];

            if (specificSotName) {
                rows = rows.filter(function(row) {
                    return row.sales_order_type &&
                        String(row.sales_order_type).toUpperCase() === String(specificSotName).toUpperCase();
                });
            }

            if (!rows.length) {
                $wrap.html('<div class="ucm-sot-slider-empty">No individual sales data found for this period.</div>');
                return;
            }

            var currency = (_ucmSotDetailData && _ucmSotDetailData.currency) || frappe.defaults.get_default("currency");

            // Same palette used for Category/Customer wise Sales, kept as its
            // own array in case this list wants an independent scheme later.
            var UCM_INDIVIDUAL_COLORS = [
                "#1a73e8", "#0d9488", "#7b1fa2", "#e65100", "#c62828",
                "#1a6e3a", "#6b3fa0", "#ad1457", "#37474f", "#0f6e56"
            ];

            // Group by sales_order_type so each type's people are ranked and
            // percented against that type's own total, never the combined total.
            var groups = {};
            var groupOrder = [];
            rows.forEach(function(row) {
                var type = row.sales_order_type || "Unknown";
                if (!groups[type]) {
                    groups[type] = [];
                    groupOrder.push(type);
                }
                groups[type].push(row);
            });

            var html = "";

            groupOrder.forEach(function(type) {

                var typeRows = groups[type].slice().sort(function(a, b) {
                    return (b.value || 0) - (a.value || 0);
                });

                var typeTotal = typeRows.reduce(function(s, row) { return s + (row.value || 0); }, 0);
                var maxVal = typeRows.reduce(function(m, row) { return Math.max(m, row.value || 0); }, 0) || 1;

                var statsHtml =
                    '<div class="ucm-sot-profit-row" style="margin:0;">' +
                        '<div class="ucm-sot-profit-item">' +
                            '<div class="ucm-sot-profit-label">People</div>' +
                            '<div class="ucm-sot-profit-value" style="color:#3d5170;">' + typeRows.length + '</div>' +
                        '</div>' +
                        '<div class="ucm-sot-profit-item">' +
                            '<div class="ucm-sot-profit-label">Total Sales</div>' +
                            '<div class="ucm-sot-profit-value" style="color:#1a73e8;">' + format_currency_nodecimal(typeTotal, currency) + '</div>' +
                        '</div>' +
                    '</div>';

                var rowsHtml = "";

                typeRows.forEach(function(row, idx) {

                    var value = row.value || 0;
                    var color = UCM_INDIVIDUAL_COLORS[idx % UCM_INDIVIDUAL_COLORS.length];
                    var barPct = Math.max(4, Math.round((value / maxVal) * 100));
                    var sharePct = typeTotal ? Math.round((value / typeTotal) * 1000) / 10 : 0;
                    var label = row.order_by || "Not Set";

                    rowsHtml +=
                        '<div class="ucm-sot-row" style="--ucm-sot-row-color:' + color + ';">' +
                            '<div class="ucm-sot-row-top">' +
                                '<span class="ucm-sot-row-label">' + frappe.utils.escape_html(label) + '</span>' +
                                '<span class="ucm-sot-row-value">' + format_currency_nodecimal(value, currency) + '</span>' +
                            '</div>' +
                            '<div class="ucm-sot-row-track"><div class="ucm-sot-row-fill" style="width:' + barPct + '%;"></div></div>' +
                            '<span class="ucm-sot-row-pct">' + sharePct + '% of ' + frappe.utils.escape_html(type) + ' sales</span>' +
                        '</div>';

                });

                html +=
                    '<div class="ucm-sot-individual-group">' +
                        (groupOrder.length > 1
                            ? '<div class="ucm-sot-individual-group-title">' + frappe.utils.escape_html(type) + '</div>'
                            : '') +
                        '<div class="ucm-sot-category-sticky">' + statsHtml + '</div>' +
                        '<div class="ucm-sot-category-list">' + rowsHtml + '</div>' +
                    '</div>';

            });

            $wrap.html(html);
        },
        error: function() {
            if (!$panel.closest("body").length) return;
            $wrap.html('<div class="ucm-sot-slider-empty">Could not load individual sales data. Check that ' +
                frappe.utils.escape_html(UCM_INDIVIDUAL_SALES_METHOD) + ' is deployed and whitelisted.</div>');
        }
    });

}



