    chips.forEach(function (c) {
        chipHtml += '<span class="ucm-soa-filter' + (c[0] === "all" ? ' active' : '') + '" data-soa-filter="' + c[0] + '">' +
            c[1] + ' (' + c[2] + ')</span>';
    });
