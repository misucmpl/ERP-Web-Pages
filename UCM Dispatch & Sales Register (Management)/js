    // ── 4. Sales Order list ──
    var sorted = orders.slice().sort(function (a, c) {
        var ra = (UCM_SOA_PERF[a.perf] || {}).rank || 9;
        var rc = (UCM_SOA_PERF[c.perf] || {}).rank || 9;
        return (ra - rc) || ((c.delay_days || 0) - (a.delay_days || 0));
    });

    var chips = [
        ["all", "All", b.so_count],
        ["on_time", "On Time", b.on_time || 0],
        ["delayed", "Delayed", delayed],
        ["late", "↳ Delivered Late", b.late || 0],
        ["overdue", "↳ Overdue", b.overdue || 0],
        ["on_track", "Pending", b.on_track || 0],
