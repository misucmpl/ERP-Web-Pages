function _ucmSoaQty(v) { return Math.round(v || 0).toLocaleString("en-IN"); }
function _ucmSoaPct(a, b) { return b ? Math.round(((a || 0) / b) * 1000) / 10 : 0; }
function _ucmSoaDate(d) { return d ? frappe.datetime.str_to_user(d) : "—"; }
function _ucmSoaMoney(v) {
    var currency = frappe.defaults.get_default("currency");
    return typeof format_currency_nodecimal === "function"
        ? format_currency_nodecimal(v || 0, currency)
        : format_currency(v || 0, currency);
}

function _ucmSoaLockPageScroll(lock) {
    var body = document.body;
    if (lock) {
        if (body.classList.contains("ucm-soa-scroll-locked")) return;
        // Scrollbar hatne se page side mein na khiske — uski jagah padding
        var sbw = window.innerWidth - document.documentElement.clientWidth;
        body.setAttribute("data-ucm-soa-pr", body.style.paddingRight || "");
        if (sbw > 0) body.style.paddingRight = sbw + "px";
        body.classList.add("ucm-soa-scroll-locked");
    } else {
        if (!body.classList.contains("ucm-soa-scroll-locked")) return;
        body.classList.remove("ucm-soa-scroll-locked");
        body.style.paddingRight = body.getAttribute("data-ucm-soa-pr") || "";
        body.removeAttribute("data-ucm-soa-pr");
    }
}

