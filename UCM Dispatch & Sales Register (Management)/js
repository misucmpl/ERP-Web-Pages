    var grandProfitTotal = (payload.grand_profit != null) ? parseFloat(payload.grand_profit) || 0

        : profitList.reduce(function(s, p) { return s + p.amount; }, 0);



    var box = $('<div id="ucm-party-sales-box"></div>');

    box.append(

