  (function mirrorReportStyles() {
    var doc = w.document;
    if (!doc || !("adoptedStyleSheets" in doc) || typeof w.CSSStyleSheet !== "function") return;
    var sheets = new Map();
    function isReportStyle(n) { return n && n.nodeName === "STYLE" && /^ucm/.test(n.id || ""); }
    function add(el) {
      if (sheets.has(el)) return;
      try {
        var sh = new w.CSSStyleSheet();
        sh.replaceSync(el.textContent || "");
        sheets.set(el, sh);
        doc.adoptedStyleSheets = doc.adoptedStyleSheets.concat([sh]);
      } catch (e) { console.warn("[UCM] style mirror failed for #" + el.id, e); }
    }
    function remove(el) {
      var sh = sheets.get(el);
      if (!sh) return;
      sheets.delete(el);
      doc.adoptedStyleSheets = doc.adoptedStyleSheets.filter(function (x) { return x !== sh; });
    }
    Array.prototype.forEach.call(doc.querySelectorAll("style"), function (n) { if (isReportStyle(n)) add(n); });
    new MutationObserver(function (muts) {
      muts.forEach(function (m) {
        Array.prototype.forEach.call(m.addedNodes, function (n) { if (isReportStyle(n)) add(n); });
        Array.prototype.forEach.call(m.removedNodes, function (n) { if (sheets.has(n)) remove(n); });
      });
    }).observe(doc.head || doc.documentElement, { childList: true, subtree: true });
  })();

