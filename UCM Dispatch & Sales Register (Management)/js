            '<div class="ucm-sot-newcust-wrap">' +
                '<div class="ucm-sot-slider-loading">Loading new customers…</div>' +
            '</div>' +
        '</div>' +
        '<div class="ucm-sot-tab-panel" data-tab-panel="personnew" style="display:none;">' +
            '<div class="ucm-sot-personnew-wrap">' +
                '<div class="ucm-sot-slider-loading">Loading sales person wise new customers…</div>' +
            '</div>' +
        '</div>';

    var $panel = $(
        '<div class="ucm-sot-slider">' +
            '<div class="ucm-sot-slider-header">' +
                '<div>' +
                    '<h4>Sales Order Type Breakdown</h4>' +
                    '<div class="sub">' + frappe.utils.escape_html(specificSotName || "All Types") + '</div>' +
                '</div>' +
                '<button class="ucm-sot-slider-close">&times;</button>' +
            '</div>' +
            '<div class="ucm-sot-tabs">' +
                '<div class="ucm-sot-tab active" data-tab="details">Details</div>' +
                '<div class="ucm-sot-tab" data-tab="category">Category wise Sales</div>' +
                '<div class="ucm-sot-tab" data-tab="customer">Customer wise Sales</div>' +
                '<div class="ucm-sot-tab" data-tab="individual">Individual Sales Data</div>' +
                '<div class="ucm-sot-tab" data-tab="newcust">New Customers</div>' +
                '<div class="ucm-sot-tab" data-tab="personnew">Sales Person New Customers</div>' +
            '</div>' +
            '<div class="ucm-sot-slider-body">' + slidBodyHtml + '</div>' +
        '</div>'
    ).appendTo("body");



    requestAnimationFrame(function() {

        $backdrop.addClass("open");

        $panel.addClass("open");

    });



    _ucmLoadCategoryWiseSales(specificSotName, $panel);

    _ucmLoadCustomerWiseSales(specificSotName, $panel);

    _ucmLoadIndividualSalesData(specificSotName, $panel);

    _ucmLoadNewCustomers(specificSotName, $panel);

    _ucmLoadPersonNewCustomers(specificSotName, $panel);



    function closePanel() {

        $backdrop.removeClass("open");

        $panel.removeClass("open");

        setTimeout(function() { $backdrop.remove(); $panel.remove(); }, 250);

    }

    $backdrop.on("click", closePanel);

    $panel.on("click", ".ucm-sot-slider-close", closePanel);

    // Tab switching — show the clicked tab's panel, hide the other, no re-fetch
    $panel.on("click", ".ucm-sot-tab", function() {

        var tab = $(this).attr("data-tab");

        $panel.find(".ucm-sot-tab").removeClass("active");

        $(this).addClass("active");

        $panel.find(".ucm-sot-tab-panel").hide();

        $panel.find('.ucm-sot-tab-panel[data-tab-panel="' + tab + '"]').show();

    });

}



// Fetches item-category-wise sales (via UCM_CATEGORY_WISE_SALES_METHOD) for
// the report's current date range / customer filter, and renders it as the
// "Category wise Sales" table inside the View Details slider. If a specific
// sales order type was clicked (specificSotName), the table is filtered to
// just that type; otherwise it shows every category across both types.
function _ucmLoadCategoryWiseSales(specificSotName, $panel) {

    var $wrap = $panel.find(".ucm-sot-category-wrap");

    var fromDate = frappe.query_report.get_filter_value("from_date");

    var toDate   = frappe.query_report.get_filter_value("to_date");

    var customer = frappe.query_report.get_filter_value("customer");

    if (!fromDate || !toDate) {
        $wrap.html('<div class="ucm-sot-slider-empty">Select a date range to load category-wise sales.</div>');
        return;
    }

    frappe.call({
        method: UCM_CATEGORY_WISE_SALES_METHOD,
        args: {
            from_date: fromDate,
            to_date: toDate,
            customer: customer || undefined
        },
        callback: function(r) {

            // Slider may have been closed/reopened for a different sot by
            // the time this resolves — bail if it's no longer in the DOM.
            if (!$panel.closest("body").length) return;

            var rows = r.message || [];

            if (specificSotName) {
                rows = rows.filter(function(row) {
                    return row.sales_order_type &&
                        String(row.sales_order_type).toUpperCase() === String(specificSotName).toUpperCase();
                });
            }

            if (!rows.length) {
                $wrap.html('<div class="ucm-sot-slider-empty">No category-wise sales found for this period.</div>');
                return;
            }

            var currency = (_ucmSotDetailData && _ucmSotDetailData.currency) || frappe.defaults.get_default("currency");

            var totalQty = 0, totalAmount = 0;

            rows.forEach(function(row) {
                totalQty += row.qty || 0;
                totalAmount += row.amount || 0;
            });

            var maxAmount = rows.reduce(function(m, row) { return Math.max(m, row.amount || 0); }, 0) || 1;

            // Cycles through a fixed palette per category — same approach used
            // for the party-wise sales cards elsewhere in this report.
            var UCM_CATEGORY_COLORS = [
                "#1a73e8", "#0d9488", "#7b1fa2", "#e65100", "#c62828",
                "#1a6e3a", "#6b3fa0", "#ad1457", "#37474f", "#0f6e56"
            ];

            var statsHtml =
                '<div class="ucm-sot-profit-row" style="margin:0;">' +
                    '<div class="ucm-sot-profit-item">' +
                        '<div class="ucm-sot-profit-label">Categories</div>' +
                        '<div class="ucm-sot-profit-value" style="color:#3d5170;">' + rows.length + '</div>' +
                    '</div>' +
                    '<div class="ucm-sot-profit-item">' +
                        '<div class="ucm-sot-profit-label">Total Qty</div>' +
                        '<div class="ucm-sot-profit-value" style="color:#0d9488;">' + format_number(Math.round(totalQty), null, 0) + '</div>' +
                    '</div>' +
                    '<div class="ucm-sot-profit-item">' +
                        '<div class="ucm-sot-profit-label">Total Amount</div>' +
                        '<div class="ucm-sot-profit-value" style="color:#1a73e8;">' + format_currency_nodecimal(totalAmount, currency) + '</div>' +
                    '</div>' +
                '</div>';

            var rowsHtml = "";

            rows.forEach(function(row, idx) {

                var qty = row.qty || 0;
                var amount = row.amount || 0;
                var color = UCM_CATEGORY_COLORS[idx % UCM_CATEGORY_COLORS.length];
                var barPct = Math.max(4, Math.round((amount / maxAmount) * 100));
                var sharePct = totalAmount ? Math.round((amount / totalAmount) * 1000) / 10 : 0;

                rowsHtml +=
                    '<div class="ucm-sot-row ucm-cat-clickable" data-cat-idx="' + idx + '" style="--ucm-sot-row-color:' + color + ';">' +
                        '<div class="ucm-sot-row-top">' +
                            '<span class="ucm-sot-row-label"><span class="ucm-cat-caret">&#9654;</span>' + frappe.utils.escape_html(row.category || "Uncategorized") + '</span>' +
                            '<span class="ucm-sot-row-value">' + format_currency_nodecimal(amount, currency) + '</span>' +
                        '</div>' +
                        '<div class="ucm-sot-row-track"><div class="ucm-sot-row-fill" style="width:' + barPct + '%;"></div></div>' +
                        '<span class="ucm-sot-row-pct">' + format_number(Math.round(qty), null, 0) + ' qty &middot; ' + sharePct + '% of total &middot; click to see invoices</span>' +
                    '</div>' +
                    '<div class="ucm-cat-detail" data-cat-detail="' + idx + '"></div>';

            });

            var html =
                '<div class="ucm-sot-category-sticky">' + statsHtml + '</div>' +
                '<div class="ucm-sot-category-list">' + rowsHtml + '</div>';

            $wrap.html(html);

            // ── Click a category → toggle its invoice list (Invoice No / Customer / Amount)
            var _invCache = {};
            $wrap.find(".ucm-cat-clickable").on("click", function () {
                var $row = $(this);
                var idx = parseInt($row.attr("data-cat-idx"), 10);
                var $detail = $wrap.find('.ucm-cat-detail[data-cat-detail="' + idx + '"]');
                var catRow = rows[idx];

                if ($detail.hasClass("open")) {
                    $detail.removeClass("open");
                    $row.removeClass("ucm-cat-open");
                    return;
                }
                $detail.addClass("open");
                $row.addClass("ucm-cat-open");
                if (_invCache[idx]) { $detail.html(_invCache[idx]); return; }

                $detail.html('<div class="ucm-cat-detail-msg">Loading invoices…</div>');
                frappe.call({
                    method: UCM_CATEGORY_INVOICES_METHOD,
                    args: {
                        from_date: fromDate,
                        to_date: toDate,
                        customer: customer || undefined,
                        category: catRow.category || "",
                        sales_order_type: catRow.sales_order_type || undefined
                    },
                    callback: function (res) {
                        var inv = (res && res.message) || [];
                        if (!inv.length) {
                            $detail.html('<div class="ucm-cat-detail-msg">No invoices found for this category.</div>');
                            return;
                        }
                        var tot = 0;
                        var h = '<table><thead><tr>' +
                            '<th>Invoice No</th><th>Customer</th><th class="r">Amount</th>' +
                            '</tr></thead><tbody>';
                        inv.forEach(function (i) {
                            tot += i.amount || 0;
                            h += '<tr>' +
                                '<td><a href="/app/sales-invoice/' + encodeURIComponent(i.invoice) + '" target="_blank">' +
                                    frappe.utils.escape_html(i.invoice) + '</a></td>' +
                                '<td>' + frappe.utils.escape_html(i.customer_name || i.customer || "") + '</td>' +
                                '<td class="r">' + format_currency_nodecimal(i.amount || 0, currency) + '</td>' +
                            '</tr>';
                        });
                        h += '<tr class="ucm-cat-total"><td colspan="2">Total (' + inv.length + ' invoices)</td>' +
                            '<td class="r">' + format_currency_nodecimal(tot, currency) + '</td></tr></tbody></table>';
                        _invCache[idx] = h;
                        $detail.html(h);
                    },
                    error: function () {
                        $detail.html('<div class="ucm-cat-detail-msg">Could not load invoices. Check that ' +
                            frappe.utils.escape_html(UCM_CATEGORY_INVOICES_METHOD) + ' is deployed and whitelisted.</div>');
                    }
                });
            });
        },
        error: function() {
            if (!$panel.closest("body").length) return;
            $wrap.html('<div class="ucm-sot-slider-empty">Could not load category-wise sales. Check that ' +
                frappe.utils.escape_html(UCM_CATEGORY_WISE_SALES_METHOD) + ' is deployed and whitelisted.</div>');
        }
    });

}



