    };

    function _svgPieChart(items, size) {
        size = size || 220;
        var r = size / 2 - 4, cx = size / 2, cy = size / 2;
        var total = items.reduce(function (s, it) { return s + Math.max(it.value, 0); }, 0) || 1;
        var angle = -90, paths = "";
        items.forEach(function (it, idx) {
            var val = Math.max(it.value, 0);
            var slice = (val / total) * 360;
            var x1 = cx + r * Math.cos((Math.PI / 180) * angle);
            var y1 = cy + r * Math.sin((Math.PI / 180) * angle);
            angle += slice;
            var x2 = cx + r * Math.cos((Math.PI / 180) * angle);
            var y2 = cy + r * Math.sin((Math.PI / 180) * angle);
            var large = slice > 180 ? 1 : 0;
            var color = it.color || PALETTE[idx % PALETTE.length];
            if (val > 0) {
                paths += '<path d="M' + cx + ',' + cy + ' L' + x1.toFixed(2) + ',' + y1.toFixed(2) +
                    ' A' + r + ',' + r + ' 0 ' + large + ' 1 ' + x2.toFixed(2) + ',' + y2.toFixed(2) +
                    ' Z" fill="' + color + '" stroke="#fff" stroke-width="2"/>';
            }
        });
        return '<svg width="' + size + '" height="' + size + '" viewBox="0 0 ' + size + ' ' + size + '">' + paths + '</svg>';
    }

    function _svgLegend(items, big) {
        var fs = big ? "15px" : "12px";
        var sw = big ? "14px" : "10px";
        var html = '<div style="display:flex; flex-direction:column; gap:' + (big ? "14px" : "8px") + ';">';
        items.forEach(function (it, idx) {
            var color = it.color || PALETTE[idx % PALETTE.length];
            html += '<div style="display:flex; align-items:center; gap:10px; font-size:' + fs + ';">' +
                '<span style="width:' + sw + '; height:' + sw + '; border-radius:3px; background:' + color + '; display:inline-block; flex-shrink:0;"></span>' +
                '<span style="flex:1;">' + frappe.utils.escape_html(it.label) + '</span>' +
                '<span style="font-weight:700;">' + it.display + '</span>' +
                '</div>';
        });
        html += '</div>';
        return html;
    }

    function _svgBarChart(items, big) {
        var maxAbs = items.reduce(function (m, it) { return Math.max(m, Math.abs(it.value)); }, 0) || 1;
        var fs = big ? "15px" : "12px";
        var barH = big ? "16px" : "10px";
        var html = '<div style="display:flex; flex-direction:column; gap:' + (big ? "16px" : "10px") + ';">';
        items.forEach(function (it) {
            var pct = Math.max(4, Math.round((Math.abs(it.value) / maxAbs) * 100));
            var color = it.value >= 0 ? "#1a6e3a" : "#c62828";
            html +=
                '<div>' +
                    '<div style="display:flex; justify-content:space-between; font-size:' + fs + '; margin-bottom:5px;">' +
                        '<span style="font-weight:600;">' + frappe.utils.escape_html(it.label) + '</span>' +
                        '<span style="font-weight:700; color:' + color + ';">' + (it.value >= 0 ? "▲ " : "▼ ") + it.display + '</span>' +
                    '</div>' +
                    '<div style="height:' + barH + '; background:#eef2fa; border-radius:6px; overflow:hidden;">' +
                        '<div style="height:100%; width:' + pct + '%; background:' + color + '; border-radius:6px;"></div>' +
                    '</div>' +
                '</div>';
        });
        html += '</div>';
        return html;
    }

