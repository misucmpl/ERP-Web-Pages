/* ═══════════════════════════════════════════════════════════════════════════
   UCM Dispatch & Sales Register — Web Page CSS
   Web Page → Style → "CSS" box mein poora paste karein.
   Palette: teal (Ultra / accent) + terracotta (Large Blow), baaki slate neutral.
   (Management report ke plum/gold se alag rakha gaya hai.)
   ═══════════════════════════════════════════════════════════════════════════ */

#ucm-dsr, .ucmd-nav-title, .ucmd-gear, .ucmd-drawer, .ucmd-modal-scrim, .ucmd-toast {
  --ink: #0f172a; --ink2: #334155; --mut: #64748b; --mut2: #94a3b8;
  --line: #e5e7eb; --line2: #f1f5f9; --soft: #f8fafc; --bg: #f6f7f9;
  --plum: #0f766e; --plum-d: #115e59; --plum-l: #e9f6f4; --plum-b: #c5e6e1;
  --gold: #c2612c; --gold-l: #fbeee6; --gold-b: #f0cfba;
  --ok: #15803d; --ok-l: #ecf8f0; --draft: #b45309; --draft-l: #fff5e8;
  --bad: #dc2626;
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}
#ucm-dsr *, #ucm-dsr *::before, #ucm-dsr *::after,
.ucmd-drawer *, .ucmd-modal-scrim * { box-sizing: border-box; }

body.ucmd-nav-merged, body.ucmd-nav-merged .page-content-wrapper, body.ucmd-nav-merged main,
body.ucmd-nav-merged .page_content, body.ucmd-nav-merged .page-content { background: var(--bg, #f6f7f9) !important; }
body.ucmd-nav-merged .page-header-wrapper, body.ucmd-nav-merged .page-breadcrumbs { display: none !important; }
body.ucmd-nav-merged main.container, body.ucmd-nav-merged .page-content-wrapper .container { max-width: 100% !important; padding-left: 0 !important; padding-right: 0 !important; }
/* Header (navbar) aur footer bhi poori screen ki width mein */
body.ucmd-nav-merged nav.navbar > .container,
body.ucmd-nav-merged .web-footer .container,
body.ucmd-nav-merged footer .container,
body.ucmd-nav-merged .footer-container { box-sizing: border-box !important; max-width: 100% !important; width: 100% !important; padding-left: 24px !important; padding-right: 24px !important; }
body.ucmd-nav-merged .web-footer, body.ucmd-nav-merged footer { background: #fff; border-top: 1px solid #e5e7eb; }

#ucm-dsr { color: var(--ink); font-size: 12.5px; line-height: 1.45; padding: 0; max-width: none; margin: 0; position: relative; }
#ucm-dsr button { font-family: inherit; }
#ucm-dsr a { color: var(--plum); text-decoration: none; }
#ucm-dsr a:hover { text-decoration: underline; }

/* ── progress line ── */
#ucm-dsr .ucmd-progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 1050; overflow: hidden; pointer-events: none; }
#ucm-dsr.is-busy .ucmd-progress::after {
  content: ""; position: absolute; top: 0; bottom: 0; width: 35%; left: -35%;
  background: linear-gradient(90deg, var(--plum), var(--gold)); animation: ucmdSlide 1.1s ease-in-out infinite;
}
@keyframes ucmdSlide { to { left: 100%; } }
.ucmd-spin { display: inline-block; width: 14px; height: 14px; border: 2px solid #c5e6e1; border-top-color: #0f766e; border-radius: 50%; animation: ucmdSpin .7s linear infinite; vertical-align: -2px; margin-right: 8px; }
@keyframes ucmdSpin { to { transform: rotate(360deg); } }
#ucm-dsr .ucmd-checking { padding: 110px 16px; text-align: center; color: var(--mut2); font-size: 13px; }

/* ═════ NAVBAR merge ═════ */
body.ucmd-nav-merged nav.navbar { background: #fff !important; border-bottom: 1px solid #e5e7eb; }
body.ucmd-nav-merged nav.navbar .navbar-brand { display: flex; align-items: center; margin-right: 0; }
body.ucmd-nav-merged nav.navbar .navbar-brand img { max-height: 40px !important; height: 40px; width: auto; }
.ucmd-nav-title { display: flex; flex-direction: column; justify-content: center; margin: 0 16px 0 14px; padding-left: 14px; border-left: 1px solid #e5e7eb; min-width: 0; }
.ucmd-nav-title h1, #ucm-dsr .ucmd-title h1 { margin: 0; font-size: 16.5px; font-weight: 700; color: #0f172a; letter-spacing: -.01em; line-height: 1.25; white-space: nowrap; }
.ucmd-nav-title .ucmd-sub, #ucm-dsr .ucmd-title .ucmd-sub { font-size: 11px; color: #64748b; white-space: nowrap; margin-top: 1px; }
@media (max-width: 1100px) { .ucmd-nav-title .ucmd-sub { display: none; } }
@media (max-width: 760px) { .ucmd-nav-title { display: none; } }

.ucmd-gear-li { display: flex; align-items: center; margin-right: 10px; list-style: none; }
.ucmd-gear {
  width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center;
  border: 1px solid #c5e6e1; background: #f2faf8; color: #0f766e; cursor: pointer; transition: background .15s, transform .3s;
}
.ucmd-gear:hover { background: #e2f3f0; }
.ucmd-gear:hover svg { transform: rotate(45deg); }
.ucmd-gear svg { transition: transform .35s; }

#ucm-dsr .ucmd-head { display: flex; align-items: center; gap: 12px; padding: 14px 24px; background: #fff; border-bottom: 1px solid var(--line); }
#ucm-dsr .ucmd-head.is-merged { display: none; }
#ucm-dsr .ucmd-head-actions { margin-left: auto; display: flex; gap: 8px; }

/* ═════ FILTER BAND (white, full width) ═════ */
#ucm-dsr .ucmd-band {
  display: flex; align-items: flex-end; gap: 12px; flex-wrap: wrap; padding: 12px 24px;
  background: #fff; border-bottom: 1px solid var(--line);
}
#ucm-dsr .ucmd-fgroup { display: flex; flex-direction: column; gap: 4px; }
#ucm-dsr .ucmd-flabel, #ucm-dsr .ucmd-field > span { font-size: 11.5px; font-weight: 500; color: var(--ink2); }
#ucm-dsr .ucmd-periods { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
#ucm-dsr .ucmd-chip {
  height: 32px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--line); background: #fff; color: var(--ink2);
  font-size: 12px; font-weight: 500; cursor: pointer; transition: all .15s;
}
#ucm-dsr .ucmd-chip:hover { border-color: var(--plum-b); color: var(--plum); background: var(--plum-l); }
#ucm-dsr .ucmd-chip.on { background: var(--plum); border-color: var(--plum); color: #fff; }
#ucm-dsr .ucmd-range { display: inline-flex; align-items: center; gap: 4px; height: 32px; padding: 0 6px 0 10px; border: 1px solid var(--line); border-radius: 8px; background: #fff; color: var(--mut2); }
#ucm-dsr .ucmd-range.on { border-color: var(--plum); box-shadow: 0 0 0 3px rgba(15,118,110,.1); }
#ucm-dsr .ucmd-range span { display: inline-flex; }
#ucm-dsr .ucmd-range input { border: 0; background: transparent; font: inherit; font-size: 12.5px; color: var(--ink); height: 28px; padding: 0 2px; outline: none; width: 116px; }
#ucm-dsr .ucmd-field { display: flex; flex-direction: column; gap: 4px; flex: 2 1 150px; min-width: 120px; max-width: none; margin: 0; }
#ucm-dsr .ucmd-field.is-sm { flex: 1 1 110px; min-width: 100px; }
#ucm-dsr .ucmd-field input, #ucm-dsr .ucmd-field select {
  height: 32px; width: 100%; padding: 0 10px; border: 1px solid var(--line); border-radius: 8px; background: #fff;
  font: inherit; font-size: 12.5px; color: var(--ink); outline: none; transition: border-color .15s, box-shadow .15s, background .15s;
}
#ucm-dsr .ucmd-field input::placeholder { color: var(--mut2); }
#ucm-dsr .ucmd-field input:focus, #ucm-dsr .ucmd-field select:focus { border-color: var(--plum); box-shadow: 0 0 0 3px rgba(15,118,110,.1); }
#ucm-dsr .ucmd-field input:not(:placeholder-shown) { background: var(--plum-l); border-color: var(--plum-b); }
#ucm-dsr .ucmd-clear { height: 32px; padding: 0 10px; border: 0; background: none; color: var(--plum); font-size: 12px; font-weight: 600; cursor: pointer; border-radius: 8px; }
#ucm-dsr .ucmd-clear:hover { background: var(--plum-l); }
#ucm-dsr .ucmd-band-actions { display: flex; gap: 8px; align-self: center; margin-left: 14px; }
#ucm-dsr .ucmd-pbtn {
  display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px; border-radius: 8px;
  border: 1px solid var(--plum-b); background: var(--plum-l); color: var(--plum-d); font-size: 12.5px; font-weight: 600; cursor: pointer; transition: background .15s;
}
#ucm-dsr .ucmd-pbtn:hover { background: #d9efeb; }
#ucm-dsr.is-busy #ucmd-refresh svg { animation: ucmdSpin .9s linear infinite; }

/* ═════ TABS (underline, full width) ═════ */
#ucm-dsr .ucmd-tabs { display: flex; align-items: flex-end; gap: 22px; padding: 0 24px; background: #fff; border-bottom: 1px solid var(--line); }
#ucm-dsr .ucmd-view {
  display: inline-flex; align-items: center; gap: 7px; height: 42px; padding: 0 2px; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px;
  background: none; color: var(--mut); font-size: 13px; font-weight: 600; cursor: pointer; transition: color .15s, border-color .15s;
}
#ucm-dsr .ucmd-view:hover { color: var(--ink); }
#ucm-dsr .ucmd-view.on { color: var(--plum); border-bottom-color: var(--plum); }
#ucm-dsr .ucmd-tab-count:empty { display: none; }
#ucm-dsr .ucmd-tab-count { font-size: 11px; font-weight: 700; padding: 1px 8px; border-radius: 99px; background: var(--plum-l); color: var(--plum); }
#ucm-dsr .ucmd-tabs-meta { margin-left: auto; align-self: center; font-size: 12px; color: var(--mut); }

#ucm-dsr .ucmd-main { padding: 16px 24px 48px; }

.ucmd-icon-btn {
  width: 32px; height: 32px; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; padding: 0;
  border-radius: 9px; border: 1px solid #c5e6e1; background: #fff; color: #0f766e; cursor: pointer; transition: background .15s, border-color .15s;
}
.ucmd-icon-btn:hover { background: #eef8f6; border-color: #9fd4cc; }
.ucmd-icon-btn.is-sm { width: 28px; height: 28px; border-radius: 8px; }
.ucmd-icon-btn.is-danger { color: #b91c1c; border-color: #f3d4d4; }
.ucmd-icon-btn.is-danger:hover { background: #fef2f2; border-color: #eab0b0; }

/* ═════ KPIs ═════ */
#ucm-dsr .ucmd-kpis { display: grid; grid-template-columns: 1.35fr 1fr 1fr 1.1fr 1.1fr; gap: 10px; margin-bottom: 12px; }
#ucm-dsr .ucmd-kpi {
  position: relative; text-align: left; font: inherit; color: inherit; padding: 12px 14px; border-radius: 12px;
  background: #fff; border: 1px solid var(--line); min-width: 0; display: flex; flex-direction: column; gap: 3px;
}
#ucm-dsr .ucmd-kpi-label { display: flex; align-items: center; gap: 6px; font-size: 10.5px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--mut); }
#ucm-dsr .ucmd-kpi-label em { font-style: normal; text-transform: none; letter-spacing: 0; font-weight: 500; color: var(--mut2); }
#ucm-dsr .ucmd-kpi-value { font-size: 22px; font-weight: 700; letter-spacing: -.02em; line-height: 1.15; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#ucm-dsr .ucmd-kpi-sub { font-size: 11.5px; color: var(--mut); display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
#ucm-dsr .ucmd-kpi-foot { margin-top: auto; padding-top: 6px; font-size: 11px; color: rgba(255,255,255,.75); }
#ucm-dsr .ucmd-kpi.is-hero { background: linear-gradient(135deg, #0b3f3b 0%, #0f5f58 55%, #12786f 100%); border-color: transparent; color: #fff; box-shadow: 0 10px 24px -14px rgba(11,63,59,.8); }
#ucm-dsr .ucmd-kpi.is-hero .ucmd-kpi-label, #ucm-dsr .ucmd-kpi.is-hero .ucmd-kpi-label em, #ucm-dsr .ucmd-kpi.is-hero .ucmd-kpi-sub { color: rgba(255,255,255,.82); }
#ucm-dsr .ucmd-kpi.is-hero .ucmd-kpi-value { color: #fff; font-size: 25px; }
#ucm-dsr .ucmd-kpi.is-hero::after { content: ""; position: absolute; right: -30px; top: -30px; width: 110px; height: 110px; border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,.12), transparent 70%); pointer-events: none; }
#ucm-dsr .ucmd-meter { height: 5px; border-radius: 99px; background: var(--line2); overflow: hidden; margin: 4px 0 2px; }
#ucm-dsr .ucmd-meter i { display: block; height: 100%; border-radius: 99px; background: var(--ok); }
#ucm-dsr .ucmd-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
#ucm-dsr .ucmd-dot.is-ok { background: var(--ok); }
#ucm-dsr .ucmd-dot.is-draft { background: #f59e0b; margin-left: 6px; }
#ucm-dsr .ucmd-kpi.is-seg { cursor: pointer; transition: border-color .15s, box-shadow .15s; border-top-width: 3px; }
#ucm-dsr .ucmd-kpi.is-ultra { border-top-color: var(--plum); }
#ucm-dsr .ucmd-kpi.is-lb { border-top-color: var(--gold); }
#ucm-dsr .ucmd-kpi.is-done { border-top-color: #475569; }
#ucm-dsr .ucmd-kpi.is-pending { border-top-color: #f59e0b; }
#ucm-dsr .ucmd-kpi.is-seg:hover { box-shadow: 0 6px 18px -12px rgba(15,23,42,.4); }
#ucm-dsr .ucmd-sw { width: 9px; height: 9px; border-radius: 3px; }
#ucm-dsr .ucmd-share { margin-left: auto; font-size: 11px; letter-spacing: 0; padding: 1px 7px; border-radius: 99px; }
#ucm-dsr .is-ultra .ucmd-sw, #ucm-dsr .is-ultra .ucmd-meter i { background: var(--plum); }
#ucm-dsr .is-ultra .ucmd-share { background: var(--plum-l); color: var(--plum); }
#ucm-dsr .is-ultra.on { border-color: var(--plum); box-shadow: 0 0 0 3px rgba(15,118,110,.12); }
#ucm-dsr .is-lb .ucmd-sw, #ucm-dsr .is-lb .ucmd-meter i { background: var(--gold); }
#ucm-dsr .is-lb .ucmd-share { background: var(--gold-l); color: #9a4519; }
#ucm-dsr .is-done .ucmd-sw, #ucm-dsr .is-done .ucmd-meter i { background: #475569; }
#ucm-dsr .is-done .ucmd-share { background: #f1f5f9; color: #334155; }
#ucm-dsr .is-done.on { border-color: #475569; box-shadow: 0 0 0 3px rgba(71,85,105,.14); }
#ucm-dsr .is-pending .ucmd-sw, #ucm-dsr .is-pending .ucmd-meter i { background: #f59e0b; }
#ucm-dsr .is-pending .ucmd-share { background: var(--draft-l); color: var(--draft); }
#ucm-dsr .is-pending.on { border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,.15); }
#ucm-dsr .is-lb.on { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(194,97,44,.15); }

/* ═════ CARDS ═════ */
#ucm-dsr .ucmd-card { background: #fff; border: 1px solid var(--line); border-radius: 12px; }
#ucm-dsr .ucmd-mini-empty, .ucmd-drawer .ucmd-mini-empty, .ucmd-modal .ucmd-mini-empty { padding: 22px 8px; text-align: center; color: var(--mut2); font-size: 12px; }

/* ═════ TABLE ═════ */
#ucm-dsr .ucmd-tablecard { overflow: hidden; }
#ucm-dsr .ucmd-table-head { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
#ucm-dsr .ucmd-th-title { font-size: 13px; font-weight: 700; color: var(--ink); }
.ucmd-search { display: flex; align-items: center; gap: 7px; flex: 0 1 420px; height: 31px; padding: 0 10px; border: 1px solid #e5e7eb; border-radius: 8px; background: #f8fafc; color: #94a3b8; margin: 0; }
.ucmd-search:focus-within { border-color: #0f766e; background: #fff; box-shadow: 0 0 0 3px rgba(15,118,110,.1); }
.ucmd-search input { border: 0; outline: none; background: transparent; font: inherit; font-size: 12.5px; color: #0f172a; width: 100%; height: 29px; padding: 0; }
#ucm-dsr .ucmd-info { margin-left: auto; font-size: 11.5px; color: var(--mut); white-space: nowrap; }

#ucm-dsr .ucmd-table-wrap { overflow-x: auto; overscroll-behavior: auto; }
#ucm-dsr .ucmd-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 11.5px; }
#ucm-dsr .ucmd-table th {
  position: sticky; top: 0; z-index: 1; text-align: left; white-space: nowrap; padding: 8px 6px; background: #f9fafb;
  font-size: 10.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--mut); border-bottom: 1px solid var(--line);
}
#ucm-dsr .ucmd-table td { padding: 5px 6px; vertical-align: top; color: var(--ink2); white-space: nowrap; }
#ucm-dsr .ucmd-table tr.b0 td { background: #fff; }
#ucm-dsr .ucmd-table tr.b1 td { background: #f7fafb; }
#ucm-dsr .ucmd-table tr.is-first td { padding-top: 7px; }
#ucm-dsr .ucmd-table tr.is-last td { padding-bottom: 7px; border-bottom: 1px solid var(--line2); }
#ucm-dsr .ucmd-table tbody tr:hover td { background: #eaf5f3; }
#ucm-dsr .ucmd-table .c-num { text-align: right; font-variant-numeric: tabular-nums; }
#ucm-dsr .ucmd-table .c-sn { width: 34px; color: var(--mut2); text-align: right; }
#ucm-dsr .ucmd-table .c-date { color: var(--ink); font-weight: 500; }
#ucm-dsr .ucmd-table .c-doc a { font-weight: 600; }
#ucm-dsr .ucmd-table .c-cust span { display: inline-block; max-width: 160px; overflow: hidden; text-overflow: ellipsis; vertical-align: top; color: var(--ink); font-weight: 500; }
#ucm-dsr .ucmd-table .c-item { white-space: normal; min-width: 190px; max-width: 260px; }
#ucm-dsr .ucmd-table .c-item a { color: var(--ink); }
#ucm-dsr .ucmd-table .c-item a:hover { color: var(--plum); text-decoration: underline dotted; }
#ucm-dsr .ucmd-table .c-qty { color: var(--ink); font-weight: 600; }
#ucm-dsr .ucmd-table .c-amt { color: var(--ink); font-weight: 600; }
#ucm-dsr .ucmd-table .c-frt span { display: inline-block; max-width: 120px; overflow: hidden; text-overflow: ellipsis; vertical-align: top; }
#ucm-dsr .ucmd-table .c-cat { color: var(--mut); max-width: 110px; overflow: hidden; text-overflow: ellipsis; }
#ucm-dsr .ucmd-table .c-loc { max-width: 150px; overflow: hidden; text-overflow: ellipsis; }
#ucm-dsr .ucmd-table tfoot td { padding: 9px 8px; background: #eef7f5; border-top: 1px solid var(--plum-b); font-weight: 700; color: var(--ink); white-space: nowrap; }
#ucm-dsr .ucmd-table tfoot td:first-child { font-weight: 500; color: var(--mut); font-size: 11px; }

.ucmd-pill { display: inline-flex; align-items: center; gap: 5px; padding: 1px 8px 1px 6px; border-radius: 99px; font-size: 10.5px; font-weight: 600; }
.ucmd-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.ucmd-pill.is-ok { background: #ecf8f0; color: #15803d; }
.ucmd-pill.is-draft { background: #fff5e8; color: #b45309; }
.ucmd-type { display: inline-block; padding: 1px 7px; border-radius: 5px; font-size: 10.5px; font-weight: 600; }
.ucmd-type.is-ultra { background: #e9f6f4; color: #0f766e; }
.ucmd-type.is-lb { background: #fbeee6; color: #9a4519; }

#ucm-dsr .ucmd-more-wrap { padding: 12px; text-align: center; border-top: 1px solid var(--line2); }
#ucm-dsr .ucmd-more { border: 1px solid var(--plum-b); background: #fff; color: var(--plum); border-radius: 99px; height: 30px; padding: 0 16px; font-size: 12px; font-weight: 600; cursor: pointer; }
#ucm-dsr .ucmd-more:hover { background: var(--plum-l); }

.ucmd-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 48px 16px; color: #94a3b8; font-size: 12.5px; text-align: center; }
.ucmd-empty b { color: #334155; font-size: 13px; }
.ucmd-empty .ucmd-spin { margin: 0 0 4px; }
.ucmd-error { margin: 14px; padding: 12px 14px; border-radius: 10px; background: #fef2f2; border: 1px solid #fbd5d5; color: #991b1b; font-size: 12.5px; }
.ucmd-error div { margin-top: 4px; color: #7f1d1d; }

/* ═════ BUTTONS (shared) ═════ */
.ucmd-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 32px; padding: 0 14px; border-radius: 9px;
  font: inherit; font-size: 12.5px; font-weight: 600; text-decoration: none !important; cursor: pointer;
  color: #115e59; background: #fff; border: 1px solid #c5e6e1; transition: background .15s, box-shadow .15s; white-space: nowrap;
}
.ucmd-btn:hover { background: #eef8f6; }
.ucmd-btn.is-primary { color: #fff; background: #0f766e; border-color: #0f766e; box-shadow: 0 6px 16px -8px rgba(15,118,110,.7); }
.ucmd-btn.is-primary:hover { background: #0d5f59; }
#ucm-dsr a.ucmd-btn { color: #115e59; text-decoration: none; }
#ucm-dsr a.ucmd-btn.is-primary { color: #fff; }

/* ═════ DRAWER (sliders) ═════ */
.ucmd-scrim { position: fixed; inset: 0; background: rgba(15,23,42,.28); backdrop-filter: blur(1.5px); opacity: 0; pointer-events: none; transition: opacity .2s; z-index: 1040; }
.ucmd-scrim.on { opacity: 1; pointer-events: auto; }
.ucmd-drawer {
  position: fixed; top: 0; right: 0; bottom: 0; width: min(560px, 96vw); background: #fff; z-index: 1041;
  box-shadow: -18px 0 48px -20px rgba(15,23,42,.45); transform: translateX(105%); transition: transform .26s cubic-bezier(.2,.8,.2,1);
  display: flex; flex-direction: column; color: #0f172a; font-size: 12.5px;
}
.ucmd-drawer.on { transform: none; }
.ucmd-dr-head { display: flex; align-items: flex-start; gap: 12px; padding: 16px 18px 12px; border-bottom: 1px solid #e5e7eb; background: linear-gradient(180deg, #f2faf8, #fff); position: relative; }
.ucmd-dr-head::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: linear-gradient(90deg, #0f766e, #c2612c); }
.ucmd-dr-titles { flex: 1 1 auto; min-width: 0; }
.ucmd-dr-kicker { font-size: 10.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #b45a2a; }
.ucmd-dr-head h3 { margin: 2px 0 0; font-size: 16px; font-weight: 700; line-height: 1.3; color: #0f172a; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.ucmd-dr-sub { font-size: 11.5px; color: #64748b; margin-top: 2px; }
.ucmd-dr-sub a { color: #0f766e; font-weight: 600; text-decoration: none; }
.ucmd-dr-actions { display: flex; gap: 6px; }
.ucmd-dr-body { flex: 1 1 auto; overflow-y: auto; overscroll-behavior: auto; padding: 14px 18px 24px; }
.ucmd-dr-desc { margin: 0 0 12px; font-size: 12px; color: #64748b; }
.ucmd-stockcard { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px; border-radius: 12px; background: linear-gradient(135deg, #e9f6f4, #fbeee6); border: 1px solid #d4ebe7; margin-bottom: 12px; }
.ucmd-stockcard .ucmd-kpi-label { font-size: 10.5px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: #64748b; }
.ucmd-stock-val { font-size: 24px; font-weight: 700; color: #115e59; letter-spacing: -.02em; }
.ucmd-stock-val small { font-size: 12px; font-weight: 600; color: #64748b; margin-left: 5px; }
.ucmd-stock-note { text-align: right; font-size: 11px; color: #64748b; }
.ucmd-seg { display: inline-flex; padding: 3px; gap: 2px; background: #eef1f4; border-radius: 9px; margin-bottom: 10px; }
.ucmd-seg button { border: 0; background: none; height: 27px; padding: 0 11px; border-radius: 7px; font: inherit; font-size: 12px; font-weight: 600; color: #64748b; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
.ucmd-seg button span { font-size: 10.5px; padding: 0 6px; border-radius: 99px; background: rgba(15,23,42,.06); }
.ucmd-seg button.on { background: #fff; color: #0f766e; box-shadow: 0 1px 3px rgba(15,23,42,.1); }
.ucmd-mtable { width: 100%; border-collapse: collapse; font-size: 12px; }
.ucmd-mtable th { text-align: left; font-size: 10.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: #64748b; padding: 7px 8px; background: #f9fafb; border-bottom: 1px solid #e5e7eb; position: sticky; top: -14px; }
.ucmd-mtable td { padding: 6px 8px; border-bottom: 1px solid #f1f5f9; color: #334155; }
.ucmd-mtable tbody tr:nth-child(even) td { background: #fcfcfd; }
.ucmd-mtable .c-num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.ucmd-mtable .is-in { color: #15803d; font-weight: 600; }
.ucmd-mtable .is-out { color: #dc2626; font-weight: 600; }
.ucmd-mtable.is-click tbody tr { cursor: pointer; }
.ucmd-mtable.is-click tbody tr:hover td { background: #e9f6f4; }
.ucmd-mtable a { color: #115e59; text-decoration: none; font-weight: 500; }
.ucmd-mtable a:hover { text-decoration: underline; }
.ucmd-linkish { color: #115e59; font-weight: 600; }
.ucmd-dr-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 12px; }
.ucmd-dr-stats div { padding: 9px 12px; border-radius: 10px; background: #f9fafb; border: 1px solid #eef1f4; min-width: 0; }
.ucmd-dr-stats span { display: block; font-size: 10.5px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: #94a3b8; }
.ucmd-dr-stats b { display: block; font-size: 16px; font-weight: 700; color: #0f172a; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ucmd-dr-stats b.is-text { font-size: 13px; color: #115e59; }
.ucmd-back { display: inline-flex; align-items: center; gap: 4px; border: 0; background: #e9f6f4; color: #0f766e; font: inherit; font-size: 12px; font-weight: 600; padding: 5px 10px 5px 7px; border-radius: 8px; cursor: pointer; margin-bottom: 10px; }

/* ═════ SETTINGS MODAL ═════ */
.ucmd-modal-scrim { position: fixed; inset: 0; z-index: 1060; background: rgba(15,23,42,.35); backdrop-filter: blur(2px); display: flex; align-items: flex-start; justify-content: center; padding: 7vh 16px 16px; opacity: 0; pointer-events: none; transition: opacity .18s; }
.ucmd-modal-scrim.on { opacity: 1; pointer-events: auto; }
.ucmd-modal {
  width: 100%; max-width: 640px; max-height: 84vh; display: flex; flex-direction: column; background: #fff; border-radius: 16px; overflow: hidden;
  box-shadow: 0 30px 80px -30px rgba(15,23,42,.6); color: #0f172a; font-size: 12.5px; transform: translateY(8px); transition: transform .2s;
}
.ucmd-modal-scrim.on .ucmd-modal { transform: none; }
.ucmd-modal.is-busy { opacity: .7; pointer-events: none; }
.ucmd-modal-head { display: flex; align-items: flex-start; gap: 12px; padding: 18px 18px 14px; border-bottom: 1px solid #eef1f4; position: relative; }
.ucmd-modal-head::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: linear-gradient(90deg, #0f766e, #c2612c); }
.ucmd-modal-head > div { flex: 1 1 auto; }
.ucmd-modal-head h3 { margin: 0; font-size: 16px; font-weight: 700; }
.ucmd-modal-head p { margin: 2px 0 0; font-size: 12px; color: #64748b; }
.ucmd-modal-ico { width: 36px; height: 36px; flex: 0 0 36px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; background: #e9f6f4; color: #0f766e; }
.ucmd-levels { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; padding: 12px 18px; background: #fafbfc; border-bottom: 1px solid #eef1f4; }
.ucmd-level { padding: 9px 10px; border-radius: 10px; background: #fff; border: 1px solid #eef1f4; }
.ucmd-level b { display: flex; align-items: center; gap: 6px; font-size: 12px; margin-bottom: 2px; }
.ucmd-level span { font-size: 11px; color: #64748b; line-height: 1.4; display: block; }
.ucmd-level.is-dispatch b { color: #9a4519; }
.ucmd-level.is-sales b { color: #0f766e; }
.ucmd-level.is-full b { color: #1e293b; }
.ucmd-level.is-admin b { color: #334155; }
.ucmd-add { display: flex; gap: 8px; padding: 12px 18px; border-bottom: 1px solid #eef1f4; align-items: center; }
.ucmd-add .ucmd-search { flex: 1 1 auto; }
.ucmd-add select, .ucmd-lvl-sel { height: 31px; border: 1px solid #e5e7eb; border-radius: 8px; background: #fff; font: inherit; font-size: 12px; color: #0f172a; padding: 0 8px; outline: none; cursor: pointer; }
.ucmd-add select:focus, .ucmd-lvl-sel:focus { border-color: #0f766e; box-shadow: 0 0 0 3px rgba(15,118,110,.1); }
.ucmd-ulist { overflow-y: auto; overscroll-behavior: auto; padding: 4px 10px 10px; flex: 1 1 auto; }
.ucmd-ulist-head { padding: 10px 8px 6px; font-size: 12px; font-weight: 650; color: #0f172a; }
.ucmd-ulist-head span { font-weight: 500; color: #94a3b8; margin-left: 6px; font-size: 11px; }
.ucmd-urow { display: flex; align-items: center; gap: 10px; padding: 7px 8px; border-radius: 10px; }
.ucmd-urow:hover { background: #f9fafb; }
.ucmd-urow.is-off { opacity: .55; }
.ucmd-av { width: 30px; height: 30px; flex: 0 0 30px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: #fff; background: #0f766e; }
.ucmd-av.is-dispatch { background: #c2612c; }
.ucmd-av.is-sales { background: #0f766e; }
.ucmd-av.is-full { background: #1e293b; }
.ucmd-av.is-admin { background: #334155; }
.ucmd-uname { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
.ucmd-uname b { font-size: 12.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ucmd-uname b em { font-style: normal; font-size: 10px; font-weight: 600; padding: 1px 6px; border-radius: 99px; background: #eef1f4; color: #64748b; margin-left: 4px; vertical-align: 1px; }
.ucmd-uname small { font-size: 11px; color: #94a3b8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ucmd-lvl { display: inline-flex; align-items: center; gap: 5px; height: 28px; padding: 0 10px; border-radius: 8px; font-size: 11.5px; font-weight: 600; background: #f1f5f9; color: #334155; }
.ucmd-lvl-sel { height: 28px; font-weight: 600; }
.ucmd-lvl-sel.is-sales { color: #0f766e; background: #eef8f6; border-color: #c5e6e1; }
.ucmd-lvl-sel.is-full { color: #1e293b; background: #f1f5f9; border-color: #cbd5e1; }
.ucmd-lvl-sel.is-dispatch { color: #9a4519; background: #fdf3ec; border-color: #f0cfba; }
.ucmd-rm-ph { width: 28px; flex: 0 0 28px; }
.ucmd-modal-foot { padding: 10px 18px; border-top: 1px solid #eef1f4; font-size: 11px; color: #94a3b8; background: #fafbfc; }
.ucmd-modal-foot code, .ucmd-error code { font-size: 10.5px; background: rgba(15,23,42,.06); padding: 1px 5px; border-radius: 4px; color: inherit; }

/* ═════ TOAST ═════ */
.ucmd-toast { position: fixed; left: 50%; bottom: 24px; transform: translate(-50%, 16px); z-index: 1100; background: #0f172a; color: #fff; padding: 9px 16px; border-radius: 10px; font-size: 12.5px; font-weight: 500; box-shadow: 0 12px 30px -12px rgba(15,23,42,.6); opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s; }
.ucmd-toast.on { opacity: 1; transform: translate(-50%, 0); }
.ucmd-toast.is-bad { background: #b91c1c; }

/* ═════ ACCESS GATE ═════ */
#ucm-dsr.ucmd-locked { padding: 0; max-width: none; }
.ucmd-gate {
  min-height: calc(100vh - 140px); display: flex; align-items: center; justify-content: center; padding: 40px 16px;
  background: radial-gradient(600px 300px at 50% 0%, rgba(15,118,110,.07), transparent 70%), radial-gradient(400px 220px at 85% 100%, rgba(208,122,69,.07), transparent 70%);
}
.ucmd-gate-card { position: relative; overflow: hidden; width: 100%; max-width: 440px; background: #fff; border: 1px solid #d4ebe7; border-radius: 16px; box-shadow: 0 1px 2px rgba(15,23,42,.04), 0 18px 48px -18px rgba(19,78,74,.28); padding: 34px 32px 22px; text-align: center; }
.ucmd-gate-band { position: absolute; inset: 0 0 auto 0; height: 4px; background: linear-gradient(90deg, #0f766e 0%, #2a9d8f 55%, #d07a45 100%); }
.ucmd-gate-icon { width: 64px; height: 64px; margin: 0 auto 16px; border-radius: 18px; display: flex; align-items: center; justify-content: center; color: #0f766e; background: linear-gradient(145deg, #ecf7f5, #e0f2ef); box-shadow: inset 0 0 0 1px #cfe8e3; }
.ucmd-gate-kicker { font-size: 10.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #b45a2a; }
.ucmd-gate-title { margin: 6px 0 8px; font-size: 21px; font-weight: 700; color: #0f172a; letter-spacing: -.01em; }
.ucmd-gate-text { margin: 0 auto; max-width: 350px; font-size: 13px; line-height: 1.6; color: #64748b; }
.ucmd-gate-text b { color: #134e4a; font-weight: 600; }
.ucmd-gate-user { display: inline-flex; align-items: center; gap: 8px; margin-top: 16px; padding: 4px 12px 4px 4px; border-radius: 999px; background: #f8fafc; border: 1px solid #eef0f3; font-size: 12px; color: #334155; }
.ucmd-gate-user .ucmd-av { width: 22px; height: 22px; flex-basis: 22px; font-size: 10px; }
.ucmd-gate-actions { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 22px; }
.ucmd-gate-foot { margin-top: 22px; padding-top: 12px; border-top: 1px dashed #eef0f3; font-size: 10.5px; color: #94a3b8; letter-spacing: .04em; }

/* ═════ RESPONSIVE ═════ */
@media (max-width: 1280px) {
  #ucm-dsr .ucmd-kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  #ucm-dsr .ucmd-kpi.is-hero { grid-column: span 3; }
}
@media (max-width: 900px) {
  #ucm-dsr { padding: 12px 12px 40px; }
  #ucm-dsr .ucmd-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  #ucm-dsr .ucmd-kpi.is-hero { grid-column: span 2; }
  #ucm-dsr .ucmd-periods { margin-left: 0; }
  .ucmd-levels { grid-template-columns: 1fr; }
  .ucmd-add { flex-wrap: wrap; }
}

/* ═════ Category Wise slider ═════ */
.ucmd-drawer[data-kind="category"] { width: min(760px, 96vw); }
#ucm-dsr .ucmd-pbtn.is-alt { background: #fbeee6; border-color: #f0cfba; color: #9a4519; }
#ucm-dsr .ucmd-pbtn.is-alt:hover { background: #f8e2d4; }
.ucmd-share-cell { display: inline-block; width: 54px; height: 5px; border-radius: 99px; background: #f1f5f9; overflow: hidden; margin-right: 8px; vertical-align: middle; }
.ucmd-share-cell i { display: block; height: 100%; background: #0f766e; border-radius: 99px; }
.ucmd-dr-note { margin: 10px 2px 0; font-size: 11px; color: #94a3b8; }

/* ═════ PRINT: category slider ═════ */
@media print {
  body.ucmd-print-drawer > *:not(.ucmd-drawer) { display: none !important; }
  body.ucmd-print-drawer .ucmd-drawer { position: static; transform: none; width: 100% !important; box-shadow: none; }
  body.ucmd-print-drawer .ucmd-dr-actions, body.ucmd-print-drawer .ucmd-back, body.ucmd-print-drawer .ucmd-dr-note { display: none !important; }
  body.ucmd-print-drawer .ucmd-dr-body { overflow: visible; }
}

/* ═════ SALES PERSON tab ═════ */
#ucm-dsr .ucmd-persons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; align-items: start; }
#ucm-dsr .ucmd-persons[hidden], #ucm-dsr .ucmd-tablecard[hidden] { display: none; }
#ucm-dsr .ucmd-ptable { overflow: hidden; border-top-width: 3px; }
#ucm-dsr .ucmd-ptable.is-ultra { border-top-color: var(--plum); }
#ucm-dsr .ucmd-ptable.is-lb { border-top-color: var(--gold); }
#ucm-dsr .ucmd-ptable-head { display: flex; align-items: center; gap: 8px; padding: 12px 14px; border-bottom: 1px solid var(--line); }
#ucm-dsr .ucmd-ptable-head b { font-size: 13.5px; font-weight: 700; color: var(--ink); }
#ucm-dsr .ucmd-ptable.is-ultra .ucmd-sw { background: var(--plum); }
#ucm-dsr .ucmd-ptable.is-lb .ucmd-sw { background: var(--gold); }
#ucm-dsr .ucmd-ptable-tot { margin-left: auto; font-size: 13px; font-weight: 700; padding: 3px 10px; border-radius: 99px; }
#ucm-dsr .ucmd-ptable.is-ultra .ucmd-ptable-tot { background: var(--plum-l); color: var(--plum-d); }
#ucm-dsr .ucmd-ptable.is-lb .ucmd-ptable-tot { background: var(--gold-l); color: #9a4519; }
#ucm-dsr .ucmd-ptbl { font-size: 12.5px; }
#ucm-dsr .ucmd-ptbl td { padding: 8px 10px; vertical-align: middle; }
#ucm-dsr .ucmd-ptbl th { padding: 8px 10px; }
#ucm-dsr .ucmd-ptbl .c-rank { width: 40px; }
#ucm-dsr .ucmd-ptbl .c-pct { width: 150px; }
#ucm-dsr .ucmd-ptable.is-lb .ucmd-share-cell i { background: var(--gold); }
#ucm-dsr .ucmd-person { border: 0; background: none; padding: 0; font: inherit; font-weight: 600; color: var(--plum-d); cursor: pointer; text-align: left; }
#ucm-dsr .ucmd-ptable.is-lb .ucmd-person { color: #9a4519; }
#ucm-dsr .ucmd-person:hover { text-decoration: underline; }
#ucm-dsr .ucmd-ptbl tbody tr:hover td { background: #f3f8f7; }

.ucmd-drawer[data-kind="person"] { width: min(900px, 96vw); }
.ucmd-dbtn { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 12px; border-radius: 8px; border: 1px solid #c5e6e1; background: #e9f6f4; color: #115e59; font: inherit; font-size: 12px; font-weight: 600; cursor: pointer; }
.ucmd-dbtn:hover { background: #d9efeb; }
.ucmd-pp-tools { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
.ucmd-pp-tools .ucmd-seg { margin-bottom: 0; }
.ucmd-pp-tools .ucmd-search { flex: 1 1 220px; }
.ucmd-mtable .c-muted { color: #94a3b8; width: 32px; }
.ucmd-mtable .ucmd-sort { cursor: pointer; user-select: none; }
.ucmd-mtable .ucmd-sort:hover { color: #0f766e; }
.ucmd-pp-foot { display: flex; justify-content: space-between; align-items: center; padding: 12px 18px; border-top: 1px solid #e5e7eb; background: #f8fafc; font-size: 12.5px; color: #64748b; }
.ucmd-pp-foot b { font-size: 15px; color: #0f172a; }
@media (max-width: 1000px) { #ucm-dsr .ucmd-persons { grid-template-columns: 1fr; } }
#ucm-dsr .ucmd-pbtn[hidden], #ucm-dsr .ucmd-field[hidden] { display: none !important; }

/* ═════ Slider header: rangeen background (dark teal) ═════ */
.ucmd-dr-head { background: linear-gradient(135deg, #0b3f3b 0%, #0f5f58 60%, #12786f 100%); border-bottom: 0; color: #fff; padding: 18px 18px 16px; }
.ucmd-dr-head::before { height: 3px; background: linear-gradient(90deg, #d07a45, #f0cfba); }
.ucmd-dr-head .ucmd-dr-kicker { color: #f6c7a6; }
.ucmd-dr-head h3 { color: #fff; }
.ucmd-dr-head .ucmd-dr-sub { color: rgba(255,255,255,.78); }
.ucmd-dr-head .ucmd-dr-sub a { color: #9ee6dc; }
.ucmd-dr-head .ucmd-icon-btn { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.28); color: #fff; }
.ucmd-dr-head .ucmd-icon-btn:hover { background: rgba(255,255,255,.22); border-color: rgba(255,255,255,.45); }
.ucmd-dr-head .ucmd-dbtn { background: #fff; border-color: #fff; color: #0f5f58; }
.ucmd-dr-head .ucmd-dbtn:hover { background: #e9f6f4; }
@media print { body.ucmd-print-drawer .ucmd-dr-head { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }

/* ═════ WHITE DROPDOWN (sab filters + settings ek jaise) ═════ */
.ucmd-dd { position: relative; width: 100%; }
.ucmd-dd .ucmd-dd-in {
  width: 100%; height: 32px; padding: 0 52px 0 10px !important; border: 1px solid #e5e7eb; border-radius: 8px; background: #fff;
  font: inherit; font-size: 12.5px; color: #0f172a; outline: none; cursor: text; text-overflow: ellipsis;
  transition: border-color .15s, box-shadow .15s, background .15s;
}
.ucmd-dd .ucmd-dd-in[readonly] { cursor: pointer; padding-right: 30px !important; }
.ucmd-dd .ucmd-dd-in::placeholder { color: #94a3b8; }
.ucmd-dd.open .ucmd-dd-in, .ucmd-dd .ucmd-dd-in:focus { border-color: #0f766e; box-shadow: 0 0 0 3px rgba(15,118,110,.1); background: #fff !important; }
#ucm-dsr .ucmd-dd.has-val .ucmd-dd-in { background: #e9f6f4; border-color: #c5e6e1; color: #115e59; font-weight: 600; }
.ucmd-dd-caret { position: absolute; right: 9px; top: 50%; transform: translateY(-50%); color: #94a3b8; pointer-events: none; display: inline-flex; transition: transform .15s; }
.ucmd-dd.open .ucmd-dd-caret { transform: translateY(-50%) rotate(180deg); color: #0f766e; }
.ucmd-dd-x { position: absolute; right: 27px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; border: 0; border-radius: 50%; background: #cfe8e3; color: #115e59; display: none; align-items: center; justify-content: center; padding: 0; cursor: pointer; }
.ucmd-dd-x:hover { background: #9fd4cc; }
.ucmd-dd.has-val .ucmd-dd-x { display: inline-flex; }
.ucmd-dd-menu {
  position: fixed; z-index: 1080; display: none; max-height: 280px; overflow-y: auto; overscroll-behavior: contain;
  background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 4px;
  box-shadow: 0 16px 40px -12px rgba(15,23,42,.28), 0 2px 6px rgba(15,23,42,.06);
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; max-width: 420px;
}
.ucmd-dd.open .ucmd-dd-menu { display: block; }
.ucmd-dd-opt { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 7px; cursor: pointer; color: #334155; font-size: 12.5px; }
.ucmd-dd-opt:hover, .ucmd-dd-opt.act { background: #f1f5f9; }
.ucmd-dd-opt.sel { color: #0f766e; background: #e9f6f4; }
.ucmd-dd-opt.sel b { font-weight: 600; }
.ucmd-dd-opt svg { margin-left: auto; flex: 0 0 auto; color: #0f766e; }
.ucmd-dd-l { display: flex; flex-direction: column; min-width: 0; }
.ucmd-dd-l b { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ucmd-dd-l small { font-size: 11px; color: #94a3b8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ucmd-dd-none { padding: 12px 10px; color: #94a3b8; font-size: 12px; text-align: center; }
/* settings modal */
.ucmd-add .ucmd-add-user { flex: 1 1 auto; }
.ucmd-add .ucmd-add-level { flex: 0 0 236px; }
.ucmd-lvl-dd { width: 236px; flex: 0 0 236px; }
.ucmd-lvl-dd .ucmd-dd-in { height: 28px; font-weight: 600; }
.ucmd-lvl-dd.is-dispatch .ucmd-dd-in { color: #9a4519; background: #fdf3ec; border-color: #f0cfba; }
.ucmd-lvl-dd.is-sales .ucmd-dd-in { color: #0f766e; background: #eef8f6; border-color: #c5e6e1; }
.ucmd-lvl-dd.is-full .ucmd-dd-in { color: #1e293b; background: #f1f5f9; border-color: #cbd5e1; }

/* Filter row poori width bhare (last field tak) */
#ucm-dsr .ucmd-band { flex-wrap: nowrap; }
@media (max-width: 1200px) { #ucm-dsr .ucmd-band { flex-wrap: wrap; } }
#ucm-dsr .ucmd-clear { flex: 0 0 auto; }
#ucm-dsr .ucmd-fgroup { flex: 0 0 auto; }
#ucm-dsr .ucmd-band .ucmd-periods { flex-wrap: nowrap; }
#ucm-dsr .ucmd-band .ucmd-field { min-width: 96px; }
#ucm-dsr .ucmd-band .ucmd-field.is-sm { min-width: 88px; }
#ucm-dsr .ucmd-clear { padding: 0 8px; }

/* ═════ Kal ke Draft dispatches — popup ═════ */
.ucmd-draft-modal { max-width: 820px; }
.ucmd-draft-head { display: flex; align-items: flex-start; gap: 14px; padding: 18px 18px 16px; background: linear-gradient(135deg, #fff7ed, #fffbeb); border-bottom: 1px solid #fde4c3; position: relative; }
.ucmd-draft-head::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: linear-gradient(90deg, #f59e0b, #d07a45); }
.ucmd-draft-head > div { flex: 1 1 auto; }
.ucmd-draft-ico { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: #fef3c7; color: #b45309; box-shadow: inset 0 0 0 1px #fde68a; }
.ucmd-draft-kicker { font-size: 10.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #b45309; }
.ucmd-draft-head h3 { margin: 2px 0 4px; font-size: 17px; font-weight: 700; color: #0f172a; }
.ucmd-draft-head p { margin: 0; font-size: 12.5px; color: #64748b; line-height: 1.5; }
.ucmd-draft-head p b { color: #9a4519; }
.ucmd-draft-body { overflow-y: auto; overscroll-behavior: auto; padding: 6px 18px 4px; max-height: 52vh; }
.ucmd-draft-body .ucmd-mtable th { top: -6px; }
.ucmd-draft-link { display: inline-flex; align-items: center; gap: 4px; font-weight: 700 !important; color: #b45309 !important; }
.ucmd-draft-link svg { opacity: .6; }
.ucmd-draft-lines { color: #94a3b8; font-size: 11px; }
.ucmd-draft-foot { display: flex; justify-content: flex-end; gap: 8px; padding: 12px 18px; border-top: 1px solid #eef1f4; background: #fafbfc; }

/* ═════════════ MOBILE (phone) ═════════════ */
#ucm-dsr .ucmd-vs { display: none; }
#ucm-dsr #ucmd-cat-btn { white-space: nowrap; }
#ucm-dsr .ucmd-mcards { display: flex; flex-direction: column; gap: 10px; padding: 10px; background: #f6f8fa; }
#ucm-dsr .ucmd-mc { position: relative; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px 0 14px; overflow: hidden; }
#ucm-dsr .ucmd-mc::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: #cbd5e1; }
#ucm-dsr .ucmd-mc.is-ultra::before { background: #0f766e; }
#ucm-dsr .ucmd-mc.is-lb::before { background: #c2622d; }
#ucm-dsr .ucmd-mc.is-draft { background: #fffcf5; border-color: #fde4c3; }
#ucm-dsr .ucmd-mc-top { display: flex; align-items: center; gap: 8px; }
#ucm-dsr .ucmd-mc-sn { font-size: 11px; color: var(--mut2); min-width: 14px; }
#ucm-dsr .ucmd-mc-doc { font-weight: 700; font-size: 13px; color: var(--plum); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#ucm-dsr .ucmd-mc-date { margin-left: auto; font-size: 12px; color: var(--mut); white-space: nowrap; }
#ucm-dsr .ucmd-mc-cust { margin-top: 3px; font-size: 14px; font-weight: 600; color: var(--ink); line-height: 1.3; }
#ucm-dsr .ucmd-mc-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 6px; }
#ucm-dsr .ucmd-mc-meta { font-size: 11.5px; color: var(--mut); min-width: 0; overflow-wrap: anywhere; }
#ucm-dsr .ucmd-mc-lines { margin-top: 8px; border-top: 1px dashed #e6eaef; }
#ucm-dsr .ucmd-mc-line { display: flex; align-items: flex-start; gap: 10px; padding: 7px 0; border-bottom: 1px dashed #eef1f4; font-size: 12.5px; }
#ucm-dsr .ucmd-mc-line:last-child { border-bottom: 0; }
#ucm-dsr .ucmd-mc-line .ucmd-item { flex: 1 1 auto; min-width: 0; color: var(--ink2); text-decoration: none; line-height: 1.35; }
#ucm-dsr .ucmd-mc-q { flex: 0 0 auto; text-align: right; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
#ucm-dsr .ucmd-mc-q small { display: block; font-size: 11px; font-weight: 500; color: var(--mut); }
#ucm-dsr .ucmd-mc-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 -12px 0 -14px; padding: 7px 12px 8px 14px; background: #f8fafb; border-top: 1px solid #eef1f4; font-size: 11.5px; color: var(--mut); }
#ucm-dsr .ucmd-mc-foot span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#ucm-dsr .ucmd-mc-foot b { flex: 0 0 auto; color: var(--ink2); font-weight: 600; }
#ucm-dsr .ucmd-mc-total { display: flex; justify-content: space-between; gap: 10px; padding: 10px 14px; border-top: 1px solid var(--line); font-size: 12px; color: var(--mut); background: #fff; }
#ucm-dsr .ucmd-mc-total b { color: var(--ink); }

@media (max-width: 700px) {
  html, body { overflow-x: hidden; }

  /* filters: period scroll row · date full · fields 2-up */
  #ucm-dsr .ucmd-band { display: grid !important; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 10px 8px; padding: 12px; }
  #ucm-dsr .ucmd-band > .ucmd-fgroup { grid-column: 1 / -1; min-width: 0; }
  #ucm-dsr .ucmd-band .ucmd-periods { overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; margin: 0 -12px; padding: 0 12px 2px; }
  #ucm-dsr .ucmd-band .ucmd-periods::-webkit-scrollbar { display: none; }
  #ucm-dsr .ucmd-chip { flex: 0 0 auto; height: 34px; padding: 0 12px; }
  #ucm-dsr .ucmd-range { display: flex; width: 100%; height: 36px; }
  #ucm-dsr .ucmd-range input { flex: 1 1 0; width: auto; min-width: 0; }
  #ucm-dsr .ucmd-band .ucmd-field, #ucm-dsr .ucmd-band .ucmd-field.is-sm { min-width: 0; }
  #ucm-dsr .ucmd-band .ucmd-field[data-fk="customer"] { grid-column: 1 / -1; }
  #ucm-dsr .ucmd-clear { grid-column: 1 / -1; justify-self: end; }

  /* tabs: 3 equal tabs, then action row */
  #ucm-dsr .ucmd-tabs { flex-wrap: wrap; gap: 0; padding: 0 8px; align-items: stretch; }
  #ucm-dsr .ucmd-view { flex: 1 1 0; min-width: 0; justify-content: center; gap: 5px; height: 44px; padding: 0 4px; font-size: 12.5px; white-space: nowrap; }
  #ucm-dsr .ucmd-view svg { display: none; }
  #ucm-dsr .ucmd-view > span:not(.ucmd-tab-count) { overflow: hidden; text-overflow: ellipsis; }
  #ucm-dsr .ucmd-tabs-meta { display: none; }
  #ucm-dsr .ucmd-vl { display: none; }
  #ucm-dsr .ucmd-vs { display: inline; }
  #ucm-dsr .ucmd-band-actions { display: contents; }
  #ucm-dsr #ucmd-refresh { order: 5; flex: 0 0 34px; width: 34px; height: 34px; align-self: center; margin-left: 4px; padding: 0; justify-content: center; font-size: 0; gap: 0; }
  #ucm-dsr #ucmd-cat-btn { order: 9; flex: 1 0 100%; justify-content: center; height: 38px; margin: 8px 0 10px; white-space: nowrap; }
  #ucm-dsr #ucmd-cat-btn[hidden] { display: none !important; }

  /* cards & kpis */
  #ucm-dsr .ucmd-main { padding: 12px 12px 32px; }
  #ucm-dsr .ucmd-kpis { gap: 8px; }
  #ucm-dsr .ucmd-kpi { padding: 12px; }
  #ucm-dsr .ucmd-kpi { position: relative; }
  #ucm-dsr .ucmd-kpi-label { letter-spacing: .03em; font-size: 10px; padding-right: 44px; }
  #ucm-dsr .ucmd-kpi-label .ucmd-share { position: absolute; top: 10px; right: 10px; margin: 0; }
  #ucm-dsr .ucmd-tab-count { display: none; }
  #ucm-dsr .ucmd-kpi-label .ucmd-sw { display: none; }
  #ucm-dsr .ucmd-ptbl tr > :nth-child(5) { display: none; }
  #ucm-dsr .ucmd-ptbl th, #ucm-dsr .ucmd-ptbl td { padding-left: 8px; padding-right: 8px; }

  /* register header */
  #ucm-dsr .ucmd-table-head { padding: 10px; gap: 8px; }
  #ucm-dsr .ucmd-table-head > * { min-width: 0; }

  /* sliders full screen */
  .ucmd-drawer, .ucmd-drawer[data-kind="category"] { width: 100vw !important; }
  /* popup + person slider tables -> stacked rows */
  .ucmd-draft-body .ucmd-mtable, #ucmd-pp-table .ucmd-mtable { display: block; width: 100%; }
  .ucmd-draft-body .ucmd-mtable thead, #ucmd-pp-table .ucmd-mtable thead { display: none; }
  .ucmd-draft-body .ucmd-mtable tbody, #ucmd-pp-table .ucmd-mtable tbody { display: block; }
  .ucmd-draft-body .ucmd-mtable tr, #ucmd-pp-table .ucmd-mtable tr { display: grid; grid-template-columns: 20px minmax(0,1fr) auto; column-gap: 8px; row-gap: 3px; align-items: center; padding: 10px 2px; border-bottom: 1px solid #eef1f4; }
  .ucmd-draft-body .ucmd-mtable td, #ucmd-pp-table .ucmd-mtable td { display: block; padding: 0 !important; border: 0 !important; background: none !important; white-space: normal; min-width: 0; }
  .ucmd-draft-body .ucmd-mtable td:nth-child(1), #ucmd-pp-table .ucmd-mtable td:nth-child(1) { grid-column: 1; grid-row: 1 / span 3; align-self: start; font-size: 11px; color: #94a3b8; }
  .ucmd-draft-body .ucmd-mtable td:nth-child(2), #ucmd-pp-table .ucmd-mtable td:nth-child(2) { grid-column: 2; grid-row: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* draft popup: DN | qty / party / type | person */
  .ucmd-draft-body .ucmd-mtable td:nth-child(6) { grid-column: 3; grid-row: 1; text-align: right; font-weight: 600; }
  .ucmd-draft-body .ucmd-mtable td:nth-child(3) { grid-column: 2 / 4; grid-row: 2; font-weight: 600; color: #0f172a; }
  .ucmd-draft-body .ucmd-mtable td:nth-child(4) { grid-column: 2; grid-row: 3; }
  .ucmd-draft-body .ucmd-mtable td:nth-child(5) { grid-column: 3; grid-row: 3; text-align: right; font-size: 12px; color: #64748b; }
  /* person slider: invoice | amount / customer / date | type */
  #ucmd-pp-table .ucmd-mtable td:nth-child(6) { grid-column: 3; grid-row: 1; text-align: right; }
  #ucmd-pp-table .ucmd-mtable td:nth-child(4) { grid-column: 2 / 4; grid-row: 2; font-weight: 500; color: #0f172a; }
  #ucmd-pp-table .ucmd-mtable td:nth-child(3) { grid-column: 2; grid-row: 3; font-size: 12px; color: #64748b; }
  #ucmd-pp-table .ucmd-mtable td:nth-child(5) { grid-column: 3; grid-row: 3; text-align: right; }
  .ucmd-draft-body { padding: 4px 14px; max-height: 50vh; }
  .ucmd-draft-head { padding: 16px 14px 14px; gap: 10px; }
  .ucmd-draft-ico { width: 34px; height: 34px; flex-basis: 34px; }
  .ucmd-draft-head h3 { font-size: 16px; }
  .ucmd-draft-foot { padding: 10px 14px; }
  .ucmd-draft-foot > * { flex: 1 1 0; justify-content: center; }
}

/* Stock slider: 30 din ka ledger summary */
.ucmd-sle-sum { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 8px; margin: -2px 0 12px; }
.ucmd-sle-sum > div { border: 1px solid #e2e8f0; border-radius: 10px; padding: 8px 10px; background: #fff; }
.ucmd-sle-sum span { display: block; font-size: 11px; font-weight: 600; color: #64748b; }
.ucmd-sle-sum b { font-size: 16px; font-weight: 700; color: #0f172a; }
.ucmd-sle-sum .in b { color: #0f766e; }
.ucmd-sle-sum .out b { color: #c2410c; }
.ucmd-sle-sum .bal { background: #f0faf8; border-color: #c5e6e1; }
.ucmd-mtable td.c-party { max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #475569; }
@media (max-width: 700px) {
  .ucmd-sle-sum { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .ucmd-dr-table { overflow-x: auto; }
}

/* Stock slider: chauda, taaki date / document / party ek line mein dikhein */
.ucmd-drawer[data-kind="stock"] { width: min(980px, 96vw); }
.ucmd-drawer[data-kind="stock"] .ucmd-mtable td,
.ucmd-drawer[data-kind="stock"] .ucmd-mtable th { white-space: nowrap; }
.ucmd-drawer[data-kind="stock"] .ucmd-mtable td.c-party { max-width: 300px; }
@media (max-width: 700px) { .ucmd-drawer[data-kind="stock"] { width: 100vw !important; } }

/* Stock slider: set ke andar ke items */
.ucmd-set { border: 1px solid #c5e6e1; border-radius: 12px; overflow: hidden; margin: 0 0 14px; background: #fff; }
.ucmd-set-h { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; background: #f0faf8; border-bottom: 1px solid #d4ebe7; }
.ucmd-set-h b { display: block; font-size: 13px; color: #0f172a; }
.ucmd-set-h small { font-size: 11px; color: #64748b; }
.ucmd-set-can { text-align: right; }
.ucmd-set-can span { display: block; font-size: 11px; font-weight: 600; color: #64748b; }
.ucmd-set-can b { font-size: 20px; color: #115e59; }
.ucmd-set .ucmd-mtable { margin: 0; }
.ucmd-set .ucmd-mtable td small { display: block; font-size: 10.5px; color: #94a3b8; }
.ucmd-set .ucmd-mtable td.c-num small { display: inline; }
.ucmd-set-item { color: #0f766e; text-decoration: none; }
.ucmd-set-item:hover { text-decoration: underline; }
.ucmd-set tr.is-short td { background: #fff7ed; }
.ucmd-set-tag { font-size: 10px; font-weight: 700; color: #c2410c; background: #ffedd5; border-radius: 99px; padding: 1px 6px; margin-left: 4px; }
