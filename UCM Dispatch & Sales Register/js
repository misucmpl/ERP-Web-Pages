  /* ═════════════════════════ BOOT ═════════════════════════ */
  function boot() {
    var root = $("#ucm-dsr");
    if (!root || root.getAttribute("data-ready")) return;
    root.setAttribute("data-ready", "1");
    if (isGuest()) { renderGate(root, "guest"); return; }
    root.className = "ucmd-root is-checking";
    root.innerHTML = '<div class="ucmd-checking"><span class="ucmd-spin"></span>Checking access…</div>';
    api(API_DATA, { check_access: 1 }).then(function (m) {
      if (!m || !m.access) { renderGate(root, "denied"); return; }
      S.access = m.access; S.isAdmin = !!m.is_admin; S.me = m.user; S.meName = m.full_name;
      buildShell(root);
      try { mergeNavbar(); } catch (e) { console.warn("[UCM] navbar merge skipped", e); }
      var want = (location.hash || "").replace("#", "");
      setView((want === "sales" || want === "persons") && canView(want) ? want : (canView("dispatch") ? "dispatch" : "sales"));
      setTimeout(checkYesterdayDrafts, 400);
    }).catch(function (err) {
      if (isNoAccess(err)) { renderGate(root, "denied"); return; }
      root.className = "ucmd-root";
      root.innerHTML = '<div class="ucmd-error" style="margin:40px auto;max-width:640px"><b>Could not open the register.</b> ' + esc(cleanMsg(err)) +
        "<div>Check that the Server Script <code>" + API_DATA + "</code> is saved and enabled.</div></div>";
    });
  }
  if (d.readyState === "loading") d.addEventListener("DOMContentLoaded", boot); else boot();
  w.addEventListener("load", boot);
})(window);
