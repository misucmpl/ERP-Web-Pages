  /* ═════════════════════════ Kal ke DRAFT dispatches (page khulte hi) ═════════════════════════ */
  function checkYesterdayDrafts() {
    if (!canView("dispatch")) return;
    var y = periodRange("yesterday")[0], key = "dispatch|" + y + "|" + y;
    var got = function (rows) {
      S.cache[key] = rows;
      var docs = {}, order = [];
      rows.forEach(function (r) {
        if (r.status !== "Draft") return;
        if (!docs[r.name]) { docs[r.name] = { name: r.name, party: r.customer_name, type: r.order_type, by: r.order_by, qty: 0, lines: 0, date: r.posting_date }; order.push(docs[r.name]); }
        docs[r.name].qty += r.qty; docs[r.name].lines++;
      });
      if (order.length) showDraftAlert(order, y);
    };
    if (S.cache[key]) { got(S.cache[key]); return; }
    api(API_DATA, { source: "Delivery Note", from_date: y, to_date: y }).then(function (m) { got((m && m.rows) || []); }).catch(function () { /* chup-chaap */ });
  }
