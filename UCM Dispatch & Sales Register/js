        options: function (q) { return uniqueOpts(S.rows, t.fn, q, t.label); },
        display: t.label ? function (v) { return t.label(v || ""); } : null,
        type: function (txt) {
          S.f[k] = txt; clearTimeout(typeTimer);
          typeTimer = setTimeout(function () { S.showAll = false; renderAll(); }, 160);
        },
        pick: function (v) { S.f[k] = v || ""; S.showAll = false; renderAll(); }
      });
    });
    Object.keys(FIXED).forEach(function (k) {
      FD[k] = makeDD($('[data-dd="' + k + '"]', root), {
        search: false, placeholder: "All", clearable: false,
        get: function () { return S.f[k]; },
        options: function () { return FIXED[k]; },
        display: function (v) { var o = FIXED[k].filter(function (x) { return x.v === (v || ""); })[0]; return o ? o.l : "All"; },
        pick: function (v) { S.f[k] = v || ""; S.showAll = false; renderAll(); }
      });
    });
  }
  function setFilter(k, v) {
    S.f[k] = v || "";
    if (FD[k]) FD[k].sync();
