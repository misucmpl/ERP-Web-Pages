        '<div class="ucmd-kpi-sub">' + inr(val) + " · " + basis.toLowerCase() + "</div>" +
        (draftVal ? '<div class="ucmd-kpi-foot">+ ' + inrShort(draftVal) + " pending in drafts</div>" : '<div class="ucmd-kpi-foot">' + rangeText() + "</div>") +
      "</div>" +
      '<div class="ucmd-kpi">' +
        '<div class="ucmd-kpi-label">' + V.doc + "es".slice(V.doc === "Dispatch" ? 0 : 1) + "</div>" +
        '<div class="ucmd-kpi-value">' + num(nDocs) + "</div>" +
        '<div class="ucmd-meter"><i style="width:' + pc + '%"></i></div>' +
        '<div class="ucmd-kpi-sub"><span class="ucmd-dot is-ok"></span>' + num(nComp) + ' completed <span class="ucmd-dot is-draft"></span>' + num(nDraft) + " draft</div>" +
      "</div>" +
      '<div class="ucmd-kpi">' +
        '<div class="ucmd-kpi-label">Quantity</div>' +
