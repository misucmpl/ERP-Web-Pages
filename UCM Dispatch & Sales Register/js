  function rangeText() { return S.from === S.to ? longDate(S.from) : longDate(S.from) + " – " + longDate(S.to); }

  /* ───────── table ───────── */
  function searchRows(rows) {
    if (!S.q) return rows;
    var words = lc(S.q).split(/\s+/).filter(Boolean);
    // poora document match ho to uski saari lines dikhao
    var hitDocs = {};
    rows.forEach(function (r) {
      var hay = lc([r.name, r.customer_name, r.item_name, r.item_code, r.po_no, r.oa_no, r.city, r.state, r.order_by, r.category, r.item_group, r.freight, r.order_type, r.status, r.payment_terms].join(" "));
      if (words.every(function (wd) { return hay.indexOf(wd) >= 0; })) hitDocs[r.name + "|" + r.item_code] = 1;
    });
    return rows.filter(function (r) { return hitDocs[r.name + "|" + r.item_code]; });
  }

  function renderTable(rowsIn) {
    var rows = searchRows(rowsIn || filtered());
    var V = VIEWS[S.view], isSales = S.view === "sales";
    var host = $("#ucmd-table");
    var docsAll = {}; rows.forEach(function (r) { docsAll[r.name] = 1; });
    var nDocs = Object.keys(docsAll).length;
    $$(".ucmd-view").forEach(function (b) {
      var c = $(".ucmd-tab-count", b); if (c) c.textContent = b.getAttribute("data-view") === S.view ? num(nDocs) : "";
    });
    var rt = $("#ucmd-range-txt"); if (rt) rt.textContent = rangeText();
    $("#ucmd-info").textContent = num(nDocs) + " document" + (nDocs === 1 ? "" : "s") + " · " + num(rows.length) + " line" + (rows.length === 1 ? "" : "s");

    if (!rows.length) {
      host.innerHTML = '<div class="ucmd-empty">' + ico(I.search, 22) + "<b>No " + V.label.toLowerCase() + " found</b><span>" +
        (S.rows.length ? "Try clearing filters or search." : "Nothing in " + rangeText() + ". Try another period.") + "</span></div>";
      return;
    }

    var limit = S.showAll ? rows.length : Math.min(rows.length, ROW_LIMIT);
    if (isMobile()) { renderCards(rows, limit, nDocs, V, isSales, host); return; }
    var h = [], last = null, parity = 1, sn = 0, tq = 0, ta = 0;
    rows.forEach(function (r) { tq += r.qty; ta += r.amount; });
    for (var i = 0; i < limit; i++) {
      var r = rows[i], first = r.name !== last;
