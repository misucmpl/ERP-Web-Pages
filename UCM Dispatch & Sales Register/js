        '<td class="c-st">' + (first ? '<span class="ucmd-pill ' + (r.status === "Draft" ? "is-draft" : "is-ok") + '">' + r.status + "</span>" : "") + "</td>" +
        '<td class="c-type">' + (first && r.order_type ? '<span class="ucmd-type ' + (r.order_type === "Ultra" ? "is-ultra" : "is-lb") + '">' + esc(r.order_type) + "</span>" : "") + "</td>" +
        '<td class="c-doc">' + (first ? '<a href="/app/' + V.slug + "/" + encodeURIComponent(r.name) + '" target="_blank" rel="noopener">' + esc(r.name) + "</a>" : "") + "</td>" +
        '<td class="c-po">' + (first ? esc(r.po_no) : "") + "</td>" +
        '<td class="c-cust">' + (first ? '<span title="' + esc(r.customer_name) + '">' + esc(r.customer_name) + "</span>" : "") + "</td>" +
        '<td class="c-item"><a href="#" class="ucmd-item" data-item="' + esc(r.item_code) + '" title="' + esc(r.item_code) + ' — click for stock">' + esc(r.item_name) + "</a></td>" +
        '<td class="c-num c-qty">' + qtyFmt(r.qty) + "</td>" +
        '<td class="c-num">' + nf2.format(r.rate) + "</td>" +
