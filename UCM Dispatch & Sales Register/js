      var cls = "b" + parity + (first ? " is-first" : "") + (nextSame ? "" : " is-last") + (r.status === "Draft" ? " is-draft" : "");
      var loc = [r.city, r.state].filter(Boolean).join(", ");
      h.push('<tr class="' + cls + '">' +
