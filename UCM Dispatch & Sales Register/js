  // cardFree = true: card wale filters (Order type, Status) chhod do — KPI cards inse nahi badalte
  function filtered(cardFree) {
    var f = S.f;
    var persons = S.view === "persons";
    var fc = lc(f.customer), fi = persons ? "" : lc(f.item), fp = lc(f.person);
    return S.rows.filter(function (r) {
      if (fc && lc(r.customer_name).indexOf(fc) < 0 && lc(r.customer).indexOf(fc) < 0) return false;
      if (fi && lc(r.item_name).indexOf(fi) < 0 && lc(r.item_code).indexOf(fi) < 0) return false;
      if (fp && lc(r.order_by).indexOf(fp) < 0 && lc(personLabel(r.order_by, "Ultra")).indexOf(fp) < 0) return false;
      if (!cardFree && f.otype && r.order_type !== f.otype) return false;
      if (!cardFree && f.status && !persons && r.status !== f.status) return false;
      return true;
    });
  }
  // Value / qty summary: sirf Completed documents (drafts alag "pending" mein)
  function valueRows(rows) { return rows.filter(function (r) { return r.status === "Completed"; }); }

  function renderAll() {
    var rows = filtered();
    renderKpis(filtered(true));
    if (S.view === "persons") renderPersons(rows); else renderTable(rows);
    var any = Object.keys(S.f).some(function (k) { return S.f[k]; });
