  }

  /* ───────── KPIs ───────── */
  // Dispatches: sirf ginti (kitne dispatch, Ultra / Large Blow, Completed / Draft) — value nahi
  function renderDispatchKpis(rows) {
    var docs = {}, comp = {}, draft = {}, ult = {}, lbd = {};
    rows.forEach(function (r) {
      docs[r.name] = 1;
      if (r.status === "Completed") comp[r.name] = 1; else draft[r.name] = 1;
      if (r.order_type === "Ultra") ult[r.name] = 1;
      else if (r.order_type === "Large Blow") lbd[r.name] = 1;
    });
    var n = Object.keys(docs).length, nc = Object.keys(comp).length, nd = Object.keys(draft).length;
    var nu = Object.keys(ult).length, nl = Object.keys(lbd).length;
    var pct = function (x) { return n ? Math.round(x / n * 100) : 0; };
    $("#ucmd-kpis").innerHTML =
      '<div class="ucmd-kpi is-hero">' +
        '<div class="ucmd-kpi-label">Total Dispatches</div>' +
        '<div class="ucmd-kpi-value">' + num(n) + "</div>" +
        '<div class="ucmd-kpi-sub">Delivery Notes</div>' +
        '<div class="ucmd-kpi-foot">' + rangeText() + "</div>" +
      "</div>" +
      card("otype", "Ultra", "is-ultra", nu, pct(nu), "of all Dispatches") +
      card("otype", "Large Blow", "is-lb", nl, pct(nl), "of all Dispatches") +
      card("status", "Completed", "is-done", nc, pct(nc), "submitted") +
      card("status", "Draft", "is-pending", nd, pct(nd), "not yet submitted");
    function card(f, name, cls, count, share, sub) {
      return '<button type="button" class="ucmd-kpi is-seg ' + cls + (S.f[f] === name ? " on" : "") + '" data-kf="' + f + '" data-kv="' + name + '" title="Show only ' + name + '">' +
        '<div class="ucmd-kpi-label"><span class="ucmd-sw"></span>' + name + '<span class="ucmd-share">' + share + "%</span></div>" +
        '<div class="ucmd-kpi-value">' + num(count) + "</div>" +
        '<div class="ucmd-meter"><i style="width:' + share + '%"></i></div>' +
        '<div class="ucmd-kpi-sub">' + sub + "</div>" +
      "</button>";
    }
    $$("#ucmd-kpis [data-kf]").forEach(function (b) {
      b.addEventListener("click", function () {
        var f = b.getAttribute("data-kf"), v = b.getAttribute("data-kv");
        setFilter(f, S.f[f] === v ? "" : v);
      });
    });
  }

  function renderKpis(rows) {
    if (S.view === "dispatch") { renderDispatchKpis(rows); return; }
    if (S.view === "persons") { renderPersonKpis(rows); return; }
    var V = VIEWS[S.view];
    var docs = {}, comp = {}, draft = {}, draftVal = 0;
    rows.forEach(function (r) {
      docs[r.name] = 1;
      if (r.status === "Completed") comp[r.name] = 1; else { draft[r.name] = 1; draftVal += r.amount; }
    });
    var vr = valueRows(rows), val = 0, qty = 0, u = { v: 0, q: 0 }, lb = { v: 0, q: 0 };
    vr.forEach(function (r) {
      val += r.amount; qty += r.qty;
      if (r.order_type === "Ultra") { u.v += r.amount; u.q += r.qty; }
      else if (r.order_type === "Large Blow") { lb.v += r.amount; lb.q += r.qty; }
    });
    var nDocs = Object.keys(docs).length, nComp = Object.keys(comp).length, nDraft = Object.keys(draft).length;
    var pc = nDocs ? Math.round(nComp / nDocs * 100) : 0;
    var uShare = val ? Math.round(u.v / val * 100) : 0, lbShare = val ? 100 - uShare : 0;
    if (!val) { uShare = 0; lbShare = 0; }
    var basis = "Completed documents";

    $("#ucmd-kpis").innerHTML =
      '<div class="ucmd-kpi is-hero">' +
