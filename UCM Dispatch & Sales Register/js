  /* ═════════════════════════ DATA ═════════════════════════ */
  function cacheKey() { return S.view + "|" + S.from + "|" + S.to; }
  function load() {
    var key = cacheKey(), id = ++S.req, root = $("#ucm-dsr");
    var tt = $("#ucmd-table-title"); if (tt) tt.textContent = VIEWS[S.view].doc + " Register";
    var cl = $("#ucmd-cat-lbl"); if (cl) cl.textContent = S.view === "dispatch" ? "Category Wise Dispatch" : "Category Wise Sales";
    var cb = $("#ucmd-cat-btn"); if (cb) cb.hidden = S.view === "persons";
    // Sales Person tab invoice-wise hai: Product aur Status filter wahan nahi
    ["item", "status"].forEach(function (k) {
      var fe = $('[data-fk="' + k + '"]'); if (fe) fe.hidden = S.view === "persons";
    });
    if (S.cache[key]) { S.rows = S.cache[key]; renderAll(); return; }
    root.classList.add("is-busy");
    $("#ucmd-table").innerHTML = '<div class="ucmd-empty"><span class="ucmd-spin"></span>Loading ' + VIEWS[S.view].label.toLowerCase() + "…</div>";
    api(API_DATA, { source: VIEWS[S.view].source, from_date: S.from, to_date: S.to }).then(function (m) {
      if (id !== S.req) return;
      root.classList.remove("is-busy");
      S.rows = (m && m.rows) || [];
      S.cache[key] = S.rows;
      renderAll();
    }).catch(function (err) {
      if (id !== S.req) return;
      root.classList.remove("is-busy");
      if (isNoAccess(err)) { renderGate(root, isGuest() ? "guest" : "denied"); return; }
      S.rows = [];
      renderAll();
      $("#ucmd-table").innerHTML = '<div class="ucmd-error"><b>Could not load data.</b> ' + esc(cleanMsg(err)) +
        '<div>Check that the Server Script <code>' + API_DATA + "</code> is saved and enabled.</div></div>";
    });
