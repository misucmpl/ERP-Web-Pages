      "</div>" +
      seg("Ultra", "is-ultra", u, uShare) +
      seg("Large Blow", "is-lb", lb, lbShare);

    function seg(name, cls, o, share) {
      return '<button type="button" class="ucmd-kpi is-seg ' + cls + (S.f.otype === name ? " on" : "") + '" data-otype="' + name + '" title="Show only ' + name + '">' +
        '<div class="ucmd-kpi-label"><span class="ucmd-sw"></span>' + name + '<span class="ucmd-share">' + share + "%</span></div>" +
        '<div class="ucmd-kpi-value" title="' + inr(o.v) + '">' + inrShort(o.v) + "</div>" +
        '<div class="ucmd-meter"><i style="width:' + share + '%"></i></div>' +
