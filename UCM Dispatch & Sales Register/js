        '<td class="c-cat">' + esc(r.category) + "</td>" +
        (isSales ? '<td class="c-pt">' + (first ? esc(r.payment_terms) : "") + "</td>" : "") +
      "</tr>");
    }
    var cols = isSales ? 17 : 16;
    host.innerHTML =
      '<table class="ucmd-table"><thead><tr>' +
        '<th class="c-sn">#</th><th>Date</th><th>Status</th><th>Type</th><th>' + V.doc + '</th><th>PO No</th><th>Customer</th><th>Product</th>' +
        '<th class="c-num">Qty</th><th class="c-num">Rate</th><th class="c-num">Amount</th><th>Order by</th><th>OA No</th><th>City, State</th><th>Freight</th><th>Category</th>' +
        (isSales ? "<th>Payment terms</th>" : "") +
      "</tr></thead><tbody>" + h.join("") + "</tbody>" +
      '<tfoot><tr><td colspan="8">Total · ' + num(nDocs) + " documents · amounts excl. GST, incl. drafts</td>" +
        '<td class="c-num">' + qtyFmt(tq) + '</td><td></td><td class="c-num">' + nf2.format(ta) + '</td><td colspan="' + (cols - 11) + '"></td></tr></tfoot>' +
      "</table>" +
      (limit < rows.length ? '<div class="ucmd-more-wrap"><button type="button" class="ucmd-more">Show all ' + num(rows.length) + " lines (" + num(rows.length - limit) + " more)</button></div>" : "");
  }

  /* ───────── Mobile: register as document cards ───────── */
  function isMobile() { return w.matchMedia && w.matchMedia("(max-width: 700px)").matches; }
  function renderCards(rows, limit, nDocs, V, isSales, host) {
    var docs = [], byName = {}, tq = 0, ta = 0;
    rows.forEach(function (r) { tq += r.qty; ta += r.amount; });
    for (var i = 0; i < limit; i++) {
      var r = rows[i], g = byName[r.name];
      if (!g) { g = byName[r.name] = { h: r, lines: [], qty: 0, amt: 0 }; docs.push(g); }
      g.lines.push(r); g.qty += r.qty; g.amt += r.amount;
    }
    var out = docs.map(function (g, k) {
      var r = g.h, draft = r.status === "Draft";
      var loc = [r.city, r.state].filter(Boolean).join(", ");
      var meta = [r.po_no ? "PO " + esc(r.po_no) : "", r.oa_no ? "OA " + esc(r.oa_no) : "", esc(loc)].filter(Boolean).join(" · ");
      var foot = [r.order_by ? "By " + esc(r.order_by) : "", r.freight ? esc(r.freight) : "", isSales && r.payment_terms ? esc(r.payment_terms) : ""].filter(Boolean).join(" · ");
      return '<article class="ucmd-mc' + (draft ? " is-draft" : "") + (r.order_type === "Ultra" ? " is-ultra" : r.order_type ? " is-lb" : "") + '">' +
        '<div class="ucmd-mc-top"><span class="ucmd-mc-sn">' + (k + 1) + "</span>" +
          '<a class="ucmd-mc-doc" href="/app/' + V.slug + "/" + encodeURIComponent(r.name) + '" target="_blank" rel="noopener">' + esc(r.name) + "</a>" +
          '<span class="ucmd-mc-date">' + esc(shortDate(r.posting_date)) + "</span></div>" +
        '<div class="ucmd-mc-cust">' + esc(r.customer_name) + "</div>" +
        '<div class="ucmd-mc-tags"><span class="ucmd-pill ' + (draft ? "is-draft" : "is-ok") + '">' + esc(r.status) + "</span>" +
