# ═══════════════════════════════════════════════════════════════════════════
# Server Script
#   Script Type : API
#   API Method  : ucm_dsr_data
#   Allow Guest : NO (untick)
#
# "UCM Dispatch & Sales Register" (naya report) ka data — Web Page ke liye.
#
# Access (roles se):
#   System Manager                       → Dispatches + Sales Invoices + ⚙️ Settings
#   UCM Dispatch Viewer                  → Dispatches
#   UCM Invoice Viewer                   → Sales Invoices + Sales Person
#   dono roles (ya purana UCM Sales Viewer) → Dispatches + Sales Invoices
#   baaki sab                            → "You do not have access"
# Jo tab user ko nahi mila, uska data server bhi nahi deta.
#
# Input : check_access=1  → sirf access info
#         source ("Delivery Note" / "Sales Invoice" / "Sales Person"), from_date, to_date
#         "Sales Person" = "UCM Monthly Sales Summary" report wala data (invoice-wise)
# Output: {"source", "from_date", "to_date", "rows": [...]}
#         Customer / Product / Segment / Status filters web page khud lagata hai.
# ═══════════════════════════════════════════════════════════════════════════

DISPATCH_ROLE = "UCM Dispatch Viewer"
INVOICE_ROLE = "UCM Invoice Viewer"
LEGACY_FULL_ROLE = "UCM Sales Viewer"

session_user = frappe.session.user
if session_user == "Guest":
    frappe.throw("UCM_NO_ACCESS: Please log in.")

my_roles = set(frappe.get_all(
    "Has Role",
    filters={"parent": session_user, "parenttype": "User"},
    pluck="role"
))
is_admin = "System Manager" in my_roles
can_dispatch = is_admin or DISPATCH_ROLE in my_roles or LEGACY_FULL_ROLE in my_roles
can_invoice = is_admin or INVOICE_ROLE in my_roles or LEGACY_FULL_ROLE in my_roles
access = ""
if can_dispatch and can_invoice:
    access = "full"
elif can_dispatch:
    access = "dispatch"
elif can_invoice:
    access = "sales"

if not access:
    frappe.throw("UCM_NO_ACCESS: You do not have access to this page.")

if frappe.form_dict.get("check_access"):
    frappe.response["message"] = {
        "access": access,
        "is_admin": 1 if is_admin else 0,
        "user": session_user,
        "full_name": frappe.db.get_value("User", session_user, "full_name") or session_user,
    }
else:
    source = frappe.form_dict.get("source")
    if source not in ["Sales Invoice", "Sales Person"]:
        source = "Delivery Note"
    if source in ["Sales Invoice", "Sales Person"] and not can_invoice:
        frappe.throw("UCM_NO_ACCESS: You do not have access to Sales Invoices.")
    if source == "Delivery Note" and not can_dispatch:
        frappe.throw("UCM_NO_ACCESS: You do not have access to Dispatches.")

    today = frappe.utils.nowdate()
    from_date = str(frappe.utils.getdate(frappe.form_dict.get("from_date") or today))
    to_date = str(frappe.utils.getdate(frappe.form_dict.get("to_date") or today))
    if from_date > to_date:
        frappe.throw("From Date cannot be after To Date.")
    if frappe.utils.date_diff(to_date, from_date) > 400:
        frappe.throw("Please choose a date range of up to one year.")

    params = {"from_date": from_date, "to_date": to_date}

    if source == "Sales Person":
        # "UCM Monthly Sales Summary" report jaisa: sirf submitted invoices,
        # return nahi, Ultra / Large Blow; har invoice ka amount (qty x rate).
        out = []
        for r in frappe.db.sql("""
            SELECT
                si.name AS invoice,
                si.customer_name AS customer,
                si.posting_date AS posting_date,
                si.custom_order_by AS order_by,
                UPPER(si.custom_sales_order_type) AS sales_order_type,
                SUM(sii.qty * sii.rate) AS amount
            FROM `tabSales Invoice` si
            INNER JOIN `tabSales Invoice Item` sii ON sii.parent = si.name
            WHERE si.docstatus = 1
                AND si.is_return = 0
                AND si.posting_date BETWEEN %(from_date)s AND %(to_date)s
                AND UPPER(si.custom_sales_order_type) IN ('ULTRA', 'LARGE BLOW')
            GROUP BY si.name, si.customer_name, si.posting_date, si.custom_order_by, UPPER(si.custom_sales_order_type)
            ORDER BY si.posting_date DESC, si.name DESC
        """, params, as_dict=True):
            out.append({
                "name": r.get("invoice") or "",
                "customer_name": r.get("customer") or "",
                "posting_date": str(r.get("posting_date") or ""),
                "order_by": r.get("order_by") or "Not Set",
                "order_type": "Large Blow" if r.get("sales_order_type") == "LARGE BLOW" else "Ultra",
                "amount": frappe.utils.flt(r.get("amount")),
                "status": "Completed",
            })
    else:
        incoterm_case = """
            CASE dn.incoterm
                WHEN 'FTP' THEN 'Freight to Pay by Customer'
                WHEN 'EXW' THEN 'Ex Works'
                WHEN 'FCA' THEN 'Free Carrier'
                WHEN 'CPT' THEN 'Carriage Paid To'
                WHEN 'CIP' THEN 'Carriage and Insurance Paid To'
                WHEN 'DPU' THEN 'Delivered at Place Unloaded'
                WHEN 'DAP' THEN 'Delivered at Place'
                WHEN 'DDP' THEN 'Delivered Duty Paid'
                WHEN 'FAS' THEN 'Free Alongside Ship'
                WHEN 'FOB' THEN 'Free On Board'
                WHEN 'CFR' THEN 'Cost and Freight'
                WHEN 'CIF' THEN 'Cost Insurance and Freight'
                WHEN 'FOR' THEN 'Free On Road'
                ELSE dn.incoterm
            END AS incoterm_label
        """

        # Report jaisi hi shartein: RM- items nahi, credit note / return nahi,
        # sirf Large Blow / Ultra order types, Draft + Submitted dono.
        common_where = """
                dn.docstatus IN (0, 1)
                AND dn.posting_date BETWEEN %(from_date)s AND %(to_date)s
                AND UPPER(dni.item_code) NOT LIKE 'RM-%%'
                AND dn.is_return = 0
        """

        if source == "Delivery Note":
            # Dispatch: order type linked Sales Order se aata hai
            sql = """
                SELECT
                    dn.posting_date, dn.docstatus, dn.name, dn.po_no, dn.customer, dn.customer_name,
                    addr.city, addr.state,
                    dni.item_code, COALESCE(item.item_name, dni.item_name) AS item_name,
                    item.item_group, item.custom_item_category,
                    so.custom_sales_order_type AS order_type,
                    dni.qty, dni.rate, (dni.qty * dni.rate) AS amount,
                    dn.custom_oa_no, dn.custom_order_by,
                    '' AS payment_terms_template,
                    """ + incoterm_case + """
                FROM `tabDelivery Note` dn
                INNER JOIN `tabDelivery Note Item` dni ON dni.parent = dn.name
                LEFT JOIN `tabItem` item ON item.name = dni.item_code
                LEFT JOIN `tabAddress` addr ON addr.name = dn.customer_address
                LEFT JOIN `tabSales Order` so ON so.name = dni.against_sales_order
                WHERE """ + common_where + """
                    AND so.custom_sales_order_type IN ('Large Blow', 'Ultra')
                ORDER BY dn.posting_date DESC, dn.name, dni.idx
            """
        else:
            sql = """
                SELECT
                    dn.posting_date, dn.docstatus, dn.name, dn.po_no, dn.customer, dn.customer_name,
                    addr.city, addr.state,
                    dni.item_code, COALESCE(item.item_name, dni.item_name) AS item_name,
                    item.item_group, item.custom_item_category,
                    dn.custom_sales_order_type AS order_type,
                    dni.qty, dni.rate, (dni.qty * dni.rate) AS amount,
                    dn.custom_oa_no, dn.custom_order_by,
                    dn.payment_terms_template,
                    """ + incoterm_case + """
                FROM `tabSales Invoice` dn
                INNER JOIN `tabSales Invoice Item` dni ON dni.parent = dn.name
                LEFT JOIN `tabItem` item ON item.name = dni.item_code
                LEFT JOIN `tabAddress` addr ON addr.name = dn.customer_address
                WHERE """ + common_where + """
                    AND dn.custom_sales_order_type IN ('Large Blow', 'Ultra')
                ORDER BY dn.posting_date DESC, dn.name, dni.idx
            """

        out = []
        for r in frappe.db.sql(sql, params, as_dict=True):
            out.append({
                "posting_date": str(r.get("posting_date") or ""),
                "status": "Completed" if r.get("docstatus") == 1 else "Draft",
                "name": r.get("name") or "",
                "po_no": r.get("po_no") or "",
                "customer": r.get("customer") or "",
                "customer_name": r.get("customer_name") or "",
                "city": r.get("city") or "",
                "state": r.get("state") or "",
                "item_code": r.get("item_code") or "",
                "item_name": r.get("item_name") or "",
                "item_group": r.get("item_group") or "",
                "category": r.get("custom_item_category") or "",
                "order_type": r.get("order_type") or "",
                "qty": frappe.utils.flt(r.get("qty")),
                "rate": frappe.utils.flt(r.get("rate")),
                "amount": frappe.utils.flt(r.get("amount")),
                "oa_no": r.get("custom_oa_no") or "",
                "order_by": r.get("custom_order_by") or "",
                "freight": r.get("incoterm_label") or "",
                "payment_terms": r.get("payment_terms_template") or "",
            })

    frappe.response["message"] = {
        "source": source,
        "from_date": from_date,
        "to_date": to_date,
        "rows": out,
    }
