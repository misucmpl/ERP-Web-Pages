# ═══════════════════════════════════════════════════════════════════════════
# Server Script
#   Script Type : API
#   API Method  : ucm_complaint_access
#   Allow Guest : NO (untick)
#
# Complaint Dashboard ka access + comments API.
# Access User par roles ke roop mein save hota hai:
#   "UCM Complaint Viewer"   → View      : sirf dashboard dekh sakta hai
#   "UCM Complaint Logger"   → Log       : (Sales) complaint log + comment + close
#   "UCM Complaint Quality"  → Quality   : quality reply + comment + close
#   Logger + Quality dono    → Full      : sab kuch
#   System Manager           → hamesha Full + ⚙️ Settings
# (Roles na hon to ye script khud bana deta hai.)
#
# action = "me"        → mera access          (koi bhi logged-in user)
# action = "comments"  → complaint ke comments (View ya upar)      · name
# action = "comment"   → reply add karo        (Log / Quality / Full) · name, text, files
#                         Complaint log karne wale ke alawa koi aur pehla reply kare to
#                         status "Open" → "Replied" (status_changed = True)
#                         files = upload kiye gaye photo / video ke file_url (list)
# action = "edit_comment" → apna reply badlo, sirf jab tak wo sabse aakhri reply hai · name, comment, text
# action = "latest"    → mera abhi-abhi log kiya complaint (photo / video upload ke liye)
# action = "list"      → users + access        (sirf System Manager)
# action = "set"       → access badlo          (sirf System Manager) · user, level
#                         level = view / log / quality / full / none
# ═══════════════════════════════════════════════════════════════════════════

DOCTYPE = "Customer Complaint"
VIEW_ROLE = "UCM Complaint Viewer"
LOG_ROLE = "UCM Complaint Logger"
QUALITY_ROLE = "UCM Complaint Quality"
PAGE_ROLES = [VIEW_ROLE, LOG_ROLE, QUALITY_ROLE]

session_user = frappe.session.user
if session_user == "Guest":
    frappe.throw("Please log in.")

my_roles = frappe.get_all(
    "Has Role",
    filters={"parent": session_user, "parenttype": "User", "role": ["in", PAGE_ROLES + ["System Manager"]]},
    pluck="role"
)
is_admin = session_user == "Administrator" or "System Manager" in my_roles
can_log = is_admin or LOG_ROLE in my_roles
can_reply = is_admin or QUALITY_ROLE in my_roles
can_view = is_admin or len(my_roles) > 0
can_close = can_log or can_reply
can_comment = can_log or can_reply

if is_admin:
    my_level = "admin"
elif can_log and can_reply:
    my_level = "full"
elif can_log:
    my_level = "log"
elif can_reply:
    my_level = "quality"
elif can_view:
    my_level = "view"
else:
    my_level = "none"

action = frappe.form_dict.get("action") or "me"


if action == "me":
    full_name = frappe.db.get_value("User", session_user, "full_name") or session_user
    frappe.response["message"] = {
        "user": session_user, "full_name": full_name, "level": my_level,
        "can_view": can_view, "can_log": can_log, "can_reply": can_reply,
        "can_close": can_close, "can_comment": can_comment, "is_admin": is_admin,
    }

elif action == "comments" or action == "comment" or action == "edit_comment":
    if not can_view:
        frappe.throw("You do not have access to complaints.")
    complaint = (frappe.form_dict.get("name") or "").strip()
    status_changed = False
    if not complaint or not frappe.db.exists(DOCTYPE, complaint):
        frappe.throw("Complaint not found.")

    if action == "comment":
        if not can_comment:
            frappe.throw("You can only view complaints. Ask a System Manager for Log or Quality access to comment.")
        text = (frappe.form_dict.get("text") or "").strip()
        # photo / video: sirf wahi file jo isi complaint par attach hai
        want_files = frappe.form_dict.get("files") or []
        if isinstance(want_files, str):
            want_files = frappe.parse_json(want_files) if want_files.startswith("[") else [want_files]
        att_links = []
        if want_files:
            have = {}
            for f in frappe.get_all("File", filters={"attached_to_doctype": DOCTYPE, "attached_to_name": complaint},
                                    fields=["file_url", "file_name"], limit_page_length=0):
                have[f.get("file_url")] = f.get("file_name") or f.get("file_url")
            for u in want_files:
                if u in have:
                    fname = str(have[u]).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;")
                    att_links.append('<a href="' + u + '" target="_blank">' + fname + '</a>')
        if len(text) < 2 and not att_links:
            frappe.throw("Write a comment first.")
        if len(text) > 2000:
            text = text[:2000]
        safe = text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\n", "<br>")
        if att_links:
            safe = safe + ("<br><br>" if safe else "") + "<br>".join(att_links)
        full_name = frappe.db.get_value("User", session_user, "full_name") or session_user
        frappe.get_doc({
            "doctype": "Comment",
            "comment_type": "Comment",
            "reference_doctype": DOCTYPE,
            "reference_name": complaint,
            "content": safe,
            "comment_email": session_user,
            "comment_by": full_name,
        }).insert(ignore_permissions=True)
        cinfo = frappe.db.get_value(DOCTYPE, complaint, ["owner", "status"], as_dict=True) or {}
        if (cinfo.get("status") or "Open") == "Open" and cinfo.get("owner") != session_user:
            frappe.db.set_value(DOCTYPE, complaint, "status", "Replied")
            status_changed = True

    # ── apna reply edit: sirf likhne wala, aur sirf jab tak uske baad koi naya reply nahi aaya ──
    if action == "edit_comment":
        if not can_comment:
            frappe.throw("You can only view complaints.")
        ec_name = (frappe.form_dict.get("comment") or "").strip()
        ec = frappe.db.get_value("Comment", ec_name, ["name", "reference_doctype", "reference_name", "comment_type",
                                                       "comment_email", "owner", "content"], as_dict=True)
        if not ec or ec.get("reference_doctype") != DOCTYPE or ec.get("reference_name") != complaint or ec.get("comment_type") != "Comment":
            frappe.throw("Reply not found.")
        if (ec.get("comment_email") or ec.get("owner")) != session_user:
            frappe.throw("You can only edit your own reply.")
        ec_last = frappe.get_all("Comment", filters={"reference_doctype": DOCTYPE, "reference_name": complaint,
                                                     "comment_type": "Comment"},
                                 fields=["name"], order_by="creation desc", limit_page_length=1)
        if not ec_last or ec_last[0].get("name") != ec_name:
            frappe.throw("This reply can no longer be edited because a newer reply has been posted.")
        if (frappe.db.get_value(DOCTYPE, complaint, "status") or "") == "Closed":
            frappe.throw("The complaint is closed. Reopen it to edit the reply.")
        et = (frappe.form_dict.get("text") or "").strip()
        if len(et) > 2000:
            et = et[:2000]
        # purani photo / video links waise hi rakho, sirf text badlo
        eo = ec.get("content") or ""
        e_links = []
        epos = 0
        while True:
            ei = eo.find("<a ", epos)
            if ei < 0:
                break
            ej = eo.find("</a>", ei)
            if ej < 0:
                break
            ea = eo[ei:ej + 4]
            if 'href="/private/files/' in ea or 'href="/files/' in ea:
                e_links.append(ea)
            epos = ej + 4
        if len(et) < 2 and not e_links:
            frappe.throw("Write the reply first.")
        e_safe = et.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\n", "<br>")
        if e_links:
            e_safe = e_safe + ("<br><br>" if e_safe else "") + "<br>".join(e_links)
        frappe.db.set_value("Comment", ec_name, "content", e_safe)

    # NOTE: Server Script mein function (def) top-level variables nahi dekh paate, isliye sab inline hai
    c_rows = frappe.get_all(
        "Comment",
        filters={"reference_doctype": DOCTYPE, "reference_name": complaint, "comment_type": "Comment"},
        fields=["name", "content", "comment_email", "comment_by", "owner", "creation", "modified"],
        order_by="creation asc",
        limit_page_length=500
    )
    c_emails = list(set([(r.get("comment_email") or r.get("owner")) for r in c_rows if (r.get("comment_email") or r.get("owner"))]))
    c_names = {}
    if c_emails:
        for u in frappe.get_all("User", filters={"name": ["in", c_emails]}, fields=["name", "full_name"]):
            c_names[u.get("name")] = u.get("full_name") or u.get("name")
    comments = []
    c_last = c_rows[len(c_rows) - 1].get("name") if c_rows else ""
    c_closed = (frappe.db.get_value(DOCTYPE, complaint, "status") or "") == "Closed"
    for r in c_rows:
        who = r.get("comment_email") or r.get("owner") or ""
        raw0 = r.get("content") or ""
        # comment ke andar photo / video links (href="/files/..." ya "/private/files/...")
        c_files = []
        cut = -1
        pos = 0
        while True:
            i = raw0.find('href="', pos)
            if i < 0:
                break
            j = raw0.find('"', i + 6)
            if j < 0:
                break
            u = raw0[i + 6:j]
            if u.startswith("/private/files/") or u.startswith("/files/"):
                c_files.append(u)
                if cut < 0:
                    cut = raw0.rfind("<a", 0, i)
            pos = j + 1
        if cut >= 0:
            raw0 = raw0[:cut]
        raw = raw0.replace("<br>", "\n").replace("<br/>", "\n").replace("<br />", "\n").replace("</p>", "\n")
        plain = ""
        inside = False
        for ch in raw:
            if ch == "<":
                inside = True
            elif ch == ">":
                inside = False
            elif not inside:
                plain = plain + ch
        plain = plain.replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", '"').replace("&#39;", "'").replace("&nbsp;", " ").replace("&amp;", "&").strip()
        comments.append({
            "name": r.get("name"),
            "text": plain,
            "by": r.get("comment_by") or c_names.get(who) or who,
            "user": who,
            "on": str(r.get("creation") or ""),
            "files": c_files,
            # 60 sec se zyada baad badla ho to "edited"
            "edited": 1 if (r.get("modified") and r.get("creation")
                            and frappe.utils.time_diff_in_seconds(r.get("modified"), r.get("creation")) > 60) else 0,
            # apna, sabse aakhri reply hi edit ho sakta hai
            "editable": 1 if (can_comment and not c_closed and r.get("name") == c_last and who == session_user) else 0,
        })

    # is complaint par attach saari files (log ke waqt, reply ke saath, comment ke saath)
    f_rows = frappe.get_all(
        "File",
        filters={"attached_to_doctype": DOCTYPE, "attached_to_name": complaint, "is_folder": 0},
        fields=["name", "file_name", "file_url", "file_size", "owner", "creation"],
        order_by="creation asc",
        limit_page_length=200
    )
    f_owners = []
    for f in f_rows:
        if f.get("owner") and f.get("owner") not in f_owners and f.get("owner") not in c_names:
            f_owners.append(f.get("owner"))
    if f_owners:
        for u in frappe.get_all("User", filters={"name": ["in", f_owners]}, fields=["name", "full_name"]):
            c_names[u.get("name")] = u.get("full_name") or u.get("name")
    files = []
    for f in f_rows:
        if not f.get("file_url"):
            continue
        files.append({
            "name": f.get("name"),
            "file_name": f.get("file_name") or "",
            "url": f.get("file_url"),
            "size": f.get("file_size") or 0,
            "user": f.get("owner") or "",
            "by": c_names.get(f.get("owner")) or f.get("owner") or "",
            "on": str(f.get("creation") or ""),
        })
    cdoc = frappe.db.get_value(DOCTYPE, complaint, ["owner", "creation"], as_dict=True) or {}
    frappe.response["message"] = {"comments": comments, "files": files, "status_changed": status_changed,
                                  "owner": cdoc.get("owner") or "", "created": str(cdoc.get("creation") or "")}

elif action == "latest":
    # Log Complaint page: complaint save hone ke baad uska naam (agar page ne naam nahi diya)
    since = frappe.utils.add_to_date(frappe.utils.now_datetime(), minutes=-15)
    latest = frappe.get_all(DOCTYPE, filters={"owner": session_user, "creation": [">", since]},
                            fields=["name"], order_by="creation desc", limit_page_length=1)
    frappe.response["message"] = {"name": latest[0].get("name") if latest else ""}

elif action == "list" or action == "set":
    if not is_admin:
        frappe.throw("Only a System Manager can change access to the complaint portal.")

    for role_name in PAGE_ROLES:
        if not frappe.db.exists("Role", role_name):
            frappe.get_doc({"doctype": "Role", "role_name": role_name, "desk_access": 1}).insert(ignore_permissions=True)

    if action == "set":
        target = (frappe.form_dict.get("user") or "").strip()
        level = frappe.form_dict.get("level") or "none"
        if level not in ["view", "log", "quality", "full", "none"]:
            frappe.throw("Invalid access level.")
        if not target or not frappe.db.exists("User", target):
            frappe.throw("User not found.")
        if target in ["Administrator", "Guest"]:
            frappe.throw("This user cannot be changed.")
        if frappe.get_all("Has Role", filters={"parent": target, "parenttype": "User", "role": "System Manager"}, pluck="role"):
            frappe.throw("System Managers always have full access.")

        want = []
        if level == "view":
            want.append(VIEW_ROLE)
        if level in ["log", "full"]:
            want.append(LOG_ROLE)
        if level in ["quality", "full"]:
            want.append(QUALITY_ROLE)

        user_doc = frappe.get_doc("User", target)
        # (comprehension ke andar top-level naam Server Script mein nahi dikhte — isliye loop)
        keep = []
        for r in user_doc.roles:
            if r.role not in PAGE_ROLES:
                keep.append(r)
        user_doc.set("roles", keep)
        for role_name in want:
            user_doc.append("roles", {"role": role_name})
        # Role Profile wale user ke roles normal save par overwrite ho jaate hain — isliye validate skip
        user_doc.flags.ignore_validate = True
        user_doc.flags.ignore_permissions = True
        user_doc.save()

        saved_roles = frappe.get_all("Has Role", filters={"parent": target, "parenttype": "User"}, pluck="role")
        missing = []
        for r in want:
            if r not in saved_roles:
                missing.append(r)
        if missing:
            frappe.throw("Access could not be saved for " + target + " (" + ", ".join(missing) + " missing). "
                         "If this user has a Role Profile, add the role to that Role Profile.")

    role_rows = frappe.get_all(
        "Has Role",
        filters={"parenttype": "User", "role": ["in", PAGE_ROLES + ["System Manager"]]},
        fields=["parent", "role"]
    )
    user_roles = {}
    for row in role_rows:
        u = row.get("parent")
        if u in ["Administrator", "Guest"]:
            continue
        if u not in user_roles:
            user_roles[u] = []
        user_roles[u].append(row.get("role"))

    users = []
    if user_roles:
        for info in frappe.get_all("User", filters={"name": ["in", list(user_roles.keys())], "enabled": 1},
                                   fields=["name", "full_name", "enabled"], limit_page_length=0):
            r = user_roles.get(info.get("name")) or []
            if "System Manager" in r:
                lvl = "admin"
            elif LOG_ROLE in r and QUALITY_ROLE in r:
                lvl = "full"
            elif LOG_ROLE in r:
                lvl = "log"
            elif QUALITY_ROLE in r:
                lvl = "quality"
            else:
                lvl = "view"
            users.append({"user": info.get("name"), "full_name": info.get("full_name") or info.get("name"),
                          "enabled": info.get("enabled"), "level": lvl})
    users = sorted(users, key=lambda x: ({"admin": 0, "full": 1, "quality": 2, "log": 3, "view": 4}.get(x["level"], 5), (x["full_name"] or "").lower()))

    candidates = []
    for info in frappe.get_all("User",
                               filters={"user_type": "System User", "enabled": 1, "name": ["not in", ["Administrator", "Guest"]]},
                               fields=["name", "full_name"], order_by="full_name asc", limit_page_length=0):
        candidates.append({"user": info.get("name"), "full_name": info.get("full_name") or info.get("name")})

    frappe.response["message"] = {"users": users, "candidates": candidates}

else:
    frappe.throw("Unknown action.")
