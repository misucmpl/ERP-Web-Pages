/* files ko 3 jagah baanto: complaint ke saath / reply ke saath / comment ke saath */
function splitFiles(m) {
  const inCm = {};
  (m.comments || []).forEach((c) => (c.files || []).forEach((u) => (inCm[u] = 1)));
  const made = pd(m.created), log = [], rep = [];
  (m.files || []).forEach((f) => {
    if (inCm[f.url]) return;
    const t = pd(f.on);
    if (m.owner && f.user === m.owner && made && t && (t - made) <= 30 * 60e3) log.push(f); else rep.push(f);
  });
  return { log: log, rep: rep };
}

