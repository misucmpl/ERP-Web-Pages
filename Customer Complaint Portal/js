/* ---------------- photos / videos (log, reply, comment) ---------------- */
const ATT = {
  MAX_FILES: 6,
  VIDEO_MAX: 10 * 1024 * 1024,      /* video: 10 MB tak */
  IMAGE_MAX: 10 * 1024 * 1024,      /* photo: compress ke baad 10 MB tak */
  IMG_EDGE: 1920                    /* badi photo ko 1920px tak chhota karke bhejo */
};
const fSize = (b) => b >= 1048576 ? (Math.round(b / 104857.6) / 10) + " MB" : Math.max(1, Math.round(b / 1024)) + " KB";
const isVid = (n) => /\.(mp4|mov|m4v|webm|3gp|mkv|avi)$/i.test(String(n || "").split("?")[0]);
const isImg = (n) => /\.(jpe?g|png|gif|webp|heic|heif|bmp)$/i.test(String(n || "").split("?")[0]);

/* badi photo ko browser mein hi chhota karo (JPEG), taaki upload jaldi ho */
function shrinkImage(file) {
  return new Promise((resolve) => {
    if (!/^image\/(jpeg|png|webp)$/i.test(file.type) || file.size < 1.2 * 1048576) { resolve(file); return; }
    const url = URL.createObjectURL(file), img = new Image();
    img.onload = () => {
      const k = Math.min(1, ATT.IMG_EDGE / Math.max(img.naturalWidth, img.naturalHeight));
      const cv = document.createElement("canvas");
      cv.width = Math.round(img.naturalWidth * k); cv.height = Math.round(img.naturalHeight * k);
      const cx = cv.getContext("2d");
      cx.fillStyle = "#fff"; cx.fillRect(0, 0, cv.width, cv.height);
      cx.drawImage(img, 0, 0, cv.width, cv.height);
      URL.revokeObjectURL(url);
      cv.toBlob((b) => {
        if (!b || b.size >= file.size) { resolve(file); return; }
        resolve(new File([b], file.name.replace(/\.[^.]+$/, "") + ".jpg", { type: "image/jpeg" }));
      }, "image/jpeg", 0.82);
    };
    img.onerror = () => { URL.revokeObjectURL(url); resolve(file); };
    img.src = url;
  });
}

/* picker: "+ Photo / Video" button + chhote thumbnails, x se hatao */
function attPicker(boxId, msgEl) {
  const box = $(boxId);
  const P = { files: [], busy: false };
  box.innerHTML = `<input type="file" accept="image/*,video/*" multiple hidden>
    <button class="ucd-att-add" type="button" title="Add photos or videos (video up to 10 MB)">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.4 11.1l-9.2 9.2a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5"/></svg>
      <span>Photo / Video</span></button>
    <div class="ucd-att-list"></div>`;
  const inp = box.querySelector("input"), list = box.querySelector(".ucd-att-list");
  function draw() {
    list.innerHTML = P.files.map((f, i) => `<div class="ucd-att-it${f.vid ? " v" : ""}" title="${esc(f.file.name)} \u00b7 ${fSize(f.file.size)}">
      ${f.vid ? `<video src="${f.url}#t=0.3" muted preload="metadata"></video><i>&#9654;</i>` : `<img src="${f.url}" alt="">`}
      <small>${fSize(f.file.size)}</small>
      <button type="button" data-i="${i}" aria-label="Remove">&times;</button></div>`).join("");
    box.classList.toggle("has", P.files.length > 0);
  }
  box.querySelector(".ucd-att-add").addEventListener("click", () => { if (!P.busy) inp.click(); });
  list.addEventListener("click", (e) => {
    const b = e.target.closest("button[data-i]"); if (!b || P.busy) return;
    const f = P.files.splice(+b.dataset.i, 1)[0];
    if (f) URL.revokeObjectURL(f.url);
    draw();
  });
  inp.addEventListener("change", async () => {
    const picked = Array.prototype.slice.call(inp.files || []);
    inp.value = "";
    const bad = [];
    for (const raw of picked) {
      if (P.files.length >= ATT.MAX_FILES) { bad.push("Only " + ATT.MAX_FILES + " files can be added at a time."); break; }
      const vid = /^video\//i.test(raw.type) || isVid(raw.name);
      const img = /^image\//i.test(raw.type) || isImg(raw.name);
      if (!vid && !img) { bad.push(raw.name + ": only photos and videos can be added."); continue; }
      if (vid && raw.size > ATT.VIDEO_MAX) { bad.push(raw.name + " is " + fSize(raw.size) + ". Videos must be 10 MB or smaller."); continue; }
      const file = vid ? raw : await shrinkImage(raw);
      if (!vid && file.size > ATT.IMAGE_MAX) { bad.push(raw.name + " is too large (" + fSize(file.size) + "). Photos must be 10 MB or smaller."); continue; }
      P.files.push({ file: file, vid: vid, url: URL.createObjectURL(file) });
    }
    draw();
    if (msgEl) msg(msgEl, bad.join(" "));
  });
  P.clear = () => { P.files.forEach((f) => URL.revokeObjectURL(f.url)); P.files = []; draw(); };
  P.lock = (on) => { P.busy = on; box.classList.toggle("busy", on); };
  return P;
}

/* ek-ek file Frappe upload_file se complaint par attach karo (private) */
function uploadOne(file, docname, onPct) {
  return new Promise((resolve, reject) => {
    const fd = new FormData();
    fd.append("file", file, file.name);
    fd.append("is_private", "1");
    fd.append("doctype", DOCTYPE);
    fd.append("docname", docname);
    fd.append("folder", "Home/Attachments");
    const x = new XMLHttpRequest();
    x.open("POST", "/api/method/upload_file");
    x.setRequestHeader("Accept", "application/json");
    x.setRequestHeader("X-Frappe-CSRF-Token", (window.frappe && window.frappe.csrf_token) || window.csrf_token || "");
    x.upload.onprogress = (e) => { if (e.lengthComputable && onPct) onPct(e.loaded / e.total); };
    x.onload = () => {
      let j = {}; try { j = JSON.parse(x.responseText); } catch (e) {}
      if (x.status >= 200 && x.status < 300 && j.message && j.message.file_url) { resolve(j.message); return; }
      let why = "";
      try { why = JSON.parse(JSON.parse(j._server_messages)[0]).message; } catch (e) {}
      if (x.status === 413) why = "File is larger than the server allows";
      reject(new Error((why || j.exc_type || ("upload failed (" + x.status + ")")).replace(/<[^>]+>/g, "") + " \u2013 " + file.name));
    };
    x.onerror = () => reject(new Error("Network error while uploading " + file.name));
    x.send(fd);
  });
}
async function uploadAll(P, docname, btn) {
  const out = [], n = P.files.length, label = btn ? btn.textContent : "";
  for (let i = 0; i < n; i++) {
    const show = (p) => { if (btn) btn.textContent = "Uploading " + (i + 1) + "/" + n + " \u00b7 " + Math.round(p * 100) + "%"; };
    show(0);
    out.push(await uploadOne(P.files[i].file, docname, show));
  }
  if (btn) btn.textContent = label;
  return out;
}

