(function () {
/* put "Customer Complaint Portal" next to the ERP header logo */
(function () {
  const brand = document.querySelector(".navbar .navbar-brand");
  if (!brand || document.querySelector(".ux-brand")) return;
  const t = document.createElement("span");
  t.className = "ux-brand";
  t.textContent = "Customer Complaint Portal";
  brand.insertAdjacentElement("afterend", t);
  const wrap = brand.parentElement;
  if (wrap && getComputedStyle(wrap).display !== "flex") {
    brand.style.display = "inline-flex"; t.style.verticalAlign = "middle";
  }
  document.getElementById("ucd").classList.add("has-brand");
})();

const API = "/api/method/ucm_complaints";
const DOCTYPE = "Customer Complaint";
const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const MONTHS_FULL = ["January","February","March","April","May","June","July","August","September","October","November","December"];

const $ = (id) => document.getElementById(id);
const root = $("ucd");
const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) =>
  ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
const cookie = (k) => { const m = document.cookie.match(new RegExp("(?:^|; )" + k + "=([^;]*)")); return m ? decodeURIComponent(m[1]) : ""; };
const pd = (s) => s ? new Date(String(s).replace(" ", "T")) : null;
const fDate = (s) => { if (!s) return ""; const p = String(s).slice(0, 10).split("-"); return `${+p[2]} ${MONTHS[+p[1] - 1]} ${p[0]}`; };
const fTime = (s) => { const d = pd(s); return d ? d.toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" }) : ""; };
const fQty = (q) => q == null ? "" : Number(q).toLocaleString("en-IN", { maximumFractionDigits: 3 });
const dur = (h) => {
  if (h == null || isNaN(h)) return "\u2013";
  if (h < 1) return Math.max(1, Math.round(h * 60)) + "m";
  if (h < 48) return (Math.round(h * 10) / 10) + "h";
  return (Math.round(h / 24 * 10) / 10) + "d";
};
const replyHours = (c) => {
  const a = pd(c.logged_on), b = pd(c.replied_on);
  return a && b ? (b - a) / 36e5 : null;
};

if (!cookie("user_id") || cookie("user_id") === "Guest") {
  window.location.href = "/login?redirect-to=" + encodeURIComponent(location.pathname);
  return;
}

const PAGE = 25;
const st = { all: [], month: "", status: "", type: "", q: "", cur: null, show: PAGE, canDelete: false, cn: null };
const CN_API = "/api/method/ucm_complaint_credit_notes";
const ACCESS_API = "/api/method/ucm_complaint_access";
/* access: view / log (sales) / quality / full / admin — set from ⚙️ Settings */
let acc = { can_view: false, can_log: false, can_reply: false, can_close: false, can_comment: false, is_admin: false, level: "none" };

function msg(el, text, kind) {
  el.className = "ucd-msg" + (text ? " show " + (kind || "err") : "");
  el.textContent = text || "";
}

async function api(url, opts) {
  opts = opts || {};
  const token = (window.frappe && window.frappe.csrf_token) || window.csrf_token || "";
  const r = await fetch(url, Object.assign({
    credentials: "same-origin",
    headers: { "Content-Type": "application/json", Accept: "application/json", "X-Frappe-CSRF-Token": token }
  }, opts));
  if (r.status === 401) { window.location.href = "/login?redirect-to=" + encodeURIComponent(location.pathname); return null; }
  const j = await r.json().catch(() => ({}));
  if (!r.ok) {
    let reason = "";
    try { reason = JSON.parse(JSON.parse(j._server_messages)[0]).message; } catch (e) {}
    if (r.status === 403) reason = reason || "Permission denied for Customer Complaint.";
    throw new Error((reason || j.exc_type || ("Server error " + r.status)).replace(/<[^>]+>/g, ""));
  }
  return j;
}

/* ---------------- load ---------------- */
async function load(keepId) {
  try {
    const j = await api(API);
    if (!j) return;
    st.all = Array.isArray(j.message) ? j.message : [];
    st.canDelete = !!j.can_delete;
    if (st.cn === null) loadCN();
    buildFilters();
    render();
    if (keepId) { const c = st.all.find((x) => x.name === keepId); if (c) openDrawer(c); }
    const want = !keepId && !st.opened && new URLSearchParams(location.search).get("open");
    st.opened = true;
    if (want) { const c = st.all.find((x) => x.name === want); if (c) openDrawer(c); }
  } catch (e) {
    msg($("dMsg"), "Could not load complaints: " + e.message + ". Check that the ucm_complaints API is enabled.");
    $("tList").innerHTML = '<div class="ucd-none">No data</div>';
  }
}

function buildFilters() {
  const mSel = $("dMonth"), tSel = $("dType");
  const months = {}, types = {};
  st.all.forEach((c) => { months[String(c.logged_on).slice(0, 7)] = 1; if (c.complaint_type) types[c.complaint_type] = 1; });
  const keepM = mSel.value, keepT = tSel.value;
  mSel.innerHTML = '<option value="">All months</option>' + Object.keys(months).sort().reverse()
    .map((k) => `<option value="${k}">${MONTHS_FULL[+k.slice(5) - 1]} ${k.slice(0, 4)}</option>`).join("");
  tSel.innerHTML = '<option value="">All types</option>' + Object.keys(types).sort()
    .map((t) => `<option value="${esc(t)}">${esc(t)}</option>`).join("");
  mSel.value = months[keepM] ? keepM : "";
  tSel.value = types[keepT] ? keepT : "";
  st.month = mSel.value; st.type = tSel.value;
}

/* rows matching month + type + search (status applied separately so KPIs show the split) */
function base() {
  const q = st.q.toLowerCase();
  return st.all.filter((c) =>
    (!st.month || String(c.logged_on).startsWith(st.month)) &&
    (!st.type || c.complaint_type === st.type) &&
    (!q || [c.name, c.invoice_no, c.customer_name, c.customer, c.item_code, c.logged_by_name]
      .some((v) => String(v || "").toLowerCase().includes(q))));
}

function render() {
  st.show = PAGE;
  const b = base();
  const rows = st.status ? b.filter((c) => c.status === st.status) : b;

  /* KPIs */
  const cnt = (s) => b.filter((c) => c.status === s).length;
  $("kTotal").textContent = b.length;
  $("kOpen").textContent = cnt("Open");
  $("kReplied").textContent = cnt("Replied");
  $("kClosed").textContent = cnt("Closed");
  $("kTotalSub").textContent = st.month ? MONTHS_FULL[+st.month.slice(5) - 1] + " " + st.month.slice(0, 4) : "All months";
  const hs = b.map(replyHours).filter((h) => h != null);
  $("kAvg").textContent = hs.length ? dur(hs.reduce((a, x) => a + x, 0) / hs.length) : "\u2013";
  $("kAvgSub").textContent = hs.length ? `${hs.length} replied` : "No replies yet";
  root.querySelectorAll(".ucd-kpi[data-s]").forEach((k) => k.classList.toggle("sel", k.dataset.s === st.status));
  root.querySelectorAll("#dStatus button").forEach((x) => x.classList.toggle("on", x.dataset.s === st.status));

  renderCN();
  monthChart();
  hbars($("cType"), group(rows, (c) => c.complaint_type || "Other"), 8);
  hbars($("cCust"), group(rows, (c) => c.customer_name || c.customer || "Unknown"), 6);
  table(rows);
}

function group(rows, keyFn) {
  const m = {};
  rows.forEach((c) => { const k = keyFn(c); m[k] = (m[k] || 0) + 1; });
  return Object.keys(m).map((k) => ({ k, v: m[k] })).sort((a, b) => b.v - a.v);
}

function hbars(el, data, limit) {
  if (!data.length) { el.innerHTML = '<div class="ucd-none">No complaints</div>'; return; }
  const top = data.slice(0, limit);
  if (data.length > limit) top.push({ k: "Other " + (data.length - limit), v: data.slice(limit).reduce((a, x) => a + x.v, 0) });
  const max = Math.max.apply(null, top.map((d) => d.v));
  el.innerHTML = '<div class="ucd-hb">' + top.map((d) =>
    `<div class="r" data-tip="${esc(d.k)}: ${d.v}"><span class="k">${esc(d.k)}</span><span class="v">${d.v}</span>
      <div class="t"><i style="width:${Math.max(3, d.v / max * 100)}%"></i></div></div>`).join("") + "</div>";
}

/* last 12 months ending at the latest month with data (or this month) */
function monthChart() {
  const el = $("cMonth");
  const q = st.q.toLowerCase();
  const pool = st.all.filter((c) => (!st.type || c.complaint_type === st.type) && (!st.status || c.status === st.status) &&
    (!q || [c.name, c.invoice_no, c.customer_name, c.customer, c.item_code, c.logged_by_name]
      .some((v) => String(v || "").toLowerCase().includes(q))));
  const now = new Date();
  let end = now.getFullYear() * 12 + now.getMonth();
  const keys = [];
  for (let i = 11; i >= 0; i--) {
    const n = end - i, y = Math.floor(n / 12), m = n % 12;
    keys.push(`${y}-${String(m + 1).padStart(2, "0")}`);
  }
  const counts = keys.map((k) => pool.filter((c) => String(c.logged_on).startsWith(k)).length);
  const max = Math.max(1, Math.max.apply(null, counts));
  el.innerHTML = `<div class="ucd-cols">${keys.map((k, i) =>
    `<div class="ucd-col${st.month === k ? " sel" : ""}" data-m="${k}" data-tip="${MONTHS_FULL[+k.slice(5) - 1]} ${k.slice(0, 4)}: ${counts[i]} complaint${counts[i] === 1 ? "" : "s"}">
      ${counts[i] ? `<span class="n">${counts[i]}</span>` : ""}
      <div class="bar" style="height:${counts[i] ? Math.max(4, counts[i] / max * 100) : 1.5}%"></div></div>`).join("")}</div>
    <div class="ucd-xl">${keys.map((k) => `<span>${MONTHS[+k.slice(5) - 1]}</span>`).join("")}</div>`;
  el.querySelectorAll(".ucd-col").forEach((c) => c.addEventListener("click", () => {
    st.month = st.month === c.dataset.m ? "" : c.dataset.m;
    const sel = $("dMonth");
    if (st.month && !Array.from(sel.options).some((o) => o.value === st.month)) {
      const o = document.createElement("option"); o.value = st.month;
      o.textContent = MONTHS_FULL[+st.month.slice(5) - 1] + " " + st.month.slice(0, 4); sel.appendChild(o);
    }
    sel.value = st.month;
    render();
  }));
}

/* right side: complaints list (card rows) */
function ago(s) {
  const d = pd(s); if (!d) return "";
  const h = (Date.now() - d) / 36e5;
  if (h < 1) return Math.max(1, Math.round(h * 60)) + "m ago";
  if (h < 24) return Math.round(h) + "h ago";
  const dd = Math.round(h / 24);
  return dd + (dd === 1 ? " day ago" : " days ago");
}
function table(rows) {
  $("tCount").textContent = `${rows.length} complaint${rows.length === 1 ? "" : "s"}`;
  if (!rows.length) {
    $("tList").innerHTML = `<div class="ucd-none">${st.all.length ? "No complaints match these filters" :
      (acc.can_log ? 'No complaints yet. <a href="/log-complaint">Log the first one</a>.' : "No complaints yet.")}</div>`;
    return;
  }
  const shown = rows.slice(0, st.show);
  $("tList").innerHTML = shown.map((c) => {
    const h = replyHours(c);
    const rep = h != null
      ? `<span class="rep">Reply in <b>${dur(h)}</b>${c.replied_by_name ? " · " + esc(c.replied_by_name) : ""}</span>`
      : (c.quality_reply ? '<span class="rep">Replied</span>' : '<span class="rep pending">Reply pending</span>');
    return `<div class="ucd-item ${esc(c.status)}${st.cur && st.cur.name === c.name ? " cur" : ""}" data-id="${esc(c.name)}">
      <div class="ucd-it-top"><span class="id">${esc(c.name)}</span><span class="ucd-badge ${esc(c.status)}">${esc(c.status)}</span>${c.complaint_type ? `<span class="type">${esc(c.complaint_type)}</span>` : ""}</div>
      <div class="ucd-it-cust" title="${esc(c.customer_name || c.customer)}">${esc(c.customer_name || c.customer)}</div>
      <div class="ucd-it-meta" title="${esc(c.item_code)}"><b>${esc(c.item_code)}</b> · Inv ${esc(c.invoice_no)}${c.invoice_date ? " (" + fDate(c.invoice_date) + ")" : ""}</div>
      ${c.complaint ? `<div class="ucd-it-text">${esc(c.complaint)}</div>` : ""}
      <div class="ucd-it-side">
        <span class="when">${fDate(c.logged_on)}<small>${fTime(c.logged_on)} · ${ago(c.logged_on)}</small></span>
        <span class="rep">by ${esc(c.logged_by_name || "")}</span>
        ${rep}
      </div>
    </div>`;
  }).join("") + (rows.length > shown.length
    ? `<div class="ucd-more"><button class="ucd-btn ghost" id="tMore" type="button">Show more (${rows.length - shown.length} left)</button></div>` : "");
  const more = $("tMore");
  if (more) more.addEventListener("click", (e) => { e.stopPropagation(); st.show += PAGE; table(rows); });
}
function markCur() {
  document.querySelectorAll("#tList .ucd-item").forEach((el) => el.classList.toggle("cur", !!st.cur && el.dataset.id === st.cur.name));
}

/* ---------------- drawer ---------------- */
function openDrawer(c) {
  st.cur = c;
  msg($("dwMsg"), "");
  $("dwId").textContent = c.name;
  $("dwBadge").innerHTML = `<span class="ucd-badge ${esc(c.status)}">${esc(c.status)}</span>`;
  $("dwKv").innerHTML = `
    <div><span>Invoice</span><b>${esc(c.invoice_no)}</b></div>
    <div><span>Invoice date</span><b>${fDate(c.invoice_date)}</b></div>
    <div class="full"><span>Customer</span><b>${esc(c.customer_name || c.customer)}</b></div>
    <div class="full"><span>Item</span><b>${esc(c.item_code)}</b></div>
    <div><span>Invoice qty</span><b>${fQty(c.item_qty)}</b></div>
    <div><span>Type</span><b>${esc(c.complaint_type)}</b></div>
    <div><span>Logged by</span><b>${esc(c.logged_by_name)}</b></div>
    <div><span>Logged on</span><b>${fDate(c.logged_on)}, ${fTime(c.logged_on)}</b></div>`;
  $("dwText").textContent = c.complaint || "";
  if (c.quality_reply) {
    const meta = [];
    if (c.replied_by_name) meta.push(esc(c.replied_by_name));
    if (c.replied_on) {
      meta.push(fDate(c.replied_on) + ", " + fTime(c.replied_on));
      meta.push(dur(replyHours(c)) + " after logging");
    }
    $("dwReplyShow").innerHTML = `<p class="ucd-sec">Quality reply</p><div class="ucd-box q">${meta.length ? `<span class="who">${meta.join(" &middot; ")}</span>` : ""}${esc(c.quality_reply)}</div>`;
    $("dwReplyLbl").textContent = "Update reply";
  } else {
    $("dwReplyShow").innerHTML = "";
    $("dwReplyLbl").textContent = "Quality reply";
  }
  $("dwReply").value = "";
  $("dwReply").placeholder = c.quality_reply
    ? "Write the updated reply here. It will replace the reply above\u2026"
    : "Root cause, action taken, and what the customer should expect\u2026";
  const closed = c.status === "Closed";
  $("dwReplyEdit").style.display = closed || !acc.can_reply ? "none" : "";
  $("dwSave").style.display = closed || !acc.can_reply ? "none" : "";
  $("dwDone").style.display = acc.can_close ? "" : "none";
  $("dwCmAdd").style.display = acc.can_comment ? "" : "none";
  $("dwCmText").value = "";
  loadComments(c.name);
  $("dwDone").textContent = closed ? "Reopen" : "Mark Closed";
  $("dwDone").classList.toggle("green", !closed);
  $("dwDone").classList.toggle("ghost", closed);
  $("dwDel").style.display = st.canDelete ? "" : "none";
  resetDel();
  root.classList.add("dopen");
  markCur();
  lockScroll(true);
  $("dDrawer").setAttribute("aria-hidden", "false");
}
function closeDrawer() { root.classList.remove("dopen"); $("dDrawer").setAttribute("aria-hidden", "true"); st.cur = null; lockScroll(false); markCur(); }
/* stop the page behind the panel from scrolling; keep layout from jumping */
function lockScroll(on) {
  const de = document.documentElement, b = document.body;
  if (on) {
    if (b.dataset.ucdLock) return;
    const gap = window.innerWidth - de.clientWidth;
    b.dataset.ucdLock = "1";
    de.style.overflow = "hidden"; b.style.overflow = "hidden";
    if (gap > 0) b.style.paddingRight = gap + "px";
  } else {
    delete b.dataset.ucdLock;
    de.style.overflow = ""; b.style.overflow = ""; b.style.paddingRight = "";
  }
}

async function update(fields, okText) {
  const c = st.cur;
  if (!c) return;
  const btns = [$("dwSave"), $("dwDone"), $("dwDel")];
  btns.forEach((b) => (b.disabled = true));
  try {
    await api(`/api/resource/${encodeURIComponent(DOCTYPE)}/${encodeURIComponent(c.name)}`,
      { method: "PUT", body: JSON.stringify(fields) });
    await load(c.name);
    msg($("dwMsg"), okText, "ok");
  } catch (e) {
    msg($("dwMsg"), "Not saved: " + e.message);
  }
  btns.forEach((b) => (b.disabled = false));
}

$("dwSave").addEventListener("click", () => {
  const t = $("dwReply").value.trim();
  if (t.length < 5) { msg($("dwMsg"), "Write the reply first (at least a few words)."); return; }
  if (st.cur && t === (st.cur.quality_reply || "")) { msg($("dwMsg"), "Reply is unchanged."); return; }
  update({ quality_reply: t }, "Reply saved and posted on the invoice.");
});
/* Delete: System Manager only, click twice to confirm */
let delTimer;
function resetDel() { const b = $("dwDel"); b.classList.remove("arm"); b.textContent = "Delete"; clearTimeout(delTimer); }
$("dwDel").addEventListener("click", async () => {
  const b = $("dwDel"), c = st.cur;
  if (!c) return;
  if (!b.classList.contains("arm")) {
    b.classList.add("arm"); b.textContent = "Click again to delete";
    delTimer = setTimeout(resetDel, 4000);
    return;
  }
  resetDel();
  b.disabled = true;
  try {
    await api(`/api/resource/${encodeURIComponent(DOCTYPE)}/${encodeURIComponent(c.name)}`, { method: "DELETE" });
    closeDrawer();
    await load();
    msg($("dMsg"), `${c.name} deleted.`, "ok");
    setTimeout(() => msg($("dMsg"), ""), 4000);
  } catch (e) {
    msg($("dwMsg"), "Not deleted: " + e.message);
  }
  b.disabled = false;
});

$("dwDone").addEventListener("click", () => {
  if (!st.cur) return;
  if (st.cur.status === "Closed") update({ status: st.cur.quality_reply ? "Replied" : "Open" }, "Complaint reopened.");
  else update({ status: "Closed" }, "Complaint closed.");
});
$("dwClose").addEventListener("click", closeDrawer);
$("dShade").addEventListener("click", () => { closeDrawer(); closeCN(); });
document.addEventListener("keydown", (e) => { if (e.key !== "Escape") return; if (st.cur) closeDrawer(); closeCN(); });
$("tList").addEventListener("click", (e) => {
  if (e.target.closest("a, button")) return;
  const tr = e.target.closest(".ucd-item[data-id]");
  if (!tr) return;
  const c = st.all.find((x) => x.name === tr.dataset.id);
  if (c) openDrawer(c);
});


/* ---------------- customer rejection: credit notes ---------------- */
const fAmt = (v) => "\u20b9" + Number(v || 0).toLocaleString("en-IN", { maximumFractionDigits: 0 });
const fAmtS = (v) => { v = v || 0; return v >= 1e7 ? "\u20b9" + (v / 1e7).toFixed(2) + " Cr" : v >= 1e5 ? "\u20b9" + (v / 1e5).toFixed(2) + " L" : fAmt(v); };
async function loadCN() {
  st.cn = [];
  try {
    const j = await api(CN_API);
    st.cn = (j && Array.isArray(j.message)) ? j.message : [];
    if (j && !Array.isArray(j.message)) console.warn("ucm_complaint_credit_notes response:", j);
    st.cnErr = "";
  } catch (e) { st.cnErr = e.message; }
  renderCN();
}
/* month filter + search (customer / invoice) lagta hai; status / type nahi */
function cnRows() {
  const q = st.q.toLowerCase();
  return (st.cn || []).filter((r) =>
    (!st.month || String(r.posting_date).startsWith(st.month)) &&
    (!q || [r.name, r.customer_name, r.customer, r.return_against].some((v) => String(v || "").toLowerCase().includes(q))));
}
function renderCN() {
  if (st.cnErr) { $("cnAmt").textContent = "\u2013"; $("cnCount").textContent = "\u2013"; $("cnInv").textContent = "\u2013"; $("cnSub").textContent = "Could not load: " + st.cnErr; $("cnSub").title = st.cnErr; return; }
  const r = cnRows();
  const amt = r.reduce((a, x) => a + (x.amount || 0), 0);
  const inv = {}; r.forEach((x) => { if (x.return_against) inv[x.return_against] = 1; });
  $("cnAmt").textContent = fAmtS(amt);
  $("cnAmt").title = fAmt(amt);
  $("cnCount").textContent = r.length;
  $("cnInv").textContent = Object.keys(inv).length;
  $("cnSub").textContent = (st.month ? MONTHS_FULL[+st.month.slice(5) - 1] + " " + st.month.slice(0, 4) : "Since 1 Jul 2026") + " \u00b7 Sales Invoice returns";
  if (root.classList.contains("cnopen")) drawCNList();
}
function drawCNList() {
  const r = cnRows();
  const amt = r.reduce((a, x) => a + (x.amount || 0), 0);
  $("cnDSub").textContent = `${r.length} credit note${r.length === 1 ? "" : "s"} \u00b7 ${fAmt(amt)} excl. GST \u00b7 ` + (st.month ? MONTHS_FULL[+st.month.slice(5) - 1] + " " + st.month.slice(0, 4) : "since 1 Jul 2026");
  if (!r.length) { $("cnList").innerHTML = '<div class="ucd-none">No credit notes for this filter</div>'; return; }
  /* customer-wise summary + list */
  const byC = {};
  r.forEach((x) => { const k = x.customer_name || x.customer; byC[k] = byC[k] || { n: 0, a: 0 }; byC[k].n++; byC[k].a += x.amount || 0; });
  const cs = Object.keys(byC).sort((a, b) => byC[b].a - byC[a].a);
  const max = cs.length ? byC[cs[0]].a : 0;
  $("cnList").innerHTML =
    '<p class="ucd-sec">By customer</p><div class="ucd-hb" style="margin-bottom:18px">' + cs.slice(0, 8).map((k) =>
      `<div class="r"><span class="k">${esc(k)} <span style="color:var(--ink-3)">\u00b7 ${byC[k].n}</span></span><span class="v">${fAmt(byC[k].a)}</span>
        <div class="t"><i style="width:${Math.max(3, byC[k].a / max * 100)}%;background:var(--err)"></i></div></div>`).join("") + "</div>" +
    '<p class="ucd-sec">Credit notes</p><div class="ucd-cn-rows">' + r.map((x) =>
      `<div class="ucd-cn-row">
        <div><a href="/app/sales-invoice/${encodeURIComponent(x.name)}" target="_blank" rel="noopener">${esc(x.name)}</a>
          <small>${fDate(x.posting_date)}${x.return_against ? ' \u00b7 against <a href="/app/sales-invoice/' + encodeURIComponent(x.return_against) + '" target="_blank" rel="noopener">' + esc(x.return_against) + "</a>" : ""}</small></div>
        <div class="c">${esc(x.customer_name || x.customer)}${x.remarks ? `<small>${esc(x.remarks)}</small>` : ""}</div>
        <b>${fAmt(x.amount)}</b>
      </div>`).join("") + "</div>";
}
function openCN() { drawCNList(); root.classList.add("cnopen"); $("cnDrawer").setAttribute("aria-hidden", "false"); lockScroll(true); }
function closeCN() { root.classList.remove("cnopen"); $("cnDrawer").setAttribute("aria-hidden", "true"); if (!st.cur) lockScroll(false); }
$("cnCard").addEventListener("click", openCN);
$("cnClose").addEventListener("click", closeCN);

/* ---------------- filters ---------------- */
$("dMonth").addEventListener("change", (e) => { st.month = e.target.value; render(); });
$("dType").addEventListener("change", (e) => { st.type = e.target.value; render(); });
let tmr;
$("dSearch").addEventListener("input", (e) => { clearTimeout(tmr); tmr = setTimeout(() => { st.q = e.target.value.trim(); render(); }, 150); });
$("dStatus").addEventListener("click", (e) => { const b = e.target.closest("button"); if (!b) return; st.status = b.dataset.s; render(); });
root.querySelectorAll(".ucd-kpi[data-s]").forEach((k) => k.addEventListener("click", () => { st.status = k.dataset.s; render(); }));

/* ---------------- tooltip ---------------- */
const tip = $("dTip");
root.addEventListener("mousemove", (e) => {
  const t = e.target.closest("[data-tip]");
  if (!t) { tip.style.display = "none"; return; }
  tip.textContent = t.dataset.tip;
  tip.style.display = "block";
  const w = tip.offsetWidth;
  tip.style.left = Math.min(window.innerWidth - w - 8, e.clientX + 12) + "px";
  tip.style.top = (e.clientY - 34) + "px";
});
root.addEventListener("mouseleave", () => { tip.style.display = "none"; });

/* ---------------- comments (Sales + Quality) ---------------- */
const fWhen = (s) => s ? fDate(s) + ", " + fTime(s) : "";
function drawComments(list) {
  $("dwCmN").textContent = list.length ? "(" + list.length + ")" : "";
  $("dwCmList").innerHTML = list.length ? list.map((m) => `
    <div class="ucd-cm-item${m.user === acc.user ? " me" : ""}">
      <div class="ucd-cm-av">${esc(String(m.by || "?").trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join("").toUpperCase())}</div>
      <div class="ucd-cm-b"><div class="ucd-cm-h"><b>${esc(m.by)}</b><span>${fWhen(m.on)} &middot; ${ago(m.on)}</span></div>
      <div class="ucd-cm-t">${esc(m.text)}</div></div>
    </div>`).join("") : '<div class="ucd-cm-none">No comments yet.</div>';
}
async function loadComments(name) {
  $("dwCmN").textContent = "";
  $("dwCmList").innerHTML = '<div class="ucd-cm-none">Loading comments&hellip;</div>';
  try {
    const j = await api(ACCESS_API + "?action=comments&name=" + encodeURIComponent(name));
    if (st.cur && st.cur.name === name) drawComments((j && j.message && j.message.comments) || []);
  } catch (e) { $("dwCmList").innerHTML = '<div class="ucd-cm-none">Could not load comments: ' + esc(e.message) + "</div>"; }
}
$("dwCmSend").addEventListener("click", async () => {
  const c = st.cur, t = $("dwCmText").value.trim(), b = $("dwCmSend");
  if (!c) return;
  if (t.length < 2) { msg($("dwMsg"), "Write a comment first."); return; }
  b.disabled = true;
  try {
    const j = await api(ACCESS_API, { method: "POST", body: JSON.stringify({ action: "comment", name: c.name, text: t }) });
    $("dwCmText").value = "";
    msg($("dwMsg"), "");
    if (st.cur && st.cur.name === c.name) drawComments((j && j.message && j.message.comments) || []);
  } catch (e) { msg($("dwMsg"), "Comment not posted: " + e.message); }
  b.disabled = false;
});

/* ---------------- ⚙️ access settings (System Manager) ---------------- */
const LV = { admin: "System Manager", full: "Full", quality: "Quality", log: "Log \u00b7 Sales", view: "View" };
const sv = { users: [], cand: [], pick: null };
function openSettings() { $("sBg").hidden = false; lockScroll(true); msg($("sMsg"), ""); loadSettings(); }
function closeSettings() { if ($("sBg").hidden) return; $("sBg").hidden = true; if (!st.cur) lockScroll(false); }
async function loadSettings(body) {
  try {
    const j = await api(ACCESS_API, { method: "POST", body: JSON.stringify(body || { action: "list" }) });
    const m = (j && j.message) || {};
    sv.users = m.users || []; sv.cand = m.candidates || [];
    drawSettings();
    return true;
  } catch (e) { msg($("sMsg"), (body ? "Not saved: " : "Could not load users: ") + e.message); return false; }
}
function drawSettings() {
  const lvSel = (u) => `<select class="ucd-lv ${u.level}" data-u="${esc(u.user)}">` +
    ["view", "log", "quality", "full"].map((k) => `<option value="${k}"${u.level === k ? " selected" : ""}>${LV[k]}</option>`).join("") + "</select>";
  $("sList").innerHTML = sv.users.length ? sv.users.map((u) => `
    <div class="ucd-urow${u.enabled ? "" : " off"}">
      <div class="ucd-uav">${esc(String(u.full_name || u.user).trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join("").toUpperCase())}</div>
      <div class="ucd-un"><b>${esc(u.full_name)}</b><small>${esc(u.user)}${u.enabled ? "" : " \u00b7 disabled"}</small></div>
      ${u.level === "admin" ? '<span class="ucd-lvtag admin">System Manager</span><span class="ucd-urm"></span>'
        : lvSel(u) + `<button class="ucd-urm" type="button" data-rm="${esc(u.user)}" title="Remove access">&times;</button>`}
    </div>`).join("") : '<div class="ucd-none">No users yet</div>';
}
function pickList() {
  const q = $("sUser").value.trim().toLowerCase(), have = {};
  sv.users.forEach((u) => (have[u.user] = 1));
  const list = sv.cand.filter((c) => !have[c.user] && (!q || (c.full_name + " " + c.user).toLowerCase().includes(q))).slice(0, 8);
  const box = $("sUserList");
  box.innerHTML = list.length ? list.map((c) => `<button type="button" data-u="${esc(c.user)}"><b>${esc(c.full_name)}</b><small>${esc(c.user)}</small></button>`).join("")
    : '<div class="ucd-none">No user found</div>';
  box.hidden = false;
}
$("sUser").addEventListener("focus", pickList);
$("sUser").addEventListener("input", () => { sv.pick = null; pickList(); });
$("sUserList").addEventListener("mousedown", (e) => {
  const b = e.target.closest("button[data-u]"); if (!b) return;
  e.preventDefault();
  const c = sv.cand.find((x) => x.user === b.dataset.u);
  sv.pick = c ? c.user : null; $("sUser").value = c ? c.full_name + " (" + c.user + ")" : "";
  $("sUserList").hidden = true;
});
$("sUser").addEventListener("blur", () => setTimeout(() => ($("sUserList").hidden = true), 120));
$("sGrant").addEventListener("click", async () => {
  if (!sv.pick) { msg($("sMsg"), "Pick a user from the list first."); return; }
  const b = $("sGrant"); b.disabled = true;
  const who = sv.pick;
  if (await loadSettings({ action: "set", user: who, level: $("sLevel").value })) {
    sv.pick = null; $("sUser").value = "";
    msg($("sMsg"), "Access given to " + who + ".", "ok");
  }
  b.disabled = false;
});
$("sList").addEventListener("change", async (e) => {
  const s = e.target.closest("select[data-u]"); if (!s) return;
  s.disabled = true;
  if (await loadSettings({ action: "set", user: s.dataset.u, level: s.value })) msg($("sMsg"), "Access updated for " + s.dataset.u + ".", "ok");
  else s.disabled = false;
});
$("sList").addEventListener("click", async (e) => {
  const b = e.target.closest("button[data-rm]"); if (!b) return;
  if (!b.classList.contains("arm")) { b.classList.add("arm"); b.textContent = "Remove?"; setTimeout(() => { b.classList.remove("arm"); b.innerHTML = "&times;"; }, 3000); return; }
  b.disabled = true;
  if (await loadSettings({ action: "set", user: b.dataset.rm, level: "none" })) msg($("sMsg"), "Access removed for " + b.dataset.rm + ".", "ok");
});
$("dGear").addEventListener("click", openSettings);
$("sClose").addEventListener("click", closeSettings);
$("sBg").addEventListener("mousedown", (e) => { if (e.target === $("sBg")) closeSettings(); });
document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeSettings(); });

/* ---------------- start: access check, then dashboard ---------------- */
async function boot() {
  try {
    const j = await api(ACCESS_API + "?action=me");
    acc = Object.assign(acc, (j && j.message) || {});
  } catch (e) {
    $("dGate").innerHTML = `<div class="ucd-gate-card"><div class="ico">!</div><h3>Could not check access</h3><p>${esc(e.message)}</p><p class="s">Check that the <b>ucm_complaint_access</b> Server Script is saved and enabled.</p></div>`;
    return;
  }
  if (!acc.can_view) {
    $("dGate").innerHTML = `<div class="ucd-gate-card"><div class="ico lock">&#128274;</div><h3>You do not have access</h3>
      <p>The complaint portal is open only to users given access by a System Manager.</p>
      <p class="s">Signed in as <b>${esc(acc.full_name || acc.user || "")}</b></p></div>`;
    return;
  }
  $("dGate").hidden = true;
  $("dMain").hidden = false;
  $("dLog").hidden = !acc.can_log;
  $("dGear").hidden = !acc.is_admin;
  const tag = { view: "View only", quality: "Quality", log: "Sales" }[acc.level];
  if (tag) { $("dRole").hidden = false; $("dRole").textContent = tag; $("dRole").className = "ucd-role " + acc.level; }
  load();
}
boot();
})();
