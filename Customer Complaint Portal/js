  if ($("lgBg").hidden) return;
  $("lgBg").hidden = true; $("lgFrame").src = "about:blank";
  if (!st.cur) lockScroll(false);
}
$("lgFrame").addEventListener("load", () => {
  if ($("lgFrame").src.indexOf("about:blank") >= 0) return;
  $("lgLoad").hidden = true; $("lgFrame").style.visibility = "";
});
root.addEventListener("click", (e) => {
  const a = e.target.closest('a[href^="/log-complaint"]');
  if (!a || e.ctrlKey || e.metaKey || e.shiftKey) return;
  e.preventDefault(); openLog();
});
$("lgClose").addEventListener("click", closeLog);
document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeLog(); });
/* form ke andar se message: complaint save hua \u2192 popup band, list refresh, naya complaint khulo */
window.addEventListener("message", (e) => {
  if (e.origin !== location.origin || !e.data) return;
  if (e.data.type === "ucm-complaint-logged") {
    closeLog();
    load(e.data.name || undefined).then(() => {
      msg($("dMsg"), (e.data.name ? e.data.name + " logged." : "Complaint logged."), "ok");
      setTimeout(() => msg($("dMsg"), ""), 4000);
    });
  } else if (e.data.type === "ucm-complaint-close") closeLog();
});
$("sClose").addEventListener("click", closeSettings);
$("sBg").addEventListener("mousedown", (e) => { if (e.target === $("sBg")) closeSettings(); });
document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeSettings(); });

/* ---------------- start: access check, then dashboard ---------------- */
async function boot() {
  try {
    const j = await api(ACCESS_API + "?action=me");
    acc = Object.assign(acc, (j && j.message) || {});
  } catch (e) {
    $("dGate").innerHTML = `<div class="ucd-gate-card"><div class="ico">!</div><h3>Could not check access</h3><p>${esc(e.message)}</p><p class="s">Check that the <b>ucm_complaint_access</b> Server Script is saved and enabled.</p></div>`;
    return;
  }
  if (!acc.can_view) {
    $("dGate").innerHTML = `<div class="ucd-gate-card"><div class="ico lock">&#128274;</div><h3>You do not have access</h3>
      <p>The complaint portal is open only to users given access by a System Manager.</p>
      <p class="s">Signed in as <b>${esc(acc.full_name || acc.user || "")}</b></p></div>`;
    return;
  }
  $("dGate").hidden = true;
  $("dMain").hidden = false;
  $("dLog").hidden = !acc.can_log;
  $("dGear").hidden = !acc.is_admin;
  const tag = { view: "View only", quality: "Quality", log: "Sales" }[acc.level];
  if (tag) { $("dRole").hidden = false; $("dRole").textContent = tag; $("dRole").className = "ucd-role " + acc.level; }
  load();
}
boot();
})();
