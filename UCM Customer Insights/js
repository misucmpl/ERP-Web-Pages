      lst.innerHTML = list.length ? list.map(function (c) { return '<button type="button" data-u="' + esc(c.user) + '"><b>' + esc(c.full_name) + "</b><small>" + esc(c.user) + "</small></button>"; }).join("") : '<div class="ci-none">No user found</div>';
      lst.hidden = false;
    }
    inp.addEventListener("focus", pick);
    inp.addEventListener("input", function () { SV.pick = null; pick(); });
    inp.addEventListener("blur", function () { setTimeout(function () { lst.hidden = true; }, 120); });
    lst.addEventListener("mousedown", function (e) {
      var b = e.target.closest("button[data-u]"); if (!b) return; e.preventDefault();
      var c = SV.cand.filter(function (x) { return x.user === b.getAttribute("data-u"); })[0];
      SV.pick = c ? c.user : null; inp.value = c ? c.full_name + " (" + c.user + ")" : ""; lst.hidden = true;
    });
    $("#ci-set-add").addEventListener("click", function (e) {
      var b = e.target.closest("[data-rep]"); if (!b) return;
      SV.add = toggled(SV.add, b.getAttribute("data-rep")); drawAdd();
    });
    $("#ci-set-go").addEventListener("click", async function () {
      if (!SV.pick) { setMsg("Pick a user from the list first."); return; }
      var reps = selStr(SV.add); if (!reps) { setMsg("Select Full or at least one report."); return; }
      this.disabled = true; var who = SV.pick;
      if (await settingsCall({ action: "set", user: who, reports: reps })) { SV.pick = null; inp.value = ""; setMsg("Access given to " + who + ": " + accText(reps) + ".", true); }
      this.disabled = false;
    });
    $("#ci-set-list").addEventListener("click", async function (e) {
      var b = e.target.closest("button[data-u]"); if (!b || b.disabled) return;
      var who = b.getAttribute("data-u"), u = SV.users.filter(function (x) { return x.user === who; })[0]; if (!u) return;
      var reps;
      if (b.hasAttribute("data-rm")) {
        if (!b.classList.contains("arm")) { b.classList.add("arm"); b.textContent = "Remove?"; setTimeout(function () { if (b.isConnected) { b.classList.remove("arm"); b.innerHTML = I.x; } }, 3000); return; }
        reps = "";
      } else {
        var cur = {}; (u.reports || []).forEach(function (k) { cur[k] = 1; });
        reps = selStr(toggled(cur, b.getAttribute("data-rep")));
        if (!reps && !confirmRemove(b)) return;
      }
      $$("button", b.closest(".ci-urow")).forEach(function (x) { x.disabled = true; });
      if (await settingsCall({ action: "set", user: who, reports: reps })) setMsg(reps ? "Access for " + who + ": " + accText(reps) + "." : "Access removed for " + who + ".", true);
    });
    settingsCall({ action: "list" });
  }
  function confirmRemove(b) {
    if (b.classList.contains("arm")) return true;
    b.classList.add("arm"); setMsg("Click again to remove all access for this user.");
    setTimeout(function () { if (b.isConnected) b.classList.remove("arm"); }, 3000);
    return false;
  }
  function accText(reps) { var a = reps.split(",").filter(Boolean); return a.length === 3 ? "Full" : a.map(function (k) { return REP_LABEL[k]; }).join(", "); }
  function drawAdd() { $("#ci-set-add").innerHTML = '<span class="ci-addl">Access</span>' + repToggles(SV.add, ""); }
  function setMsg(t, ok) { var el = $("#ci-set-msg"); if (!el) return; el.className = "ci-msg" + (t ? " show" + (ok ? " ok" : "") : ""); el.textContent = t || ""; }
  async function settingsCall(body) {
    try {
      var m = await api(body, "POST"); if (!m) return false;
      SV.users = (m.users || []).filter(function (u) { return u.enabled !== 0 && u.enabled !== false; }); SV.cand = m.candidates || [];
      $("#ci-set-list").innerHTML = SV.users.length ? SV.users.map(function (u) {
        var sel = {}; (u.reports || []).forEach(function (k) { sel[k] = 1; });
        return '<div class="ci-urow"><span class="av">' + esc(initials(u.full_name || u.user)) + '</span><div class="nm"><b>' + esc(u.full_name) + "</b><small>" + esc(u.user) + "</small></div>" +
          (u.admin ? '<span class="tag admin">System Manager \u00b7 Full</span><span class="rm"></span>'
            : repToggles(sel, 'data-u="' + esc(u.user) + '"') + '<button type="button" class="rm" data-u="' + esc(u.user) + '" data-rm="1" title="Remove access">' + I.x + "</button>") + "</div>";
      }).join("") : '<div class="ci-none">No users yet</div>';
      return true;
    } catch (e) { setMsg((body.action === "list" ? "Could not load users: " : "Not saved: ") + e.message); return false; }
  }
  function closeSettings() { var m = $("#ci-set"); if (m.hidden) return; m.hidden = true; lock(false); }
  $("#ci-gear").addEventListener("click", openSettings);
  $("#ci-set").addEventListener("mousedown", function (e) { if (e.target === this) closeSettings(); });

  /* ============ UCM standard header: title + buttons ERP navbar mein ============ */
  function mergeNav() {
    var nav = d.querySelector("nav.navbar"), brand = nav && nav.querySelector(".navbar-brand");
    if (!nav || !brand) return;
    var t = d.createElement("div"); t.className = "ci-nav-title";
    t.innerHTML = '<h1>Customer Insights</h1><p class="ci-sub"></p>';
    brand.insertAdjacentElement("afterend", t);
    var sw = $("#ci-head .ci-sec"); if (sw) { sw.classList.add("in-nav"); t.insertAdjacentElement("afterend", sw); }
    var act = $("#ci-act"); act.classList.add("ci-nav-act");
    var login = nav.querySelector("#website-post-login");
    if (login && login.parentNode) {
      var li = d.createElement("li"); li.className = "nav-item ci-nav-li"; li.appendChild(act);
      login.parentNode.insertBefore(li, login);
    } else { (brand.parentElement || nav).appendChild(act); act.classList.add("is-end"); }
    $("#ci-head").hidden = true;
    d.body.classList.add("ci-nav-merged");
    alignToLogo();
    w.addEventListener("resize", alignToLogo);
    w.addEventListener("load", alignToLogo);
  }
  /* page ka left margin = logo ka left margin */
  function alignToLogo() {
    var brand = d.querySelector("nav.navbar .navbar-brand"); if (!brand) return;
    var img = brand.querySelector("img, svg") || brand;
    var left = Math.round(img.getBoundingClientRect().left - root.getBoundingClientRect().left);
    if (left >= 8 && left <= 120) root.style.setProperty("--ci-pad", left + "px");
    var nav = d.querySelector("nav.navbar"), pos = nav ? getComputedStyle(nav).position : "";
    var stick = nav && (pos === "sticky" || pos === "fixed") ? Math.round(nav.getBoundingClientRect().height) : 0;
    if (!stick && nav && nav.parentElement && /sticky|fixed/.test(getComputedStyle(nav.parentElement).position)) stick = Math.round(nav.parentElement.getBoundingClientRect().height);
    root.style.setProperty("--ci-nav-h", stick + "px");
  }

  /* ============ start ============ */
  async function boot() {
    if (!cookie("user_id") || cookie("user_id") === "Guest") { location.href = "/login?redirect-to=" + encodeURIComponent(location.pathname); return; }
    try { S.acc = await api({ action: "me" }); }
    catch (e) {
      $("#ci-gate").innerHTML = '<div class="ci-gate-card"><div class="ico warn">!</div><h3>Could not check access</h3><p>' + esc(e.message) + '</p><p class="s">Check that the <b>ucm_customer_insights</b> Server Script is saved and enabled.</p></div>';
      return;
    }
    var acc = (S.acc && S.acc.access) || {};
    S.secs = SECS.filter(function (s) { return acc[s.k]; }).map(function (s) { return s.k; });
    if (!S.secs.length) {
      $("#ci-gate").innerHTML = '<div class="ci-gate-card"><div class="ico">' + I.lock + '</div><h3>You do not have access</h3><p>This page is open only to System Managers and users given access by them.</p><p class="s">Signed in as <b>' + esc((S.acc && (S.acc.full_name || S.acc.user)) || "") + "</b></p></div>";
      return;
    }
    $$(".ci-sec [data-sec]").forEach(function (b) { b.hidden = S.secs.indexOf(b.getAttribute("data-sec")) < 0; });
    root.classList.toggle("is-single", S.secs.length === 1); d.body.classList.toggle("ci-is-single", S.secs.length === 1);
    $("#ci-gate").hidden = true; $("#ci-app").hidden = false;
    $("#ci-gear").hidden = !S.acc.is_admin;
    mergeNav();
    setSection(store("sec") || S.secs[0]);
  }
  boot();
})();
