.pir-pcard .t em { font-style: normal; font-size: 11px; font-weight: 600; color: var(--mc); background: color-mix(in srgb, var(--mc) 12%, #fff); padding: 1px 8px; border-radius: 99px; white-space: nowrap; }
.pir-pcard .v { font-size: 22px; font-weight: 800; letter-spacing: -.4px; margin-top: 8px; color: var(--ink); }
