.pir-pt5 th.tint, .pir-pt5 td.tint { background: var(--mt); }
.pir-pt5 td.amt { font-weight: 600; }
.pir-pt5 td.c-item { min-width: 170px; }
.pir-pt5 tbody tr:hover td.tint { filter: brightness(.97); }
.pir-pt5 tbody tr td:first-child { box-shadow: inset 3px 0 0 var(--pri); }
.pir-pt5 tr.tot td { font-weight: 800; border-top: 2px solid var(--pri-b); border-bottom: 0; background: var(--pri-l); cursor: default; }
.pir-pt5 tr.tot td.tint { background: color-mix(in srgb, var(--mt) 60%, var(--pri-l)); }
.pir-pt5 tr.tot td:first-child { box-shadow: none; }
@media (max-width: 1280px) and (min-width: 761px) {
  .pir-pt5 { font-size: 12px; }
  .pir-pt5 td, .pir-pt5 th button { padding-left: 5px; padding-right: 5px; }
  .pir-pt5 td.c-item { min-width: 120px; }
}

/* purchase slider */
.pir-pfl { display: flex; flex-wrap: wrap; gap: 10px; padding: 12px 22px; background: #fff; border-bottom: 1px solid var(--line); }
.pir-pfl label { display: flex; flex-direction: column; gap: 4px; flex: 1 1 160px; min-width: 0; }
.pir-pfl label span { font-size: 11.5px; font-weight: 600; color: var(--ink2); }
.pir-pfl select, .pir-pfl input { height: 34px; border: 1px solid var(--line2); border-radius: 8px; padding: 0 10px; font: inherit; font-size: 13px; background: var(--soft); outline: none; color: var(--ink); width: 100%; }
.pir-pfl select:focus, .pir-pfl input:focus { border-color: var(--pri); background: #fff; box-shadow: 0 0 0 3px rgba(22,156,138,.12); }
.pir-dr-f { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 22px; border-top: 1px solid var(--line); background: #fff; font-size: 13px; }
.pir-dr-f:empty { display: none; }
.pir-dr-f span { color: var(--ink2); }
.pir-dr-f b { font-size: 15px; color: var(--pri-d); }
.pir-pt small.u { display: inline; font-size: 10.5px; }

/* purchase mobile */
@media (max-width: 1100px) and (min-width: 761px) {
  .pir-pcards { grid-template-columns: repeat(3, minmax(0,1fr)); }
  .pir-charts { grid-template-columns: 1fr; }
}
@media (max-width: 760px) {
  .pir-pcards { grid-template-columns: 1fr 1fr; gap: 8px; }
  .pir-pcards .pir-pcard:first-child { grid-column: 1 / -1; }
  .pir-pcard { padding: 11px 12px; }
  .pir-pcard .v { font-size: 18px; }
  .pir-charts { grid-template-columns: 1fr; }
  .pir-chart { padding: 12px; }
  .pir-pmc .t strong { font-size: 14px; font-weight: 800; color: var(--pri-d); white-space: nowrap; }
  .pir-pmc .pm { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 4px; margin-top: 8px; }
  .pir-pmc .pm span { background: var(--soft); border-radius: 8px; padding: 5px 4px; text-align: center; border-top: 2px solid var(--mc); min-width: 0; }
  .pir-pmc .pm em { display: block; font-style: normal; font-size: 10px; color: var(--mut); }
  .pir-pmc .pm b { display: block; font-size: 11.5px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pir-pmc .pm small { display: block; font-size: 9.5px; color: var(--mut); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pir-pmc-tot { display: flex; justify-content: space-between; padding: 10px 12px; border-radius: 12px; background: var(--pri-l); border: 1px solid var(--pri-b); font-size: 13px; }
  .pir-pmc-tot b { color: var(--pri-d); }
  .pir-pfl { padding: 10px 12px; }
  .pir-pfl label { flex: 1 1 140px; }
  .pir-dr-f { padding: 10px 12px; }
}
@media print {
  .pir-sec, .pir-secbar, .pir-pband .pir-filters { display: none !important; }
  .pir-pcard, .pir-pt5 th, .pir-pt5 td, .pir-chart svg rect { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .pir-charts { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 760px) {
  .pir-pband .pir-ptab span { display: none; }
  .pir-pcard .t { flex-direction: column; align-items: flex-start; gap: 4px; }
  .pir-chart svg .ax { font-size: 12px; }
  .pir-chart svg .lb { font-size: 13px; }
  .pir-chart svg .vl { font-size: 13px; }
}
