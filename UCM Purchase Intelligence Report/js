        '<div class="pir-dr-act">' + (isDana ? "" : '<a class="pir-ibtn is-dark" href="/app/item/' + encodeURIComponent(r.item_code) + '" target="_blank" rel="noopener" title="Open Item">' + I.doc + "</a>") +
