      : [["item_code", "Item Code"], ["description", "Description"], ["item_group", "Item Group"], ["category", "Category"], ["current_balance", "Current Stock"], ["reorder_level", "Reorder Level"], ["reorder_qty", "Reorder Qty"], ["total_consumption", "Consumption"], ["avg_daily", "Avg Daily"], ["days_left", "Days Left"], ["last_consumption", "Last Used"], ["below_since", "Below Since"], ["mr_name", "Material Request"], ["po_raised", "PO Raised"], ["status", "Status"]];
