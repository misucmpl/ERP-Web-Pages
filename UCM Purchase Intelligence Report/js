    dr.classList.add("on"); dr.setAttribute("aria-hidden", "false"); $("#pir-scrim").classList.add("on");
    lock(true);
    $("#pir-dr-x").addEventListener("click", closeItem);
    $("#pir-ps-csv").addEventListener("click", purchaseSliderCSV);
    $("#pir-ps-m").addEventListener("change", function () { PS.month = this.value; renderPurchaseSlider(); });
    [["#pir-ps-q", "q"], ["#pir-ps-d", "desc"], ["#pir-ps-s", "sup"]].forEach(function (p) {
      $(p[0]).addEventListener("input", function () { PS[p[1]] = this.value.trim().toLowerCase(); renderPurchaseSlider(); });
    });
    renderPurchaseSlider();
  }
  function psVisible() {
    return PS.rows.filter(function (r) {
      return (!PS.month || String(r.month_bucket) === PS.month) &&
        (!PS.q || (r.item_code || "").toLowerCase().indexOf(PS.q) >= 0) &&
        (!PS.desc || ((r.description || "") + " " + (r.item_name || "")).toLowerCase().indexOf(PS.desc) >= 0) &&
        (!PS.sup || (r.supplier || "").toLowerCase().indexOf(PS.sup) >= 0);
    });
  }
  function renderPurchaseSlider() {
    var rows = psVisible(), it = {}, order = [], tq = 0, ta = 0;
    rows.forEach(function (r) {
      var k = r.item_code || "\u2013";
      if (!it[k]) { it[k] = { q: 0, a: 0, n: r.description || r.item_name || "", u: r.uom || "", c: 0 }; order.push(k); }
      it[k].q += +r.qty || 0; it[k].a += +r.amount || 0; it[k].c++; tq += +r.qty || 0; ta += +r.amount || 0;
    });
    order.sort(function (a, b) { return it[b].a - it[a].a; });
    var lines = rows.length ? '<div class="pir-ptw"><table class="pir-pt"><thead><tr><th>Date</th><th>Month</th><th>Voucher</th><th>Supplier</th><th>Item</th><th class="n">Rate</th><th class="n">Qty</th><th class="n">Amount</th></tr></thead><tbody>' +
      rows.slice().reverse().map(function (r) {
        return "<tr><td>" + dmy(r.posting_date) + "</td><td>" + esc(r.month_label) + "</td><td>" + docLink("Purchase Receipt", r.voucher) + "</td><td>" + esc(r.supplier) + "</td><td>" + docLink("Item", r.item_code) + (r.description ? "<small>" + esc(r.description) + "</small>" : "") +
          '</td><td class="n">' + inr(r.rate) + '</td><td class="n">' + num(r.qty) + (r.uom ? " <small class=\"u\">" + esc(r.uom) + "</small>" : "") + '</td><td class="n"><b>' + inr(r.amount) + "</b></td></tr>";
      }).join("") + "</tbody></table></div>" : '<div class="pir-none">No receipts for this filter.</div>';
    var items = order.length ? '<div class="pir-ptw"><table class="pir-pt"><thead><tr><th>Item</th><th class="n">Receipts</th><th class="n">Qty</th><th class="n">Amount</th><th class="n">Avg Rate</th></tr></thead><tbody>' +
      order.map(function (k) { var x = it[k]; return "<tr><td>" + docLink("Item", k) + (x.n ? "<small>" + esc(x.n) + "</small>" : "") + '</td><td class="n">' + x.c + '</td><td class="n">' + num(x.q) + (x.u ? ' <small class="u">' + esc(x.u) + "</small>" : "") + '</td><td class="n"><b>' + inr(x.a) + '</b></td><td class="n">' + (x.q ? inr(x.a / x.q) : "\u2013") + "</td></tr>"; }).join("") +
      '<tr class="tot"><td>Category Total</td><td class="n">' + rows.length + '</td><td class="n">' + num(tq) + '</td><td class="n">' + inr(ta) + '</td><td class="n"></td></tr></tbody></table></div>' : "";
    $("#pir-ps-b").innerHTML = (items ? sec("Item-wise Total", items) : "") + sec("Purchase Receipt Lines <span class=\"pir-h-note\">" + rows.length + " line" + (rows.length === 1 ? "" : "s") + "</span>", lines);
    $("#pir-ps-f").innerHTML = "<span>" + (PS.month ? esc(P.data.months[+PS.month].label) : "All 5 months") + " \u00b7 " + rows.length + " line" + (rows.length === 1 ? "" : "s") + "</span><b>Qty " + num(tq) + " \u00b7 " + inr(ta) + "</b>";
  }
  function purchaseSliderCSV() {
    var rows = psVisible(); if (!rows.length) return;
    var C = [["posting_date", "Date"], ["month_label", "Month"], ["voucher", "Voucher"], ["supplier", "Supplier"], ["item_code", "Item"], ["description", "Description"], ["rate", "Rate"], ["qty", "Qty"], ["uom", "UOM"], ["amount", "Amount"]];
    var qq = function (v) { v = v == null ? "" : String(v); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; };
    var out = [C.map(function (c) { return qq(c[1]); }).join(",")];
    rows.forEach(function (r) { out.push(C.map(function (c) { return qq(r[c[0]]); }).join(",")); });
    saveCSV(out, "purchase-receipts-" + PS.cat.toLowerCase().replace(/[^a-z0-9]+/g, "-") + ".csv");
  }

  /* --- Stock / Purchase switch --- */
  function syncSub() {
    var sub;
    if (S.sec === "purchase") {
      var m = P.data && P.data.months;
      sub = "Purchase \u00b7 " + S.pg + (m ? " \u00b7 " + m[m.length - 1].label + " \u2013 " + m[0].label : "");
    } else sub = WAREHOUSE + " \u00b7 Consumption " + rangeLabel();
    $$(".pir-sub").forEach(function (p) { p.textContent = sub; });
  }
  function setSection(sec, first) {
    if (sec !== "stock" && sec !== "purchase") sec = "stock";
    var changed = S.sec !== sec; S.sec = sec; store("sec", sec);
    $$(".pir-sec [data-sec]").forEach(function (b) { var on = b.getAttribute("data-sec") === sec; b.classList.toggle("on", on); b.setAttribute("aria-selected", on ? "true" : "false"); });
    var st = sec === "stock";
    $("#pir-band").hidden = !st; $("#pir-main").hidden = !st;
    $("#pir-pband").hidden = st; $("#pir-pmain").hidden = st;
    root.classList.toggle("is-purchase", !st);
    syncSub();
    if (!changed && !first) return;
    if (st) { if (first || !S.loadedOnce) { S.loadedOnce = true; syncFilters(); load(); } }
    else { syncPurchaseBand(); if (!P.data || P.data.item_group !== S.pg) loadPurchase(); }
  }
  d.addEventListener("click", function (e) {
    var b = e.target.closest(".pir-sec [data-sec]"); if (!b) return;
    closeItem(); setSection(b.getAttribute("data-sec"));
  });

  /* ============ settings (System Manager) ============ */
  var SV = { users: [], cand: [], pick: null };
  function openSettings() {
    var m = $("#pir-set");
    $(".pir-modal", m).innerHTML =
      '<div class="pir-mh"><div><h3>Report access</h3><p>Only <b>View</b> access \u2014 this page cannot change any data. System Managers always have full access.</p></div>' +
        '<button type="button" class="pir-ibtn" id="pir-set-x" title="Close">' + I.x + "</button></div>" +
      '<div class="pir-mb"><div class="pir-msg" id="pir-set-msg"></div>' +
        '<div class="pir-add"><div class="pir-pick"><input type="text" id="pir-set-u" placeholder="Type user name or email\u2026" autocomplete="off"><div class="pir-pick-l" id="pir-set-l" hidden></div></div>' +
        '<button type="button" class="pir-btn" id="pir-set-go">Give view access</button></div>' +
        '<div class="pir-ulist" id="pir-set-list"><div class="pir-none">Loading\u2026</div></div></div>';
    m.hidden = false; lock(true);
    $("#pir-set-x").addEventListener("click", closeSettings);
    var inp = $("#pir-set-u"), lst = $("#pir-set-l");
    function pick() {
      var qs = inp.value.trim().toLowerCase(), have = {};
      SV.users.forEach(function (u) { have[u.user] = 1; });
      var list = SV.cand.filter(function (c) { return !have[c.user] && (!qs || (c.full_name + " " + c.user).toLowerCase().indexOf(qs) >= 0); }).slice(0, 8);
      lst.innerHTML = list.length ? list.map(function (c) { return '<button type="button" data-u="' + esc(c.user) + '"><b>' + esc(c.full_name) + "</b><small>" + esc(c.user) + "</small></button>"; }).join("") : '<div class="pir-none">No user found</div>';
      lst.hidden = false;
    }
    inp.addEventListener("focus", pick);
    inp.addEventListener("input", function () { SV.pick = null; pick(); });
    inp.addEventListener("blur", function () { setTimeout(function () { lst.hidden = true; }, 120); });
    lst.addEventListener("mousedown", function (e) {
      var b = e.target.closest("button[data-u]"); if (!b) return; e.preventDefault();
      var c = SV.cand.filter(function (x) { return x.user === b.getAttribute("data-u"); })[0];
      SV.pick = c ? c.user : null; inp.value = c ? c.full_name + " (" + c.user + ")" : ""; lst.hidden = true;
    });
    $("#pir-set-go").addEventListener("click", async function () {
      if (!SV.pick) { setMsg("Pick a user from the list first."); return; }
      this.disabled = true; var who = SV.pick;
      if (await settingsCall({ action: "set", user: who, level: "view" })) { SV.pick = null; inp.value = ""; setMsg("View access given to " + who + ".", true); }
      this.disabled = false;
    });
    $("#pir-set-list").addEventListener("click", async function (e) {
      var b = e.target.closest("button[data-rm]"); if (!b) return;
      if (!b.classList.contains("arm")) { b.classList.add("arm"); b.textContent = "Remove?"; setTimeout(function () { b.classList.remove("arm"); b.innerHTML = I.x; }, 3000); return; }
      b.disabled = true;
      if (await settingsCall({ action: "set", user: b.getAttribute("data-rm"), level: "none" })) setMsg("Access removed for " + b.getAttribute("data-rm") + ".", true);
    });
    settingsCall({ action: "list" });
  }
  function setMsg(t, ok) { var el = $("#pir-set-msg"); if (!el) return; el.className = "pir-msg" + (t ? " show" + (ok ? " ok" : "") : ""); el.textContent = t || ""; }
  async function settingsCall(body) {
    try {
      var m = await api(body, "POST"); if (!m) return false;
      SV.users = (m.users || []).filter(function (u) { return u.enabled !== 0 && u.enabled !== false; }); SV.cand = m.candidates || [];
      $("#pir-set-list").innerHTML = SV.users.length ? SV.users.map(function (u) {
        return '<div class="pir-urow' + (u.enabled ? "" : " off") + '"><span class="av">' + esc(initials(u.full_name || u.user)) + '</span><div class="nm"><b>' + esc(u.full_name) + "</b><small>" + esc(u.user) + (u.enabled ? "" : " \u00b7 disabled") + "</small></div>" +
          (u.level === "admin" ? '<span class="tag admin">System Manager</span><span class="rm"></span>' : '<span class="tag">View</span><button type="button" class="rm" data-rm="' + esc(u.user) + '" title="Remove access">' + I.x + "</button>") + "</div>";
      }).join("") : '<div class="pir-none">No users yet</div>';
      return true;
    } catch (e) { setMsg((body.action === "list" ? "Could not load users: " : "Not saved: ") + e.message); return false; }
  }
  function closeSettings() { var m = $("#pir-set"); if (m.hidden) return; m.hidden = true; lock(false); }
  $("#pir-gear").addEventListener("click", openSettings);
  $("#pir-set").addEventListener("mousedown", function (e) { if (e.target === this) closeSettings(); });

  /* ============ UCM standard header: title + buttons ERP navbar mein ============ */
  function mergeNav() {
    var nav = d.querySelector("nav.navbar"), brand = nav && nav.querySelector(".navbar-brand");
    if (!nav || !brand) return;
    var t = d.createElement("div"); t.className = "pir-nav-title";
    t.innerHTML = '<h1>Purchase Intelligence</h1><p class="pir-sub"></p>';
    brand.insertAdjacentElement("afterend", t);
    var sw = $("#pir-head .pir-sec"); if (sw) { sw.classList.add("in-nav"); t.insertAdjacentElement("afterend", sw); }
    var act = $("#pir-act"); act.classList.add("pir-nav-act");
    var login = nav.querySelector("#website-post-login");
    if (login && login.parentNode) {
      var li = d.createElement("li"); li.className = "nav-item pir-nav-li"; li.appendChild(act);
      login.parentNode.insertBefore(li, login);
    } else {
      (brand.parentElement || nav).appendChild(act);
      act.classList.add("is-end");
    }
    $("#pir-head").hidden = true;
    d.body.classList.add("pir-nav-merged");
    alignToLogo();
    w.addEventListener("resize", alignToLogo);
    w.addEventListener("load", alignToLogo);
  }
  /* page ka left margin = logo ka left margin */
  function alignToLogo() {
    var brand = d.querySelector("nav.navbar .navbar-brand"); if (!brand) return;
    var img = brand.querySelector("img, svg") || brand;
    var left = Math.round(img.getBoundingClientRect().left - root.getBoundingClientRect().left);
    if (left >= 8 && left <= 120) root.style.setProperty("--pir-pad", left + "px");
    /* table heading navbar ke neeche chipke (navbar sticky ho to) */
    var nav = d.querySelector("nav.navbar"), pos = nav ? getComputedStyle(nav).position : "";
    var stick = nav && (pos === "sticky" || pos === "fixed") ? Math.round(nav.getBoundingClientRect().height) : 0;
    if (!stick && nav && nav.parentElement && /sticky|fixed/.test(getComputedStyle(nav.parentElement).position)) stick = Math.round(nav.parentElement.getBoundingClientRect().height);
    root.style.setProperty("--pir-nav-h", stick + "px");
  }

  /* ============ start ============ */
  async function boot() {
    if (!cookie("user_id") || cookie("user_id") === "Guest") { location.href = "/login?redirect-to=" + encodeURIComponent(location.pathname); return; }
    try { S.acc = await api({ action: "me" }); }
    catch (e) {
      $("#pir-gate").innerHTML = '<div class="pir-gate-card"><div class="ico warn">!</div><h3>Could not check access</h3><p>' + esc(e.message) + '</p><p class="s">Check that the <b>ucm_pir</b> Server Script is saved and enabled.</p></div>';
      return;
    }
    if (!S.acc || !S.acc.can_view) {
      $("#pir-gate").innerHTML = '<div class="pir-gate-card"><div class="ico">' + I.lock + '</div><h3>You do not have access</h3><p>This report is open only to System Managers and users given access by them.</p><p class="s">Signed in as <b>' + esc((S.acc && (S.acc.full_name || S.acc.user)) || "") + "</b></p></div>";
      return;
    }
    if (S.acc.warehouse) WAREHOUSE = S.acc.warehouse;
    $("#pir-gate").hidden = true; $("#pir-app").hidden = false;
    $("#pir-gear").hidden = !S.acc.is_admin;
    mergeNav();
    setSection(S.sec, true);
  }
  boot();
})();
