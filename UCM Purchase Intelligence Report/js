  function mergeDana(list) {
    var tx = [], po = [], used = {};
    list.forEach(function (p) {
      tx = tx.concat(p.transactions || []); po = po.concat(p.purchase_orders || []);
      (p.used_in_products || []).forEach(function (u) {
        var k = u.product_code;
        if (!used[k]) used[k] = { product_code: u.product_code, product_name: u.product_name, total_qty_consumed: 0, work_orders: [] };
        used[k].total_qty_consumed += (+u.total_qty_consumed || 0);
        used[k].work_orders = used[k].work_orders.concat(u.work_orders || []);
      });
    });
    tx.sort(function (a, b) { var x = (a.posting_date || "") + " " + (a.posting_time || ""), y = (b.posting_date || "") + " " + (b.posting_time || ""); return x < y ? 1 : x > y ? -1 : 0; });
    po.sort(function (a, b) { return a.po_date < b.po_date ? 1 : a.po_date > b.po_date ? -1 : 0; });
    var u = Object.keys(used).map(function (k) { return used[k]; }).sort(function (a, b) { return b.total_qty_consumed - a.total_qty_consumed; });
    return { transactions: tx, purchase_orders: po.slice(0, 5), used_in_products: u };
  }
  function danaBreak(tx) {
    var b = { inward: 0, sold: 0, mfg: 0, issue: 0 };
    tx.forEach(function (t) {
      var q = parseFloat(t.actual_qty) || 0;
      if (q > 0) { b.inward += q; return; }
      if (!q) return;
      var a = Math.abs(q), vt = t.voucher_type || "", st = t.stock_entry_type || "";
