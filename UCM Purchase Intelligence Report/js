  /* Used In Products: sirf chuni hui period (days) ke Work Orders */
  function usedInPeriod(list, f) {
    return (list || []).map(function (p) {
      var all = p.work_orders || [];
      var wo = all.filter(function (x) { var dd = String(x.date || "").split(" ")[0]; return !/^\d{4}-\d{2}-\d{2}$/.test(dd) || dd >= f; });
      var tot = wo.length === all.length ? (+p.total_qty_consumed || 0) : wo.reduce(function (s, x) { return s + (+x.qty || 0); }, 0);
      return { product_code: p.product_code, product_name: p.product_name, total_qty_consumed: tot, work_orders: wo };
    }).filter(function (p) { return p.work_orders.length; })
