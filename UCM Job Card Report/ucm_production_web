elif pw_action == "ul_delete":
    # Ultra entry (page se bani) ki poori chain Cancel - ulte order mein:
    # final QC transfer -> Quality transfer -> Quality Inspection -> Manufacture -> Material Transfer for Manufacture
    # (final transfer cancel par app WO ka rework khud wapas karta hai). Documents delete nahi hote, sirf Cancel.
    if not pw_can_delete:
        frappe.throw("You do not have Delete & Close access.")
    ud_name = (frappe.form_dict.get("stock_entry") or "").strip()
    if not ud_name or not frappe.db.exists("Stock Entry", ud_name):
        frappe.throw("Stock Entry not found.")
    ud_m = frappe.get_doc("Stock Entry", ud_name)
    ud_rm = ud_m.get("remarks") or ""
    if ud_m.stock_entry_type != "Manufacture" or "Ultra production entry (web page)" not in ud_rm:
        frappe.throw(ud_name + " was not created from this page, so it cannot be cancelled here. Cancel it in ERPNext.")
    ud_qmts = frappe.get_all("Stock Entry", filters={"custom_reference_stock_entry": ud_name, "docstatus": ["<", 2]}, pluck="name", limit_page_length=0)
    ud_qis = []
    if ud_qmts:
        ud_qis = frappe.get_all("Quality Inspection", filters={"reference_type": "Stock Entry", "reference_name": ["in", ud_qmts], "docstatus": ["<", 2]},
                                pluck="name", limit_page_length=0)
    ud_fins = []
    if ud_qis:
        ud_fins = frappe.get_all("Stock Entry", filters={"custom_quality_inspection": ["in", ud_qis], "docstatus": ["<", 2]}, pluck="name", limit_page_length=0)
    ud_mtm = ""
    if ". MTM: " in ud_rm:
        ud_mtm = ud_rm.split(". MTM: ")[1].strip().split(" ")[0]
    ud_chain = []
    # rejection repack (WH Rejected se maal leta hai) - sabse pehle cancel
    for n in frappe.get_all("Stock Entry", filters={"stock_entry_type": "Repack", "docstatus": ["<", 2],
                                                    "remarks": ["like", "Ultra rejection repack (web page) - " + ud_name + " %"]},
                            pluck="name", limit_page_length=0):
        ud_chain.append(["Stock Entry", n])
    if ud_fins:
        for n in frappe.get_all("Stock Entry", filters={"stock_entry_type": "Repack", "docstatus": ["<", 2], "custom_reference_stock_entry": ["in", ud_fins]},
                                pluck="name", limit_page_length=0):
            if ["Stock Entry", n] not in ud_chain:
                ud_chain.append(["Stock Entry", n])
    for n in ud_fins:
        ud_chain.append(["Stock Entry", n])
    for n in ud_qmts:
        ud_chain.append(["Stock Entry", n])
    for n in ud_qis:
        ud_chain.append(["Quality Inspection", n])
    ud_chain.append(["Stock Entry", ud_name])
    if ud_mtm and frappe.db.exists("Stock Entry", ud_mtm):
        ud_chain.append(["Stock Entry", ud_mtm])
    ud_done = []
    for pr in ud_chain:
        d = frappe.get_doc(pr[0], pr[1])
        if d.docstatus == 1:
            try:
                d.cancel()
            except Exception as e:
                frappe.throw("Could not cancel " + pr[1] + ": " + str(e) + " (nothing was cancelled)")
            ud_done.append(pr[1])
        elif d.docstatus == 0:
            frappe.delete_doc(pr[0], pr[1])
            ud_done.append(pr[1])
    frappe.response["message"] = {"cancelled": ud_done}

elif pw_action == "ul_submit":
    # ═════ Ultra: ek machine ki poori entry, ERPNext jaisa hi (6 steps) ═════
    # 1. Material Transfer for Manufacture (WH1 -> WH3) - WO ki bachi qty tak (total aur bachi mein jo kam ho)
    #    pehle RM stock check: kam ho to "Raw material short"
    # 2. Manufacture - FG = total pcs; RM consume = step 1 mein jitna transfer hua
    #    15% (Manufacturing Settings) se zyada over-production ho to rok do: "Overproduction % badhao"
    # 3. Transfer to Quality (dt_ultracraft_customization ka apna method) -> 4. Quality Inspection (OK / Hold / Rej)
    # 5. Material Transfer submit -> 6. final transfer (app banata hai) submit -> app WO ka rework khud update karta hai
    # Koi bhi step fail ho to kuch nahi banta (poori request rollback).
    if not pw_can_entry:
        frappe.throw("You do not have Production Entry access. Ask a System Manager to give it from the access settings.")
    us_date = str(frappe.utils.getdate(frappe.form_dict.get("date") or frappe.utils.nowdate()))
    if us_date > frappe.utils.nowdate():
        frappe.throw("Production date cannot be in the future.")
    us_shift = (frappe.form_dict.get("shift") or "").strip().upper()
    if us_shift not in ["A", "B"]:
        frappe.throw("Select Shift A or B.")
    us_plant = frappe.form_dict.get("plant") or ""
    if us_plant not in ["New Plant", "Old Plant"]:
        frappe.throw("Select New Plant or Old Plant.")
    us_rows = frappe.form_dict.get("rows") or []
    if isinstance(us_rows, str):
        us_rows = frappe.parse_json(us_rows)
    if not us_rows:
        frappe.throw("Nothing to submit.")
    if len(us_rows) > 1:
        frappe.throw("Submit one machine at a time.")
    us_lbl = {}
    us_opts = {}
    for df in frappe.get_meta("Stock Entry").fields:
        lk = (df.label or "").strip().lower()
        if lk and lk not in us_lbl:
            us_lbl[lk] = df.fieldname
            us_opts[lk] = df.options or ""
    us_fld = {}
    for pr in UL_FIELDS:
        fn = us_lbl.get(pr[1]) or ""
        if not fn:
            for lk in us_lbl:
                if lk.startswith(pr[1].split(" (")[0]):
                    fn = us_lbl[lk]
                    break
        if not fn:
            fn = pr[2]
        us_fld[pr[0]] = fn
    us_meta = {}
    for df in frappe.get_meta("Stock Entry").fields:
        us_meta[df.fieldname] = {"fieldtype": df.fieldtype, "options": df.options or "", "label": df.label or ""}
    us_shift_val = "SHIFT " + us_shift
    if us_opts.get("shift") and us_shift_val not in us_opts.get("shift") and us_shift in us_opts.get("shift").split("\n"):
        us_shift_val = us_shift
    # Elec / Wage rate Workstation se (page se nahi aata)
    us_fetch = {}
    for df in frappe.get_meta("Stock Entry").fields:
        us_fetch[df.fieldname] = df.fetch_from or ""
    us_rsrc = {}
    for k in [["elec_rate", "hour_rate_electricity"], ["wage_rate", "hour_rate_labour"]]:
        ff = us_fetch.get(us_fld.get(k[0]) or "") or ""
        us_rsrc[k[0]] = ff.split(".")[1] if "." in ff else k[1]
    us_out = []
    for row in us_rows:
        mc = (row.get("machine") or "").strip()
        wo = (row.get("work_order") or "").strip()
        qty = frappe.utils.flt(row.get("qty"))
        eh = frappe.utils.flt(row.get("elec_hrs"))
        mh = frappe.utils.flt(row.get("man_hrs"))
        mp = frappe.utils.flt(row.get("manpower"))
        us_wsd = {}
        try:
            us_wsd = frappe.db.get_value("Workstation", mc, [us_rsrc["elec_rate"], us_rsrc["wage_rate"]], as_dict=True) or {}
        except Exception:
            us_wsd = {}
        er = frappe.utils.flt(us_wsd.get(us_rsrc["elec_rate"])) or 125
        wr = frappe.utils.flt(us_wsd.get(us_rsrc["wage_rate"])) or 60
        if not mc or not frappe.db.exists("Workstation", mc):
            frappe.throw("Machine not found: " + mc)
        if us_plant.lower() not in mc.lower() or "eco blow" in mc.lower():
            frappe.throw(mc + " is not a " + us_plant + " machine.")
        if not wo or not frappe.db.exists("Work Order", wo):
            frappe.throw(mc + ": select a running work order from the list.")
        wo_i = frappe.db.get_value("Work Order", wo, ["docstatus", "status", "production_item"], as_dict=True)
        if frappe.utils.cint(wo_i.docstatus) != 1 or wo_i.status not in ["Not Started", "In Process"]:
            frappe.throw(mc + ": work order " + wo + " is " + (wo_i.status or "not submitted") + ". Pick a running one.")
        if qty <= 0:
            frappe.throw(mc + ": enter the quantity.")
        us_ok = frappe.utils.flt(row.get("ok"))
        us_hold = frappe.utils.flt(row.get("hold"))
        us_rej = frappe.utils.flt(row.get("rej"))
        if us_ok < 0 or us_hold < 0 or us_rej < 0:
            frappe.throw(mc + ": Approved / Hold / Rejected cannot be negative.")
        if us_rej > 0 and frappe.utils.flt(row.get("pcs_weight")) <= 0:
            frappe.throw(mc + ": enter Pcs Weight (gm) - it is needed to put the rejected pcs back as MIX (Kg).")
        if abs(us_ok + us_hold + us_rej - qty) > 0.001:
            frappe.throw(mc + ": Approved + Hold + Rejected (" + str(us_ok + us_hold + us_rej) + ") must equal total qty (" + str(qty) + ").")
        # 15% over-production check (cumulative)
        us_wo = frappe.db.get_value("Work Order", wo, ["qty", "produced_qty", "material_transferred_for_manufacturing", "skip_transfer"], as_dict=True)
        us_pct = frappe.utils.flt(frappe.db.get_single_value("Manufacturing Settings", "overproduction_percentage_for_work_order"))
        us_woq = frappe.utils.flt(us_wo.qty)
        us_after = frappe.utils.flt(us_wo.produced_qty) + qty
        if us_woq > 0 and us_after > us_woq * (1 + us_pct / 100.0) + 0.001:
            us_need = frappe.utils.ceil((us_after / us_woq - 1) * 100)
            frappe.throw("Overproduction: Work Order " + wo + " qty is " + frappe.utils.fmt_money(us_woq, precision=0) +
                         ", total made will be " + frappe.utils.fmt_money(us_after, precision=0) + " (" + str(us_need) + "% extra). Allowed is only " +
                         str(frappe.utils.cint(us_pct)) + "%. Increase Overproduction Percentage for Work Order in Manufacturing Settings to at least " +
                         str(us_need) + "%, then submit again.")
        us_dup = frappe.db.sql("""
            SELECT se.name FROM `tabStock Entry` se
            WHERE se.docstatus = 1 AND se.stock_entry_type = 'Manufacture' AND se.posting_date = %(d)s
              AND se.custom_workstation = %(m)s AND se.work_order = %(w)s
              AND UPPER(REPLACE(IFNULL(se.custom_shift, ''), 'SHIFT', '')) LIKE %(s)s
            LIMIT 1
        """, {"d": us_date, "m": mc, "w": wo, "s": "%" + us_shift + "%"}, as_dict=True)
        if us_dup:
            frappe.throw(mc + " already has an entry for " + wo + " on " + us_date + " Shift " + us_shift + ": " + us_dup[0].name)
        e_cost = round(eh * er, 2)
        m_cost = round(mp * mh * wr, 2)
        us_mk = "erpnext.manufacturing.doctype.work_order.work_order.make_stock_entry"
        # ── Step 1: Material Transfer for Manufacture (WO ki bachi qty tak) ──
        us_mtm = None
        us_mtm_map = {}
        us_mtm_qty = min(qty, us_woq - frappe.utils.flt(us_wo.material_transferred_for_manufacturing))
        if not frappe.utils.cint(us_wo.skip_transfer) and us_mtm_qty > 0:
            try:
                us_mtm = frappe.get_doc(frappe.call(us_mk, work_order_id=wo, purpose="Material Transfer for Manufacture", qty=us_mtm_qty))
            except Exception as e:
                frappe.throw(mc + " (" + wo + ") material transfer: " + str(e))
            us_short = []
            for it in us_mtm.items:
                if not it.s_warehouse:
                    continue
                have = frappe.utils.flt(frappe.db.get_value("Bin", {"item_code": it.item_code, "warehouse": it.s_warehouse}, "actual_qty"))
                if have + 0.0001 < frappe.utils.flt(it.qty):
                    us_short.append(it.item_code + ": need " + str(round(frappe.utils.flt(it.qty), 3)) + " " + (it.uom or "") +
                                    ", " + it.s_warehouse + " has " + str(round(have, 3)))
            if us_short:
                frappe.throw("Raw material short for " + str(frappe.utils.cint(us_mtm_qty)) + " pcs (" + wo + "): " + "; ".join(us_short))
            us_mtm.set_posting_time = 1
            us_mtm.posting_date = us_date
            us_mtm.posting_time = frappe.utils.nowtime()
            us_mtm.remarks = "Ultra production entry (web page) - material transfer for " + mc + ", " + us_date + " Shift " + us_shift + ". By " + pw_user
            try:
                us_mtm.insert()
                us_mtm.submit()
            except Exception as e:
                frappe.throw(mc + " (" + wo + ") material transfer: " + str(e))
            for it in us_mtm.items:
                us_mtm_map[it.item_code] = frappe.utils.flt(us_mtm_map.get(it.item_code)) + frappe.utils.flt(it.qty)
        # ── Step 2: Manufacture (FG = total; RM = jitna step 1 mein gaya) ──
        try:
            us_se = frappe.get_doc(frappe.call(us_mk, work_order_id=wo, purpose="Manufacture", qty=qty))
        except Exception as e:
            frappe.throw(mc + " (" + wo + "): " + str(e))
        if us_mtm_map:
            for it in us_se.items:
                if it.s_warehouse and not it.is_finished_item and not it.get("is_scrap_item") and it.item_code in us_mtm_map:
                    it.qty = us_mtm_map[it.item_code]
                    it.transfer_qty = frappe.utils.flt(it.qty) * (frappe.utils.flt(it.conversion_factor) or 1)
        us_se.set_posting_time = 1
        us_se.posting_date = us_date
        us_se.posting_time = frappe.utils.nowtime()
        us_se.remarks = ("Ultra production entry (web page) - " + mc + ", " + us_date + " Shift " + us_shift + ". By " + pw_user +
                         (". MTM: " + us_mtm.name if us_mtm else ""))
        us_vals = {"manpower": mp, "elec_hrs": eh, "man_hrs": mh, "elec_rate": er, "wage_rate": wr,
                   "cycle_time": frappe.utils.flt(row.get("cycle_time")), "cavity": frappe.utils.flt(row.get("cavity")),
                   "pcs_weight": frappe.utils.flt(row.get("pcs_weight")),
                   "reason": (row.get("reason") or "").strip(), "mold": (row.get("mold") or "").strip()}
        # Select / Int field (jaise CT, Cavity = "1".."50"): decimal nahi, option mein hona chahiye
        for k in us_vals:
            fn = us_fld.get(k)
            if not fn:
                continue
            v = us_vals[k]
            fm = us_meta.get(fn) or {}
            if fm.get("fieldtype") == "Select" and k not in ["reason", "mold"]:
                fv = frappe.utils.flt(v)
                v = "" if not fv else (str(frappe.utils.cint(fv)) if fv == frappe.utils.cint(fv) else str(fv))
                fo = (fm.get("options") or "").split("\n")
                if v and v not in fo:
                    frappe.throw(mc + ": " + (fm.get("label") or k) + " cannot be " + v + ". Allowed: " + ", ".join([o for o in fo if o][:3]) + " ... " + ([o for o in fo if o] or [""])[-1])
            elif fm.get("fieldtype") == "Int":
                v = frappe.utils.cint(v)
            us_se.set(fn, v)
        for pr in [["workstation", mc], ["shift", us_shift_val],
                   ["total cost of electricity", e_cost], ["total cost of manpower", m_cost],
                   ["total cost", e_cost + m_cost], ["total working hours per manpower", mp * mh]]:
            fn = us_lbl.get(pr[0])
            if fn:
                us_se.set(fn, pr[1])
        if not us_lbl.get("workstation"):
            us_se.set("custom_workstation", mc)
        if not us_lbl.get("shift"):
            us_se.set("custom_shift", us_shift_val)
        # Additional Costs: is machine ki pichhli Ultra entry jaisi lines
        us_prev = frappe.db.sql("""
            SELECT se.name FROM `tabStock Entry` se
            WHERE se.docstatus = 1 AND se.stock_entry_type = 'Manufacture' AND se.custom_workstation = %(m)s
              AND IFNULL(se.work_order, '') != ''
            ORDER BY se.posting_date DESC, se.posting_time DESC LIMIT 1
        """, {"m": mc}, as_dict=True)
        if us_prev:
            for ac in frappe.db.sql("""
                SELECT expense_account, description FROM `tabLanded Cost Taxes and Charges`
                WHERE parent = %(p)s AND parenttype = 'Stock Entry' ORDER BY idx
            """, {"p": us_prev[0].name}, as_dict=True):
                ds = (ac.description or "").lower()
                if "elec" in ds:
                    amt = e_cost
                elif "man" in ds or "wage" in ds or "labour" in ds:
                    amt = m_cost
                else:
                    continue
                us_se.append("additional_costs", {"expense_account": ac.expense_account, "description": ac.description, "amount": amt})
        try:
            us_se.insert()
            us_se.submit()
        except Exception as e:
            frappe.throw(mc + " (" + wo + "): " + str(e))
        fg_qty = 0
        us_batch = ""
        us_has_sbf = frappe.get_meta("Stock Entry Detail").has_field("use_serial_batch_fields")
        for it in us_se.items:
            if it.is_finished_item:
                fg_qty = fg_qty + frappe.utils.flt(it.qty)
                if not us_batch:
                    us_batch = it.get("batch_no") or ""
                    if not us_batch and it.get("serial_and_batch_bundle"):
                        us_batch = frappe.db.get_value("Serial and Batch Entry", {"parent": it.serial_and_batch_bundle}, "batch_no") or ""
        # ── Step 3: Transfer to Quality (app ka apna method, jaise form ka button) ──
        try:
            us_tq = frappe.call("dt_ultracraft_customization.public.py.stock_entry.transfer_to_quality", source_name=us_se.name)
        except Exception as e:
            frappe.throw(mc + " (" + wo + ") transfer to quality: " + str(e))
        if not us_tq:
            frappe.throw(mc + ": Transfer to Quality returned nothing for " + us_se.name)
        if isinstance(us_tq, str):
            us_qmt = frappe.get_doc("Stock Entry", us_tq)
        elif isinstance(us_tq, dict):
            us_qmt = frappe.get_doc(us_tq)
        else:
            us_qmt = us_tq
        if us_qmt.docstatus == 0:
            us_qmt.set_posting_time = 1
            us_qmt.posting_date = us_date
            us_qmt.posting_time = frappe.utils.nowtime()
            # Manufacture ka hi batch aage le jao (warna ERPNext WH3 ka purana batch utha leta hai)
            if us_batch:
                for it in us_qmt.items:
                    if it.item_code == wo_i.production_item:
                        if us_has_sbf:
                            it.use_serial_batch_fields = 1
                            it.serial_and_batch_bundle = None
                        it.batch_no = us_batch
            if us_qmt.get("__islocal") or not us_qmt.name or not frappe.db.exists("Stock Entry", us_qmt.name):
                us_qmt.insert()
            else:
                us_qmt.save()
        us_qrow = None
        for it in us_qmt.items:
            if it.item_code == wo_i.production_item and it.t_warehouse:
                us_qrow = it
                break
        if not us_qrow:
            frappe.throw(mc + ": Transfer to Quality entry " + us_qmt.name + " has no row for " + wo_i.production_item)
        # ── Step 4: Quality Inspection (OK / Hold / Rejected) ──
        us_qi = frappe.get_doc({"doctype": "Quality Inspection", "inspection_type": "Incoming", "reference_type": "Stock Entry",
                                "reference_name": us_qmt.name, "item_code": us_qrow.item_code, "sample_size": 0,
                                "inspected_by": pw_user, "report_date": us_date, "status": "Accepted", "manual_inspection": 1,
                                "child_row_reference": us_qrow.name})
        for pr in [["custom_total_inspection_qty", qty], ["custom_pass_qty", us_ok], ["custom_hold_qty", us_hold], ["custom_rejected_qty", us_rej]]:
            us_qi.set(pr[0], pr[1])
        try:
            us_qi.insert()
            us_qi.submit()
        except Exception as e:
            frappe.throw(mc + " quality inspection: " + str(e))
        # ── Step 5: Quality transfer submit ──
        if us_qmt.docstatus == 0:
            frappe.db.set_value("Stock Entry Detail", us_qrow.name, "quality_inspection", us_qi.name)
            us_qmt.reload()
            if us_batch:
                for it in us_qmt.items:
                    if it.item_code == wo_i.production_item and (it.get("batch_no") or "") != us_batch:
                        if us_has_sbf:
                            it.use_serial_batch_fields = 1
                            it.serial_and_batch_bundle = None
                        it.batch_no = us_batch
            try:
                us_qmt.submit()
            except Exception as e:
                frappe.throw(mc + " transfer to quality " + us_qmt.name + ": " + str(e))
        # ── Step 6: final transfer (WH2 / Hold / Rejected) - app banata hai; draft ho to submit ──
        us_fin = frappe.get_all("Stock Entry", filters={"custom_quality_inspection": us_qi.name, "docstatus": ["<", 2]},
                                fields=["name", "docstatus"], limit_page_length=5)
        if not us_fin:
            frappe.throw(mc + ": the final QC transfer was not created after " + us_qi.name + ". Nothing was saved. Do this entry in ERPNext and tell the developer.")
        us_fin_name = us_fin[0].name
        if frappe.utils.cint(us_fin[0].docstatus) == 0:
            us_fd = frappe.get_doc("Stock Entry", us_fin_name)
            if us_batch:
                for it in us_fd.items:
                    if it.item_code == wo_i.production_item:
                        if us_has_sbf:
                            it.use_serial_batch_fields = 1
                            it.serial_and_batch_bundle = None
                        it.batch_no = us_batch
            us_fd.set_posting_time = 1
            us_fd.posting_date = us_date
            us_fd.posting_time = frappe.utils.nowtime()
            try:
                us_fd.save()
                us_fd.submit()
            except Exception as e:
                frappe.throw(mc + " final QC transfer " + us_fin_name + ": " + str(e))
        # ── Step 7: Rejection Repack - Rejected pcs (WH Rejected) -> MIX Kg (WH1), jaise STE/UCM/26-27/48582 ──
        us_rp_name = ""
        if us_rej > 0:
            us_pw = frappe.utils.flt(row.get("pcs_weight"))
            us_kg = round(us_rej * us_pw / 1000.0, 3)
            us_mix = ""
            for ri in frappe.get_all("Work Order Item", filters={"parent": wo}, fields=["item_code"], limit_page_length=0):
                if (ri.item_code or "").upper().startswith("MIX-"):
                    us_mix = ri.item_code
                    break
            if not us_mix and frappe.db.exists("Item", "MIX-" + wo_i.production_item):
                us_mix = "MIX-" + wo_i.production_item
            if not us_mix:
                frappe.throw(mc + ": no MIX item found for " + wo_i.production_item + " (rejection repack). Nothing was saved.")
            us_rjwh = "WH Rejected - UCM"
            us_mixwh = "WH1 - UCM"
            us_rp = frappe.get_doc({"doctype": "Stock Entry", "stock_entry_type": "Repack", "purpose": "Repack", "company": us_se.company,
                                    "set_posting_time": 1, "posting_date": us_date, "posting_time": frappe.utils.nowtime(),
                                    "remarks": "Ultra rejection repack (web page) - " + us_se.name + " / final transfer " + us_fin_name + ": " + str(frappe.utils.cint(us_rej)) +
                                               " pcs x " + str(us_pw) + " gm = " + str(us_kg) + " Kg. By " + pw_user})
            us_rrow = {"s_warehouse": us_rjwh, "item_code": wo_i.production_item, "qty": us_rej}
            if us_batch:
                if us_has_sbf:
                    us_rrow["use_serial_batch_fields"] = 1
                us_rrow["batch_no"] = us_batch
            us_rp.append("items", us_rrow)
            us_rp.append("items", {"t_warehouse": us_mixwh, "item_code": us_mix, "qty": us_kg, "is_finished_item": 1})
            # final transfer se link (Reference Stock Entry)
            if us_meta.get("custom_reference_stock_entry"):
                us_rp.custom_reference_stock_entry = us_fin_name
            for pr in [["workstation", mc], ["shift", us_shift_val]]:
                fn = us_lbl.get(pr[0])
                if fn:
                    us_rp.set(fn, pr[1])
            try:
                us_rp.insert()
                us_rp.submit()
            except Exception as e:
                frappe.throw(mc + " rejection repack (" + str(frappe.utils.cint(us_rej)) + " pcs -> " + str(us_kg) + " Kg " + us_mix + "): " + str(e))
            us_rp_name = us_rp.name
        us_out.append({"machine": mc, "stock_entry": us_se.name, "work_order": wo, "qty": fg_qty or qty, "repack": us_rp_name,
                       "mtm": us_mtm.name if us_mtm else "", "quality_transfer": us_qmt.name, "quality_inspection": us_qi.name,
                       "final_transfer": us_fin_name, "batch": us_batch, "ok": us_ok, "hold": us_hold, "rej": us_rej})
    frappe.response["message"] = {"date": us_date, "shift": us_shift, "plant": us_plant, "entries": us_out}

# ───────────────────── 3. JOB CARD PERFORMANCE ─────────────────────
elif pw_action == "performance":
    if not pw_access["perf"]:
        frappe.throw("You do not have access to the Performance report.")
    today_d = frappe.utils.getdate(frappe.utils.nowdate())
    pf = {
        "from_date": frappe.form_dict.get("from_date") or str(frappe.utils.get_first_day(today_d)),
        "to_date": frappe.form_dict.get("to_date") or str(frappe.utils.get_last_day(today_d)),
        "status_filter": frappe.form_dict.get("status_filter") or "Completed",
        "item_code": frappe.form_dict.get("item_code") or None,
    }
    if pf["status_filter"] not in ["All", "Completed", "In Process"]:
        pf["status_filter"] = "Completed"
    PERF_SQL = """
SELECT
    wo.name AS work_order,
    wo.status AS work_order_status,
    wo.production_plan,
    pp.status,
    pp.custom_ucm_job_card_no AS job_card_no,

    (
        SELECT MIN(se.posting_date)
        FROM `tabStock Entry` se
        INNER JOIN `tabWork Order` wo2
            ON wo2.name = se.work_order
        WHERE wo2.production_plan = wo.production_plan
          AND se.stock_entry_type = 'Manufacture'
          AND se.docstatus = 1
    ) AS start_date,

    (
        SELECT MAX(se.posting_date)
        FROM `tabStock Entry` se
        INNER JOIN `tabWork Order` wo2
            ON wo2.name = se.work_order
        WHERE wo2.production_plan = wo.production_plan
          AND se.stock_entry_type = 'Manufacture'
          AND se.docstatus = 1
    ) AS end_date,

    DATE_FORMAT(
        (
            SELECT MIN(se.posting_date)
            FROM `tabStock Entry` se
            INNER JOIN `tabWork Order` wo2
                ON wo2.name = se.work_order
            WHERE wo2.production_plan = wo.production_plan
              AND se.stock_entry_type = 'Manufacture'
              AND se.docstatus = 1
        ),
        '%%M %%Y'
    ) AS month,

    wo.production_item AS item_code,
    wo.item_name,
    item.item_group,

    COALESCE((
        SELECT SUM(mri.qty)
        FROM `tabProduction Plan Item` ppi
        INNER JOIN `tabMaterial Request Item` mri
            ON mri.parent = ppi.material_request
            AND mri.item_code = ppi.item_code
        WHERE ppi.parent = wo.production_plan
          AND ppi.item_code = wo.production_item
    ), 0) AS qty_to_manufacture,

    COALESCE((
        SELECT SUM(qi.custom_pass_qty)
        FROM `tabStock Entry` se_manufacture
        INNER JOIN `tabStock Entry` se_quality
            ON se_quality.custom_reference_stock_entry = se_manufacture.name
            AND se_quality.docstatus = 1
        INNER JOIN `tabQuality Inspection` qi
            ON qi.reference_name = se_quality.name
            AND qi.reference_type = 'Stock Entry'
            AND qi.docstatus = 1
        WHERE se_manufacture.work_order = wo.name
          AND se_manufacture.stock_entry_type = 'Manufacture'
          AND se_manufacture.docstatus = 1
    ), 0) AS approved_qty_total,

    item.weight_per_unit AS pc_weight,
    item.custom_cycle_time AS std_cycle_time,
    item.custom_cavity AS std_cavity,

    ROUND(
        (
            COALESCE((
                SELECT SUM(mri.qty)
                FROM `tabProduction Plan Item` ppi
                INNER JOIN `tabMaterial Request Item` mri
                    ON mri.parent = ppi.material_request
                    AND mri.item_code = ppi.item_code
                WHERE ppi.parent = wo.production_plan
                  AND ppi.item_code = wo.production_item
            ), 0)
            / NULLIF(item.custom_cavity, 0)
        ) * COALESCE(item.custom_cycle_time, 0) / 3600.0
    , 4) AS std_lead_time,

    ROUND(
        COALESCE((
            SELECT SUM(se.custom_electricity_working_hours)
            FROM `tabStock Entry` se
            WHERE se.work_order = wo.name
              AND se.stock_entry_type = 'Manufacture'
              AND se.docstatus = 1
        ), 0)
    , 4) AS actual_lead_time,

    DATEDIFF(
        (
            SELECT MAX(se.posting_date)
            FROM `tabStock Entry` se
            INNER JOIN `tabWork Order` wo2
                ON wo2.name = se.work_order
            WHERE wo2.production_plan = wo.production_plan
              AND se.stock_entry_type = 'Manufacture'
              AND se.docstatus = 1
        ),
        (
            SELECT MIN(se.posting_date)
            FROM `tabStock Entry` se
            INNER JOIN `tabWork Order` wo2
                ON wo2.name = se.work_order
            WHERE wo2.production_plan = wo.production_plan
              AND se.stock_entry_type = 'Manufacture'
              AND se.docstatus = 1
        )
    ) + 1 AS lead_time_days,

    ROUND(
        COALESCE((
            SELECT SUM(se.custom_total_cost)
            FROM `tabStock Entry` se
            WHERE se.work_order = wo.name
              AND se.stock_entry_type = 'Manufacture'
              AND se.docstatus = 1
        ), 0)
        /
        NULLIF(COALESCE((
            SELECT SUM(se.custom_electricity_working_hours)
            FROM `tabStock Entry` se
            WHERE se.work_order = wo.name
              AND se.stock_entry_type = 'Manufacture'
              AND se.docstatus = 1
        ), 0), 0)
        *
        ROUND(
            (
                COALESCE((
                    SELECT SUM(mri.qty)
                    FROM `tabProduction Plan Item` ppi
                    INNER JOIN `tabMaterial Request Item` mri
                        ON mri.parent = ppi.material_request
                        AND mri.item_code = ppi.item_code
                    WHERE ppi.parent = wo.production_plan
                      AND ppi.item_code = wo.production_item
                ), 0)
                / NULLIF(item.custom_cavity, 0)
            ) * COALESCE(item.custom_cycle_time, 0) / 3600.0
        , 4)
    , 4) AS std_production_cost,

    ROUND(
        COALESCE((
            SELECT SUM(se.custom_total_cost)
            FROM `tabStock Entry` se
            WHERE se.work_order = wo.name
              AND se.stock_entry_type = 'Manufacture'
              AND se.docstatus = 1
        ), 0)
    , 4) AS production_cost,

    ROUND(
        COALESCE((
            SELECT SUM(se.custom_total_cost)
            FROM `tabStock Entry` se
            WHERE se.work_order = wo.name
              AND se.stock_entry_type = 'Manufacture'
              AND se.docstatus = 1
        ), 0)
        -
        (
            COALESCE((
                SELECT SUM(se.custom_total_cost)
                FROM `tabStock Entry` se
                WHERE se.work_order = wo.name
                  AND se.stock_entry_type = 'Manufacture'
                  AND se.docstatus = 1
            ), 0)
            /
            NULLIF(COALESCE((
                SELECT SUM(se.custom_electricity_working_hours)
                FROM `tabStock Entry` se
                WHERE se.work_order = wo.name
                  AND se.stock_entry_type = 'Manufacture'
                  AND se.docstatus = 1
            ), 0), 0)
            *
            ROUND(
                (
                    COALESCE((
                        SELECT SUM(mri.qty)
                        FROM `tabProduction Plan Item` ppi
                        INNER JOIN `tabMaterial Request Item` mri
                            ON mri.parent = ppi.material_request
                            AND mri.item_code = ppi.item_code
                        WHERE ppi.parent = wo.production_plan
                          AND ppi.item_code = wo.production_item
                    ), 0)
                    / NULLIF(item.custom_cavity, 0)
                ) * COALESCE(item.custom_cycle_time, 0) / 3600.0
            , 4)
        )
    , 4) AS extra_production_cost,

    ROUND(
        (
            ROUND(
                (
                    COALESCE((
                        SELECT SUM(mri.qty)
                        FROM `tabProduction Plan Item` ppi
                        INNER JOIN `tabMaterial Request Item` mri
                            ON mri.parent = ppi.material_request
                            AND mri.item_code = ppi.item_code
                        WHERE ppi.parent = wo.production_plan
                          AND ppi.item_code = wo.production_item
                    ), 0)
                    / NULLIF(item.custom_cavity, 0)
                ) * COALESCE(item.custom_cycle_time, 0) / 3600.0
            , 4)
            /
            NULLIF(
                COALESCE((
                    SELECT SUM(se.custom_electricity_working_hours)
                    FROM `tabStock Entry` se
                    WHERE se.work_order = wo.name
                      AND se.stock_entry_type = 'Manufacture'
                      AND se.docstatus = 1
                ), 0),
                0
            )
        ) * 100
    , 2) AS efficiency,

    wo.production_plan AS prod_plan_link

FROM `tabWork Order` wo
INNER JOIN `tabItem` item
    ON item.name = wo.production_item
INNER JOIN `tabProduction Plan` pp
    ON pp.name = wo.production_plan

WHERE
    wo.docstatus < 2
    AND item.item_group IN ('ultra')
    AND wo.production_plan > 'MFG-PP-2026-00611'
    AND NOT (wo.docstatus = 0 AND pp.status = 'Closed')
    AND wo.production_plan IN (
        SELECT production_plan
        FROM `tabWork Order`
        WHERE production_plan IS NOT NULL
          AND production_plan != ''
        GROUP BY production_plan
        HAVING COUNT(*) >= 2
           AND SUM(CASE WHEN docstatus = 2 THEN 1 ELSE 0 END) = 0
    )
    AND (
        (
            %(item_code)s IS NOT NULL AND %(item_code)s != ''
            AND wo.production_item = %(item_code)s
        )
        OR
        (
            (%(item_code)s IS NULL OR %(item_code)s = '')
            AND (
                SELECT MIN(se.posting_date)
                FROM `tabStock Entry` se
                INNER JOIN `tabWork Order` wo2
                    ON wo2.name = se.work_order
                WHERE wo2.production_plan = wo.production_plan
                  AND se.stock_entry_type = 'Manufacture'
                  AND se.docstatus = 1
            ) BETWEEN %(from_date)s AND %(to_date)s
        )
    )
    AND (
        %(status_filter)s = 'All'
        OR (
            %(status_filter)s = 'Completed'
            AND wo.production_plan IN (
                SELECT name
                FROM `tabProduction Plan`
                WHERE status IN ('Completed', 'Closed')
            )
        )
        OR (
            %(status_filter)s = 'In Process'
            AND wo.production_plan IN (
                SELECT name
                FROM `tabProduction Plan`
                WHERE status = 'In Process'
            )
        )
    )

ORDER BY
    wo.production_plan DESC,
    item.item_group ASC,
    wo.name ASC
"""
    PERF_TOTAL_SQL = """
SELECT DISTINCT wo.production_plan AS production_plan
FROM `tabWork Order` wo
INNER JOIN `tabItem` item
    ON item.name = wo.production_item
INNER JOIN `tabProduction Plan` pp
    ON pp.name = wo.production_plan

WHERE
    wo.docstatus < 2
    AND item.item_group IN ('ultra')
    AND wo.production_plan > 'MFG-PP-2026-00611'
    AND NOT (wo.docstatus = 0 AND pp.status = 'Closed')
    AND wo.production_plan IN (
        SELECT production_plan
        FROM `tabWork Order`
        WHERE production_plan IS NOT NULL
          AND production_plan != ''
        GROUP BY production_plan
        HAVING COUNT(*) >= 2
           AND SUM(CASE WHEN docstatus = 2 THEN 1 ELSE 0 END) = 0
    )
    AND (
        (
            %(item_code)s IS NOT NULL AND %(item_code)s != ''
            AND wo.production_item = %(item_code)s
        )
        OR
        (
            (%(item_code)s IS NULL OR %(item_code)s = '')
            AND (
                SELECT MIN(se.posting_date)
                FROM `tabStock Entry` se
                INNER JOIN `tabWork Order` wo2
                    ON wo2.name = se.work_order
                WHERE wo2.production_plan = wo.production_plan
                  AND se.stock_entry_type = 'Manufacture'
                  AND se.docstatus = 1
            ) BETWEEN %(from_date)s AND %(to_date)s
        )
    )
"""
    pr_rows = frappe.db.sql(PERF_SQL, pf, as_dict=True)
    pr_out = []
    plans_all = {}
    plans_done = {}
    eff_sum = 0
    eff_n = 0
    tot_cost = 0
    tot_extra = 0
    for r in pr_rows:
        eff = r.get("efficiency")
        qtm = frappe.utils.flt(r.get("qty_to_manufacture"))
        apq = frappe.utils.flt(r.get("approved_qty_total"))
        pps = r.get("status") or ""
        comp = ""
        comp_pct = None
        if pps in ["Completed", "Closed"]:
            if qtm:
                comp_pct = int(apq / qtm * 100)
                comp = "COMPLETED" if apq >= qtm * 0.9 else "PARTIALLY COMPLETED"
                if apq < qtm * 0.9:
                    scv = frappe.utils.flt(r.get("std_cavity"))
                    sct = frappe.utils.flt(r.get("std_cycle_time"))
                    alt = frappe.utils.flt(r.get("actual_lead_time"))
                    if scv > 0 and sct > 0 and alt > 0:
                        nslt = (apq / scv) * sct / 3600.0
                        if nslt > 0:
                            eff = round((nslt / alt) * 100, 2)
        plan = r.get("production_plan")
        if plan:
            plans_all[plan] = 1
            if pps in ["Completed", "Closed"]:
                plans_done[plan] = 1
        tot_cost = tot_cost + frappe.utils.flt(r.get("production_cost"))
        tot_extra = tot_extra + frappe.utils.flt(r.get("extra_production_cost"))
        if eff is not None:
            eff_sum = eff_sum + frappe.utils.flt(eff)
            eff_n = eff_n + 1
        pr_out.append({
            "work_order": r.get("work_order"), "wo_status": r.get("work_order_status") or "",
            "production_plan": plan, "pp_status": pps, "job_card_no": r.get("job_card_no") or "",
            "start_date": str(r.get("start_date")) if r.get("start_date") else None,
            "end_date": str(r.get("end_date")) if r.get("end_date") else None,
            "month": r.get("month") or "", "lead_time_days": r.get("lead_time_days"),
            "item_code": r.get("item_code"), "item_name": r.get("item_name") or r.get("item_code"),
            "qty_to_manufacture": qtm, "approved_qty": apq,
            "pc_weight": frappe.utils.flt(r.get("pc_weight")),
            "std_cycle_time": frappe.utils.flt(r.get("std_cycle_time")), "std_cavity": frappe.utils.flt(r.get("std_cavity")),
            "std_lead_time": frappe.utils.flt(r.get("std_lead_time")), "actual_lead_time": frappe.utils.flt(r.get("actual_lead_time")),
            "std_production_cost": frappe.utils.flt(r.get("std_production_cost")),
            "production_cost": frappe.utils.flt(r.get("production_cost")),
            "extra_production_cost": frappe.utils.flt(r.get("extra_production_cost")),
            "efficiency": frappe.utils.flt(eff) if eff is not None else None,
            "completion": comp, "completion_pct": comp_pct,
            "zero_std": 0 if (r.get("std_cavity") and r.get("std_cycle_time")) else 1,
        })
    summary = None
    if pw_show_summary:
        tp = {}
        for t in frappe.db.sql(PERF_TOTAL_SQL, pf, as_dict=True):
            if t.get("production_plan"):
                tp[t.get("production_plan")] = 1
        summary = {"total_job_card": len(tp), "completed_plans": len(plans_done),
                   "avg_efficiency": round(eff_sum / eff_n, 2) if eff_n else 0,
                   "production_cost": tot_cost, "extra_cost": tot_extra}
    frappe.response["message"] = {"rows": pr_out, "summary": summary, "from_date": str(pf["from_date"]),
                                  "to_date": str(pf["to_date"]), "status_filter": pf["status_filter"]}

# ───────────────────── 4. PRODUCTION PLANNING ─────────────────────
elif pw_action == "planning":
    if not pw_access["planning"]:
        frappe.throw("You do not have access to the Production Planning report.")
    pl_month = (frappe.form_dict.get("month") or "").strip()   # "2026-10" ya blank
    pl_item = (frappe.form_dict.get("item_code") or "").strip()
    PLAN_SQL = """
    SELECT
        pp.name AS pp_name,
        pp.custom_ucm_job_card_no AS job_card_no,
        pp.docstatus,
        wo.status AS wo_status,
        pp.posting_date,
        pp.custom_expted_completion_date AS expected_date,
        IFNULL(cust.customer_name, pp.custom_party_name) AS party_name,
        wo.production_item,
        it.item_name AS product_name,
        wo.name AS wo_name,

        (SELECT MIN(se.posting_date) FROM `tabStock Entry` se
         WHERE se.work_order = wo.name AND se.purpose = 'Manufacture' AND se.docstatus = 1) AS start_date,

        (SELECT MAX(se.posting_date) FROM `tabStock Entry` se
         WHERE se.work_order = wo.name AND se.purpose = 'Manufacture' AND se.docstatus = 1) AS end_date,

        (SELECT SUM(mri.qty) FROM `tabProduction Plan Item` ppi
         INNER JOIN `tabMaterial Request Item` mri ON mri.name = ppi.material_request_item
         WHERE ppi.parent = pp.name AND ppi.item_code = wo.production_item) AS planned_qty,

        -- Approved Qty:
        --   1) SUM(Quality Inspection.custom_pass_qty) for QC raised against
        --      a Stock Entry whose custom_reference_stock_entry points back
        --      to this Work Order's Manufacture entry, PLUS
        --   2) SUM(qty) from any 'M/C Pending Clear' / 'Hold Clear' Stock
        --      Entries for this Work Order (qty cleared but not yet QC'd).
        CAST(IFNULL((
            SELECT SUM(qi.custom_pass_qty)
            FROM `tabStock Entry` se_main
            INNER JOIN `tabStock Entry` se_qi
                ON se_qi.custom_reference_stock_entry = se_main.name
            INNER JOIN `tabQuality Inspection` qi
                ON qi.reference_name = se_qi.name
                AND qi.reference_type = 'Stock Entry'
                AND qi.docstatus = 1
                AND qi.item_code = wo.production_item
            WHERE se_main.work_order = wo.name
              AND se_main.docstatus = 1
              AND se_main.stock_entry_type = 'Manufacture'
        ), 0) AS UNSIGNED)
        +
        CAST(IFNULL((
            SELECT SUM(sed_clear.qty)
            FROM `tabStock Entry` se_clear
            INNER JOIN `tabStock Entry Detail` sed_clear
                ON sed_clear.parent = se_clear.name
            WHERE se_clear.work_order = wo.name
              AND se_clear.docstatus = 1
              AND se_clear.stock_entry_type IN ('M/C Pending Clear', 'Hold Clear')
              AND sed_clear.item_code = wo.production_item
        ), 0) AS UNSIGNED) AS approved_qty

    FROM `tabWork Order` wo
    INNER JOIN `tabProduction Plan` pp ON wo.production_plan = pp.name
    LEFT JOIN `tabItem` it ON it.name = wo.production_item
    LEFT JOIN `tabCustomer` cust ON cust.name = pp.custom_party_name

    WHERE wo.docstatus IN (0, 1) AND wo.production_item NOT LIKE 'MIX%%'
    AND (pp.custom_ucm_job_card_no IS NULL OR pp.custom_ucm_job_card_no != 'ASSEMBLY')
"""
    pl_vals = {}
    if len(pl_month) == 7 and pl_month[4] == "-":
        pl_vals["m"] = frappe.utils.cint(pl_month[5:7])
        pl_vals["y"] = frappe.utils.cint(pl_month[0:4])
        PLAN_SQL = PLAN_SQL + """ AND (
            (pp.custom_ucm_job_card_no IS NOT NULL AND pp.custom_ucm_job_card_no != ''
             AND CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(pp.custom_ucm_job_card_no, '/', 2), '/', -1) AS UNSIGNED) = %(m)s
             AND YEAR(pp.posting_date) = %(y)s)
            OR
            ((pp.custom_ucm_job_card_no IS NULL OR pp.custom_ucm_job_card_no = '')
             AND MONTH(pp.posting_date) = %(m)s AND YEAR(pp.posting_date) = %(y)s)
        )"""
    if pl_item:
        pl_vals["item"] = pl_item
        PLAN_SQL = PLAN_SQL + " AND wo.production_item = %(item)s"
    PLAN_SQL = PLAN_SQL + " ORDER BY pp.posting_date DESC, wo.name ASC"
    today_o = frappe.utils.getdate()
    pl_out = []
    for r in frappe.db.sql(PLAN_SQL, pl_vals, as_dict=True):
        st_raw = r.get("start_date")
        en_raw = r.get("end_date")
        ex_raw = r.get("expected_date")
        lead = 0
        if st_raw and en_raw:
            lead = (frappe.utils.getdate(en_raw) - frappe.utils.getdate(st_raw)).days + 1
        ws = r.get("wo_status") or ""
        exp_o = frappe.utils.getdate(ex_raw) if ex_raw else None
        end_o = frappe.utils.getdate(en_raw) if en_raw else None
        if ws == "Cancelled":
            stv = "CANCELLED"
        elif ws == "Stopped":
            stv = "HOLD"
        elif not st_raw:
            stv = "DELAYED" if (exp_o and exp_o < today_o) else "NOT STARTED"
        elif ws in ["Closed", "Completed"]:
            if not ex_raw:
                stv = "COMPLETED"
            elif exp_o and end_o and exp_o < end_o:
                stv = "DELAY"
            else:
                stv = "ON TIME"
        elif exp_o and exp_o < today_o:
            stv = "DELAYED"
        else:
            stv = "IN PROGRESS"
        jc = r.get("job_card_no") or "N/A"
        parts = jc.split("/")
        k1 = 999
        k2 = 999
        if len(parts) >= 3:
            if parts[1].isdigit():
                k1 = int(parts[1])
            if parts[2].isdigit():
                k2 = int(parts[2])
        pl_out.append({
            "pp_name": r.get("pp_name"), "job_card_no": jc, "wo_name": r.get("wo_name"),
            "wo_status": ws or "Draft", "posting_date": str(r.get("posting_date")) if r.get("posting_date") else None,
            "expected_date": str(ex_raw) if ex_raw else None, "party_name": r.get("party_name") or "",
            "item_code": r.get("production_item"), "product_name": r.get("product_name") or r.get("production_item"),
            "planned_qty": frappe.utils.flt(r.get("planned_qty")), "approved_qty": frappe.utils.flt(r.get("approved_qty")),
            "start_date": str(st_raw) if st_raw else None, "end_date": str(en_raw) if en_raw else None,
            "lead_time": lead, "status": stv, "sort_key": k1 * 100000 + k2,
        })
    pl_out = sorted(pl_out, key=lambda x: x["sort_key"])
    frappe.response["message"] = {"rows": pl_out, "month": pl_month, "item_code": pl_item}

# ───────────────────── 1b. CLOSE PRODUCTION PLAN ("Delete & Close" access) ─────────────────────
# Pehle plan ke saare submitted Work Orders (Completed / Closed / Cancelled chhod kar) Close,
# ERPNext ke apne close_work_order se. Sab band ho jaayein tab hi Production Plan Close.
elif pw_action == "close_plan":
    if not pw_can_close:
        frappe.throw("You do not have Delete & Close access. Ask a System Manager to give it from the access settings.")
    cp_name = (frappe.form_dict.get("plan") or "").strip()
    if not cp_name or not frappe.db.exists("Production Plan", cp_name):
        frappe.throw("Production Plan not found.")
    cp_info = frappe.db.get_value("Production Plan", cp_name, ["status", "docstatus"], as_dict=True) or {}
    if frappe.utils.cint(cp_info.get("docstatus")) != 1:
        frappe.throw("Only a submitted Production Plan can be closed.")
    cp_wos = frappe.get_all("Work Order",
                            filters={"production_plan": cp_name, "docstatus": 1,
                                     "status": ["not in", ["Completed", "Closed", "Cancelled"]]},
                            pluck="name", limit_page_length=0)
    cp_drafts = frappe.get_all("Work Order", filters={"production_plan": cp_name, "docstatus": 0},
                               pluck="name", limit_page_length=0)
    cp_closed = []
    cp_failed = []
    for wo in cp_wos:
        try:
            frappe.call("erpnext.manufacturing.doctype.work_order.work_order.close_work_order",
                        work_order=wo, status="Closed")
            cp_closed.append(wo)
        except Exception as e:
            cp_failed.append({"work_order": wo, "error": str(e)})
    cp_plan_closed = False
    if not cp_failed:
        if (cp_info.get("status") or "") == "Closed":
            cp_plan_closed = True
        else:
            try:
                cp_doc = frappe.get_doc("Production Plan", cp_name)
                cp_doc.set_status(close=True)
            except Exception:
                frappe.db.set_value("Production Plan", cp_name, "status", "Closed")
            cp_plan_closed = (frappe.db.get_value("Production Plan", cp_name, "status") == "Closed")
    frappe.response["message"] = {"plan": cp_name, "closed_work_orders": cp_closed, "failed": cp_failed,
                                  "draft_work_orders": cp_drafts, "plan_closed": cp_plan_closed}

# ───────────────────── 5. NON MOVING FG ITEM ─────────────────────
# SQL "UCM Non Moving FG Item" report se BILKUL same hai.
# Inward = (a) Material Transfer jisme Quality Inspection bhara ho + (b) Purchase Receipt, is warehouse mein.
# Sirf wo items jinka koi bhi out (DN / Manufacture / other) is period mein nahi hua.
elif pw_action == "nonmoving":
    if not pw_access["nonmoving"]:
        frappe.throw("You do not have access to the Non Moving report.")
    nm_today = frappe.utils.getdate(frappe.utils.nowdate())
    nm_f = {
        "from_date": frappe.form_dict.get("from_date") or str(frappe.utils.get_first_day(nm_today)),
        "to_date": frappe.form_dict.get("to_date") or str(frappe.utils.get_last_day(nm_today)),
        "warehouse": frappe.form_dict.get("warehouse") or "WH2 - UCM",
        "item_group": frappe.form_dict.get("item_group") or "Ultra",
    }
    nm_rows = frappe.db.sql("""
        SELECT
            inbound.item_code,
            i.item_name,
            i.item_group,
            inbound.inward_qty,
            IFNULL((
                SELECT SUM(ABS(sle.actual_qty))
                FROM `tabStock Ledger Entry` sle
                WHERE sle.item_code = inbound.item_code AND sle.warehouse = %(warehouse)s
                AND sle.voucher_type = 'Delivery Note' AND sle.actual_qty < 0
                AND sle.posting_date BETWEEN %(from_date)s AND %(to_date)s
            ), 0) AS dn_out_qty,
            IFNULL((
                SELECT SUM(ABS(sle.actual_qty))
                FROM `tabStock Ledger Entry` sle
                INNER JOIN `tabStock Entry` ste ON ste.name = sle.voucher_no
                WHERE sle.item_code = inbound.item_code AND sle.warehouse = %(warehouse)s
                AND sle.voucher_type = 'Stock Entry' AND ste.stock_entry_type = 'Manufacture'
                AND sle.actual_qty < 0 AND sle.posting_date BETWEEN %(from_date)s AND %(to_date)s
            ), 0) AS assembly_qty,
            IFNULL((
                SELECT SUM(ABS(sle.actual_qty))
                FROM `tabStock Ledger Entry` sle
                LEFT JOIN `tabStock Entry` ste ON ste.name = sle.voucher_no AND sle.voucher_type = 'Stock Entry'
                WHERE sle.item_code = inbound.item_code AND sle.warehouse = %(warehouse)s AND sle.actual_qty < 0
                AND sle.posting_date BETWEEN %(from_date)s AND %(to_date)s
                AND sle.voucher_type <> 'Delivery Note'
                AND (ste.stock_entry_type IS NULL OR ste.stock_entry_type <> 'Manufacture')
            ), 0) AS other_out_qty
        FROM (
            SELECT item_code, SUM(qty) AS inward_qty
            FROM (
                SELECT sed.item_code AS item_code, sed.qty AS qty
                FROM `tabStock Entry Detail` sed
                INNER JOIN `tabStock Entry` se ON se.name = sed.parent
                WHERE se.docstatus = 1
                AND sed.t_warehouse = %(warehouse)s
                AND se.stock_entry_type = 'Material Transfer'
                AND se.custom_quality_inspection IS NOT NULL
                AND se.custom_quality_inspection != ''
                AND se.posting_date BETWEEN %(from_date)s AND %(to_date)s

                UNION ALL

                SELECT pri.item_code AS item_code, pri.qty AS qty
                FROM `tabPurchase Receipt Item` pri
                INNER JOIN `tabPurchase Receipt` pr ON pr.name = pri.parent
                WHERE pr.docstatus = 1
                AND pri.warehouse = %(warehouse)s
                AND pr.posting_date BETWEEN %(from_date)s AND %(to_date)s
            ) combined_inward
            GROUP BY item_code
        ) inbound
        INNER JOIN `tabItem` i ON i.item_code = inbound.item_code
        WHERE i.item_group = %(item_group)s
        AND inbound.item_code NOT LIKE 'FG-BLO%%' AND inbound.item_code NOT LIKE 'FG-ECOBASE%%'
        AND i.item_name NOT LIKE '%%cover plat%%'
        GROUP BY inbound.item_code, i.item_name, i.item_group, inbound.inward_qty
        HAVING dn_out_qty = 0 AND assembly_qty = 0 AND other_out_qty = 0
        ORDER BY inbound.inward_qty DESC
    """, nm_f, as_dict=True)
    nm_out = []
    for r in nm_rows:
        inw = frappe.utils.flt(r.get("inward_qty"))
        dn = frappe.utils.flt(r.get("dn_out_qty"))
        asm = frappe.utils.flt(r.get("assembly_qty"))
        oth = frappe.utils.flt(r.get("other_out_qty"))
        nm_out.append({"item_code": r.get("item_code"), "item_name": r.get("item_name") or r.get("item_code"),
                       "item_group": r.get("item_group") or "", "inward_qty": inw, "dn_out_qty": dn,
                       "assembly_qty": asm, "other_out_qty": oth, "balance_qty": inw - dn - asm - oth})
    frappe.response["message"] = {"rows": nm_out, "from_date": str(nm_f["from_date"]), "to_date": str(nm_f["to_date"]),
                                  "warehouse": nm_f["warehouse"], "item_group": nm_f["item_group"]}

else:
    frappe.throw("Unknown action.")
