elif pw_action == "ul_form":
    # ═════ Ultra "Add Production Entry" form: New Plant / Old Plant ═════
    # Har machine: is date + shift ki entry ho to "Entered", na ho to pichhli shift ki entry (copy ke liye).
    # Field ke naam Stock Entry ke label se dhoondhe jaate hain (UL_FIELDS).
    if not pw_access["daily"]:
        frappe.throw("You do not have access to the Daily Production report.")
    uf_date = str(frappe.utils.getdate(frappe.form_dict.get("date") or frappe.utils.nowdate()))
    uf_shift = (frappe.form_dict.get("shift") or "A").strip().upper()
