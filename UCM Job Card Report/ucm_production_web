    uf_plant = frappe.form_dict.get("plant") or "New Plant"
    if uf_plant not in ["New Plant", "Old Plant"]:
        frappe.throw("Select New Plant or Old Plant.")
    uf_lbl = {}
    uf_fmeta = {}
    uf_fetch = {}
    for df in frappe.get_meta("Stock Entry").fields:
        lk = (df.label or "").strip().lower()
        if lk and lk not in uf_lbl:
            uf_lbl[lk] = df.fieldname
        uf_fmeta[df.fieldname] = {"fieldtype": df.fieldtype, "options": df.options or ""}
        uf_fetch[df.fieldname] = df.fetch_from or ""
    uf_fld = {}
    for pr in UL_FIELDS:
        fn = uf_lbl.get(pr[1]) or ""
        if not fn:
            for lk in uf_lbl:
                if lk.startswith(pr[1].split(" (")[0]):
                    fn = uf_lbl[lk]
                    break
        if not fn:
            fn = pr[2]
        uf_fld[pr[0]] = fn
    uf_rows = frappe.db.sql("""
        SELECT se.*, sed.item_code AS ul_item_code, sed.item_name AS ul_item_name, sed.qty AS ul_qty, sed.uom AS ul_uom,
               wo.status AS ul_wo_status, wo.docstatus AS ul_wo_docstatus, wo.production_plan AS ul_pp,
               IFNULL(pp.custom_ucm_job_card_no, '') AS ul_jc
        FROM `tabStock Entry` se
        INNER JOIN `tabStock Entry Detail` sed ON sed.parent = se.name AND sed.is_finished_item = 1
        INNER JOIN `tabWork Order` wo ON wo.name = se.work_order
        LEFT JOIN `tabProduction Plan` pp ON pp.name = wo.production_plan
        INNER JOIN `tabItem` item ON item.name = sed.item_code
        WHERE se.docstatus = 1 AND se.stock_entry_type = 'Manufacture'
          AND se.posting_date BETWEEN %(f)s AND %(t)s
          AND item.item_group IN ('ultra') AND sed.item_code NOT LIKE 'MIX%%'
          AND se.custom_workstation LIKE %(pl)s AND se.custom_workstation NOT LIKE '%%Eco Blow%%'
        ORDER BY se.posting_date, se.posting_time
    """, {"f": str(frappe.utils.add_days(uf_date, -60)), "t": uf_date, "pl": "%" + uf_plant + "%"}, as_dict=True)
    uf_list = []
    for r in uf_rows:
        sv = (r.get("custom_shift") or "").upper().replace("SHIFT", "").replace("-", "").strip()
        sl = sv if sv in ["A", "B"] else ""
        pd = str(r.get("posting_date") or "")
        ws_open = r.get("ul_wo_docstatus") == 1 and r.get("ul_wo_status") in ["Not Started", "In Process"]
        e = {"stock_entry": r.get("name"), "posting_date": pd, "shift_letter": sl,
             "sk": pd + ("1" if sl == "A" else ("2" if sl == "B" else "0")) + str(r.get("posting_time") or ""),
             "machine": r.get("custom_workstation") or "",
             "work_order": r.get("work_order") or "", "wo_status": r.get("ul_wo_status") or "", "wo_open": 1 if ws_open else 0,
             "production_plan": r.get("ul_pp") or "", "job_card_no": r.get("ul_jc") or "",
             "item_code": r.get("ul_item_code") or "", "item_name": r.get("ul_item_name") or r.get("ul_item_code") or "",
             "qty": frappe.utils.flt(r.get("ul_qty")), "uom": r.get("ul_uom") or "",
             "by_page": 1 if "Ultra production entry (web page)" in (r.get("remarks") or "") else 0, "has_qc": 0}
        for pr in UL_FIELDS:
            fn = uf_fld[pr[0]]
            v = r.get(fn) if fn else None
            if pr[0] in ["reason", "mold"]:
                e[pr[0]] = v or ""
            else:
                e[pr[0]] = frappe.utils.flt(v) if v is not None else None
        uf_list.append(e)
    uf_key = uf_date + ("1" if uf_shift == "A" else "2")
    uf_cur = {}
    uf_prev = {}
    for e in uf_list:
        mc = e["machine"]
        if not mc:
            continue
        if e["posting_date"] == uf_date and e["shift_letter"] == uf_shift:
            if mc not in uf_cur:
                uf_cur[mc] = []
            uf_cur[mc].append(e)
        elif e["sk"][:11] < uf_key:
            if mc not in uf_prev or e["sk"] > uf_prev[mc]["sk"]:
                uf_prev[mc] = e
    # Entered entry: QC (OK / Hold / Rejected) Quality Inspection se
    uf_cn = []
    for mc in uf_cur:
        for e in uf_cur[mc]:
            uf_cn.append(e["stock_entry"])
    if uf_cn:
        uf_qc = {}
        for q in frappe.get_all("Stock Entry", filters={"custom_reference_stock_entry": ["in", uf_cn], "docstatus": ["<", 2]},
                                fields=["custom_reference_stock_entry"], limit_page_length=0):
            uf_qc[q.get("custom_reference_stock_entry")] = 1
        for mc in uf_cur:
            for e in uf_cur[mc]:
                e["has_qc"] = 1 if uf_qc.get(e["stock_entry"]) else 0
        uf_qmap = {}
        for q in frappe.db.sql("""
            SELECT se.custom_reference_stock_entry AS mfg, qi.custom_pass_qty AS ok, qi.custom_hold_qty AS hold, qi.custom_rejected_qty AS rej
            FROM `tabStock Entry` se
            INNER JOIN `tabQuality Inspection` qi ON qi.reference_type = 'Stock Entry' AND qi.reference_name = se.name AND qi.docstatus = 1
            WHERE se.custom_reference_stock_entry IN %(n)s AND se.docstatus < 2
        """, {"n": uf_cn}, as_dict=True):
            uf_qmap[q.mfg] = q
        for mc in uf_cur:
            for e in uf_cur[mc]:
                q = uf_qmap.get(e["stock_entry"])
                if q:
                    e["qc"] = {"ok": frappe.utils.flt(q.ok), "hold": frappe.utils.flt(q.hold), "rej": frappe.utils.flt(q.rej)}
    # machines: "New Plant" / "Old Plant" naam wale Workstation, number ke order mein (Assembly nahi)
    uf_ws = []
    for wsn in frappe.get_all("Workstation", filters={"name": ["like", "%" + uf_plant + "%"]}, pluck="name", limit_page_length=0):
        if "assembly" in wsn.lower() or "eco blow" in wsn.lower():
            continue
        dg = ""
        for ch in wsn.split("-")[0]:
            if ch.isdigit():
                dg = dg + ch
        uf_ws.append([frappe.utils.cint(dg) if dg else 999, wsn])
    uf_ws = sorted(uf_ws)
    uf_machines = []
    for x in uf_ws:
        uf_machines.append(x[1])
    uf_out = []
    for mc in uf_machines:
        uf_out.append({"machine": mc, "current": uf_cur.get(mc) or [], "previous": uf_prev.get(mc)})
    for mc in uf_cur:
        if mc not in uf_machines:
            uf_out.append({"machine": mc, "current": uf_cur[mc], "previous": uf_prev.get(mc)})
    # Elec / Wage rate: Workstation (custom_workstation) se — Stock Entry field ka "Fetch From",
    # na mile to ERPNext Workstation ke hour_rate_electricity / hour_rate_labour
    uf_rsrc = {}
    for k in [["elec_rate", "hour_rate_electricity"], ["wage_rate", "hour_rate_labour"]]:
        ff = uf_fetch.get(uf_fld.get(k[0]) or "") or ""
        uf_rsrc[k[0]] = ff.split(".")[1] if "." in ff else k[1]
    for x in uf_out:
        wsd = {}
        try:
            wsd = frappe.db.get_value("Workstation", x["machine"], [uf_rsrc["elec_rate"], uf_rsrc["wage_rate"]], as_dict=True) or {}
        except Exception:
            wsd = {}
        x["rates"] = {"elec_rate": frappe.utils.flt(wsd.get(uf_rsrc["elec_rate"])) or 125,
                      "wage_rate": frappe.utils.flt(wsd.get(uf_rsrc["wage_rate"])) or 60}
    uf_meta_out = {}
    for pr in UL_FIELDS:
        uf_meta_out[pr[0]] = uf_fmeta.get(uf_fld.get(pr[0]) or "")
    frappe.response["message"] = {"date": uf_date, "shift": uf_shift, "plant": uf_plant, "machines": uf_out, "fields": uf_fld,
                                  "field_meta": uf_meta_out}

