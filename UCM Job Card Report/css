/* ============================================================
   UCMPL - Production (Job Card + Daily Production) - Web Page CSS
   Web Page -> Style -> CSS box mein poora paste karein.
   Theme: sky #E6F4FF (fills) + blue #1565A8 (text). Fill par text gehra #0B4A7D.
   ============================================================ */
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");

.navbar > .container, .navbar .container-fluid, header .navbar .container,
.web-footer .container, footer .container { max-width: none !important; width: 100% !important; padding-left: 24px !important; padding-right: 24px !important; box-sizing: border-box !important; }
.page-content-wrapper, .page_content, main .container { max-width: none !important; }

#ucm-prod, .pr-drawer, .pr-modal-bg, .pr-scrim {
  --bg: #f5f9fd; --card: #ffffff; --line: #dde9f4; --line2: #c9dbeb; --soft: #f8fbfe;
  --ink: #13212f; --ink2: #3b4d61; --mut: #6f8297; --mut2: #a5b4c4;
  --pri: #e6f4ff; --pri-d: #1565a8; --pri-dd: #cfe8fb; --pri-l: #f2f9ff; --pri-b: #b9dcf7; --on-pri: #0b4a7d;
  --blue: #2563eb; --violet: #7c3aed; --green: #16a34a; --red: #dc2626; --dark: #334155; --amber: #ca8a04;
  --red-l: #fef1f1; --green-l: #ebf9f0;
}
#ucm-prod {
  font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: var(--ink); background: var(--bg); font-size: 14px; line-height: 1.45;
  min-height: 100vh; width: 100vw; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);
  -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums;
}
#ucm-prod *, #ucm-prod *::before, #ucm-prod *::after, .pr-drawer *, .pr-modal-bg * { box-sizing: border-box; }
#ucm-prod [hidden], .pr-drawer [hidden], .pr-modal-bg[hidden], .pr-modal-bg [hidden] { display: none !important; }
#ucm-prod button, .pr-drawer button, .pr-modal-bg button { font: inherit; color: inherit; }
#ucm-prod a, .pr-drawer a { color: var(--pri-d); text-decoration: none; }
#ucm-prod a:hover, .pr-drawer a:hover { text-decoration: underline; }
.mut { color: var(--mut2) !important; }

/* gate */
.pr-gate { display: flex; justify-content: center; padding: 80px 16px; }
.pr-gate-card { width: 100%; max-width: 440px; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 34px 28px; text-align: center; box-shadow: 0 20px 44px -30px rgba(15,40,70,.45); }
.pr-gate-card .ico { width: 54px; height: 54px; margin: 0 auto 12px; border-radius: 14px; display: flex; align-items: center; justify-content: center; background: var(--pri-l); color: var(--pri-d); }
.pr-gate-card .ico.warn { background: var(--red-l); color: var(--red); font-size: 24px; font-weight: 800; }
.pr-gate-card h3 { margin: 0 0 6px; font-size: 18px; font-weight: 700; }
.pr-gate-card p { margin: 0 0 6px; color: var(--ink2); }
.pr-gate-card p.s { margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--line); font-size: 12.5px; color: var(--mut); }
.pr-spin { display: inline-block; width: 20px; height: 20px; border: 3px solid #d4ebfc; border-top-color: var(--pri); border-radius: 50%; animation: prSpin .8s linear infinite; vertical-align: middle; }
@keyframes prSpin { to { transform: rotate(360deg); } }

/* own header (sirf tab jab ERP navbar na mile) */
.pr-head { display: flex; align-items: center; gap: 14px; padding: 12px var(--pr-pad, 24px); background: #fff; border-bottom: 1px solid var(--line); }
.pr-title { flex: 1; min-width: 0; }
.pr-title h1 { margin: 0; font-size: 15px; font-weight: 700; color: #0f172a; }
.pr-title p { margin: 1px 0 0; font-size: 11px; color: #64748b; }
.pr-head-act { display: flex; gap: 8px; }
.pr-ibtn { width: 34px; height: 34px; flex: 0 0 34px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; cursor: pointer; padding: 0;
  border: 1px solid var(--line2); background: #fff; color: var(--ink2); transition: background .15s, color .15s, border-color .15s; }
.pr-ibtn:hover { background: var(--pri-l); color: var(--pri-d); border-color: var(--pri-b); }

/* section switch */
.pr-sec { display: inline-flex; gap: 2px; padding: 3px; border-radius: 10px; background: #f8fbfe; border: 1px solid #dde9f4; font-family: "Inter", system-ui, sans-serif; }
.pr-sec button { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 13px; border: 0; border-radius: 8px; background: none; cursor: pointer; font: inherit; font-size: 13px; font-weight: 600; color: #3b4d61; white-space: nowrap; }
.pr-sec button svg { width: 15px; height: 15px; opacity: .75; flex: 0 0 auto; }
.pr-sec button .s { display: none; }
.pr-sec button:hover { color: #1565a8; }
.pr-sec button.on { background: #e6f4ff; color: #0b4a7d; box-shadow: 0 2px 6px -2px rgba(21,101,168,.7); }
.pr-sec button.on svg { opacity: 1; }
.pr-sec.in-nav { margin-right: 16px; flex: 0 0 auto; }
.pr-secbar { display: none; }
.pr-sec [hidden] { display: none !important; }
#ucm-prod.is-single .pr-sec { display: none !important; }

/* band: filters */
.pr-band { background: #fff; border-bottom: 1px solid var(--line); padding: 10px var(--pr-pad, 24px); }
.pr-filters { display: flex; align-items: center; gap: 10px 22px; flex-wrap: wrap; }
.pr-f { display: flex; align-items: center; gap: 9px; min-width: 0; }
.pr-f > span { font-size: 11px; font-weight: 700; color: var(--mut); text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
.pr-pills { display: inline-flex; gap: 2px; padding: 3px; background: var(--soft); border: 1px solid var(--line); border-radius: 9px; }
.pr-pills button { height: 28px; padding: 0 12px; border: 0; border-radius: 7px; background: none; cursor: pointer; font-size: 12.5px; font-weight: 600; color: var(--ink2); white-space: nowrap; }
.pr-pills button:hover { color: var(--pri-d); }
.pr-pills button.on { background: var(--pri); color: var(--on-pri); font-weight: 700; }
.pr-days { display: flex; align-items: center; gap: 8px; }
.pr-dayin { display: inline-flex; align-items: center; height: 34px; border: 1px solid var(--line2); border-radius: 9px; padding: 0 10px 0 4px; background: #fff; }
.pr-dayin input { width: 52px; border: 0; outline: none; font: inherit; font-size: 13px; font-weight: 600; text-align: right; background: none; }
.pr-dayin i { font-style: normal; font-size: 12px; color: var(--mut); margin-left: 4px; }
.pr-f select, .pr-dates input { height: 34px; border: 1px solid var(--line2); border-radius: 9px; padding: 0 10px; font: inherit; font-size: 13px; background: #fff; color: var(--ink); outline: none; }
.pr-f select { min-width: 190px; max-width: 260px; }
.pr-f select:focus, .pr-dates input:focus, .pr-dayin:focus-within { border-color: var(--pri); box-shadow: 0 0 0 3px rgba(21,101,168,.15); }
.pr-dates { display: flex; align-items: center; gap: 6px; }
.pr-dates i { font-style: normal; font-size: 12px; color: var(--mut); }
.pr-nav { display: inline-flex; align-items: center; gap: 4px; }
.pr-nav b { min-width: 118px; text-align: center; font-size: 13.5px; font-weight: 700; color: var(--pri-d); }
.pr-nbtn { width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--line2); background: #fff; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; color: var(--ink2); padding: 0; }
.pr-nbtn:disabled { opacity: .35; cursor: default; background: #fff !important; color: var(--ink2) !important; border-color: var(--line2) !important; }
.pr-nbtn:hover { background: var(--pri-l); border-color: var(--pri-b); color: var(--pri-d); }
.pr-note { margin: 0 0 0 auto; font-size: 12px; color: var(--mut); }

/* main */
.pr-main { padding: 16px var(--pr-pad, 24px) 40px; transition: opacity .15s; }
.pr-main.is-loading { opacity: .55; pointer-events: none; }
.pr-empty { padding: 44px 16px; text-align: center; color: var(--mut); font-size: 13.5px; }
.pr-empty .pr-spin { margin-right: 10px; }
.pr-error { padding: 16px 18px; margin: 12px 0; border-radius: 12px; background: var(--red-l); color: var(--red); border: 1px solid #f8caca; font-size: 13.5px; }
.pr-none { padding: 14px; text-align: center; color: var(--mut); font-size: 12.5px; }

/* kpi cards */
.pr-kpis { display: grid; gap: 12px; margin-bottom: 16px; }
.pr-kpis.k5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
.pr-kpis.k6 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
.pr-kpi { --c: var(--pri-d); position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; text-align: left; padding: 13px 15px 12px; border-radius: 12px; border: 1px solid var(--line); background: #fff; overflow: hidden; min-width: 0; font: inherit; }
.pr-kpi::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--c); opacity: .85; }
.pr-kpi span { font-size: 11px; font-weight: 700; color: var(--mut); text-transform: uppercase; letter-spacing: .04em; }
.pr-kpi b { font-size: 22px; font-weight: 800; color: var(--c); line-height: 1.2; letter-spacing: -.01em; }
.pr-kpi small { font-size: 11.5px; color: var(--mut); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
.pr-kpi:disabled { cursor: default; opacity: 1; }
.pr-kpi.is-click { cursor: pointer; transition: border-color .15s, box-shadow .15s, transform .15s; }
.pr-kpi.is-click:hover { border-color: var(--pri-b); transform: translateY(-1px); box-shadow: 0 8px 18px -14px rgba(15,40,70,.5); }
.pr-kpi.on { border-color: var(--c); box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 22%, transparent); background: color-mix(in srgb, var(--c) 5%, #fff); }
.pr-kpi.is-pri { --c: var(--pri-d); } .pr-kpi.is-blue { --c: var(--blue); } .pr-kpi.is-violet { --c: var(--violet); }
.pr-kpi.is-green { --c: var(--green); } .pr-kpi.is-red { --c: var(--red); } .pr-kpi.is-dark { --c: var(--dark); }

/* register (card holding a table) */
.pr-reg { background: #fff; border: 1px solid var(--line); border-radius: 14px; margin-bottom: 16px; }
.pr-reg.pr-pad { padding: 14px 18px 16px; }
.pr-reg-h { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
.pr-reg-t { flex: 1; min-width: 200px; }
.pr-reg-t h2 { margin: 0; font-size: 15px; font-weight: 700; }
.pr-reg-t p { margin: 1px 0 0; font-size: 12px; color: var(--mut); }
.pr-reg-tools { display: flex; align-items: center; gap: 8px; }
.pr-search { display: inline-flex; align-items: center; gap: 7px; height: 34px; padding: 0 11px; border: 1px solid var(--line2); border-radius: 9px; background: #fff; color: var(--mut); width: 280px; max-width: 100%; }
.pr-search:focus-within { border-color: var(--pri); box-shadow: 0 0 0 3px rgba(21,101,168,.15); }
.pr-search input { border: 0; outline: none; font: inherit; font-size: 13px; width: 100%; background: none; color: var(--ink); }
.pr-legend { display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--mut); margin-right: 6px; }
.pr-legend i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; margin-left: 6px; }
.lg-n { background: var(--pri); } .lg-r { background: #93c5fd; }

/* tables: no inner scroll bar, page scroll only */
.pr-tw { width: 100%; }
.pr-t { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; }
.pr-t th { position: sticky; top: var(--pr-nav-h, 0px); z-index: 2; background: var(--soft); border-bottom: 1px solid var(--line); padding: 9px 12px; text-align: left; white-space: nowrap; font-size: 11px; font-weight: 700; color: var(--mut); text-transform: uppercase; letter-spacing: .04em; }
.pr-t td { padding: 9px 12px; border-bottom: 1px solid #eaf3fb; vertical-align: middle; }
.pr-t tbody tr:hover td { background: #f6fafe; }
.pr-t .n { text-align: right; white-space: nowrap; }
.pr-t .c { text-align: center; }
.pr-t .i { width: 40px; color: var(--mut2); }
.pr-t td.nm { font-weight: 600; }
.pr-t td.nm small { display: block; font-size: 11px; font-weight: 500; color: var(--mut); }
.pr-t tfoot td { background: var(--pri-l); font-weight: 800; border-top: 1px solid var(--pri-b); border-bottom: 0; padding: 10px 12px; }
.pr-t tfoot td:first-child { border-bottom-left-radius: 13px; }
.pr-t tfoot td:last-child { border-bottom-right-radius: 13px; }
.pr-t th button { display: inline-flex; align-items: center; gap: 5px; border: 0; background: none; padding: 0; cursor: pointer; font: inherit; color: inherit; text-transform: inherit; letter-spacing: inherit; }
.pr-t th button svg { opacity: .35; }
.pr-t th button.on { color: var(--pri-d); }
.pr-t th button.on svg { opacity: 1; }
.pr-t tr.fut td { opacity: .5; }
.pr-click { cursor: pointer; }
.pr-click:hover td { background: var(--pri-l) !important; }
.pr-num { min-width: 38px; height: 26px; padding: 0 9px; border-radius: 7px; border: 1px solid transparent; cursor: pointer; font-weight: 700; font-size: 13px; }
.pr-num.t-new { background: var(--pri-l); color: var(--pri-d); border-color: var(--pri-b); }
.pr-num.t-repeat { background: #eff6ff; color: var(--blue); border-color: #bfdbfe; }
.pr-num.t-sample { background: #f5f3ff; color: var(--violet); border-color: #ddd6fe; }
.pr-num:hover { filter: brightness(.95); box-shadow: 0 2px 6px -3px rgba(0,0,0,.3); }
td.mix { width: 220px; white-space: nowrap; }
.pr-mix { display: inline-flex; width: 120px; height: 8px; border-radius: 4px; overflow: hidden; background: #e6f0f9; vertical-align: middle; margin-right: 8px; }
.pr-mix i.n { background: var(--pri); } .pr-mix i.r { background: #93c5fd; }
td.mix em, td.sh em { font-style: normal; font-size: 11.5px; font-weight: 600; color: var(--mut); }
.pr-bar { display: inline-block; width: 90px; height: 6px; border-radius: 3px; background: #e6f0f9; overflow: hidden; vertical-align: middle; margin-right: 8px; }
.pr-bar i { display: block; height: 100%; background: var(--pri); border-radius: 3px; }
th.sh, td.sh { width: 160px; white-space: nowrap; }
.pr-lnk { border: 0; background: none; padding: 0; cursor: pointer; font-weight: 600; color: var(--ink) !important; text-align: left; }
.pr-lnk:hover { color: var(--pri-d) !important; text-decoration: underline; }

/* pills */
.pr-gst { display: inline-block; font-size: 10.5px; font-weight: 700; padding: 2px 8px; border-radius: 99px; white-space: nowrap; }
.pr-gst.ok { background: var(--green-l); color: var(--green); border: 1px solid #bce6cb; }
.pr-gst.no { background: var(--red-l); color: var(--red); border: 1px solid #f8caca; }
.pr-gst.big { font-size: 12px; padding: 4px 12px; }
.pr-dp { display: inline-block; min-width: 46px; font-size: 11.5px; font-weight: 700; padding: 2px 8px; border-radius: 99px; text-align: center; }
.pr-dp.lo { background: var(--pri-l); color: var(--pri-d); }
.pr-dp.md { background: #fef3c7; color: #a16207; }
.pr-dp.hi { background: var(--red-l); color: var(--red); }
.pr-ig { display: inline-block; font-size: 11.5px; font-weight: 600; padding: 2px 8px; border-radius: 6px; background: #eef5fb; color: var(--ink2); white-space: nowrap; max-width: 200px; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; }
.pr-ig.s-ultra { background: #eff6ff; color: var(--blue); }
.pr-ig.s-large_blow { background: #f5f3ff; color: var(--violet); }
.pr-mlist { display: none; }

/* territory */
.pr-till { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; font-size: 13px; color: var(--ink2); }
.pr-till b { color: var(--pri-d); }
.pr-badge { background: var(--pri); color: var(--on-pri); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; padding: 5px 14px; border-radius: 99px; }
.pr-subtabs { display: flex; gap: 22px; border-bottom: 1px solid var(--line2); margin: 2px 0 16px; }
.pr-subtabs button { border: 0; background: none; padding: 9px 2px; margin-bottom: -1px; cursor: pointer; font-size: 12.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--mut); border-bottom: 2px solid transparent; }
.pr-subtabs button.on { color: var(--pri-d); border-bottom-color: var(--pri); }
.pr-reaches { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 16px; }
.pr-reach { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 13px 16px; display: flex; flex-direction: column; gap: 4px; }
.pr-reach span { font-size: 11px; font-weight: 700; color: var(--mut); text-transform: uppercase; letter-spacing: .04em; }
.pr-reach b { font-size: 22px; font-weight: 800; color: var(--pri-d); }
.pr-reach b i { font-style: normal; font-size: 15px; color: var(--mut2); font-weight: 700; }
.pr-reach .pr-bar { width: 100%; height: 7px; margin: 4px 0 2px; }
.pr-reach small { font-size: 11.5px; color: var(--mut); font-weight: 600; }
.pr-legend2 { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12px; color: var(--ink2); }
.pr-legend2 i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; vertical-align: -1px; }
.pr-legend2 i.p { background: var(--green); } .pr-legend2 i.e { background: var(--amber); } .pr-legend2 i.n { background: var(--red); }
.pr-h5 { margin: 14px 0 8px; font-size: 11px; font-weight: 800; color: var(--ink2); text-transform: uppercase; letter-spacing: .05em; }
.pr-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.pr-chip { border-radius: 99px; padding: 4px 11px; font-size: 12px; font-weight: 600; border: 1px solid; }
.pr-chip.p { background: #e9f8ee; color: #15803d; border-color: #b9e4c7; }
.pr-chip.e { background: #fdf6dd; color: #a16207; border-color: #f2dc93; }
.pr-chip.n { background: #fdeeee; color: #b91c1c; border-color: #f5c1c1; }
.pr-warn { margin-top: 14px; padding: 9px 12px; background: var(--soft); border: 1px dashed var(--line2); border-radius: 8px; font-size: 12px; color: var(--ink2); }

/* drawer (slider) */
.pr-scrim { position: fixed; inset: 0; z-index: 1060; background: rgba(10,25,45,.38); opacity: 0; pointer-events: none; transition: opacity .2s; }
.pr-scrim.on { opacity: 1; pointer-events: auto; }
.pr-drawer { position: fixed; top: 0; right: 0; bottom: 0; z-index: 1061; width: min(720px, 96vw); background: var(--bg); box-shadow: -30px 0 60px -30px rgba(10,25,45,.5); transform: translateX(105%); transition: transform .25s ease; display: flex; flex-direction: column; font-family: "Inter", system-ui, sans-serif; color: var(--ink); font-size: 13.5px; font-variant-numeric: tabular-nums; }
.pr-drawer.is-wide { width: min(940px, 96vw); }
.pr-drawer.on { transform: none; }
.pr-dr-h { display: flex; align-items: center; gap: 12px; padding: 12px 18px; background: #fff; border-bottom: 1px solid var(--line); border-top: 3px solid var(--pri); flex: 0 0 auto; }
.pr-dr-h .tt { flex: 1; min-width: 0; }
.pr-dr-h h3 { margin: 0; font-size: 15.5px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pr-dr-h p { margin: 1px 0 0; font-size: 11.5px; color: var(--mut); }
.pr-drawer.is-new .pr-dr-h { border-top-color: var(--pri); }
.pr-drawer.is-repeat .pr-dr-h { border-top-color: var(--blue); }
.pr-drawer.is-sample .pr-dr-h { border-top-color: var(--violet); }
.pr-dr-b { flex: 1; overflow-y: auto; padding: 14px 18px 30px; }
.pr-dr-b .pr-t th { position: static; }
.pr-dr-b .pr-t { background: #fff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
.pr-dr-b .pr-t tfoot td { border-radius: 0; }
.pr-dtabs { display: flex; gap: 4px; padding: 3px; background: #fff; border: 1px solid var(--line); border-radius: 10px; margin-bottom: 10px; }
.pr-dtabs button { flex: 1; height: 32px; border: 0; border-radius: 8px; background: none; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--ink2); display: inline-flex; align-items: center; justify-content: center; gap: 7px; }
.pr-dtabs button em { font-style: normal; font-size: 11px; font-weight: 700; padding: 1px 7px; border-radius: 99px; background: var(--pri-l); color: var(--pri-d); }
.pr-dtabs button.on { background: var(--pri); color: var(--on-pri); font-weight: 700; }
.pr-dtabs button.on em { background: rgba(255,255,255,.6); color: var(--on-pri); }
.pr-dtools { display: flex; gap: 8px; margin-bottom: 10px; }
.pr-dtools .pr-search { flex: 1; width: auto; }
.pr-btn { height: 34px; padding: 0 14px; border: 0; border-radius: 9px; background: var(--pri); color: var(--on-pri) !important; font-weight: 700; cursor: pointer; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; }
.pr-btn:hover { background: var(--pri-dd); }
.pr-btn:disabled { opacity: .6; cursor: wait; }
.pr-btn.is-ghost { background: #fff; color: var(--pri-d) !important; border: 1px solid var(--pri-b); }
.pr-btn.is-ghost:hover { background: var(--pri-l); }
.pr-infos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-bottom: 10px; }
.pr-info { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; min-width: 0; }
