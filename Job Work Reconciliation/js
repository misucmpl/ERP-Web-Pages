        '<tr class="tot"><td>Net Total' + (dn.total_taxes ? " + Tax " + inr(dn.total_taxes) : "") + '</td><td></td><td></td><td class="n">' + inr(dn.grand_total) + "</td></tr></tbody></table></div>";
    }
    function drawSubmit() {
      var box = $("#agr-calc-sub"); if (!box) return;
      if (CALC.done) {
        var d0 = CALC.done;
        box.className = "agr-csub is-done";
