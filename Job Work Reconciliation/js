        box.innerHTML = '<div class="agr-cdone"><span class="ok">' + I.check + "</span><div><b>Dispatch Entry submitted</b><small>" + esc(d0.product) + " \u00b7 " + qi(d0.qty) + (d0.product === "Chain Set" ? " sets" : " pcs") + " = " + qi(d0.total_pcs) + " pcs</small></div></div>" +
          '<div class="agr-cents">' + (d0.entries || []).map(function (e) {
            return '<a href="/app/stock-entry/' + encodeURIComponent(e.name) + '" target="_blank" rel="noopener"><b>' + esc(e.name) + "</b><small>Repack \u00b7 " + qi(e.fg_pcs) + " pcs \u2192 " + qi(e.rm_qty) + " kg " + esc(e.rm_item) + "</small></a>";
          }).join("") + "</div>" + dnCard(d0.delivery_note) +
          (CALC.delErr ? '<div class="agr-msg show">Delete failed: ' + esc(CALC.delErr) + "</div>" : "") +
          (CALC.delArm
            ? '<div class="agr-cconf is-del"><span>Cancel and delete <b>' + esc(docNames(d0).join(", ")) + "</b>? Stock will go back to how it was.</span>" +
                '<div class="agr-cact"><button type="button" class="agr-btn ghost" data-act="del-no"' + (CALC.delBusy ? " disabled" : "") + ">Keep</button>" +
                '<button type="button" class="agr-btn danger" data-act="del-go"' + (CALC.delBusy ? " disabled" : "") + ">" + (CALC.delBusy ? '<span class="agr-spin sm"></span> Deleting\u2026' : "Yes, Delete All") + "</button></div></div>"
            : '<div class="agr-cact"><button type="button" class="agr-btn ghost del" data-act="del">' + I.x + ' Delete Entries</button><span class="why">Something wrong? Delete these entries and create a new one.</span>' +
                '<button type="button" class="agr-btn" data-act="new">New Dispatch Entry</button></div>');
        return;
      }
      var st = state(), r = st.r, p = st.p;
      var plan = [[r.repolPcs, JW.items.repol, r.repolKgR, "REPOL"], [r.mbPcs, JW.items.mb, r.mbKgR, "Master Batch"]].filter(function (x) { return x[0] > 0 && x[2] > 0; });
      var dnKg = r.repolKgR + r.mbKgR, dnAmt = r.repolAmt + r.mbAmt;
      var planHtml = '<div class="agr-cplan"><div class="h">Entries to be created in ERP <em>(' + (plan.length || 2) + " Stock Entries \u00b7 Repack + 1 Delivery Note \u00b7 all submitted)</em></div>" +
        (plan.length ? plan.map(function (x, i) {
          return '<div class="row"><span class="n">' + (i + 1) + "</span><span class=\"src\"><small>From WH2 - UCM</small><b>" + qi(x[0]) + " pcs</b><em>" + esc(p.item) + '</em></span><span class="arr">\u2192</span><span class="tgt"><small>To WH1 - UCM</small><b>' + qi(x[2]) + " kg</b><em>" + esc(x[1]) + "</em></span></div>";
        }).join("") + '<div class="row dn"><span class="n">' + (plan.length + 1) + '</span><span class="src"><small>Delivery Note \u00b7 from WH1 - UCM</small><b>' + qi(dnKg) + " kg</b><em>REPOL " + qi(r.repolKgR) + " + MB " + qi(r.mbKgR) + '</em></span><span class="arr">\u2192</span><span class="tgt"><small>' + esc(DEFAULT_CUSTOMER) + (S.customerName && S.customerName !== DEFAULT_CUSTOMER ? " \u00b7 " + esc(S.customerName) : "") + "</small><b>" + inr0(dnAmt) + "</b><em>" + (CALC.vehicle ? esc(CALC.vehicle) : "vehicle ?") + " \u00b7 " + (CALC.dist > 0 ? qi(CALC.dist) + " km" : "km ?") + "</em></span></div>" : '<div class="none">Entries will appear here once you enter a quantity.</div>') + "</div>";
      var why = "";
      if (!S.acc || !S.acc.can_entry) why = "Aapke paas Dispatch Entry submit karne ka access nahi hai.";
      else if (!st.hasQ) why = "Pehle qty daalein.";
      else if (st.avail === null) why = JWS.err ? "Stock check nahi ho paaya." : "Stock check ho raha hai\u2026";
      else if (!st.ok) why = "WH2 - UCM mein stock kam hai, submit nahi ho sakta.";
      else if (!CALC.vehicle || CALC.vehicle.length < 6) why = "Delivery Note ke liye Vehicle No daalein.";
      else if (!(CALC.dist > 0)) why = "Distance (km) daalein.";
      var ready = st.ok && !why;
      box.className = "agr-csub" + (ready ? " is-ok" : "");
      var errHtml = (CALC.info ? '<div class="agr-msg show ok">' + esc(CALC.info) + "</div>" : "") + (CALC.err ? '<div class="agr-msg show">Submit nahi hua: ' + esc(CALC.err) + "</div>" : "");
      if (CALC.arm && ready) {
        box.innerHTML = errHtml + planHtml + '<div class="agr-cconf"><span>' + plan.length + " Repack entries and 1 Delivery Note will be <b>submitted</b>. Stock will update immediately.</span>" +
          '<div class="agr-cact"><button type="button" class="agr-btn ghost" data-act="cancel"' + (CALC.busy ? " disabled" : "") + '>Cancel</button>' +
          '<button type="button" class="agr-btn go" data-act="go"' + (CALC.busy ? " disabled" : "") + ">" + (CALC.busy ? '<span class="agr-spin sm"></span> Submitting\u2026' : "Confirm & Submit") + "</button></div></div>";
      } else {
        box.innerHTML = errHtml + planHtml + '<div class="agr-cact"><span class="why' + (st.ok ? "" : " bad") + '">' + esc(why) + "</span>" +
          '<button type="button" class="agr-btn go" data-act="arm"' + (ready ? "" : " disabled") + ">" + I.check + " Submit</button></div>";
      }
    }
    async function submitRepack() {
      if (CALC.busy) return;
      var st = state(); if (!st.ok || !CALC.vehicle || !(CALC.dist > 0)) return;
      CALC.busy = true; drawSubmit(); q.disabled = true; vIn.disabled = true; dIn.disabled = true;
      try {
        var res = await api({ action: "repack", product: CALC.key, qty: Math.floor(+q.value || 0), vehicle_no: CALC.vehicle, distance: CALC.dist }, "POST");
        CALC.busy = false; CALC.done = res; CALC.arm = false; CALC.delArm = false; CALC.delErr = ""; CALC.info = "";
        drawSubmit();
        loadJwStock().then(function () { if (!$("#agr-calcm").hidden && !CALC.done) draw(); else if (!$("#agr-calcm").hidden) { $$(".agr-cpick [data-st]", m).forEach(function (s) { var it = JW.products[s.getAttribute("data-st")].item; s.textContent = JWS.stock ? "Stock " + qi(+JWS.stock[it] || 0) + " pcs" : ""; }); } });
        load();
      } catch (e) {
        CALC.busy = false; CALC.arm = false; CALC.err = e.message; q.disabled = false; vIn.disabled = false; dIn.disabled = false;
        drawSubmit();
        loadJwStock().then(function () { if (!$("#agr-calcm").hidden && !CALC.done) draw(); });
      } finally { CALC.busy = false; }
    }
    draw(); setTimeout(function () { q.focus(); }, 30);
    loadJwStock().then(function () { if (!$("#agr-calcm").hidden && $("#agr-calc-out") && !CALC.done) draw(); });
  }
  function closeCalc() { var m = $("#agr-calcm"); if (!m || m.hidden) return; m.hidden = true; lock(false); }
  $("#agr-calc").addEventListener("click", openCalc);
  $("#agr-calcm").addEventListener("mousedown", function (e) { if (e.target === this) closeCalc(); });

  /* --------- settings settings (System Manager) --------- */
  var SV = { users: [], cand: [], pick: null };
  function openSettings() {
    var m = $("#agr-set");
    $(".agr-modal", m).innerHTML =
      '<div class="agr-mh"><div><h3>Report access</h3><p><b>View</b> = sirf report dekhna. <b>View + Dispatch Entry</b> = Dispatch Entry popup se Repack entries submit bhi kar sakte hain. System Managers ke paas hamesha sab access hai.</p></div>' +
        '<button type="button" class="agr-ibtn" id="agr-set-x" title="Close">' + I.x + "</button></div>" +
      '<div class="agr-mb"><div class="agr-msg" id="agr-set-msg"></div>' +
        '<div class="agr-add"><div class="agr-pick"><input type="text" id="agr-set-u" placeholder="Type user name or email\u2026" autocomplete="off"><div class="agr-pick-l" id="agr-set-l" hidden></div></div>' +
        '<select id="agr-set-lv" class="agr-lv"><option value="view">View</option><option value="entry">View + Dispatch Entry</option></select>' +
        '<button type="button" class="agr-btn" id="agr-set-go">Give access</button></div>' +
        '<div class="agr-ulist" id="agr-set-list"><div class="agr-none">Loading\u2026</div></div></div>';
    m.hidden = false; lock(true);
    $("#agr-set-x").addEventListener("click", closeSettings);
    var inp = $("#agr-set-u"), lst = $("#agr-set-l");
    function pick() {
      var qs = inp.value.trim().toLowerCase(), have = {};
      SV.users.forEach(function (u) { have[u.user] = 1; });
      var list = SV.cand.filter(function (c) { return !have[c.user] && (!qs || (c.full_name + " " + c.user).toLowerCase().indexOf(qs) >= 0); }).slice(0, 8);
      lst.innerHTML = list.length ? list.map(function (c) { return '<button type="button" data-u="' + esc(c.user) + '"><b>' + esc(c.full_name) + "</b><small>" + esc(c.user) + "</small></button>"; }).join("") : '<div class="agr-none">No user found</div>';
      lst.hidden = false;
    }
    inp.addEventListener("focus", pick);
    inp.addEventListener("input", function () { SV.pick = null; pick(); });
    inp.addEventListener("blur", function () { setTimeout(function () { lst.hidden = true; }, 120); });
    lst.addEventListener("mousedown", function (e) {
      var b = e.target.closest("button[data-u]"); if (!b) return; e.preventDefault();
      var c = SV.cand.filter(function (x) { return x.user === b.getAttribute("data-u"); })[0];
      SV.pick = c ? c.user : null; inp.value = c ? c.full_name + " (" + c.user + ")" : ""; lst.hidden = true;
    });
    $("#agr-set-go").addEventListener("click", async function () {
      if (!SV.pick) { setMsg("Pick a user from the list first."); return; }
      this.disabled = true; var who = SV.pick;
      var lv = $("#agr-set-lv").value;
      if (await settingsCall({ action: "set", user: who, level: lv })) { SV.pick = null; inp.value = ""; setMsg((lv === "entry" ? "View + Dispatch Entry" : "View") + " access given to " + who + ".", true); }
      this.disabled = false;
    });
    $("#agr-set-list").addEventListener("change", async function (e) {
      var sl = e.target.closest("select[data-lv]"); if (!sl) return;
      sl.disabled = true;
      if (await settingsCall({ action: "set", user: sl.getAttribute("data-lv"), level: sl.value })) setMsg("Access updated for " + sl.getAttribute("data-lv") + ".", true);
      else sl.disabled = false;
    });
    $("#agr-set-list").addEventListener("click", async function (e) {
      var b = e.target.closest("button[data-rm]"); if (!b) return;
      if (!b.classList.contains("arm")) { b.classList.add("arm"); b.textContent = "Remove?"; setTimeout(function () { b.classList.remove("arm"); b.innerHTML = I.x; }, 3000); return; }
      b.disabled = true;
      if (await settingsCall({ action: "set", user: b.getAttribute("data-rm"), level: "none" })) setMsg("Access removed for " + b.getAttribute("data-rm") + ".", true);
    });
    settingsCall({ action: "list" });
  }
  function setMsg(t, ok) { var el = $("#agr-set-msg"); if (!el) return; el.className = "agr-msg" + (t ? " show" + (ok ? " ok" : "") : ""); el.textContent = t || ""; }
  async function settingsCall(body) {
    try {
      var m = await api(body, "POST"); if (!m) return false;
      SV.users = m.users || []; SV.cand = m.candidates || [];
      $("#agr-set-list").innerHTML = SV.users.length ? SV.users.map(function (u) {
        return '<div class="agr-urow' + (u.enabled ? "" : " off") + '"><span class="av">' + esc(initials(u.full_name || u.user)) + '</span><div class="nm"><b>' + esc(u.full_name) + "</b><small>" + esc(u.user) + (u.enabled ? "" : " \u00b7 disabled") + "</small></div>" +
          (u.level === "admin" ? '<span class="tag admin">System Manager</span><span class="rm"></span>' : '<select class="agr-lv sm" data-lv="' + esc(u.user) + '"><option value="view"' + (u.level === "view" ? " selected" : "") + '>View</option><option value="entry"' + (u.level === "entry" ? " selected" : "") + '>View + Dispatch Entry</option></select><button type="button" class="rm" data-rm="' + esc(u.user) + '" title="Remove access">' + I.x + "</button>") + "</div>";
      }).join("") : '<div class="agr-none">No users yet</div>';
      return true;
    } catch (e) { setMsg((body.action === "list" ? "Could not load users: " : "Not saved: ") + e.message); return false; }
  }
  function closeSettings() { var m = $("#agr-set"); if (m.hidden) return; m.hidden = true; lock(false); }
  $("#agr-gear").addEventListener("click", openSettings);
  $("#agr-set").addEventListener("mousedown", function (e) { if (e.target === this) closeSettings(); });

  /* --------- title + buttons ERP ke top header (navbar) mein --------- */
  function mergeNav() {
    var nav = d.querySelector("nav.navbar"), brand = nav && nav.querySelector(".navbar-brand");
    if (!nav || !brand) return;                       // navbar na mile to page ka apna header hi rahega
    var t = d.createElement("div"); t.className = "agr-nav-title";
    t.innerHTML = '<h1>Job Work Reconciliation</h1><p class="agr-sub"></p>';
    brand.insertAdjacentElement("afterend", t);
    var act = $("#agr-act"); act.classList.add("agr-nav-act");
    var login = nav.querySelector("#website-post-login");
    if (login && login.parentNode) {
      var li = d.createElement("li"); li.className = "nav-item agr-nav-li"; li.appendChild(act);
      login.parentNode.insertBefore(li, login);
    } else {
      (brand.parentElement || nav).appendChild(act);
      act.classList.add("is-end");
    }
    $("#agr-head").hidden = true;
    d.body.classList.add("agr-nav-merged");
    alignToLogo();
    w.addEventListener("resize", alignToLogo);
    w.addEventListener("load", alignToLogo);
  }
  /* page ka left margin bilkul logo ki seedh mein (har screen size par) */
  function alignToLogo() {
    var brand = d.querySelector("nav.navbar .navbar-brand");
    if (!brand) return;
    var img = brand.querySelector("img, svg") || brand;
    var left = Math.round(img.getBoundingClientRect().left - root.getBoundingClientRect().left);
    if (left >= 8 && left <= 120) root.style.setProperty("--agr-pad", left + "px");
  }

  /* --------- start --------- */
  async function boot() {
    if (!cookie("user_id") || cookie("user_id") === "Guest") { location.href = "/login?redirect-to=" + encodeURIComponent(location.pathname); return; }
    try { S.acc = await api({ action: "me" }); }
    catch (e) {
      $("#agr-gate").innerHTML = '<div class="agr-gate-card"><div class="ico warn">!</div><h3>Could not check access</h3><p>' + esc(e.message) + '</p><p class="s">Check that the <b>ucm_ag_recon</b> Server Script is saved and enabled.</p></div>';
      return;
    }
    if (!S.acc || !S.acc.can_view) {
      $("#agr-gate").innerHTML = '<div class="agr-gate-card"><div class="ico">' + I.lock + '</div><h3>You do not have access</h3><p>This report is open only to System Managers and users given access by them.</p><p class="s">Signed in as <b>' + esc((S.acc && (S.acc.full_name || S.acc.user)) || "") + "</b></p></div>";
      return;
    }
    $("#agr-gate").hidden = true; $("#agr-app").hidden = false;
    $("#agr-gear").hidden = !S.acc.is_admin;
    mergeNav();
    syncPeriod(); load();
  }
  boot();
