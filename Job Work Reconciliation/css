/* ============================================================
   UCMPL · AG Job Work Reconciliation — Web Page CSS
   Web Page → Style → CSS box mein poora paste karein.
   Theme: charcoal + saffron (warm paper background)
   ============================================================ */
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");

.navbar > .container, .navbar .container-fluid, header .navbar .container,
.web-footer .container, footer .container { max-width: none !important; width: 100% !important; padding-left: 24px !important; padding-right: 24px !important; box-sizing: border-box !important; }
.page-content-wrapper, .page_content, main .container { max-width: none !important; }

#ucm-agr {
  --bg: #f6f4ef; --card: #ffffff; --line: #e7e2d8; --line2: #d9d2c4;
  --ink: #1d2330; --ink2: #4a5162; --mut: #878c99; --mut2: #a9adb7;
  --char: #222935; --char2: #313a4a;
  --pri: #c0620c; --pri-d: #9a4c06; --pri-l: #fff3e3; --pri-b: #f3d2a8; --sun: #f2a03a;
  --in: #2f7a4d; --in-l: #e9f5ee; --out: #b2433a; --out-l: #fbecea;
  font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: var(--ink); background: var(--bg); font-size: 14px; line-height: 1.45;
  min-height: 100vh; width: 100vw; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);
  -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums;
}
#ucm-agr *, #ucm-agr *::before, #ucm-agr *::after { box-sizing: border-box; }
#ucm-agr [hidden] { display: none !important; }
#ucm-agr button { font: inherit; }

/* gate */
.agr-gate { display: flex; justify-content: center; padding: 80px 16px; }
.agr-gate-card { width: 100%; max-width: 440px; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 34px 28px; text-align: center; box-shadow: 0 20px 44px -30px rgba(29,35,48,.5); }
.agr-gate-card .ico { width: 54px; height: 54px; margin: 0 auto 12px; border-radius: 14px; display: flex; align-items: center; justify-content: center; background: var(--pri-l); color: var(--pri); }
.agr-gate-card .ico.warn { background: var(--out-l); color: var(--out); font-size: 24px; font-weight: 800; }
.agr-gate-card h3 { margin: 0 0 6px; font-size: 18px; font-weight: 700; }
.agr-gate-card p { margin: 0 0 6px; color: var(--ink2); }
.agr-gate-card p.s { margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--line); font-size: 12.5px; color: var(--mut); }
.agr-spin { display: inline-block; width: 22px; height: 22px; border: 3px solid #eadfcd; border-top-color: var(--pri); border-radius: 50%; animation: agrSpin .8s linear infinite; vertical-align: middle; }
@keyframes agrSpin { to { transform: rotate(360deg); } }

/* header */
.agr-head { display: flex; align-items: center; gap: 14px; padding: 14px 24px; background: var(--char); color: #fff; position: relative; }
.agr-head::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: linear-gradient(90deg, var(--sun), var(--pri)); }
.agr-title { display: flex; align-items: center; gap: 12px; min-width: 0; flex: 1 1 auto; }
.agr-title > div { min-width: 0; }
.agr-mark { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 11px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px; letter-spacing: .04em;
  background: linear-gradient(135deg, var(--sun), var(--pri)); color: #fff; box-shadow: inset 0 0 0 1px rgba(255,255,255,.25); }
.agr-title h1 { margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 18px; font-weight: 700; letter-spacing: -.2px; color: #fff; }
.agr-title p { margin: 1px 0 0; font-size: 12.5px; color: rgba(255,255,255,.66); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.agr-head-act { margin-left: auto; display: flex; gap: 8px; }
.agr-ibtn { width: 36px; height: 36px; flex: 0 0 36px; display: inline-flex; align-items: center; justify-content: center; border-radius: 9px; cursor: pointer;
  border: 1px solid var(--line2); background: #fff; color: var(--ink2); transition: background .15s, color .15s, transform .3s; }
.agr-ibtn:hover { background: var(--pri-l); color: var(--pri); border-color: var(--pri-b); }
.agr-head .agr-ibtn, .agr-ibtn.is-dark { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.18); color: #fff; }
.agr-head .agr-ibtn:hover, .agr-ibtn.is-dark:hover { background: rgba(255,255,255,.18); color: #fff; }
.agr-ibtn.is-gear svg { transition: transform .35s; }
.agr-ibtn.is-gear:hover svg { transform: rotate(45deg); }
#ucm-agr.is-busy #agr-refresh svg { animation: agrSpin .9s linear infinite; }

/* filter band */
.agr-band { display: flex; align-items: flex-end; gap: 14px; flex-wrap: wrap; padding: 12px 24px; background: #fff; border-bottom: 1px solid var(--line); }
.agr-f { display: flex; flex-direction: column; gap: 4px; }
.agr-f > span { font-size: 11.5px; font-weight: 500; color: var(--ink2); }
.agr-f-cust { flex: 0 1 360px; min-width: 220px; }
.agr-dd { position: relative; }
.agr-dd-in { width: 100%; height: 36px; display: flex; align-items: center; gap: 8px; padding: 0 10px 0 12px; border: 1px solid var(--line2); border-radius: 9px; background: #fff; cursor: pointer; text-align: left; color: var(--ink); }
.agr-dd-in b { flex: 1; min-width: 0; font-weight: 600; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.agr-dd-in b small { font-weight: 500; color: var(--mut); margin-left: 4px; }
.agr-dd-in svg { color: var(--mut); flex: 0 0 auto; transition: transform .15s; }
.agr-dd.open .agr-dd-in { border-color: var(--pri); box-shadow: 0 0 0 3px rgba(192,98,12,.12); }
.agr-dd.open .agr-dd-in svg { transform: rotate(180deg); }
.agr-dd-pop { position: absolute; z-index: 30; top: calc(100% + 6px); left: 0; width: max(100%, 320px); background: #fff; border: 1px solid var(--line2); border-radius: 12px; box-shadow: 0 18px 36px -16px rgba(29,35,48,.4); padding: 8px; }
.agr-dd-pop input { width: 100%; height: 34px; border: 1px solid var(--line); border-radius: 8px; padding: 0 10px; font: inherit; font-size: 13px; outline: none; background: #faf9f6; }
.agr-dd-pop input:focus { border-color: var(--pri); background: #fff; }
.agr-dd-list { max-height: 300px; overflow-y: auto; margin-top: 6px; }
.agr-dd-list button { display: flex; flex-direction: column; align-items: flex-start; width: 100%; border: 0; background: none; padding: 7px 10px; border-radius: 7px; cursor: pointer; text-align: left; }
.agr-dd-list button:hover { background: var(--pri-l); }
.agr-dd-list button.sel { background: var(--pri-l); box-shadow: inset 3px 0 0 var(--pri); }
.agr-dd-list b { font-size: 13px; font-weight: 500; }
.agr-dd-list small { font-size: 11.5px; color: var(--mut); }
.agr-dd-none { padding: 12px; text-align: center; color: var(--mut); font-size: 12.5px; }
.agr-mnav { display: flex; align-items: center; height: 36px; border: 1px solid var(--line2); border-radius: 9px; overflow: hidden; background: #fff; }
.agr-mnav button { width: 34px; height: 100%; border: 0; background: none; color: var(--ink2); cursor: pointer; display: flex; align-items: center; justify-content: center; }
.agr-mnav button:hover { background: var(--pri-l); color: var(--pri); }
.agr-mnav b { min-width: 86px; text-align: center; font-size: 13px; font-weight: 700; padding: 0 6px; border-left: 1px solid var(--line); border-right: 1px solid var(--line); line-height: 34px; }
.agr-range { display: flex; align-items: center; gap: 4px; height: 36px; padding: 0 6px 0 10px; border: 1px solid var(--line2); border-radius: 9px; background: #fff; }
.agr-range input { border: 0; background: none; font: inherit; font-size: 13px; color: var(--ink); outline: none; width: 128px; }
.agr-range i { font-style: normal; color: var(--mut2); }
.agr-band-note { margin-left: auto; align-self: center; font-size: 12px; color: var(--mut); }

/* main */
.agr-main { padding: 16px 24px 32px; display: flex; flex-direction: column; gap: 14px; transition: opacity .2s; }
.agr-main.is-loading { opacity: .55; pointer-events: none; }
.agr-empty, .agr-error { padding: 40px; text-align: center; color: var(--mut); background: #fff; border: 1px solid var(--line); border-radius: 14px; display: flex; gap: 10px; align-items: center; justify-content: center; }
.agr-error { color: var(--out); background: var(--out-l); border-color: #f2cdc8; display: block; }

/* links (clickable headings) */
.agr-link { display: inline-flex; align-items: center; gap: 4px; border: 0; background: none; padding: 0; cursor: pointer; color: inherit; font-weight: inherit; text-align: left; }
.agr-link svg { opacity: .55; transition: transform .15s, opacity .15s; }
.agr-link:hover { color: var(--pri); }
.agr-link:hover svg { opacity: 1; transform: translateX(2px); }

/* 1. reconciliation equation */
.agr-recon { background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; box-shadow: 0 1px 2px rgba(29,35,48,.04); }
.agr-sec-h { display: flex; align-items: flex-end; gap: 12px; padding: 14px 20px 8px; }
.agr-sec-h h2 { margin: 0; font-size: 16px; font-weight: 700; }
.agr-sec-h p { margin: 2px 0 0; font-size: 12.5px; color: var(--mut); }
.agr-period { margin-left: auto; font-size: 12px; font-weight: 600; color: var(--pri-d); background: var(--pri-l); border: 1px solid var(--pri-b); padding: 4px 10px; border-radius: 99px; white-space: nowrap; }
.agr-eq { padding: 0 20px 6px; }
.agr-eq-row { display: grid; grid-template-columns: minmax(130px, 1.2fr) minmax(0,1fr) 24px minmax(0,1fr) 24px minmax(0,1fr) 24px minmax(0,1fr) 24px minmax(0,1.15fr); align-items: center; border-top: 1px solid #f0ece4; }
.agr-eq-row > div { padding: 9px 6px; }
.agr-eq-row .c-n { text-align: right; font-size: 20px; font-weight: 700; letter-spacing: -.3px; }
.agr-eq-row .c-op { text-align: center; color: var(--mut2); font-size: 18px; font-weight: 500; }
.agr-eq-row .c-item b { font-size: 14px; font-weight: 600; }
.agr-eq-row .c-n.is-in { color: var(--in); }
.agr-eq-row .c-n.is-out { color: var(--out); }
.agr-eq-row .c-bal { background: var(--pri-l); color: var(--pri-d); border-radius: 0; }
.agr-eq-row .c-bal.is-neg { color: var(--out); background: var(--out-l); }
.agr-eq-head { border-top: 0; }
.agr-eq-head > div { padding: 8px 6px; font-size: 12.5px; font-weight: 600; color: var(--mut); }
.agr-eq-head .c-n { font-size: 12.5px; font-weight: 600; }
.agr-eq-head .c-n .agr-link { justify-content: flex-end; width: 100%; color: var(--ink2); }
.agr-eq-head .c-n .agr-link:hover { color: var(--pri); }
.agr-eq-head .c-bal { background: var(--char); color: #fff; border-radius: 10px 10px 0 0; }
.agr-eq-tot { border-top: 2px solid var(--line2); }
.agr-eq-tot .c-item { font-weight: 700; font-size: 14px; color: var(--ink); }
.agr-eq-tot .c-n { font-size: 24px; font-weight: 800; }
.agr-eq-tot .c-bal { background: linear-gradient(135deg, var(--sun), var(--pri)); color: #fff; border-radius: 0 0 10px 10px; }
.agr-eq-tot .c-bal.is-neg { background: var(--out); color: #fff; }
.agr-foot-note { margin: 0; padding: 10px 20px 14px; font-size: 11.5px; color: var(--mut); }

/* 2. cards */
.agr-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; }
.agr-card { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px 10px; position: relative; overflow: hidden; display: flex; flex-direction: column; }
.agr-card .agr-line.is-tot { margin-top: auto; }
.agr-card .agr-docs { flex: 1; align-content: stretch; }
.agr-card::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: var(--line2); }
.agr-card.is-mfg::before { background: var(--in); }
.agr-card.is-si::before { background: var(--pri); }
.agr-card.is-docs::before { background: var(--char); }
.agr-card-h { display: flex; flex-direction: column; gap: 1px; padding-bottom: 8px; margin-bottom: 4px; border-bottom: 1px solid #f0ece4; }
.agr-card-h span, .agr-card-h .agr-link { font-size: 15px; font-weight: 700; }
.agr-card-h em { font-style: normal; font-size: 11.5px; color: var(--mut); }
.agr-line { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px dashed #efebe3; font-size: 13.5px; }
.agr-line:last-child { border-bottom: 0; }
.agr-line > span, .agr-line .agr-link { min-width: 0; color: var(--ink2); }
.agr-line .agr-link.is-row { color: var(--ink); font-weight: 500; }
.agr-line b { font-size: 15px; font-weight: 700; }
.agr-line.is-tot { border-top: 1px solid var(--line2); border-bottom: 0; margin-top: 2px; }
.agr-line.is-tot span { font-weight: 700; color: var(--ink); }
.agr-line.is-tot b { font-size: 17px; color: var(--pri-d); }
.agr-none { padding: 14px 0; text-align: center; color: var(--mut); font-size: 12.5px; }
.agr-none.big { padding: 48px 0; }
.agr-docs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 6px 0 6px; }
.agr-doc { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; background: #fbfaf7; cursor: pointer; text-align: left; transition: border-color .15s, background .15s; }
.agr-doc:hover { border-color: var(--pri-b); background: var(--pri-l); }
.agr-doc b { font-size: 20px; font-weight: 800; letter-spacing: -.3px; color: var(--ink); }
.agr-doc span { font-size: 12px; color: var(--ink2); }

/* slider */
.agr-scrim { position: fixed; inset: 0; background: rgba(29,35,48,.32); opacity: 0; pointer-events: none; transition: opacity .2s; z-index: 1040; }
.agr-scrim.on { opacity: 1; pointer-events: auto; }
.agr-drawer { position: fixed; top: 0; right: 0; bottom: 0; width: min(900px, 96vw); background: #fff; z-index: 1050; display: flex; flex-direction: column;
  transform: translateX(100%); transition: transform .25s ease; box-shadow: -18px 0 40px -20px rgba(29,35,48,.4); font-family: "Inter", system-ui, sans-serif; color: var(--ink); }
.agr-drawer.on { transform: none; }
.agr-dr-h { display: flex; align-items: flex-start; gap: 12px; padding: 18px 22px 16px; background: var(--char); color: #fff; position: relative; }
.agr-dr-h::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: linear-gradient(90deg, var(--sun), var(--pri)); }
.agr-dr-h .k { font-size: 12px; font-weight: 600; color: var(--sun); }
.agr-dr-h h3 { margin: 2px 0 2px; font-size: 18px; font-weight: 700; color: #fff; }
.agr-dr-h .s { font-size: 12.5px; color: rgba(255,255,255,.66); }
.agr-dr-act { margin-left: auto; display: flex; gap: 8px; }
.agr-dr-b { flex: 1; overflow-y: auto; padding: 16px 22px; overscroll-behavior: contain; }
.agr-grp { margin-bottom: 18px; }
.agr-grp-h { display: flex; align-items: baseline; gap: 8px; margin: 2px 0 8px; }
.agr-grp-h span { font-size: 14px; font-weight: 700; }
.agr-grp-h em { font-style: normal; font-size: 11.5px; color: var(--mut); }
.agr-tw { border: 1px solid var(--line); border-radius: 12px; overflow-x: auto; }
.agr-t { width: 100%; border-collapse: collapse; font-size: 12.5px; }
.agr-t th { position: sticky; top: 0; background: #faf8f4; text-align: left; font-size: 12px; font-weight: 600; color: var(--mut); padding: 9px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
.agr-t td { padding: 8px 10px; border-bottom: 1px solid #f2efe8; white-space: nowrap; }
.agr-t td.it { white-space: normal; min-width: 160px; }
.agr-t td.basis { white-space: normal; color: var(--ink2); }
.agr-t .n { text-align: right; }
.agr-t a { color: var(--pri-d); font-weight: 600; text-decoration: none; }
.agr-t a:hover { text-decoration: underline; }
.agr-t tbody tr:hover td { background: #fffaf2; }
.agr-t tr.sub td { background: #fbfaf7; color: var(--ink2); font-weight: 600; font-size: 12px; }
.agr-t tr.tot td { background: var(--pri-l); font-weight: 700; border-bottom: 0; border-top: 1px solid var(--pri-b); }
.agr-dr-f { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 22px; border-top: 1px solid var(--line); background: #faf8f4; font-size: 13px; }
.agr-dr-f span { color: var(--ink2); font-weight: 500; }
.agr-dr-f b { font-size: 15px; }

/* settings modal */
.agr-modal-bg { position: fixed; inset: 0; z-index: 1070; background: rgba(29,35,48,.4); display: flex; align-items: flex-start; justify-content: center; padding: 7vh 16px 16px; overflow-y: auto; font-family: "Inter", system-ui, sans-serif; }
.agr-modal { width: 100%; max-width: 560px; background: #fff; border-radius: 16px; box-shadow: 0 30px 60px -20px rgba(29,35,48,.5); color: var(--ink); }
.agr-mh { display: flex; align-items: flex-start; gap: 12px; padding: 18px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(135deg, var(--pri-l), #fff); border-radius: 16px 16px 0 0; }
.agr-mh h3 { margin: 0; font-size: 17px; font-weight: 700; }
.agr-mh p { margin: 3px 0 0; font-size: 12.5px; color: var(--ink2); }
.agr-mh .agr-ibtn { margin-left: auto; }
.agr-mb { padding: 16px 20px 20px; }
.agr-msg { display: none; padding: 10px 12px; border-radius: 10px; font-size: 13px; margin-bottom: 12px; background: var(--out-l); color: var(--out); }
.agr-msg.show { display: block; }
.agr-msg.ok { background: var(--in-l); color: var(--in); }
.agr-add { display: flex; gap: 8px; margin-bottom: 14px; }
.agr-pick { position: relative; flex: 1; min-width: 0; }
.agr-pick input { width: 100%; height: 38px; border: 1px solid var(--line2); border-radius: 9px; padding: 0 12px; font: inherit; outline: none; }
.agr-pick input:focus { border-color: var(--pri); box-shadow: 0 0 0 3px rgba(192,98,12,.12); }
.agr-pick-l { position: absolute; left: 0; right: 0; top: calc(100% + 4px); z-index: 5; background: #fff; border: 1px solid var(--line2); border-radius: 10px; box-shadow: 0 14px 30px -14px rgba(29,35,48,.4); max-height: 260px; overflow-y: auto; padding: 4px; }
.agr-pick-l button { display: flex; flex-direction: column; align-items: flex-start; width: 100%; border: 0; background: none; padding: 7px 10px; border-radius: 7px; cursor: pointer; text-align: left; }
.agr-pick-l button:hover { background: var(--pri-l); }
.agr-pick-l b { font-size: 13px; font-weight: 500; }
.agr-pick-l small { font-size: 11.5px; color: var(--mut); }
.agr-btn { height: 38px; padding: 0 16px; border: 0; border-radius: 9px; background: var(--pri); color: #fff; font-weight: 600; cursor: pointer; white-space: nowrap; }
.agr-btn:hover { background: var(--pri-d); }
.agr-btn:disabled { opacity: .6; cursor: wait; }
.agr-ulist { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
.agr-urow { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-bottom: 1px solid #f2efe8; }
.agr-urow:last-child { border-bottom: 0; }
.agr-urow.off { opacity: .55; }
.agr-urow .av { width: 32px; height: 32px; flex: 0 0 32px; border-radius: 50%; background: #f1ede5; color: var(--ink2); font-size: 11.5px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.agr-urow .nm { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.agr-urow .nm b { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.agr-urow .nm small { font-size: 11.5px; color: var(--mut); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.agr-urow .tag { font-size: 11.5px; font-weight: 600; padding: 4px 10px; border-radius: 99px; background: var(--pri-l); color: var(--pri-d); border: 1px solid var(--pri-b); white-space: nowrap; }
.agr-urow .tag.admin { background: var(--char); color: #fff; border-color: var(--char); }
.agr-urow .rm { flex: 0 0 auto; min-width: 30px; height: 30px; border: 0; border-radius: 8px; background: none; color: var(--mut); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
.agr-urow button.rm:hover { background: var(--out-l); color: var(--out); }
.agr-urow button.rm.arm { background: var(--out); color: #fff; font-size: 12px; font-weight: 600; padding: 0 8px; }

/* responsive */
@media (max-width: 1100px) {
  .agr-cards { grid-template-columns: 1fr 1fr; }
  .agr-card.is-docs { grid-column: 1 / -1; }
  .agr-card.is-docs .agr-docs { grid-template-columns: repeat(4, minmax(0,1fr)); }
}
@media (max-width: 760px) {
  .agr-head { padding: 12px 14px; }
  .agr-title h1 { font-size: 16px; }
  .agr-band { padding: 12px 14px; gap: 10px; }
  .agr-f-cust { flex: 1 0 100%; }
  .agr-f { flex: 1 1 auto; }
  .agr-range { width: 100%; }
