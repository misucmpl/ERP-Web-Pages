.agr-cplan .row.dn { border-top: 1px dashed var(--line2); }
.agr-cplan .row.dn .n { background: var(--pri); }
.agr-cdn { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; margin-bottom: 8px; background: #fff; }
.agr-cdn .t { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 7px 10px; background: var(--pri-l); border-bottom: 1px solid var(--pri-b); }
.agr-cdn .t a { text-decoration: none; }
.agr-cdn .t a b { color: var(--pri-d); font-size: 13px; }
.agr-cdn .t .pill { font-size: 10.5px; font-weight: 700; padding: 2px 8px; border-radius: 99px; background: var(--in); color: #fff; }
.agr-cdn .t em { font-style: normal; font-size: 11.5px; color: var(--ink2); margin-left: auto; }
.agr-cdn .agr-ct { border: 0; }
@media (max-width: 760px) {
  .agr-cm .agr-cin { grid-template-columns: 1fr 1fr; }
  .agr-cm .agr-cpick { grid-column: 1 / -1; }
  .agr-cdn .t em { margin-left: 0; flex-basis: 100%; }
}
#ucm-agr ~ .agr-modal-bg [hidden], .agr-cm [hidden] { display: none !important; }
@media (max-height: 720px) { .agr-cm .agr-mh p { display: none; } .agr-cm .agr-mh { padding: 8px 18px; } }
