  async function call(url, params, method) {
    var token = (w.frappe && w.frappe.csrf_token) || w.csrf_token || "";
    var opts = { credentials: "same-origin", headers: { Accept: "application/json", "X-Frappe-CSRF-Token": token } };
    if (method === "POST") { opts.method = "POST"; opts.headers["Content-Type"] = "application/json"; opts.body = JSON.stringify(params); }
    else url += "?" + Object.keys(params).filter(function (k) { return params[k] !== undefined; }).map(function (k) { return encodeURIComponent(k) + "=" + encodeURIComponent(params[k] == null ? "" : params[k]); }).join("&");
    var r = await fetch(url, opts);
    if (r.status === 401 || (r.status === 403 && !cookie("user_id"))) { location.href = "/login?redirect-to=" + encodeURIComponent(location.pathname); return null; }
    var j = await r.json().catch(function () { return {}; });
