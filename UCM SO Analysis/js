    saveXLS(head, body, "Sales_Orders_" + seg.label.replace(/\s+/g, "_") + "_" + S.from + "_to_" + S.to + ".xls");
  }

  /* --- Packing Material slider (ucm_packing_material_summary) --- */
  var PM = { idx: 0, open: {} };
  async function openPM(idx) {
    PM.idx = idx || 0; PM.open = {};
    var cfg = PM_CONFIGS[PM.idx];
    var seq = openDrawer("Packing Material", esc(cfg.title) + " \u00b7 till date", "is-wide");
    try {
      var m = await call(PM_API, { supplier: cfg.supplier, customer: cfg.customer, items: JSON.stringify(cfg.items) });
      if (seq !== DR.seq) return;
      PM.data = m || {}; drawPM();
    } catch (e) { if (seq !== DR.seq) return; $("#soa-dr-body").innerHTML = errorHTML(e.message + " (ucm_packing_material_summary)"); }
  }
  function drawPM() {
    var p = PM.data, cfg = PM_CONFIGS[PM.idx], items = p.items || [], tot = p.totals || {}, acc = ["#1a73e8", "#7b3fa0", "#00897b", "#b8560c"];
    $("#soa-dr-sub").innerHTML = esc(p.supplier_name || cfg.title) + " (" + esc(cfg.supplier) + ") \u2192 " + esc(p.customer_name || cfg.customer) + " (" + esc(cfg.customer) + ") \u00b7 till date";
    var h = "";
    if (PM_CONFIGS.length > 1) h += '<div class="soa-dtabs">' + PM_CONFIGS.map(function (c, i) { return '<button type="button" data-pm="' + i + '"' + (i === PM.idx ? ' class="on"' : "") + ">" + esc(c.title) + "</button>"; }).join("") + "</div>";
    h += '<div class="soa-sgrid k4">';
    items.forEach(function (it, i) {
      var bal = it.balance_qty || 0;
      h += '<div class="soa-scard" style="--c:' + (bal < 0 ? "#c62828" : acc[i % acc.length]) + '"><span>' + esc(it.label) + " \u00b7 Balance Qty</span><b>" + nq(bal) + "</b><small>Purchased " + nq(it.purchased_qty) + " \u00b7 Sold " + nq(it.sold_qty) + "</small>" +
        ((it.missing_codes || []).length ? '<small class="warn">Not in Item master: ' + esc(it.missing_codes.join(", ")) + "</small>" : "") + "</div>";
    });
    var bv = tot.balance_value || 0;
    h += '<div class="soa-scard" style="--c:' + (bv < 0 ? "#c62828" : "#1a6e3a") + '"><span>Total Balance Amount</span><b>' + inr(bv) + "</b><small>Purchased " + inr(tot.purchased_amount) + " \u00b7 Sold " + inr(tot.sold_amount) + "</small></div></div>" +
      '<div class="soa-note">Balance amount = balance qty \u00d7 average purchase rate of that item.</div>';
    h += pmSection("Purchased from " + (p.supplier_name || cfg.title), "Purchase Receipts (submitted). Click an item to see each receipt.", items, "pr");
    h += pmSection("Sold to " + (p.customer_name || cfg.customer), "Sales Invoices (submitted). Click an item to see each invoice.", items, "si");
    $("#soa-dr-body").innerHTML = h;
  }
  function pmSection(title, note, items, kind) {
    var isPr = kind === "pr", lk = isPr ? "receipts" : "invoices", qk = isPr ? "purchased_qty" : "sold_qty", ak = isPr ? "purchased_amount" : "sold_amount", dt = isPr ? "Purchase Receipt" : "Sales Invoice";
    var h = '<h5 class="soa-h5">' + esc(title) + '</h5><div class="soa-note">' + esc(note) + '</div><table class="soa-t soa-dt soa-pm"><thead><tr><th>Item</th><th class="n">Total Qty</th><th class="n">Amount</th><th class="n">' + (isPr ? "Receipts" : "Invoices") + "</th></tr></thead><tbody>";
    var sum = 0;
    items.forEach(function (it, i) {
      var docs = it[lk] || [], key = kind + i, op = !!PM.open[key];
      sum += it[ak] || 0;
      h += '<tr class="soa-pmrow' + (op ? " open" : "") + '" data-pmk="' + key + '"><td class="nm"><span class="cr">' + I.caret + "</span>" + esc(it.label) + "<small>" + esc((it.item_codes || []).join("  +  ")) + '</small></td><td class="n">' + nq(it[qk]) + '</td><td class="n">' + inr(it[ak]) + '</td><td class="n">' + docs.length + "</td></tr>";
      if (op) {
        h += '<tr class="soa-pmdet"><td colspan="4"><table class="soa-t"><thead><tr><th>' + dt + "</th><th>Date</th>" + (isPr ? "<th>PO</th>" : "") + '<th class="n">Qty</th><th class="n">Rate</th><th class="n">Amount</th></tr></thead><tbody>' +
          (docs.length ? docs.map(function (x) {
            return "<tr><td>" + docLink(dt, x.doc_no) + (x.is_return ? '<span class="soa-ret">Return</span>' : "") + "<small>" + esc(x.item_code) + "</small></td><td>" + esc(short(x.posting_date)) + "</td>" +
              (isPr ? "<td>" + (x.purchase_order ? docLink("Purchase Order", x.purchase_order) : "\u2013") + "</td>" : "") +
              '<td class="n">' + nq(x.qty) + '</td><td class="n">' + inr(x.rate) + '</td><td class="n">' + inr(x.amount) + "</td></tr>";
          }).join("") : '<tr><td colspan="' + (isPr ? 6 : 5) + '" class="mut">No ' + (isPr ? "receipts" : "invoices") + " yet.</td></tr>") + "</tbody></table></td></tr>";
      }
    });
    return h + '</tbody><tfoot><tr><td>Total</td><td></td><td class="n">' + inr(sum) + "</td><td></td></tr></tfoot></table>";
  }

  /* ===================================================================
     events
     =================================================================== */
  $("#soa-scrim").addEventListener("click", closeDrawer);
  d.addEventListener("keydown", function (e) { if (e.key === "Escape") { if (!$("#soa-set").hidden) closeSettings(); else closeDrawer(); } });
  $("#soa-drawer").addEventListener("click", function (e) {
    var b;
    if (e.target.closest("#soa-dr-x")) { closeDrawer(); return; }
    if ((b = e.target.closest("[data-seg]"))) { SO.seg = +b.getAttribute("data-seg"); drawSO(); return; }
    if ((b = e.target.closest("[data-xls]"))) { soXLS(b.getAttribute("data-xls")); return; }
    if ((b = e.target.closest("[data-f]"))) {
      var key = SEGS[SO.seg].key; SO.filter[key] = b.getAttribute("data-f"); drawSO();
      if (b.classList.contains("soa-scard")) { var a = $("#soa-list-anchor"); if (a) a.scrollIntoView({ behavior: "smooth", block: "start" }); }
      return;
    }
    if ((b = e.target.closest("[data-pm]"))) { openPM(+b.getAttribute("data-pm")); return; }
    if ((b = e.target.closest("tr[data-pmk]"))) { if (e.target.closest("a")) return; var k = b.getAttribute("data-pmk"); PM.open[k] = !PM.open[k]; drawPM(); return; }
  });
  /* navbar buttons root ke bahar bhi hote hain */
  d.addEventListener("click", function (e) {
    if (e.target.closest("#soa-b-so, [data-open='so']")) { openSO(); return; }
    if (e.target.closest("#soa-b-pm, [data-open='pm']")) { openPM(0); return; }
  });
  root.addEventListener("click", function (e) {
    var b;
    if (e.target.closest("#soa-prev")) { shiftMonth(-1); return; }
    if (e.target.closest("#soa-next")) { shiftMonth(1); return; }
    if ((b = e.target.closest("#soa-status [data-v]"))) { S.status = b.getAttribute("data-v"); store("status", S.status); syncBand(); load(); return; }
    if ((b = e.target.closest("[data-kpi='overdue']"))) { if (S.status !== "Overdue") { S.status = "Overdue"; syncBand(); load(); } return; }
    if (e.target.closest("#soa-csv")) { mainCSV(); return; }
    if ((b = e.target.closest("#soa-main [data-cust]"))) { openCust(b.getAttribute("data-cust"), b.getAttribute("data-cn")); return; }
  });
  var qT = null;
  root.addEventListener("input", function (e) { if (e.target.id === "soa-q") { S.q = e.target.value; clearTimeout(qT); qT = setTimeout(renderTable, 120); } });
  root.addEventListener("change", function (e) {
    var id = e.target.id, v = e.target.value;
    if (id === "soa-ig") { S.ig = v; syncBand(); load(); }
    else if (id === "soa-from" || id === "soa-to") {
      if (!v) { syncBand(); return; }
      if (id === "soa-from") S.from = v; else S.to = v;
      if (S.from > S.to) { var x = S.from; S.from = S.to; S.to = x; }
      syncBand(); load();
    }
  });
  $("#soa-refresh").addEventListener("click", load);
  $("#soa-print").addEventListener("click", function () { w.print(); });

  /* ===================================================================
     settings (System Manager)
     =================================================================== */
  var SV = { users: [], cand: [], pick: null };
  function openSettings() {
    var m = $("#soa-set");
    $(".soa-modal", m).innerHTML =
      '<div class="soa-mh"><div><h3>Report access</h3><p>Only <b>View</b> access \u2014 this page cannot change any data. System Managers always have access. Disabled users are not listed. Summary cards show only to System Manager / UCM Admin.</p></div>' +
        '<button type="button" class="soa-ibtn" id="soa-set-x" title="Close">' + I.x + "</button></div>" +
      '<div class="soa-mb"><div class="soa-msg" id="soa-set-msg"></div>' +
        '<div class="soa-add"><div class="soa-pick"><input type="text" id="soa-set-u" placeholder="Type user name or email\u2026" autocomplete="off"><div class="soa-pick-l" id="soa-set-l" hidden></div></div>' +
        '<button type="button" class="soa-btn" id="soa-set-go">Give view access</button></div>' +
        '<div class="soa-ulist" id="soa-set-list"><div class="soa-none">Loading\u2026</div></div></div>';
    m.hidden = false; lock(true);
    $("#soa-set-x").addEventListener("click", closeSettings);
    var inp = $("#soa-set-u"), lst = $("#soa-set-l");
    function pick() {
      var qs = inp.value.trim().toLowerCase(), have = {};
      SV.users.forEach(function (u) { have[u.user] = 1; });
      var list = SV.cand.filter(function (c) { return !have[c.user] && (!qs || (c.full_name + " " + c.user).toLowerCase().indexOf(qs) >= 0); }).slice(0, 8);
      lst.innerHTML = list.length ? list.map(function (c) { return '<button type="button" data-u="' + esc(c.user) + '"><b>' + esc(c.full_name) + "</b><small>" + esc(c.user) + "</small></button>"; }).join("") : '<div class="soa-none">No user found</div>';
      lst.hidden = false;
    }
    inp.addEventListener("focus", pick);
    inp.addEventListener("input", function () { SV.pick = null; pick(); });
    inp.addEventListener("blur", function () { setTimeout(function () { lst.hidden = true; }, 120); });
    lst.addEventListener("mousedown", function (e) {
      var b = e.target.closest("button[data-u]"); if (!b) return; e.preventDefault();
      var c = SV.cand.filter(function (x) { return x.user === b.getAttribute("data-u"); })[0];
      SV.pick = c ? c.user : null; inp.value = c ? c.full_name + " (" + c.user + ")" : ""; lst.hidden = true;
    });
    $("#soa-set-go").addEventListener("click", async function () {
      if (!SV.pick) { setMsg("Pick a user from the list first."); return; }
      this.disabled = true; var who = SV.pick;
      if (await settingsCall({ action: "set", user: who, level: "view" })) { SV.pick = null; inp.value = ""; setMsg("View access given to " + who + ".", true); }
      this.disabled = false;
    });
    $("#soa-set-list").addEventListener("click", async function (e) {
      var b = e.target.closest("button[data-rm]"); if (!b) return;
      if (!b.classList.contains("arm")) { b.classList.add("arm"); b.textContent = "Remove?"; setTimeout(function () { if (b.isConnected) { b.classList.remove("arm"); b.innerHTML = I.x; } }, 3000); return; }
      b.disabled = true;
      if (await settingsCall({ action: "set", user: b.getAttribute("data-rm"), level: "none" })) setMsg("Access removed for " + b.getAttribute("data-rm") + ".", true);
    });
    settingsCall({ action: "list" });
  }
  function setMsg(t, ok) { var el = $("#soa-set-msg"); if (!el) return; el.className = "soa-msg" + (t ? " show" + (ok ? " ok" : "") : ""); el.textContent = t || ""; }
  async function settingsCall(body) {
    try {
      var m = await api(body, "POST"); if (!m) return false;
      SV.users = (m.users || []).filter(function (u) { return u.enabled !== 0 && u.enabled !== false; }); SV.cand = m.candidates || [];
      $("#soa-set-list").innerHTML = SV.users.length ? SV.users.map(function (u) {
        return '<div class="soa-urow"><span class="av">' + esc(initials(u.full_name || u.user)) + '</span><div class="nm"><b>' + esc(u.full_name) + "</b><small>" + esc(u.user) + "</small></div>" +
          (u.level === "admin" ? '<span class="tag admin">System Manager</span><span class="rm"></span>' : '<span class="tag">View</span><button type="button" class="rm" data-rm="' + esc(u.user) + '" title="Remove access">' + I.x + "</button>") + "</div>";
      }).join("") : '<div class="soa-none">No users yet</div>';
      return true;
    } catch (e) { setMsg((body.action === "list" ? "Could not load users: " : "Not saved: ") + e.message); return false; }
  }
  function closeSettings() { var m = $("#soa-set"); if (m.hidden) return; m.hidden = true; lock(false); }
  $("#soa-gear").addEventListener("click", openSettings);
  $("#soa-set").addEventListener("mousedown", function (e) { if (e.target === this) closeSettings(); });

  /* ============ UCM standard header: title + buttons ERP navbar mein ============ */
  function mergeNav() {
    var nav = d.querySelector("nav.navbar"), brand = nav && nav.querySelector(".navbar-brand");
    if (!nav || !brand) return;
    var t = d.createElement("div"); t.className = "soa-nav-title";
    t.innerHTML = '<h1>Sales Order Analysis</h1><p class="soa-sub"></p>';
    brand.insertAdjacentElement("afterend", t);
    var bt = $("#soa-btns"); if (bt) { bt.classList.add("in-nav"); t.insertAdjacentElement("afterend", bt); }
    /* mobile ke liye wahi buttons page par bhi */
    $("#soa-btnbar").innerHTML = '<div class="soa-btns is-bar"><button type="button" class="soa-tbtn" data-open="so">' + I.list + '<span>Sales Orders</span></button><button type="button" class="soa-tbtn" data-open="pm">' + I.box + "<span>Packing Material</span></button></div>";
    var act = $("#soa-act"); act.classList.add("soa-nav-act");
    var login = nav.querySelector("#website-post-login");
    if (login && login.parentNode) {
      var li = d.createElement("li"); li.className = "nav-item soa-nav-li"; li.appendChild(act);
      login.parentNode.insertBefore(li, login);
    } else { (brand.parentElement || nav).appendChild(act); act.classList.add("is-end"); }
    $("#soa-head").hidden = true;
    d.body.classList.add("soa-nav-merged");
    alignToLogo();
    w.addEventListener("resize", alignToLogo);
    w.addEventListener("load", alignToLogo);
  }
  /* page ka left margin = logo ka left margin */
  function alignToLogo() {
    var brand = d.querySelector("nav.navbar .navbar-brand"); if (!brand) return;
    var img = brand.querySelector("img, svg") || brand;
    var left = Math.round(img.getBoundingClientRect().left - root.getBoundingClientRect().left);
    if (left >= 8 && left <= 120) root.style.setProperty("--soa-pad", left + "px");
    var nav = d.querySelector("nav.navbar"), pos = nav ? getComputedStyle(nav).position : "";
    var stick = nav && (pos === "sticky" || pos === "fixed") ? Math.round(nav.getBoundingClientRect().height) : 0;
    if (!stick && nav && nav.parentElement && /sticky|fixed/.test(getComputedStyle(nav.parentElement).position)) stick = Math.round(nav.parentElement.getBoundingClientRect().height);
    root.style.setProperty("--soa-nav-h", stick + "px");
  }

  /* ============ start ============ */
  async function boot() {
    if (!cookie("user_id") || cookie("user_id") === "Guest") { location.href = "/login?redirect-to=" + encodeURIComponent(location.pathname); return; }
    try { S.acc = await api({ action: "me" }); }
    catch (e) {
      $("#soa-gate").innerHTML = '<div class="soa-gate-card"><div class="ico warn">!</div><h3>Could not check access</h3><p>' + esc(e.message) + '</p><p class="s">Check that the <b>ucm_so_analysis</b> Server Script is saved and enabled.</p></div>';
      return;
    }
    if (!S.acc || !S.acc.can_view) {
      $("#soa-gate").innerHTML = '<div class="soa-gate-card"><div class="ico">' + I.lock + '</div><h3>You do not have access</h3><p>This report is open only to System Managers and users given access by them.</p><p class="s">Signed in as <b>' + esc((S.acc && (S.acc.full_name || S.acc.user)) || "") + "</b></p></div>";
      return;
    }
    $("#soa-gate").hidden = true; $("#soa-app").hidden = false;
    $("#soa-gear").hidden = !S.acc.is_admin;
    mergeNav();
    syncBand();
    loadLists();
    load();
  }
  boot();
})();
