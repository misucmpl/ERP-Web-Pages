.soa-sgrid.k4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.soa-sgrid.k3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.soa-scard { --c: #3949ab; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; text-align: left; padding: 9px 11px; border-radius: 10px; border: 1px solid var(--line); border-top: 3px solid var(--c); background: #fff; min-width: 0; font: inherit; }
.soa-scard span { font-size: 10.5px; font-weight: 700; color: var(--mut); text-transform: uppercase; letter-spacing: .03em; }
.soa-scard b { font-size: 19px; font-weight: 800; color: var(--c); line-height: 1.2; }
.soa-scard small { font-size: 11px; color: var(--mut); }
.soa-scard small.warn { color: #c62828; font-weight: 700; }
.soa-scard:disabled { cursor: default; opacity: 1; color: inherit; }
.soa-scard.is-click { cursor: pointer; }
.soa-scard.is-click:hover { box-shadow: 0 6px 14px -10px rgba(30,40,90,.6); }
.soa-scard.on { box-shadow: 0 0 0 2px var(--c); }
.soa-barw { margin-top: 8px; font-size: 11.5px; font-weight: 600; color: var(--ink2); }
.soa-barw .soa-bar { display: block; width: 100%; height: 7px; margin: 4px 0 0; }
.soa-barw .soa-bar i { display: block; height: 100%; border-radius: 3px; }
.soa-note { margin: 6px 0 0 !important; font-size: 11.5px; color: var(--mut); }
.soa-stchips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.soa-stchips span { font-size: 11.5px; padding: 3px 9px; border-radius: 99px; background: #fff; border: 1px solid var(--line); color: var(--ink2); }
.soa-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
.soa-chip { border-radius: 99px; padding: 4px 11px; font-size: 12px; font-weight: 600; border: 1px solid var(--line2); background: #fff; color: var(--ink2); cursor: pointer; }
.soa-chip em { font-style: normal; color: var(--mut); font-weight: 700; }
.soa-chip:hover { border-color: #c9d1f3; }
.soa-chip.on { background: #e6eafb; border-color: #c9d1f3; color: #283593; }
.soa-chip.on em { color: #283593; }
.soa-lbar { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; font-size: 12px; color: var(--mut); scroll-margin-top: 10px; }
.soa-lbar .soa-btn { height: 30px; font-size: 12.5px; }
.soa-badge { display: inline-block; font-size: 11px; font-weight: 700; padding: 2px 9px; border-radius: 99px; white-space: nowrap; }
.soa-dt td { font-size: 12.5px; }
.soa-minis { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; margin-bottom: 10px; }
.soa-mini { --c: #3949ab; }
.soa-mini b { color: var(--c) !important; }
.soa-mini { border-top-color: var(--c) !important; }
.soa-oc { background: #fff; border: 1px solid var(--line); border-radius: 12px; margin-bottom: 10px; overflow: hidden; }
.soa-oc-h { display: flex; align-items: center; gap: 12px; padding: 9px 12px; background: var(--soft); border-bottom: 1px solid var(--line); font-size: 12.5px; color: var(--mut); }
.soa-oc-h a { font-weight: 700; }
.soa-oc-h .soa-st { margin-left: auto; font-weight: 600; }
.soa-oi { padding: 9px 12px; border-bottom: 1px solid #eef0fa; }
.soa-oi:last-child { border-bottom: 0; }
.soa-oi.done { background: #f6fbf7; }
.soa-oi .t { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; }
.soa-oi .t span { font-weight: 700; white-space: nowrap; }
.soa-oi .q { font-size: 12px; color: var(--mut); margin-top: 2px; }
.soa-dels { margin-top: 6px; display: flex; flex-direction: column; gap: 3px; }
.soa-del { display: grid; grid-template-columns: 110px 1fr 100px 70px; gap: 8px; align-items: center; font-size: 12px; padding: 4px 8px; border-radius: 7px; background: var(--soft); }
.soa-del .ty { font-size: 10.5px; font-weight: 700; color: var(--mut); text-transform: uppercase; }
.soa-del b { text-align: right; }
.soa-nodel { margin-top: 5px; font-size: 11.5px; color: #b8560c; }
.soa-pmrow { cursor: pointer; }
.soa-pmrow .cr { display: inline-flex; margin-right: 6px; color: var(--pri-d); transition: transform .15s; vertical-align: -1px; }
.soa-pmrow.open .cr { transform: rotate(90deg); }
.soa-pmrow:hover td { background: var(--pri-l) !important; }
.soa-pmdet > td { background: var(--soft); padding: 8px 10px 12px 26px !important; }
.soa-pmdet .soa-t { border-radius: 8px; }
.soa-ret { display: inline-block; margin-left: 6px; font-size: 9.5px; font-weight: 800; padding: 1px 6px; border-radius: 6px; color: #fff; background: #c62828; }
.soa-f-cust .soa-pick { width: 230px; position: relative; }
.soa-f-cust .soa-pick input { height: 34px; padding-right: 30px; font-size: 13px; }
.soa-clr { position: absolute; right: 4px; top: 5px; width: 24px; height: 24px; border: 0; border-radius: 6px; background: none; color: var(--mut); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; padding: 0; }
.soa-clr:hover { background: var(--pri-l); color: var(--pri-d); }
.soa-f-cust .soa-pick-l { min-width: 300px; z-index: 30; }

@media (max-width: 1440px) and (min-width: 761px) {
  .soa-filters { gap: 8px 14px; }
  .soa-f { gap: 7px; }
  .soa-f-cust .soa-pick { width: 170px; }
  #ucm-soa .soa-dates input { width: 128px; padding: 0 6px; }
  #ucm-soa .soa-f select { min-width: 140px; max-width: 160px; }
  #ucm-soa .soa-nav b { min-width: 104px; }
  #ucm-soa .soa-pills button { padding: 0 9px; }
  #ucm-soa .soa-f > span { display: none; }  /* jagah bachane ke liye labels hide; placeholder se samajh aata hai */
  #ucm-soa .soa-t { font-size: 12.5px; }
}
@media (max-width: 1280px) and (min-width: 761px) { .soa-tbtn span { display: none; } .soa-tbtn { padding: 0 10px; } #ucm-soa .soa-kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 1100px) { .soa-topgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .soa-sgrid.k5 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 760px) {
  .soa-btns.in-nav { display: none; }
  .soa-btnbar { display: block; background: #fff; padding: 10px 12px 0; }
  .soa-btns.is-bar { display: flex; width: 100%; }
  .soa-btns.is-bar .soa-tbtn { flex: 1 1 0; justify-content: center; }
  #ucm-soa .soa-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .soa-topgrid { grid-template-columns: 1fr; padding: 10px 10px 0; }
  .soa-f-cust .soa-pick { width: 100%; flex: 1; }
  #soa-status { display: flex; width: 100%; } #soa-status button { flex: 1 1 0; padding: 0 2px; font-size: 12px; }
  .soa-f-cust .soa-pick-l { min-width: 0; }
  #soa-tw { display: none; }
  .soa-mlist { display: flex; flex-direction: column; gap: 8px; padding: 10px; }
  .soa-mcard { display: flex; flex-direction: column; gap: 4px; padding: 10px 12px; background: #fff; border: 1px solid var(--line); border-left: 3px solid #c9d1f3; border-radius: 10px; font-size: 12.5px; }
  .soa-mcard .t { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .soa-mcard .m { display: flex; justify-content: space-between; gap: 8px; color: var(--mut); }
  .soa-mcard .m span:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .soa-sgrid.k5, .soa-sgrid.k4, .soa-sgrid.k3, .soa-minis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .soa-dt th:nth-child(3), .soa-dt td:nth-child(3) { display: none; }
  .soa-del { grid-template-columns: 1fr 80px 50px; } .soa-del .ty { display: none; }
}
@media print { .soa-btns, .soa-btnbar, .soa-delay { box-shadow: none; } .soa-btns, .soa-btnbar { display: none !important; } }

/* ===== Slider header = theme colour (#E6EAFB) ===== */
.soa-dr-h { background: #e6eafb; border-top: 0; border-bottom: 1px solid #c9d1f3; padding: 13px 18px; }
.soa-dr-h h3 { color: #283593; }
.soa-dr-h p, .soa-dr-h p a { color: #3f4766; }
.soa-dr-h .soa-ibtn { background: #fff; border-color: #c9d1f3; color: #283593; }
.soa-dr-h .soa-ibtn:hover { background: #f4f6fe; }

/* Top customers: toggle (page load par band) */
.soa-toph { cursor: pointer; user-select: none; }
.soa-tops:not(.open) .soa-toph { border-bottom: 0; }
.soa-tops:not(.open) { padding-bottom: 0; }
.soa-tgbtn { height: 30px; font-size: 12.5px; }
.soa-tgbtn svg { transform: rotate(90deg); transition: transform .2s; }
.soa-tops.open .soa-tgbtn svg { transform: rotate(-90deg); }
