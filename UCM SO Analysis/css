/* ============================================================
   UCMPL - Sales Order Analysis - Web Page CSS
   Web Page -> Style -> CSS box mein poora paste karein.
   Theme: light indigo #E6EAFB (fills) + indigo #3949AB (text). Fill par text gehra indigo #283593.
   ============================================================ */
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");

.navbar > .container, .navbar .container-fluid, header .navbar .container,
.web-footer .container, footer .container { max-width: none !important; width: 100% !important; padding-left: 24px !important; padding-right: 24px !important; box-sizing: border-box !important; }
.page-content-wrapper, .page_content, main .container { max-width: none !important; }

#ucm-soa, .soa-drawer, .soa-modal-bg, .soa-scrim {
  --bg: #f7f8fd; --card: #ffffff; --line: #e3e7f6; --line2: #d3d9f0; --soft: #fbfcff;
  --ink: #161b33; --ink2: #3f4766; --mut: #77809e; --mut2: #a9b0c8;
  --pri: #e6eafb; --pri-d: #3949ab; --pri-dd: #d6dcf7; --pri-l: #f4f6fe; --pri-b: #c9d1f3; --on-pri: #283593;
  --blue: #2563eb; --violet: #7c3aed; --green: #16a34a; --red: #dc2626; --dark: #334155; --amber: #ca8a04;
  --red-l: #fef1f1; --green-l: #ebf9f0;
}
#ucm-soa {
  font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: var(--ink); background: var(--bg); font-size: 14px; line-height: 1.45;
  min-height: 100vh; width: 100vw; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);
  -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums;
}
#ucm-soa *, #ucm-soa *::before, #ucm-soa *::after, .soa-drawer *, .soa-modal-bg * { box-sizing: border-box; }
#ucm-soa [hidden], .soa-drawer [hidden], .soa-modal-bg[hidden], .soa-modal-bg [hidden] { display: none !important; }
#ucm-soa button, .soa-drawer button, .soa-modal-bg button { font: inherit; color: inherit; }
#ucm-soa a, .soa-drawer a { color: var(--pri-d); text-decoration: none; }
#ucm-soa a:hover, .soa-drawer a:hover { text-decoration: underline; }
.mut { color: var(--mut2) !important; }

/* gate */
.soa-gate { display: flex; justify-content: center; padding: 80px 16px; }
.soa-gate-card { width: 100%; max-width: 440px; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 34px 28px; text-align: center; box-shadow: 0 20px 44px -30px rgba(30,40,90,.45); }
.soa-gate-card .ico { width: 54px; height: 54px; margin: 0 auto 12px; border-radius: 14px; display: flex; align-items: center; justify-content: center; background: var(--pri-l); color: var(--pri-d); }
.soa-gate-card .ico.warn { background: var(--red-l); color: var(--red); font-size: 24px; font-weight: 800; }
.soa-gate-card h3 { margin: 0 0 6px; font-size: 18px; font-weight: 700; }
.soa-gate-card p { margin: 0 0 6px; color: var(--ink2); }
.soa-gate-card p.s { margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--line); font-size: 12.5px; color: var(--mut); }
.soa-spin { display: inline-block; width: 20px; height: 20px; border: 3px solid #d6dcf7; border-top-color: var(--pri); border-radius: 50%; animation: soaSpin .8s linear infinite; vertical-align: middle; }
@keyframes soaSpin { to { transform: rotate(360deg); } }

/* own header (sirf tab jab ERP navbar na mile) */
.soa-head { display: flex; align-items: center; gap: 14px; padding: 12px var(--soa-pad, 24px); background: #fff; border-bottom: 1px solid var(--line); }
.soa-title { flex: 1; min-width: 0; }
.soa-title h1 { margin: 0; font-size: 15px; font-weight: 700; color: #0f172a; }
.soa-title p { margin: 1px 0 0; font-size: 11px; color: #64748b; }
.soa-head-act { display: flex; gap: 8px; }
.soa-ibtn { width: 34px; height: 34px; flex: 0 0 34px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; cursor: pointer; padding: 0;
  border: 1px solid var(--line2); background: #fff; color: var(--ink2); transition: background .15s, color .15s, border-color .15s; }
.soa-ibtn:hover { background: var(--pri-l); color: var(--pri-d); border-color: var(--pri-b); }

/* section switch */
.soa-sec { display: inline-flex; gap: 2px; padding: 3px; border-radius: 10px; background: #fbfcff; border: 1px solid #e3e7f6; font-family: "Inter", system-ui, sans-serif; }
.soa-sec button { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 13px; border: 0; border-radius: 8px; background: none; cursor: pointer; font: inherit; font-size: 13px; font-weight: 600; color: #3f4766; white-space: nowrap; }
.soa-sec button svg { width: 15px; height: 15px; opacity: .75; flex: 0 0 auto; }
.soa-sec button .s { display: none; }
.soa-sec button:hover { color: #3949ab; }
.soa-sec button.on { background: #e6eafb; color: #283593; box-shadow: 0 2px 6px -2px rgba(57,73,171,.7); }
.soa-sec button.on svg { opacity: 1; }
.soa-sec.in-nav { margin-right: 16px; flex: 0 0 auto; }
.soa-secbar { display: none; }
.soa-sec [hidden] { display: none !important; }
#ucm-soa.is-single .soa-sec { display: none !important; }

/* band: filters */
.soa-band { background: #fff; border-bottom: 1px solid var(--line); padding: 10px var(--soa-pad, 24px); }
.soa-filters { display: flex; align-items: center; gap: 10px 22px; flex-wrap: wrap; }
.soa-f { display: flex; align-items: center; gap: 9px; min-width: 0; }
.soa-f > span { font-size: 11px; font-weight: 700; color: var(--mut); text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
.soa-pills { display: inline-flex; gap: 2px; padding: 3px; background: var(--soft); border: 1px solid var(--line); border-radius: 9px; }
.soa-pills button { height: 28px; padding: 0 12px; border: 0; border-radius: 7px; background: none; cursor: pointer; font-size: 12.5px; font-weight: 600; color: var(--ink2); white-space: nowrap; }
.soa-pills button:hover { color: var(--pri-d); }
.soa-pills button.on { background: var(--pri); color: var(--on-pri); font-weight: 700; }
.soa-days { display: flex; align-items: center; gap: 8px; }
.soa-dayin { display: inline-flex; align-items: center; height: 34px; border: 1px solid var(--line2); border-radius: 9px; padding: 0 10px 0 4px; background: #fff; }
.soa-dayin input { width: 52px; border: 0; outline: none; font: inherit; font-size: 13px; font-weight: 600; text-align: right; background: none; }
.soa-dayin i { font-style: normal; font-size: 12px; color: var(--mut); margin-left: 4px; }
.soa-f select, .soa-dates input { height: 34px; border: 1px solid var(--line2); border-radius: 9px; padding: 0 10px; font: inherit; font-size: 13px; background: #fff; color: var(--ink); outline: none; }
.soa-f select { min-width: 190px; max-width: 260px; }
.soa-f select:focus, .soa-dates input:focus, .soa-dayin:focus-within { border-color: var(--pri); box-shadow: 0 0 0 3px rgba(57,73,171,.15); }
.soa-dates { display: flex; align-items: center; gap: 6px; }
.soa-dates i { font-style: normal; font-size: 12px; color: var(--mut); }
.soa-nav { display: inline-flex; align-items: center; gap: 4px; }
.soa-nav b { min-width: 118px; text-align: center; font-size: 13.5px; font-weight: 700; color: var(--pri-d); }
.soa-nbtn { width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--line2); background: #fff; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; color: var(--ink2); padding: 0; }
.soa-nbtn:disabled { opacity: .35; cursor: default; background: #fff !important; color: var(--ink2) !important; border-color: var(--line2) !important; }
.soa-nbtn:hover { background: var(--pri-l); border-color: var(--pri-b); color: var(--pri-d); }
.soa-note { margin: 0 0 0 auto; font-size: 12px; color: var(--mut); }

/* main */
.soa-main { padding: 16px var(--soa-pad, 24px) 40px; transition: opacity .15s; }
.soa-main.is-loading { opacity: .55; pointer-events: none; }
.soa-empty { padding: 44px 16px; text-align: center; color: var(--mut); font-size: 13.5px; }
.soa-empty .soa-spin { margin-right: 10px; }
.soa-error { padding: 16px 18px; margin: 12px 0; border-radius: 12px; background: var(--red-l); color: var(--red); border: 1px solid #f8caca; font-size: 13.5px; }
.soa-none { padding: 14px; text-align: center; color: var(--mut); font-size: 12.5px; }

/* kpi cards */
.soa-kpis { display: grid; gap: 12px; margin-bottom: 16px; }
.soa-kpis.k5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
.soa-kpis.k6 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
.soa-kpi { --c: var(--pri-d); position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; text-align: left; padding: 13px 15px 12px; border-radius: 12px; border: 1px solid var(--line); background: #fff; overflow: hidden; min-width: 0; font: inherit; }
.soa-kpi::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--c); opacity: .85; }
.soa-kpi span { font-size: 11px; font-weight: 700; color: var(--mut); text-transform: uppercase; letter-spacing: .04em; }
.soa-kpi b { font-size: 22px; font-weight: 800; color: var(--c); line-height: 1.2; letter-spacing: -.01em; }
.soa-kpi small { font-size: 11.5px; color: var(--mut); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
.soa-kpi:disabled { cursor: default; opacity: 1; }
.soa-kpi.is-click { cursor: pointer; transition: border-color .15s, box-shadow .15s, transform .15s; }
.soa-kpi.is-click:hover { border-color: var(--pri-b); transform: translateY(-1px); box-shadow: 0 8px 18px -14px rgba(30,40,90,.5); }
.soa-kpi.on { border-color: var(--c); box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 22%, transparent); background: color-mix(in srgb, var(--c) 5%, #fff); }
.soa-kpi.is-pri { --c: var(--pri-d); } .soa-kpi.is-blue { --c: var(--blue); } .soa-kpi.is-violet { --c: var(--violet); }
.soa-kpi.is-green { --c: var(--green); } .soa-kpi.is-red { --c: var(--red); } .soa-kpi.is-dark { --c: var(--dark); }

/* register (card holding a table) */
.soa-reg { background: #fff; border: 1px solid var(--line); border-radius: 14px; margin-bottom: 16px; }
.soa-reg.soa-pad { padding: 14px 18px 16px; }
.soa-reg-h { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
.soa-reg-t { flex: 1; min-width: 200px; }
.soa-reg-t h2 { margin: 0; font-size: 15px; font-weight: 700; }
.soa-reg-t p { margin: 1px 0 0; font-size: 12px; color: var(--mut); }
.soa-reg-tools { display: flex; align-items: center; gap: 8px; }
.soa-search { display: inline-flex; align-items: center; gap: 7px; height: 34px; padding: 0 11px; border: 1px solid var(--line2); border-radius: 9px; background: #fff; color: var(--mut); width: 280px; max-width: 100%; }
.soa-search:focus-within { border-color: var(--pri); box-shadow: 0 0 0 3px rgba(57,73,171,.15); }
.soa-search input { border: 0; outline: none; font: inherit; font-size: 13px; width: 100%; background: none; color: var(--ink); }
.soa-legend { display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--mut); margin-right: 6px; }
.soa-legend i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; margin-left: 6px; }
.lg-n { background: var(--pri); } .lg-r { background: #93c5fd; }

/* tables: no inner scroll bar, page scroll only */
.soa-tw { width: 100%; }
.soa-t { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; }
.soa-t th { position: sticky; top: var(--soa-nav-h, 0px); z-index: 2; background: var(--soft); border-bottom: 1px solid var(--line); padding: 9px 12px; text-align: left; white-space: nowrap; font-size: 11px; font-weight: 700; color: var(--mut); text-transform: uppercase; letter-spacing: .04em; }
.soa-t td { padding: 9px 12px; border-bottom: 1px solid #eceffb; vertical-align: middle; }
.soa-t tbody tr:hover td { background: #f8f9fe; }
.soa-t .n { text-align: right; white-space: nowrap; }
.soa-t .c { text-align: center; }
.soa-t .i { width: 40px; color: var(--mut2); }
.soa-t td.nm { font-weight: 600; }
.soa-t td.nm small { display: block; font-size: 11px; font-weight: 500; color: var(--mut); }
.soa-t tfoot td { background: var(--pri-l); font-weight: 800; border-top: 1px solid var(--pri-b); border-bottom: 0; padding: 10px 12px; }
.soa-t tfoot td:first-child { border-bottom-left-radius: 13px; }
.soa-t tfoot td:last-child { border-bottom-right-radius: 13px; }
.soa-t th button { display: inline-flex; align-items: center; gap: 5px; border: 0; background: none; padding: 0; cursor: pointer; font: inherit; color: inherit; text-transform: inherit; letter-spacing: inherit; }
.soa-t th button svg { opacity: .35; }
.soa-t th button.on { color: var(--pri-d); }
.soa-t th button.on svg { opacity: 1; }
.soa-t tr.fut td { opacity: .5; }
.soa-click { cursor: pointer; }
.soa-click:hover td { background: var(--pri-l) !important; }
.soa-num { min-width: 38px; height: 26px; padding: 0 9px; border-radius: 7px; border: 1px solid transparent; cursor: pointer; font-weight: 700; font-size: 13px; }
.soa-num.t-new { background: var(--pri-l); color: var(--pri-d); border-color: var(--pri-b); }
.soa-num.t-repeat { background: #eff6ff; color: var(--blue); border-color: #bfdbfe; }
.soa-num.t-sample { background: #f5f3ff; color: var(--violet); border-color: #ddd6fe; }
.soa-num:hover { filter: brightness(.95); box-shadow: 0 2px 6px -3px rgba(0,0,0,.3); }
td.mix { width: 220px; white-space: nowrap; }
.soa-mix { display: inline-flex; width: 120px; height: 8px; border-radius: 4px; overflow: hidden; background: #e9ecf8; vertical-align: middle; margin-right: 8px; }
.soa-mix i.n { background: var(--pri); } .soa-mix i.r { background: #93c5fd; }
td.mix em, td.sh em { font-style: normal; font-size: 11.5px; font-weight: 600; color: var(--mut); }
.soa-bar { display: inline-block; width: 90px; height: 6px; border-radius: 3px; background: #e9ecf8; overflow: hidden; vertical-align: middle; margin-right: 8px; }
.soa-bar i { display: block; height: 100%; background: var(--pri); border-radius: 3px; }
th.sh, td.sh { width: 160px; white-space: nowrap; }
.soa-lnk { border: 0; background: none; padding: 0; cursor: pointer; font-weight: 600; color: var(--ink) !important; text-align: left; }
.soa-lnk:hover { color: var(--pri-d) !important; text-decoration: underline; }

/* pills */
.soa-gst { display: inline-block; font-size: 10.5px; font-weight: 700; padding: 2px 8px; border-radius: 99px; white-space: nowrap; }
.soa-gst.ok { background: var(--green-l); color: var(--green); border: 1px solid #bce6cb; }
.soa-gst.no { background: var(--red-l); color: var(--red); border: 1px solid #f8caca; }
.soa-gst.big { font-size: 12px; padding: 4px 12px; }
.soa-dp { display: inline-block; min-width: 46px; font-size: 11.5px; font-weight: 700; padding: 2px 8px; border-radius: 99px; text-align: center; }
.soa-dp.lo { background: var(--pri-l); color: var(--pri-d); }
.soa-dp.md { background: #fef3c7; color: #a16207; }
.soa-dp.hi { background: var(--red-l); color: var(--red); }
.soa-ig { display: inline-block; font-size: 11.5px; font-weight: 600; padding: 2px 8px; border-radius: 6px; background: #eef0fa; color: var(--ink2); white-space: nowrap; max-width: 200px; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; }
.soa-ig.s-ultra { background: #eff6ff; color: var(--blue); }
.soa-ig.s-large_blow { background: #f5f3ff; color: var(--violet); }
.soa-mlist { display: none; }

/* territory */
.soa-till { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; font-size: 13px; color: var(--ink2); }
.soa-till b { color: var(--pri-d); }
.soa-badge { background: var(--pri); color: var(--on-pri); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; padding: 5px 14px; border-radius: 99px; }
.soa-subtabs { display: flex; gap: 22px; border-bottom: 1px solid var(--line2); margin: 2px 0 16px; }
.soa-subtabs button { border: 0; background: none; padding: 9px 2px; margin-bottom: -1px; cursor: pointer; font-size: 12.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--mut); border-bottom: 2px solid transparent; }
.soa-subtabs button.on { color: var(--pri-d); border-bottom-color: var(--pri); }
.soa-reaches { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 16px; }
.soa-reach { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 13px 16px; display: flex; flex-direction: column; gap: 4px; }
.soa-reach span { font-size: 11px; font-weight: 700; color: var(--mut); text-transform: uppercase; letter-spacing: .04em; }
.soa-reach b { font-size: 22px; font-weight: 800; color: var(--pri-d); }
.soa-reach b i { font-style: normal; font-size: 15px; color: var(--mut2); font-weight: 700; }
.soa-reach .soa-bar { width: 100%; height: 7px; margin: 4px 0 2px; }
.soa-reach small { font-size: 11.5px; color: var(--mut); font-weight: 600; }
.soa-legend2 { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12px; color: var(--ink2); }
.soa-legend2 i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; vertical-align: -1px; }
.soa-legend2 i.p { background: var(--green); } .soa-legend2 i.e { background: var(--amber); } .soa-legend2 i.n { background: var(--red); }
.soa-h5 { margin: 14px 0 8px; font-size: 11px; font-weight: 800; color: var(--ink2); text-transform: uppercase; letter-spacing: .05em; }
.soa-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.soa-chip { border-radius: 99px; padding: 4px 11px; font-size: 12px; font-weight: 600; border: 1px solid; }
.soa-chip.p { background: #e9f8ee; color: #15803d; border-color: #b9e4c7; }
.soa-chip.e { background: #fdf6dd; color: #a16207; border-color: #f2dc93; }
.soa-chip.n { background: #fdeeee; color: #b91c1c; border-color: #f5c1c1; }
.soa-warn { margin-top: 14px; padding: 9px 12px; background: var(--soft); border: 1px dashed var(--line2); border-radius: 8px; font-size: 12px; color: var(--ink2); }

/* drawer (slider) */
.soa-scrim { position: fixed; inset: 0; z-index: 1060; background: rgba(15,20,50,.38); opacity: 0; pointer-events: none; transition: opacity .2s; }
.soa-scrim.on { opacity: 1; pointer-events: auto; }
.soa-drawer { position: fixed; top: 0; right: 0; bottom: 0; z-index: 1061; width: min(720px, 96vw); background: var(--bg); box-shadow: -30px 0 60px -30px rgba(15,20,50,.5); transform: translateX(105%); transition: transform .25s ease; display: flex; flex-direction: column; font-family: "Inter", system-ui, sans-serif; color: var(--ink); font-size: 13.5px; font-variant-numeric: tabular-nums; }
.soa-drawer.is-wide { width: min(940px, 96vw); }
.soa-drawer.on { transform: none; }
.soa-dr-h { display: flex; align-items: center; gap: 12px; padding: 12px 18px; background: #fff; border-bottom: 1px solid var(--line); border-top: 3px solid var(--pri); flex: 0 0 auto; }
.soa-dr-h .tt { flex: 1; min-width: 0; }
.soa-dr-h h3 { margin: 0; font-size: 15.5px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.soa-dr-h p { margin: 1px 0 0; font-size: 11.5px; color: var(--mut); }
.soa-drawer.is-new .soa-dr-h { border-top-color: var(--pri); }
.soa-drawer.is-repeat .soa-dr-h { border-top-color: var(--blue); }
.soa-drawer.is-sample .soa-dr-h { border-top-color: var(--violet); }
.soa-dr-b { flex: 1; overflow-y: auto; padding: 14px 18px 30px; }
.soa-dr-b .soa-t th { position: static; }
.soa-dr-b .soa-t { background: #fff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
.soa-dr-b .soa-t tfoot td { border-radius: 0; }
.soa-dtabs { display: flex; gap: 4px; padding: 3px; background: #fff; border: 1px solid var(--line); border-radius: 10px; margin-bottom: 10px; }
.soa-dtabs button { flex: 1; height: 32px; border: 0; border-radius: 8px; background: none; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--ink2); display: inline-flex; align-items: center; justify-content: center; gap: 7px; }
.soa-dtabs button em { font-style: normal; font-size: 11px; font-weight: 700; padding: 1px 7px; border-radius: 99px; background: var(--pri-l); color: var(--pri-d); }
.soa-dtabs button.on { background: var(--pri); color: var(--on-pri); font-weight: 700; }
.soa-dtabs button.on em { background: rgba(255,255,255,.6); color: var(--on-pri); }
.soa-dtools { display: flex; gap: 8px; margin-bottom: 10px; }
.soa-dtools .soa-search { flex: 1; width: auto; }
